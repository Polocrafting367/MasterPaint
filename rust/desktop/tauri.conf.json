{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MasterPaint",
  "version": "3.0.0",
  "identifier": "fr.masterpaint.app",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MasterPaint",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "polocrafting",
    "category": "GraphicsAndDesign",
    "shortDescription": "Éditeur d'images MasterPaint",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
