msgstr "Umgekehrt"

#: ui/phone.slint:1055
msgid "N&B"
msgstr "Schwarzweiß"

#: ui/photo.slint:299
msgid "Auto : réglage automatique de cette section seulement (retrouve les valeurs calculées après des retouches à la main)"
msgstr "Auto: automatische Anpassung nur dieses Abschnitts (findet die berechneten Werte nach manuellen Anpassungen)"

#: ui/photo.slint:321
msgid "Remettre les réglages de cette section à zéro"
msgstr "Setzen Sie die Einstellungen in diesem Abschnitt zurück"

