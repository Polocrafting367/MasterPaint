msgstr "Entwicklung"

#: ui/photo.slint:563
msgid "Masque"
msgstr "Maske"

#: ui/photo.slint:582
msgid "Annuler le dernier réglage de cette photo (Ctrl+Z)"
msgstr "Machen Sie die letzte Anpassung dieses Fotos rückgängig (Strg+Z)"

#: ui/photo.slint:589
msgid "Rétablir (Ctrl+Y)"
msgstr "Wiederholen (Strg+Y)"

#: ui/photo.slint:594
msgid "Importer photos"
msgstr "Fotos importieren"

#: ui/photo.slint:595
msgid "Importer des photos dans la pellicule (JPEG, PNG, RAW…)"
msgstr "Fotos in die Kamerarolle importieren (JPEG, PNG, RAW…)"

#: ui/photo.slint:603
msgid "Ouvrir la photo réglée dans l'éditeur MasterPaint"
msgstr "Öffnen Sie das angepasste Foto im MasterPaint-Editor"

#: ui/photo.slint:614
msgid "Exporter la photo : JPEG, PNG ou TIFF 16 bits"
msgstr "Foto exportieren: JPEG, PNG oder 16-Bit-TIFF"

#: ui/photo.slint:634
msgid "JPEG (8 bits)"
msgstr "JPEG (8 Bit)"

#: ui/photo.slint:647
msgid "Appliquer à toutes"
msgstr "Bewerben Sie sich für alle"

#: ui/photo.slint:648
msgid "Appliquer les réglages et le filtre de cette photo à toutes les photos de la pellicule"
msgstr "Wenden Sie Anpassungen und Filter von diesem Foto auf alle Fotos in der Kamerarolle an"

#: ui/photo.slint:657
msgid "Auto sur toutes"
msgstr "Alles automatisch"

#: ui/photo.slint:658
msgid "Réglage automatique de chaque photo d'après sa scène (portrait, paysage, nuit…)"
msgstr "Automatische Anpassung jedes Fotos entsprechend seiner Szene (Porträt, Landschaft, Nacht usw.)"

#: ui/photo.slint:668
msgid "Réduire : revenir à l'éditeur, la pellicule et ses réglages restent (onglet Photo Pro pour revenir)"
msgstr "Reduzieren: Rückkehr zum Editor, die Filmrolle und ihre Einstellungen bleiben erhalten (Registerkarte „Pro Photo“ zur Rückkehr)"

#: ui/photo.slint:674
msgid "Fermer le Mode Photo Pro (la pellicule et ses réglages sont gardés)"
msgstr "Schließen Sie den Pro Photo-Modus (die Filmrolle und ihre Einstellungen bleiben erhalten)"

#: ui/photo.slint:850
msgid "Départ : effet entier"
msgstr "Start: volle Wirkung"

#: ui/photo.slint:850
msgid "Arrivée : plus d'effet"
msgstr "Ende: keine Wirkung"

#: ui/photo.slint:850
msgid "Centre : déplacer l'ellipse"
msgstr "Mitte: Verschieben Sie die Ellipse"

#: ui/photo.slint:850
msgid "Bord : largeur ou hauteur"
msgstr "Kante: Breite oder Höhe"

#: ui/photo.slint:970
msgid "Redresser (°)"
msgstr "Richten (°)"

#: ui/photo.slint:1018
msgid "Aucune photo chargée. Importez vos fichiers JPG, PNG, WebP…"
msgstr "Keine Fotos geladen. Importieren Sie Ihre JPG-, PNG-, WebP-Dateien ..."

#: ui/photo.slint:1062
msgid "Rendu…"
msgstr "Gerendert…"

#: ui/photo.slint:1100
msgid "Ajuster la photo à la zone (aussi : double-clic sur la photo)"
msgstr "Passen Sie das Foto an die Umgebung an (auch: Doppelklick auf das Foto)"

#: ui/photo.slint:1122
msgid "Recadrer et redresser la photo"
msgstr "Beschneiden und begradigen Sie das Foto"

#: ui/photo.slint:1142
msgid "Pipette de balance des blancs : cliquez ensuite sur un gris ou un blanc neutre de la photo, la température et la teinte se règlent pour le rendre neutre"
msgstr "Weißabgleich-Pipette: Klicken Sie dann auf ein neutrales Grau oder Weiß im Foto. Temperatur und Farbton werden angepasst, um es neutral zu machen"

#: ui/photo.slint:1166
msgid "Avant"
msgstr "Vorher"

#: ui/photo.slint:1166
msgid "Après"
msgstr "Nachher"

#: ui/photo.slint:1166
msgid "OFF"
msgstr "OFF"

#: ui/photo.slint:1166
msgid "ON"
msgstr "ON"

#: ui/photo.slint:1172
msgid "Comparer avec l'original : réglages affichés (ON) ou photo d'origine (OFF)"
msgstr "Mit Original vergleichen: angezeigte Einstellungen (EIN) oder Originalfoto (AUS)"

#: ui/photo.slint:1244
msgid "Retirer cette photo de la pellicule"
msgstr "Dieses Foto aus der Kamerarolle entfernen"

#: ui/photo.slint:1268
msgid "NAVIGATEUR"
msgstr "NAVIGATOR"

#: ui/photo.slint:1280
msgid "PRÉRÉGLAGES"
msgstr "VOREINSTELLUNGEN"

#: ui/photo.slint:1418
msgid "MASQUES"
msgstr "MASKEN"

#: ui/photo.slint:1426
msgid "Ajouter un masque : ses réglages ne touchent que la zone choisie."
msgstr "Fügen Sie eine Maske hinzu: Ihre Einstellungen wirken sich nur auf den ausgewählten Bereich aus."

#: ui/photo.slint:1432
msgid "Dégradé linéaire : effet entier d'un côté, nul de l'autre (ciel, premier plan)"
msgstr "Linearer Farbverlauf: volle Wirkung auf der einen Seite, Null auf der anderen (Himmel, Vordergrund)"

#: ui/photo.slint:1433
msgid "Dégradé radial : une ellipse au contour progressif (visage, sujet)"
msgstr "Radialer Verlauf: Ellipse mit weichem Rand (Gesicht, Motiv)"

#: ui/photo.slint:1434
msgid "Pinceau : peignez la zone sur la photo (gomme pour retirer)"
msgstr "Pinsel: Malen Sie den Bereich auf dem Foto (Radiergummi zum Entfernen)"

#: ui/photo.slint:1435
msgid "Luminance"
msgstr "Leuchtdichte"

#: ui/photo.slint:1435
msgid "Plage de luminance : les zones claires ou sombres de la photo"
msgstr "Luminanzbereich: die hellen oder dunklen Bereiche des Fotos"

#: ui/photo.slint:1436
msgid "Plage de couleur : cliquez sur une couleur de la photo"
msgstr "Farbbereich: Klicken Sie auf eine Farbe im Foto"

#: ui/photo.slint:1437
msgid "Ciel : sélection automatique des zones claires et bleutées du haut"
msgstr "Himmel: Automatische Auswahl heller und bläulicher Bereiche oben"

#: ui/photo.slint:1438
msgid "Sujet"
msgstr "Motiv"

#: ui/photo.slint:1438
msgid "Sujet : sélection automatique du centre contrasté de la photo"
msgstr "Motiv: automatische Auswahl der kontrastreichen Bildmitte"

#: ui/photo.slint:1439
msgid "Arrière-plan : tout sauf le sujet"
msgstr "Hintergrund: alles außer dem Motiv"

#: ui/photo.slint:1466
msgid "Afficher / masquer l'effet de ce masque"
msgstr "Effekt dieser Maske ein-/ausblenden"

#: ui/photo.slint:1475
msgid " (inversé)"
msgstr " (invertiert)"

#: ui/photo.slint:1482
msgid "Inverser le masque (l'effet passe de l'autre côté)"
msgstr "Maske umkehren (Effekt auf der anderen Seite anwenden)"

#: ui/photo.slint:1483
msgid "Dupliquer le masque"
msgstr "Maske duplizieren"

#: ui/photo.slint:1484
msgid "Supprimer le masque"
msgstr "Maske löschen"

#: ui/photo.slint:1496
msgid "Aucun masque pour cette photo."
msgstr "Keine Maske für dieses Foto."

#: ui/photo.slint:1519
msgid "Voir le masque"
msgstr "Maske anzeigen"

#: ui/photo.slint:1521
msgid "Voile rouge sur la zone du masque"
msgstr "Rote Überlagerung im Maskenbereich"

#: ui/photo.slint:1526
msgid "Glissez les deux poignées sur la photo : effet entier au point plein, nul au point creux."
msgstr "Ziehen Sie die beiden Griffe auf dem Foto: voller Effekt bei voller Spitze, Null bei hohler Spitze."

#: ui/photo.slint:1527
msgid "Glissez le centre et les deux bords de l'ellipse sur la photo."
msgstr "Ziehen Sie die Mitte und beide Ränder der Ellipse auf das Foto."

#: ui/photo.slint:1528
msgid "Peignez la zone sur la photo ; « Gomme » pour en retirer."
msgstr "Malen Sie den Bereich auf dem Foto; „Radiergummi“, um es zu entfernen."

#: ui/photo.slint:1529
msgid "Cliquez (ou glissez) sur la photo pour choisir la couleur."
msgstr "Klicken (oder ziehen) Sie auf das Foto, um die Farbe auszuwählen."

#: ui/photo.slint:1530
msgid "Choisissez la plage de luminance touchée."
msgstr "Wählen Sie den betroffenen Leuchtdichtebereich."

#: ui/photo.slint:1531
msgid "Sélection automatique d'après la photo ; affinez avec « Inverser » et la quantité."
msgstr "Automatische Auswahl basierend auf Foto; Mit „Invertieren“ und Menge verfeinern."

