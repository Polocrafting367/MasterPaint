msgstr "Ebene sperren"

#: ui/mpicons.slint:436
msgid "Déverrouiller le calque"
msgstr "Ebene entsperren"

#: ui/mpicons.slint:437
msgid "Pixelliser le calque"
msgstr "Rastern Sie die Ebene"

