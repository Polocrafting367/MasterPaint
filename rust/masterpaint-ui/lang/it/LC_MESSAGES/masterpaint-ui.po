msgid "DOCUMENTS"
msgstr "DOCUMENTI"

#: ui/phone.slint:835
msgid "Historique des actions"
msgstr "Cronologia delle azioni"

#: ui/phone.slint:850
msgid "FICHIER"
msgstr "FILE"

