msgid "Préréglages créatifs"
msgstr "Preset creativi"

#: ui/mpicons.slint:448
msgid "Linogravure…"
msgstr "Linoleografia…"

#: ui/mpicons.slint:449
msgid "Pointillisme…"
msgstr "Puntinismo…"

#: ui/mpicons.slint:450
msgid "Vitrail…"
msgstr "Vetrata…"

#: ui/mpicons.slint:451
