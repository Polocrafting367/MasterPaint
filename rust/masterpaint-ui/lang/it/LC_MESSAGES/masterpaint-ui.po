msgid "MENUS"
msgstr "MENÙ"

#: ui/phone.slint:1051
msgid "Galerie"
msgstr "Galleria"

#: ui/phone.slint:1052
msgid "Lum./Cont."
msgstr "Luce/Cont."

#: ui/phone.slint:1053
msgid "Teinte/Sat."
msgstr "Tinta/Sab."

#: ui/phone.slint:1054
msgid "Inverser"
msgstr "Inverso"

#: ui/phone.slint:1055
msgid "N&B"
msgstr "Bianco e nero"

#: ui/photo.slint:323
msgid "Auto : réglage automatique de cette section seulement (retrouve les valeurs calculées après des retouches à la main)"
msgstr "Auto: regolazione automatica solo di questa sezione (trova i valori calcolati dopo le regolazioni manuali)"

#: ui/photo.slint:345
msgid "Remettre les réglages de cette section à zéro"
msgstr "Ripristina le impostazioni in questa sezione"

#: ui/photo.slint:573
msgid "Mode Photo Pro"
msgstr "Modalità foto professionale"

#: ui/photo.slint:587
msgid "Bibliothèque"
msgstr "Biblioteca"

#: ui/photo.slint:587
msgid "Développement"
msgstr "Sviluppo"

#: ui/photo.slint:587
msgid "Masque"
msgstr "Maschera"

#: ui/photo.slint:606
msgid "Annuler le dernier réglage de cette photo (Ctrl+Z)"
msgstr "Annulla l'ultima modifica di questa foto (Ctrl+Z)"

#: ui/photo.slint:613
msgid "Rétablir (Ctrl+Y)"
msgstr "Ripeti (Ctrl+Y)"

#: ui/photo.slint:618
msgid "Importer photos"
msgstr "Importa foto"

#: ui/photo.slint:619
msgid "Importer des photos dans la pellicule (JPEG, PNG, RAW…)"
msgstr "Importa foto nel rullino fotografico (JPEG, PNG, RAW...)"

#: ui/photo.slint:627
msgid "Ouvrir la photo réglée dans l'éditeur MasterPaint"
msgstr "Apri la foto modificata nell'editor MasterPaint"

#: ui/photo.slint:638
msgid "Exporter la photo : JPEG, PNG ou TIFF 16 bits"
msgstr "Esporta foto: JPEG, PNG o TIFF a 16 bit"

#: ui/photo.slint:658
msgid "JPEG (8 bits)"
msgstr "JPEG (8 bit)"

#: ui/photo.slint:671
msgid "Appliquer à toutes"
msgstr "Applica a tutti"

#: ui/photo.slint:672
msgid "Appliquer les réglages et le filtre de cette photo à toutes les photos de la pellicule"
msgstr "Applica le regolazioni e filtra da questa foto a tutte le foto nel rullino fotografico"

#: ui/photo.slint:681
msgid "Auto sur toutes"
msgstr "Automatico su tutto"

#: ui/photo.slint:682
msgid "Réglage automatique de chaque photo d'après sa scène (portrait, paysage, nuit…)"
msgstr "Regolazione automatica di ciascuna foto in base alla scena (ritratto, paesaggio, notte, ecc.)"

#: ui/photo.slint:692
msgid "Réduire : revenir à l'éditeur, la pellicule et ses réglages restent (onglet Photo Pro pour revenir)"
msgstr "Riduci: torna all'editor, il rullino e le sue impostazioni rimangono (scheda Pro Photo per tornare)"

#: ui/photo.slint:698
msgid "Fermer le Mode Photo Pro : la pellicule est vidée sans enregistrer (confirmation demandée) ; « Réduire » la garde"
