msgid "Sélectionne tout ce qui ne l'était pas (Ctrl+I)."
msgstr "Selecione tudo que não foi selecionado (Ctrl+I)."

#: ui/tips.slint:17
msgid "Sélectionne toute la toile (Ctrl+A)."
msgstr "Selecione toda a tela (Ctrl+A)."

