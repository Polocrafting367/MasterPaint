msgid "DOCUMENTS"
msgstr "DOCUMENTOS"

#: ui/phone.slint:835
msgid "Historique des actions"
msgstr "Histórico de ações"

#: ui/phone.slint:850
msgid "FICHIER"
msgstr "ARQUIVO"

#: ui/phone.slint:896
msgid "MENUS"
msgstr "MENU"

#: ui/phone.slint:1051
msgid "Galerie"
msgstr "Galeria"

#: ui/phone.slint:1052
msgid "Lum./Cont."
msgstr "Luz/Cont."

#: ui/phone.slint:1053
msgid "Teinte/Sat."
msgstr "Matiz/Sábado."

#: ui/phone.slint:1054
msgid "Inverser"
msgstr "Reverso"

#: ui/phone.slint:1055
msgid "N&B"
msgstr "P&B"

#: ui/photo.slint:323
msgid "Auto : réglage automatique de cette section seulement (retrouve les valeurs calculées après des retouches à la main)"
msgstr "Auto: ajuste automático apenas desta seção (encontra os valores calculados após ajustes manuais)"

#: ui/photo.slint:345
msgid "Remettre les réglages de cette section à zéro"
msgstr "Redefina as configurações nesta seção"

#: ui/photo.slint:573
msgid "Mode Photo Pro"
msgstr "Modo Foto Profissional"

#: ui/photo.slint:587
msgid "Bibliothèque"
msgstr "Biblioteca"

#: ui/photo.slint:587
msgid "Développement"
msgstr "Revelação"

#: ui/photo.slint:587
msgid "Masque"
msgstr "Máscara"

#: ui/photo.slint:606
msgid "Annuler le dernier réglage de cette photo (Ctrl+Z)"
msgstr "Desfaça o último ajuste desta foto (Ctrl+Z)"

#: ui/photo.slint:613
msgid "Rétablir (Ctrl+Y)"
msgstr "Refazer (Ctrl+Y)"

#: ui/photo.slint:618
msgid "Importer photos"
msgstr "Importar fotos"

#: ui/photo.slint:619
msgid "Importer des photos dans la pellicule (JPEG, PNG, RAW…)"
msgstr "Importe fotos para o rolo da câmera (JPEG, PNG, RAW…)"

#: ui/photo.slint:627
msgid "Ouvrir la photo réglée dans l'éditeur MasterPaint"
msgstr "Abra a foto ajustada no editor MasterPaint"

#: ui/photo.slint:638
msgid "Exporter la photo : JPEG, PNG ou TIFF 16 bits"
msgstr "Exportar foto: JPEG, PNG ou TIFF de 16 bits"

#: ui/photo.slint:658
msgid "JPEG (8 bits)"
msgstr "JPEG (8 bits)"

#: ui/photo.slint:671
msgid "Appliquer à toutes"
msgstr "Aplicar a todos"

#: ui/photo.slint:672
msgid "Appliquer les réglages et le filtre de cette photo à toutes les photos de la pellicule"
msgstr "Aplique ajustes e filtre esta foto a todas as fotos no rolo da câmera"

#: ui/photo.slint:681
msgid "Auto sur toutes"
msgstr "Automático em tudo"

#: ui/photo.slint:682
msgid "Réglage automatique de chaque photo d'après sa scène (portrait, paysage, nuit…)"
msgstr "Ajuste automático de cada foto de acordo com sua cena (retrato, paisagem, noite, etc.)"

#: ui/photo.slint:692
msgid "Réduire : revenir à l'éditeur, la pellicule et ses réglages restent (onglet Photo Pro pour revenir)"
msgstr "Reduzir: retorne ao editor, o rolo de filme e suas configurações permanecem (guia Pro Photo para retornar)"

#: ui/photo.slint:698
msgid "Fermer le Mode Photo Pro : la pellicule est vidée sans enregistrer (confirmation demandée) ; « Réduire » la garde"
msgstr "Fechar Photo Pro: esvazia a tira de fotos sem guardar (requer confirmação); «Minimizar» mantém-na"

#: ui/photo.slint:881
msgid "Départ : effet entier"
msgstr "Início: efeito total"

#: ui/photo.slint:881
msgid "Arrivée : plus d'effet"
msgstr "Fim: sem efeito"

#: ui/photo.slint:881
msgid "Milieu : déplacer tout le dégradé"
msgstr "Meio: mover todo o gradiente"

#: ui/photo.slint:881
msgid "Centre : déplacer l'ellipse"
msgstr "Centro: mova a elipse"

#: ui/photo.slint:881
msgid "Bord : largeur ou hauteur"
msgstr "Borda: largura ou altura"

#: ui/photo.slint:1002
msgid "Redresser (°)"
msgstr "Endireitar (°)"

#: ui/photo.slint:1060
msgid "Aucune photo chargée. Importez vos fichiers JPG, PNG, WebP…"
msgstr "Nenhuma foto carregada. Importe seus arquivos JPG, PNG, WebP…"

#: ui/photo.slint:1104
msgid "Rendu…"
