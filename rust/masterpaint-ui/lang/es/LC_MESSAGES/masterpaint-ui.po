msgid "Inverser"
msgstr "revertir"

#: ui/phone.slint:1055
msgid "N&B"
msgstr "blanco y negro"

#: ui/photo.slint:323
msgid "Auto : réglage automatique de cette section seulement (retrouve les valeurs calculées après des retouches à la main)"
msgstr "Auto: ajuste automático solo de esta sección (encuentra los valores calculados después de los ajustes manuales)"

#: ui/photo.slint:345
msgid "Remettre les réglages de cette section à zéro"
msgstr "Restablecer la configuración en esta sección"

#: ui/photo.slint:573
msgid "Mode Photo Pro"
msgstr "Modo de fotografía profesional"

#: ui/photo.slint:587
msgid "Bibliothèque"
msgstr "Biblioteca"

#: ui/photo.slint:587
msgid "Développement"
msgstr "Revelado"

#: ui/photo.slint:587
msgid "Masque"
msgstr "máscara"

#: ui/photo.slint:606
msgid "Annuler le dernier réglage de cette photo (Ctrl+Z)"
msgstr "Deshacer el último ajuste de esta foto (Ctrl+Z)"

#: ui/photo.slint:613
msgid "Rétablir (Ctrl+Y)"
msgstr "Rehacer (Ctrl+Y)"

#: ui/photo.slint:618
msgid "Importer photos"
msgstr "Importar fotos"

#: ui/photo.slint:619
msgid "Importer des photos dans la pellicule (JPEG, PNG, RAW…)"
msgstr "Importar fotos al carrete de la cámara (JPEG, PNG, RAW…)"

#: ui/photo.slint:627
msgid "Ouvrir la photo réglée dans l'éditeur MasterPaint"
msgstr "Abrir foto ajustada en el editor MasterPaint"

#: ui/photo.slint:638
msgid "Exporter la photo : JPEG, PNG ou TIFF 16 bits"
msgstr "Exportar foto: JPEG, PNG o TIFF de 16 bits"

#: ui/photo.slint:658
msgid "JPEG (8 bits)"
msgstr "JPEG (8 bits)"

#: ui/photo.slint:671
msgid "Appliquer à toutes"
msgstr "Aplicar a todos"

#: ui/photo.slint:672
msgid "Appliquer les réglages et le filtre de cette photo à toutes les photos de la pellicule"
msgstr "Aplicar ajustes y filtrar desde esta foto a todas las fotos en el carrete de la cámara"

#: ui/photo.slint:681
msgid "Auto sur toutes"
msgstr "Auto en todos"

#: ui/photo.slint:682
msgid "Réglage automatique de chaque photo d'après sa scène (portrait, paysage, nuit…)"
msgstr "Ajuste automático de cada foto según su escena (retrato, paisaje, noche, etc.)"

#: ui/photo.slint:692
msgid "Réduire : revenir à l'éditeur, la pellicule et ses réglages restent (onglet Photo Pro pour revenir)"
msgstr "Reducir: vuelve al editor, el rollo de película y sus ajustes permanecen (pestaña Foto Pro para volver)"

#: ui/photo.slint:698
msgid "Fermer le Mode Photo Pro : la pellicule est vidée sans enregistrer (confirmation demandée) ; « Réduire » la garde"
msgstr "Cerrar Photo Pro: vacía la tira de fotos sin guardar (requiere confirmación); «Minimizar» la conserva"

#: ui/photo.slint:881
msgid "Départ : effet entier"
msgstr "Inicio: efecto completo"

#: ui/photo.slint:881
msgid "Arrivée : plus d'effet"
msgstr "Final: sin efecto"

#: ui/photo.slint:881
msgid "Milieu : déplacer tout le dégradé"
msgstr "Centro: mover todo el degradado"

#: ui/photo.slint:881
msgid "Centre : déplacer l'ellipse"
