#: src/perf.rs:278
msgid "Processeur : {cpu}, {cores} cœurs\nMémoire de l'appareil : {:.0} Mo, dont {:.0} Mo disponibles"
msgstr "Processor: {cpu}, {cores} cores\nDevice memory: {:.0} MB, {:.0} MB available"

#: src/perf.rs:316
msgid "L'interface a manqué de fluidité (rapport automatique).\nDurée d'une image : {medians} ms (médianes, 25 images/s = 40 ms)\nOutil : {}\nÉchelle de l'écran : {:.2} ; résolution de rendu : {} ; réduction de la toile : {} ; mode léger : {}\n"
msgstr "The interface was not smooth (automatic report).\nFrame time: {medians} ms (medians, 25 fps = 40 ms)\nTool: {}\nScreen scale: {:.2}; render resolution: {}; canvas reduction: {}; light mode: {}\n"

