msgid "Importer photos"
msgstr "Import photos"

#: ui/photo.slint:593
msgid "Importer des photos dans la pellicule (JPEG, PNG, RAW…)"
msgstr "Import photos into camera roll (JPEG, PNG, RAW…)"

#: ui/photo.slint:601
msgid "Ouvrir la photo réglée dans l'éditeur MasterPaint"
msgstr "Open adjusted photo in MasterPaint editor"

#: ui/photo.slint:612
msgid "Exporter la photo : JPEG, PNG ou TIFF 16 bits"
msgstr "Export photo: JPEG, PNG or 16-bit TIFF"

#: ui/photo.slint:632
msgid "JPEG (8 bits)"
msgstr "JPEG (8 bit)"

#: ui/photo.slint:645
msgid "Appliquer à toutes"
msgstr "Apply to all"

#: ui/photo.slint:646
msgid "Appliquer les réglages et le filtre de cette photo à toutes les photos de la pellicule"
msgstr "Apply adjustments and filter from this photo to all photos in the camera roll"

#: ui/photo.slint:655
msgid "Auto sur toutes"
msgstr "Auto on all"

#: ui/photo.slint:656
msgid "Réglage automatique de chaque photo d'après sa scène (portrait, paysage, nuit…)"
msgstr "Automatic adjustment of each photo according to its scene (portrait, landscape, night, etc.)"

