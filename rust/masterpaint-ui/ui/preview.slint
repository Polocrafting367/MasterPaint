// Aperçu 1:1 de la toile dans une seconde fenêtre (bureau) : un pixel de l'image = un pixel
// physique de l'écran (unité phx), quel que soit le facteur d'échelle du système.

import { ScrollView } from "std-widgets.slint";

export component PreviewWindow inherits Window {
    in property <image> source;
    in property <string> info;
    title: "Aperçu 1:1 — MasterPaint";
    icon: @image-url("../../desktop/icons/128x128.png");
    background: #1e1e1e;
    preferred-width: min(root.source.width * 1phx + 24px, 1200px);
    preferred-height: min(root.source.height * 1phx + 48px, 860px);
    min-width: 200px;
    min-height: 150px;
    VerticalLayout {
        ScrollView {
            content-width: max(self.visible-width, root.source.width * 1phx);
            content-height: max(self.visible-height, root.source.height * 1phx);
            Image {
                x: max(0px, (parent.width - self.width) / 2);
                y: max(0px, (parent.height - self.height) / 2);
                width: root.source.width * 1phx;
                height: root.source.height * 1phx;
                source: root.source;
                image-rendering: pixelated;
            }
        }
        Rectangle {
            height: 24px;
            background: #2b2b2b;
            Text {
                x: 8px;
                text: root.info;
                color: #cfcfcf;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
}
