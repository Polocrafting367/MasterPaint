// Aperçu de la toile dans une seconde fenêtre (bureau) : toute l'image, ajustée à la fenêtre sans
// déformation — ni défilement, ni barre d'information : redimensionner la fenêtre suffit.

export component PreviewWindow inherits Window {
    in property <image> source;
    /// (gardée pour lib.rs ; plus affichée)
    in property <string> info;
    title: @tr("Aperçu 1:1 — MasterPaint");
    icon: @image-url("../../packaging/icons/128x128.png");
    background: #1e1e1e;
    // première ouverture : l'image à 100 % si elle tient, sinon réduite aux proportions
    property <float> k: min(1, min(1200px / max(1px, root.source.width * 1phx), 860px / max(1px, root.source.height * 1phx)));
    preferred-width: max(200px, root.source.width * 1phx * root.k);
    preferred-height: max(150px, root.source.height * 1phx * root.k);
    min-width: 120px;
    min-height: 90px;
    Image {
        width: root.width;
        height: root.height;
        source: root.source;
        image-fit: contain;
        image-rendering: smooth;
    }
}
