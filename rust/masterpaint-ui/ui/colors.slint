// Fenêtre Couleurs façon Paint.NET / paintdotjs (ColorsForm : couleurs principale et secondaire
// superposées, roue ou carré de toutes les couleurs, « Plus » : curseurs en dégradé, nuancier,
// favoris « + » comme ColorAddItem, couleurs récentes), dans le style MasterPaint. Les blocs sont
// partagés par la fenêtre volante (ColorsPanel) et le panneau du téléphone (MobColors).
import { Theme } from "theme.slint";
import { Generated } from "generated.slint";
import { FaIcon, GlyphIcon, Icon, W10Button, W10Slider, W10LineEdit, NumEdit, HoverTip } from "widgets.slint";

/// Icône colorée de la bascule roue ↔ carré : montre le mode vers lequel on passe — petite
/// roue (image de la roue déjà calculée par Rust) ou petit carré de toutes les couleurs
/// (teintes en largeur, blanc en haut, noir en bas, comme `grid_color`).
export component PickerModeIcon inherits Rectangle {
    in property <bool> to-square;
    in property <image> wheel;
    in property <length> side: 14px;
    width: root.side;
    height: root.side;
    if !root.to-square: Image {
        width: root.side;
        height: root.side;
        source: root.wheel;
        image-fit: contain;
        image-rendering: smooth;
    }
    if root.to-square: Rectangle {
        width: root.side;
        height: root.side;
        border-radius: 2px * Theme.round;
        clip: true;
        background: @linear-gradient(90deg, #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%);
        Rectangle {
            background: @linear-gradient(180deg, #ffffff 0%, #ffffff00 50%, #00000000 50%, #000000 100%);
        }
        border-width: 1px;
        border-color: #00000030;
    }
}

/// Petit bouton à icône (bascule roue / carré, pipette, échanger…).
export component ColorIconButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> checked;
    in property <length> glyph-size: 11px;
    callback clicked();
    width: 24px;
    height: 22px;
    border-radius: Theme.ctl-radius;
    background: root.checked ? Theme.accent-20 : (Theme.hover-fx && ta.has-hover) ? Theme.accent-14 : transparent;
    border-width: root.checked ? 1px : 0px;
    border-color: Theme.accent-60;
    GlyphIcon {
        glyph: root.glyph;
        size: root.glyph-size;
        tint: root.checked ? Theme.accent : Theme.text;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

/// Couleurs principale (devant) et secondaire (derrière), comme Paint.NET : un clic choisit
/// celle que la roue, les curseurs et le nuancier modifient ; ⇄ échange.
export component CurrentColors inherits Rectangle {
    in-out property <color> primary: #000000;
    in-out property <color> secondary: #ffffff;
    in-out property <bool> edit-secondary;
    /// côté d'un carré de couleur
    in property <length> cell: 28px;
    in property <length> radius: 3px;
    width: root.cell * 1.6;
    height: root.cell * 1.6;
    // secondaire
    Rectangle {
        x: root.cell * 0.6;
        y: root.cell * 0.6;
        width: root.cell;
        height: root.cell;
        border-radius: root.radius;
        background: root.secondary;
        border-width: root.edit-secondary ? 2px : 1px;
        border-color: root.edit-secondary ? Theme.accent : #808080;
        TouchArea {
            clicked => {
                root.edit-secondary = true;
            }
        }
    }
    // principale
    Rectangle {
        x: 0;
        y: 0;
        width: root.cell;
        height: root.cell;
        border-radius: root.radius;
        background: root.primary;
        border-width: !root.edit-secondary ? 2px : 1px;
        border-color: !root.edit-secondary ? Theme.accent : #808080;
        TouchArea {
            clicked => {
                root.edit-secondary = false;
            }
        }
    }
    // échanger : coin haut-droit
    Rectangle {
        x: root.width - 15px;
        y: 0;
        width: 15px;
        height: 15px;
        border-radius: 3px * Theme.round;
        background: (Theme.hover-fx && swta.has-hover) ? Theme.accent-14 : transparent;
        GlyphIcon {
            glyph: "\u{f362}";
            size: 9px;
        }
        HoverTip { y: parent.height; hovered: swta.has-hover; text: @tr("Échanger les couleurs principale et secondaire"); }
        swta := TouchArea {
            clicked => {
                let p = root.primary;
                root.primary = root.secondary;
                root.secondary = p;
            }
        }
    }
}

/// Sélecteur sans barre : roue teinte × saturation (valeur réglée par les curseurs « Plus »), ou
/// carré de toutes les couleurs comme la version HTML (teinte en largeur ; blanc en haut,
/// couleurs pures au milieu, noir en bas : `grid_color` côté Rust). Images calculées par Rust
/// (filtrées par l'espace du projet) et couleur choisie par `wheel-picked`.
export component ColorPicker inherits Rectangle {
    in property <image> wheel;
    in property <image> grid-image;
    in property <bool> square;
    /// espace de couleur imposé : grille filtrée au lieu du carré libre
    in property <bool> filtered;
    /// masque α : roue remplacée par un dégradé de gris (pas de voile de valeur)
    in property <bool> gray;
    in property <[float]> comps: [0, 0, 0, 255, 0, 0, 0];  // R V B A T S V de la couleur modifiée
    in property <bool> edit-secondary;
    /// (x, y, côté, secondaire) : roue ou grille
    callback wheel-picked(length, length, length, bool);
    /// (teinte 0..360, saturation 0..1, valeur 0..1, secondaire)
    callback hsv-picked(float, float, float, bool);
    property <length> side: max(40px, min(root.width, root.height));
    property <float> hue: root.comps[4];
    property <float> sat: root.comps[5] / 100;
    property <float> val: root.comps[6] / 100;
    /// roue ou carré : couleur calculée par Rust au point visé
    function pick-main(mx: length, my: length, other: bool) {
        root.wheel-picked(clamp(mx, 0, root.side - 1px), clamp(my, 0, root.side - 1px), root.side, other);
    }
    // ---- zone principale ----
    if !root.square: Image {
        x: 0;
        y: 0;
        width: root.side;
        height: root.side;
        source: root.wheel;
    }
    // carré de toutes les couleurs (ou grille filtrée : RAL, CMJN, masque α)
    if root.square: Rectangle {
        x: 0;
        y: 0;
        width: root.side;
        height: root.side;
        border-radius: 3px * Theme.round;
        clip: true;
        border-width: 1px;
        border-color: Theme.window-border;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.grid-image;
            image-fit: fill;
        }
    }
    // repère de la couleur modifiée : roue (teinte × saturation) ou carré (teinte ; moitié haute
    // = saturation, moitié basse = valeur, comme grid_color)
    if !root.gray && (!root.square || !root.filtered): Rectangle {
        x: (root.square ? root.hue / 360 * root.side : root.side / 2 + cos(root.hue * 1deg) * root.sat * root.side / 2) - 6px;
        y: (root.square ? (root.sat < 0.995 ? root.sat / 2 : 0.5 + (1 - root.val) / 2) * root.side : root.side / 2 - sin(root.hue * 1deg) * root.sat * root.side / 2) - 6px;
        width: 12px;
        height: 12px;
        border-radius: 6px * Theme.round;
        border-width: 1px;
        border-color: #000000;
        Rectangle {
            x: 1px;
            y: 1px;
            width: 10px;
            height: 10px;
            border-radius: 5px * Theme.round;
            border-width: 2px;
            border-color: #ffffff;
        }
    }
    TouchArea {
        x: 0;
        y: 0;
        width: root.side;
        height: root.side;
        property <bool> other;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                // clic droit : l'autre couleur que celle modifiée (comme le nuancier de Paint.NET)
                self.other = (e.button == PointerEventButton.right) != root.edit-secondary;
                root.pick-main(self.mouse-x, self.mouse-y, self.other);
            }
        }
        moved => {
            if (self.pressed) {
                root.pick-main(self.mouse-x, self.mouse-y, self.other);
            }
        }
    }
}

/// Ligne d'un canal : libellé, piste en dégradé (la couleur obtenue d'un bout à l'autre) et
/// valeur saisissable.
component ChannelRow inherits HorizontalLayout {
    in property <string> label;
    in property <float> maximum: 255;
    in property <float> value;
    in property <brush> track;
    callback changed(float);
    spacing: 6px;
    height: 24px;
    if root.label != "": Text {
        width: 12px;
        text: root.label;
        color: Theme.text;
        vertical-alignment: center;
    }
    W10Slider {
        y: 2px;
        maximum: root.maximum;
        value: root.value;
        gradient: true;
        controlled: true;
        track: root.track;
        changed(v) => {
            root.changed(round(v));
        }
    }
    NumEdit {
        width: 44px;
        value: root.value;
        accepted(v) => {
            root.changed(clamp(v, 0, root.maximum));
        }
    }
}

component SliderTitle inherits Text {
    font-weight: 600;
    color: Theme.text;
    font-size: Theme.small-font-size;
}

/// Réglages détaillés (« Plus ») : RVB, TSV, hexadécimal et alpha de la couleur modifiée.
export component ColorSliders inherits Rectangle {
    in property <[float]> comps: [0, 0, 0, 255, 0, 0, 0];
    in property <color> current;
    in property <string> hex;
    /// RVB et TSV côte à côte
    in property <bool> two-columns;
    callback component-changed(int, float);
    callback hex-edited(string);
    out property <length> wanted-height: lay.preferred-height;
    lay := VerticalLayout {
        x: 0;
        y: 0;
        width: root.width;
        spacing: 6px;
        alignment: start;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                spacing: 2px;
                SliderTitle {
                    text: @tr("RVB");
                }
                ChannelRow {
                    label: @tr("R");
                    value: root.comps[0];
                    track: @linear-gradient(90deg, Colors.rgb(0, root.current.green, root.current.blue) 0%, Colors.rgb(255, root.current.green, root.current.blue) 100%);
                    changed(v) => {
                        root.component-changed(0, v);
                    }
                }
                ChannelRow {
                    label: @tr("V");
                    value: root.comps[1];
                    track: @linear-gradient(90deg, Colors.rgb(root.current.red, 0, root.current.blue) 0%, Colors.rgb(root.current.red, 255, root.current.blue) 100%);
                    changed(v) => {
                        root.component-changed(1, v);
                    }
                }
                ChannelRow {
                    label: @tr("B");
                    value: root.comps[2];
                    track: @linear-gradient(90deg, Colors.rgb(root.current.red, root.current.green, 0) 0%, Colors.rgb(root.current.red, root.current.green, 255) 100%);
                    changed(v) => {
                        root.component-changed(2, v);
                    }
                }
                if !root.two-columns: SliderTitle {
                    text: @tr("TSV");
                }
                if !root.two-columns: ChannelRow {
                    label: @tr("T");
                    maximum: 360;
                    value: root.comps[4];
                    track: @linear-gradient(90deg, #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%);
                    changed(v) => {
                        root.component-changed(4, v);
                    }
                }
                if !root.two-columns: ChannelRow {
                    label: @tr("S");
                    maximum: 100;
                    value: root.comps[5];
                    track: @linear-gradient(90deg, Colors.hsv(root.comps[4], 0, root.comps[6] / 100) 0%, Colors.hsv(root.comps[4], 1, root.comps[6] / 100) 100%);
                    changed(v) => {
                        root.component-changed(5, v);
                    }
                }
                if !root.two-columns: ChannelRow {
                    label: "V";
                    maximum: 100;
                    value: root.comps[6];
                    track: @linear-gradient(90deg, #000000 0%, Colors.hsv(root.comps[4], root.comps[5] / 100, 1) 100%);
                    changed(v) => {
                        root.component-changed(6, v);
                    }
                }
            }
            if root.two-columns: VerticalLayout {
                spacing: 2px;
                SliderTitle {
                    text: @tr("TSV");
                }
                ChannelRow {
                    label: @tr("T");
                    maximum: 360;
                    value: root.comps[4];
                    track: @linear-gradient(90deg, #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%);
                    changed(v) => {
                        root.component-changed(4, v);
                    }
                }
                ChannelRow {
                    label: @tr("S");
                    maximum: 100;
                    value: root.comps[5];
                    track: @linear-gradient(90deg, Colors.hsv(root.comps[4], 0, root.comps[6] / 100) 0%, Colors.hsv(root.comps[4], 1, root.comps[6] / 100) 100%);
                    changed(v) => {
                        root.component-changed(5, v);
                    }
                }
                ChannelRow {
                    label: "V";
                    maximum: 100;
                    value: root.comps[6];
                    track: @linear-gradient(90deg, #000000 0%, Colors.hsv(root.comps[4], root.comps[5] / 100, 1) 100%);
                    changed(v) => {
                        root.component-changed(6, v);
                    }
                }
            }
        }
        HorizontalLayout {
            height: 24px;
            spacing: 6px;
            Text {
                text: @tr("Hexa");
                color: Theme.text;
                vertical-alignment: center;
            }
            W10LineEdit {
                width: 90px;
                text: root.hex;
                accepted(t) => {
                    root.hex-edited(t);
                }
            }
            Rectangle { }
        }
        SliderTitle {
            text: @tr("Alpha");
        }
        ChannelRow {
            label: "";
            maximum: 255;
            value: root.comps[3];
            track: @linear-gradient(90deg, root.current.with-alpha(0) 0%, root.current.with-alpha(1) 100%);
            changed(v) => {
                root.component-changed(3, v);
            }
        }
    }
}

/// Rangée de cases (favoris, couleurs récentes) qui passe à la ligne. En tête : « + » façon
/// ColorAddItem de paintdotjs (la couleur modifiée et un « + ») ou une icône.
export component SwatchStrip inherits Rectangle {
    in property <[color]> colors: [];
    in property <bool> gray;
    in property <bool> add-button;
    in property <color> current;
    /// icône de tête quand il n'y a pas de « + » (récentes : horloge)
    in property <string> glyph;
    in property <length> cell: 14px;
    in property <length> gap: 2px;
    in property <length> radius: 3px;
    /// Maj + clic / clic du milieu retire une case
    in property <bool> removable;
    /// pipette (même icône que l'outil) avant le « + »
    in property <bool> pipette;
    callback add();
    callback pipette-clicked();
    /// (couleur, clic droit)
    callback pick(color, bool);
    callback remove(int);
    property <int> lead: (root.pipette ? 1 : 0) + (root.add-button || root.glyph != "" ? 1 : 0);
    property <length> add-x: root.pipette ? root.cell + root.gap : 0px;
    if root.pipette: Rectangle {
        x: 0;
        y: 0;
        width: root.cell;
        height: root.cell;
        border-radius: root.radius;
        background: (Theme.hover-fx && pta.has-hover) ? Theme.accent-14 : transparent;
        Icon {
            spec: { svg-index: 7, fa: "", fa-weight: 900 };
            size: max(10px, root.cell - 1px);
        }
        pta := TouchArea {
            clicked => {
                root.pipette-clicked();
            }
        }
    }
    // une seule rangée (fenêtre compacte) : autant de cases que de colonnes du nuancier, le
    // surplus n'est pas affiché ; cases au même pas que le nuancier (bords alignés)
    property <int> per-line: max(1, floor((root.width + root.gap) / (root.cell + root.gap) + 0.01));
    out property <length> wanted-height: root.cell;
    height: root.wanted-height;
    if root.add-button: Rectangle {
        x: root.add-x;
        y: 0;
        width: root.cell;
        height: root.cell;
        border-radius: root.radius;
        background: root.current;
        border-width: 1px;
        border-color: (Theme.hover-fx && ata.has-hover) ? Theme.accent : Theme.window-border;
        Rectangle {
            x: parent.width - self.width;
            y: parent.height - self.height;
            width: parent.width * 0.62;
            height: self.width;
            border-radius: self.width / 2;
            background: Theme.accent;
            FaIcon {
                glyph: "\u{f067}";
                size: parent.width * 0.75;
                color: Theme.on-accent;
            }
        }
        ata := TouchArea {
            clicked => {
                root.add();
            }
        }
    }
    if !root.add-button && root.glyph != "": Rectangle {
        x: root.add-x;
        y: 0;
        width: root.cell;
        height: root.cell;
        GlyphIcon {
            glyph: root.glyph;
            size: root.cell * 0.65;
            tint: Theme.text-inactive;
        }
    }
    for c[i] in root.colors: Rectangle {
        visible: i + root.lead < root.per-line;
        x: (i + root.lead) * (root.cell + root.gap);
        y: 0;
        width: root.cell;
        height: root.cell;
        border-radius: root.radius;
        property <float> luminance: round(0.299 * c.red + 0.587 * c.green + 0.114 * c.blue);
        background: root.gray ? Colors.rgb(self.luminance, self.luminance, self.luminance) : c;
        border-width: 1px;
        border-color: (Theme.hover-fx && cta.has-hover) ? Theme.accent : #c0c0c0;
        cta := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    if (root.removable && (e.modifiers.shift || e.button == PointerEventButton.middle)) {
                        root.remove(i);
                    } else {
                        root.pick(c, e.button == PointerEventButton.right);
                    }
                }
            }
        }
    }
}

/// Nuancier : cases dimensionnées sur la largeur (jamais de débordement).
export component PaletteGrid inherits Rectangle {
    in property <[color]> swatches: [];
    in property <int> cols: 14;
    in property <length> row-h: 13px;
    in property <length> radius: 0px;
    /// (couleur, clic droit)
    callback pick(color, bool);
    property <length> cell: root.width / max(1, root.cols);
    out property <length> wanted-height: ceil(root.swatches.length / max(1, root.cols)) * root.row-h;
    height: root.wanted-height;
    for c[i] in root.swatches: Rectangle {
        x: mod(i, root.cols) * root.cell;
        y: floor(i / root.cols) * root.row-h;
        width: root.cell - 1px;
        height: root.row-h - 1px;
        border-radius: root.radius;
        background: c;
        border-width: root.radius > 0px ? 0px : 1px;
        border-color: (Theme.hover-fx && pta.has-hover) ? Theme.accent : #c0c0c0;
        HoverTip { y: parent.height; hovered: pta.has-hover; text: @tr("RVB") + ": " + c.red + ", " + c.green + ", " + c.blue; }
        pta := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.pick(c, e.button == PointerEventButton.right);
                }
            }
        }
    }
}

/// Fenêtre Couleurs (volante ou ancrée) : couleurs courantes et boutons, sélecteur, nom RAL /
/// CMJN, favoris, récentes, nuancier ; « Plus » ajoute les curseurs (à droite si la fenêtre est
/// large, dessous sinon). La mise en page suit la largeur : compacte sous 430 px.
export component ColorsPanel inherits Rectangle {
    in property <image> wheel;
    in property <image> grid-image;
    in-out property <color> primary: #000000;
    in-out property <color> secondary: #ffffff;
    /// la roue / le carré / les curseurs modifient la secondaire
    in-out property <bool> edit-secondary;
    in-out property <bool> expanded;
    /// carré de toutes les couleurs au lieu de la roue (ancien bouton « Grille »)
    in-out property <bool> square;
    in property <[float]> comps: [0, 0, 0, 255, 0, 0, 0];  // R V B A T S V de la couleur modifiée
    in property <string> hex;
    /// espace de couleur du projet : nuancier imposé (RAL, encres CMJN, gris du masque α)
    in property <[color]> mode-palette: [];
    in property <bool> gray;
    in property <string> info;
    in property <[color]> favorites: [];
    in property <[color]> recents: [];
    /// grand nuancier (Palettes.full du téléphone), passé par la fenêtre
    in property <[color]> full-palette: [];
    callback wheel-picked(length, length, length, bool);
    callback hsv-picked(float, float, float, bool);
    callback component-changed(int, float);
    callback hex-edited(string);
    callback fav-add();
    callback fav-remove(int);
    callback pick-screen();
    property <bool> wide: root.width >= 430px;
    property <length> left-w: root.wide ? 215px : root.width;
    property <color> current: root.edit-secondary ? root.secondary : root.primary;
    function pick(c: color, right: bool) {
        if (right != root.edit-secondary) {
            root.secondary = c;
        } else {
            root.primary = c;
        }
    }
    // ---- couleurs courantes et boutons ----
    cur := CurrentColors {
        x: 8px;
        y: 8px;
        cell: 26px;
        primary <=> root.primary;
        secondary <=> root.secondary;
        edit-secondary <=> root.edit-secondary;
    }
    Text {
        x: 8px;
        y: cur.y + cur.height + 2px;
        text: root.edit-secondary ? @tr("Secondaire") : @tr("Principale");
        font-size: Theme.small-font-size;
        color: Theme.text-inactive;
    }
    HorizontalLayout {
        x: root.left-w - self.preferred-width - 8px;
        y: 8px;
        height: 22px;
        spacing: 4px;
        // bascule roue ↔ carré : petite icône colorée du mode suivant
        Rectangle {
            width: 24px;
            height: 22px;
            border-radius: Theme.ctl-radius;
            background: (Theme.hover-fx && mta.has-hover) ? Theme.accent-14 : transparent;
            PickerModeIcon {
                to-square: !root.square;
                wheel: root.wheel;
            }
            mta := TouchArea {
                clicked => {
                    root.square = !root.square;
                }
            }
        }
        W10Button {
            text: root.expanded ? @tr("<< Moins") : @tr("Plus >>");
            clicked => {
                root.expanded = !root.expanded;
            }
        }
    }
    // ---- sélecteur ----
    property <length> pick-side: clamp(root.left-w - 64px - 8px, 96px, 150px);
    picker := ColorPicker {
        x: 64px + max(0px, (root.left-w - 64px - 8px - self.width) / 2);
        y: 36px;
        width: root.pick-side;
        height: root.pick-side;
        wheel: root.wheel;
        grid-image: root.grid-image;
        square: root.square;
        filtered: root.mode-palette.length > 0;
        gray: root.gray;
        comps: root.comps;
        edit-secondary: root.edit-secondary;
        wheel-picked(x, y, s, r) => {
            root.wheel-picked(x, y, s, r);
        }
        hsv-picked(h, s, v, r) => {
            root.hsv-picked(h, s, v, r);
        }
    }
    // ---- nom RAL / encres CMJN ----
    property <length> info-y: picker.y + picker.height + 8px;
    property <length> info-h: root.info != "" ? 20px : 0px;
    if root.info != "": Rectangle {
        x: 8px;
        y: root.info-y;
        width: root.left-w - 16px;
        height: 16px;
        border-radius: 3px * Theme.round;
        background: Theme.accent-12;
        Text {
            x: 6px;
            width: parent.width - 12px;
            text: root.info;
            font-size: Theme.small-font-size;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    /// grille commune : nuancier, favoris et récentes ont la même case et le même pas (colonnes
    /// du nuancier), bords gauche et droit alignés ; pipette et « + » occupent chacun une case
    property <int> pal-cols: root.big ? (root.use-full ? 36 : 18) : root.use-full ? 37 : 14;
    property <length> pitch: (root.width - 16px) / max(1, root.pal-cols);
    property <length> swatch-cell: root.pitch - 1px;
    // ---- favoris : pipette (icône de l'outil), « + », puis les couleurs ----
    favs := SwatchStrip {
        gray: root.gray;
        x: 8px;
        y: root.info-y + root.info-h;
        width: root.left-w - 16px;
        cell: root.swatch-cell;
        gap: 1px;
        radius: 0px;
        pipette: true;
        pipette-clicked => {
            root.pick-screen();
        }
        add-button: true;
        removable: true;
        current: root.current;
        colors: root.favorites;
        add => {
            root.fav-add();
        }
        pick(c, r) => {
            root.pick(c, r);
        }
        remove(i) => {
            root.fav-remove(i);
        }
    }
    // ---- récentes : une rangée, juste sous les favoris (horloge dans une case) ----
    property <length> left-bottom: favs.y + favs.height + (root.recents.length > 0 ? 1px + root.swatch-cell : 0px);
    if root.recents.length > 0: recents := SwatchStrip {
        gray: root.gray;
        x: 8px;
        y: favs.y + favs.height + 1px;
        width: root.left-w - 16px;
        cell: root.swatch-cell;
        gap: 1px;
        radius: 0px;
        removable: false;
        glyph: "\u{f017}";
        colors: root.recents;
        pick(c, r) => {
            root.pick(c, r);
        }
    }
    // ---- curseurs (« Plus ») : à droite si large, sous le nuancier sinon ----
    sliders := ColorSliders {
        visible: root.expanded;
        x: root.wide ? root.left-w + 4px : 8px;
        y: root.wide ? 8px : pal.y + pal.height + 8px;
        width: root.wide ? root.width - root.left-w - 12px : root.width - 16px;
        height: root.expanded ? self.wanted-height : 0px;
        two-columns: self.width >= 290px;
        comps: root.comps;
        current: root.current;
        hex: root.hex;
        component-changed(i, v) => {
            root.component-changed(i, v);
        }
        hex-edited(t) => {
            root.hex-edited(t);
        }
    }
    // ---- nuancier : sur toute la largeur ; grand nuancier quand la place le permet ----
    property <bool> use-full: root.width >= 400px;
    property <[color]> swatches: root.mode-palette.length > 0 ? root.mode-palette : root.use-full && root.full-palette.length > 0 ? root.full-palette : Generated.palette;
    property <bool> big: root.swatches.length > 120;
    pal := PaletteGrid {
        x: 8px;
        // (hauteur des curseurs lue sans leur position : pas de boucle de liaison)
        y: max(root.left-bottom, root.wide && root.expanded ? 8px + sliders.wanted-height : 0px) + 4px;
        width: root.width - 16px;
        swatches: root.swatches;
        cols: root.pal-cols;
        row-h: root.pitch;
        pick(c, r) => {
            root.pick(c, r);
        }
    }
    /// hauteur utile de la fenêtre (titre compris) selon la largeur et l'état
    out property <length> wanted-height: (root.expanded && !root.wide ? sliders.y + sliders.height : pal.y + pal.height) + 8px + Theme.title-height;
}

/// Conversion d'une saisie hexadécimale (RRGGBB, avec ou sans #) en couleur ; alpha nul si la
/// saisie n'est pas valable (rappel tenu par lib.rs).
export global ColorUtil {
    pure callback parse-hex(string) -> color;
}

/// Fenêtre Couleurs en mode surgissant (Paramètres › couleurs du damier, couleurs des effets :
/// ombre, contour…) : la même fenêtre que la palette Couleurs (ColorsPanel), posée contre la
/// case cliquée, qui modifie la couleur de cette case au lieu de la couleur principale. Le
/// panneau est dans app.slint ; ici l'état et les rappels tenus par lib.rs.
export global ColorPop {
    in-out property <bool> open;
    /// couleur modifiée
    in-out property <color> color;
    /// case cliquée (coordonnées de la fenêtre) : la fenêtre s'ouvre dessous, sinon dessus
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-h;
    /// destination : « appearance:N » (Paramètres) ou « effect:N » (champ d'effet)
    in-out property <string> target;
    /// champs R V B A T S V et hexa de la couleur modifiée (calculés par lib.rs)
    in property <[float]> comps: [0, 0, 0, 255, 0, 0, 0];
    in property <string> hex;
    /// la couleur a changé (geste dans le panneau, nuancier, récentes…) : lib.rs l'applique
    callback changed(color);
    callback wheel-picked(length, length, length);
    callback hsv-picked(float, float, float);
    callback component-changed(int, float);
    callback hex-edited(string);
    /// champs (comps, hex) à recalculer sans rien appliquer (ouverture)
    callback sync();
    /// ouvre la fenêtre sur la couleur `c` pour la destination `t`, contre la case (x, y, h)
    public function show(t: string, c: color, x: length, y: length, h: length) {
        root.target = t;
        root.anchor-x = x;
        root.anchor-y = y;
        root.anchor-h = h;
        root.color = c;
        root.sync();
        root.open = true;
    }
}
