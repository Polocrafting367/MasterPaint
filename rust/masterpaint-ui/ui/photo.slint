// Mode Photo Pro : même disposition que la version web (js/app/PhotoModeManager.js,
// css/photo-mode.css) — interface sombre type Lightroom, toile au centre, pellicule en bas,
// réglages à droite (en bas sur téléphone).
import { Theme } from "theme.slint";
import { FaIcon, GlyphIcon } from "widgets.slint";

export struct PmThumb {
    name: string,
    thumb: image,
    active: bool,
    modified: bool,
}

/// Teintes du Mode Photo Pro (toujours sombre) : contrôles Windows 10/11 du thème sombre
/// de l'application (theme.rs), quel que soit le thème choisi.
global Pm {
    out property <color> accent: Theme.dark ? Theme.accent : Theme.accent.brighter(30%);
    out property <color> button: #383838;
    out property <color> button-hover: #454545;
    out property <color> button-press: #303030;
    out property <color> edge: #ffffff17;
    out property <color> field: #1f1f1f;
    out property <color> field-border: #6a6a6a;
    out property <color> track: #5a5a5a;
    out property <color> text: #e6e6e6;
    out property <color> label: #c8c8c8;
}

/// Bouton Windows 11 sombre : 0 principal (accent), 1 normal, 2 danger (rouge au survol).
component PmButton inherits Rectangle {
    in property <string> glyph;
    in property <string> text;
    in property <int> kind;
    callback clicked();
    property <bool> filled: root.kind == 0;
    height: 26px;
    width: lbl.text != "" ? lbl.preferred-width + (root.glyph != "" ? 40px : 24px) : 30px;
    border-radius: Theme.ctl-radius;
    background: root.filled ? (ta.pressed ? Pm.accent.darker(15%) : (Theme.hover-fx && ta.has-hover) ? Pm.accent.brighter(10%) : Pm.accent)
        : root.kind == 2 && (Theme.hover-fx && ta.has-hover) ? (ta.pressed ? #a52a1f : #c42b1c)
        : ta.pressed ? Pm.button-press : (Theme.hover-fx && ta.has-hover) ? Pm.button-hover : Pm.button;
    border-width: 1px;
    border-color: root.filled ? Pm.accent.darker(10%) : Pm.edge;
    // bord inférieur un peu plus foncé (Windows 11)
    Rectangle {
        x: root.border-radius;
        y: root.height - 1px;
        width: root.width - 2 * root.border-radius;
        height: 1px;
        background: #00000040;
    }
    if root.glyph != "": GlyphIcon {
        x: lbl.text != "" ? 11px : (parent.width - self.width) / 2;
        width: 14px;
        glyph: root.glyph;
        size: 12px;
        tint: #ffffff;
        on-accent: true;
    }
    lbl := Text {
        x: root.glyph != "" ? 30px : 12px;
        text: root.text;
        font-size: Theme.font-size;
        color: root.filled ? Theme.on-accent : ta.pressed ? #c8c8c8 : Pm.text;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

/// Curseur Windows 10 sombre : libellé, valeur dans un champ, piste fine remplie depuis la
/// valeur neutre, poignée en étiquette ; double-clic = valeur neutre.
component PmSlider inherits Rectangle {
    in property <string> label;
    in property <float> value;
    in property <float> minimum: -100;
    in property <float> maximum: 100;
    in property <float> reset-value: 0;
    callback changed(float);
    /// appui tenu sur la piste : la colonne ne doit pas défiler pendant le réglage
    callback hold(bool);
    height: 42px;
    property <float> ratio: clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0, 1);
    property <float> zero: clamp((root.reset-value - root.minimum) / (root.maximum - root.minimum), 0, 1);
    property <length> usable: root.width - 11px;
    Text {
        x: 0;
        y: 2px;
        width: parent.width - 52px;
        text: root.label;
        font-size: Theme.font-size;
        color: Pm.label;
        overflow: elide;
    }
    Rectangle {
        x: parent.width - 42px;
        y: 0;
        width: 42px;
        height: 18px;
        border-radius: max(0px, Theme.ctl-radius - 1px);
        background: Pm.field;
        border-width: 1px;
        border-color: root.value != root.reset-value ? Pm.accent : Pm.field-border;
        Text {
            text: round(root.value);
            font-size: Theme.small-font-size;
            color: Pm.text;
        }
    }
    Rectangle {
        x: 5px;
        y: 28px;
        width: parent.width - 10px;
        height: 5px;
        background: Pm.track;
        Rectangle {
            x: min(root.ratio, root.zero) * parent.width;
            width: abs(root.ratio - root.zero) * parent.width;
            height: parent.height;
            background: Pm.accent;
        }
    }
    Path {
        x: root.usable * root.ratio;
        y: 21px;
        width: 11px;
        height: 19px;
        viewbox-width: 11;
        viewbox-height: 19;
        commands: "M0 0 L11 0 L11 13 L5.5 19 L0 13 Z";
        fill: ta.pressed ? #cccccc : (Theme.hover-fx && ta.has-hover) ? Pm.accent.brighter(25%) : Pm.accent;
    }
    ta := TouchArea {
        y: 18px;
        height: 24px;
        function set-from(px: length) {
            root.changed(round(root.minimum + clamp((px - 5px) / root.usable, 0, 1) * (root.maximum - root.minimum)));
        }
        changed pressed => {
            root.hold(self.pressed);
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                self.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                self.set-from(self.mouse-x);
            }
        }
        double-clicked => {
            root.changed(root.reset-value);
        }
        // molette : un cran = ±1 (la colonne défile ailleurs que sur la piste)
        scroll-event(e) => {
            if (e.delta-y == 0) {
                return reject;
            }
            root.changed(clamp(root.value + (e.delta-y > 0 ? 1 : -1), root.minimum, root.maximum));
            accept
        }
    }
}

/// Titre de section repliable, avec un bouton ↺ (remise à zéro de la section).
component PmSectionHead inherits Rectangle {
    in property <string> title;
    in property <bool> collapsed;
    in property <bool> resettable: true;
    callback toggle();
    callback reset();
    height: 34px;
    background: (Theme.hover-fx && hta.has-hover) ? #2f2f2f : #282828;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #3a3a3a;
    }
    hta := TouchArea {
        clicked => {
            root.toggle();
        }
    }
    FaIcon {
        x: 12px;
        width: 12px;
        glyph: root.collapsed ? "\u{f054}" : "\u{f078}";
        size: 9px;
        color: #b0b0b0;
    }
    Text {
        x: 32px;
        width: parent.width - 76px;
        text: root.title;
        font-size: Theme.small-font-size;
        font-weight: 600;
        color: (Theme.hover-fx && hta.has-hover) ? #ffffff : Pm.label;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.resettable: Rectangle {
        x: parent.width - 36px;
        y: 5px;
        width: 26px;
        height: 24px;
        border-radius: Theme.ctl-radius;
        background: rta.pressed ? Pm.button-press : (Theme.hover-fx && rta.has-hover) ? Pm.button-hover : Pm.button;
        border-width: 1px;
        border-color: Pm.edge;
        GlyphIcon {
            glyph: "\u{f0e2}";
            size: 11px;
            tint: #ffffff;
            on-accent: true;
        }
        rta := TouchArea {
            clicked => {
                root.reset();
            }
        }
    }
}

export component PhotoMode inherits Rectangle {
    in property <bool> phone;
    in property <image> image;
    in property <int> img-w: 1;
    in property <int> img-h: 1;
    in property <int> full-w: 1;
    in property <[PmThumb]> photos: [];
    in property <[float]> values: [];
    in property <[string]> presets: [];
    in property <int> preset;
    in property <bool> fx-off;
    in property <string> info;
    in property <bool> busy;
    // zone rendue en haute résolution (0..1 de l'image) par-dessus l'aperçu basse résolution
    in property <image> hq-image;
    in property <float> hq-x0;
    in property <float> hq-y0;
    in property <float> hq-x1: 1;
    in property <float> hq-y1: 1;
    in property <bool> hq-shown;
    /// zone visible (0..1) et largeur affichée de l'image : rendu haute résolution de cette zone
    callback view-changed(float, float, float, float, float);
    callback action(string);
    callback select(int);
    callback remove(int);
    callback set(int, float);
    callback preset-chosen(int);
    // sections repliées (Filtres, Lumière, Couleur, Présence, Grading, TSL)
    in-out property <[bool]> folded: [false, false, false, false, true, true];
    property <int> hsl-band: 0;
    /// un curseur est tenu : la colonne ne défile pas
    property <bool> held;
    property <float> zoom: 1;
    property <length> pan-x;
    property <length> pan-y;
    background: #111111;
    // un appui ne traverse jamais vers l'éditeur en dessous
    TouchArea { }

    property <length> head-h: 46px;
    property <length> side-w: root.phone ? root.width : 300px;
    property <length> body-h: root.height - root.head-h;
    property <length> main-w: root.phone ? root.width : root.width - root.side-w;
    property <length> main-h: root.phone ? root.body-h * 0.55 : root.body-h;
    property <length> film-h: root.photos.length == 0 ? 0px : root.phone ? 80px : 110px;
    property <length> view-h: root.main-h - root.film-h;
    // taille affichée : ajustée à la zone, puis multipliée par le zoom
    property <float> fit: min((root.main-w - 32px) / (root.img-w * 1px), (root.view-h - 32px) / (root.img-h * 1px));
    property <length> disp-w: root.img-w * root.fit * root.zoom * 1px;
    property <length> disp-h: root.img-h * root.fit * root.zoom * 1px;
    // coin de l'image dans la zone d'affichage
    property <length> img-x: (root.main-w - root.disp-w) / 2 + root.pan-x;
    property <length> img-y: (root.view-h - root.disp-h) / 2 + root.pan-y;
    function report-view() {
        if (root.disp-w > 0 && root.disp-h > 0) {
            root.view-changed(
                clamp(-root.img-x / root.disp-w, 0, 1),
                clamp(-root.img-y / root.disp-h, 0, 1),
                clamp((root.main-w - root.img-x) / root.disp-w, 0, 1),
                clamp((root.view-h - root.img-y) / root.disp-h, 0, 1),
                root.disp-w / 1px);
        }
    }
    init => {
        root.report-view();
    }
    changed disp-w => {
        root.report-view();
    }
    changed disp-h => {
        root.report-view();
    }
    changed pan-x => {
        root.report-view();
    }
    changed pan-y => {
        root.report-view();
    }
    changed main-w => {
        root.report-view();
    }
    changed view-h => {
        root.report-view();
    }

    // ================= en-tête =================
    Rectangle {
        height: root.head-h;
        y: 0;
        background: #252526;
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: #333333;
        }
        GlyphIcon {
            x: 16px;
            width: 18px;
            glyph: "\u{f030}";
            size: 15px;
            tint: #ffffff;
        }
        if !root.phone: Text {
            x: 42px;
            text: @tr("Mode Photo Pro");
            font-size: 15px;
            font-weight: 500;
            color: #ffffff;
            vertical-alignment: center;
        }
        HorizontalLayout {
            x: parent.width - self.preferred-width - 10px;
            y: 10px;
            height: 26px;
            spacing: 6px;
            PmButton {
                glyph: "\u{2b}";
                text: root.phone ? @tr("Importer") : @tr("Importer photos");
                clicked => {
                    root.action("import");
                }
            }
            PmButton {
                glyph: "\u{f35d}";
                text: root.phone ? "" : @tr("Ouvrir");
                kind: 1;
                clicked => {
                    root.action("open-editor");
                }
            }
            PmButton {
                glyph: "\u{f56e}";
                text: root.phone ? @tr("Exporter") : @tr("Exporter…");
                clicked => {
                    root.action("export");
                }
            }
            PmButton {
                glyph: "\u{f0c5}";
                text: root.phone ? "" : @tr("Appliquer à toutes");
                kind: 1;
                clicked => {
                    root.action("apply-all");
                }
            }
            // réglage automatique de chaque photo selon sa scène (portrait, paysage, nuit…)
            PmButton {
                glyph: "\u{e2ca}";
                text: root.phone ? "" : @tr("Auto sur toutes");
                kind: 1;
                clicked => {
                    root.action("auto-all");
                }
            }
            PmButton {
                glyph: "\u{f00d}";
                kind: 2;
                clicked => {
                    root.action("close");
                }
            }
        }
    }

    // ================= toile =================
    Rectangle {
        x: 0;
        y: root.head-h;
        width: root.main-w;
        height: root.view-h;
        background: @radial-gradient(circle, #222222 0%, #000000 100%);
        clip: true;
        if root.photos.length > 0: Rectangle {
            x: (parent.width - root.disp-w) / 2 + root.pan-x;
            y: (parent.height - root.disp-h) / 2 + root.pan-y;
            width: root.disp-w;
            height: root.disp-h;
            background: #000000;
            drop-shadow-blur: 30px;
            drop-shadow-color: Theme.shadows ? (#000000) : transparent;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.image;
                image-fit: fill;
                image-rendering: root.zoom > 1.5 ? pixelated : smooth;
            }
            if root.hq-shown && !root.fx-off: Image {
                x: root.hq-x0 * parent.width;
                y: root.hq-y0 * parent.height;
                width: (root.hq-x1 - root.hq-x0) * parent.width;
                height: (root.hq-y1 - root.hq-y0) * parent.height;
                source: root.hq-image;
                image-fit: fill;
            }
        }
        // glisser = déplacer, molette = zoom, double-clic = ajuster
        TouchArea {
            mouse-cursor: root.zoom > 1 ? MouseCursor.move : MouseCursor.default;
            moved => {
                if (self.pressed) {
                    root.pan-x += self.mouse-x - self.pressed-x;
                    root.pan-y += self.mouse-y - self.pressed-y;
                }
            }
            double-clicked => {
                root.zoom = 1;
                root.pan-x = 0;
                root.pan-y = 0;
            }
            scroll-event(e) => {
                root.zoom = clamp(root.zoom * (e.delta-y > 0 ? 1.15 : 1 / 1.15), 0.2, 12);
                accept
            }
        }
        // photo sans pellicule : invitation à importer
        if root.photos.length == 0: VerticalLayout {
            alignment: center;
            spacing: 18px;
            HorizontalLayout {
                alignment: center;
                GlyphIcon {
                    width: 56px;
                    height: 56px;
                    glyph: "\u{f302}";
                    size: 48px;
                    tint: #333333;
                    opacity: 0.35;
                }
            }
            Text {
                text: @tr("Aucune photo chargée. Importez vos fichiers JPG, PNG, WebP…");
                font-size: 13px;
                color: #d4d4d4;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: center;
                PmButton {
                    glyph: "\u{2b}";
                    text: @tr("Importer photos");
                    clicked => {
                        root.action("import");
                    }
                }
            }
        }
        if root.photos.length > 0 && root.info != "": Text {
            x: 12px;
            y: 10px;
            text: root.info;
            font-size: 11px;
            color: #ffffffb0;
        }
        if root.busy: Rectangle {
            x: parent.width - 86px;
            y: 10px;
            width: 74px;
            height: 22px;
            border-radius: 11px * Theme.round;
            background: #141414d9;
            Text {
                text: @tr("Rendu…");
                font-size: 11px;
                color: #ffffff;
            }
        }
        // badge de zoom : facteur, ajuster, effets ON / OFF
        if root.photos.length > 0: Rectangle {
            x: 14px;
            y: parent.height - 46px;
            width: zl.preferred-width + 32px;
            height: 32px;
            border-radius: 16px * Theme.round;
            background: #141414d9;
            border-width: 1px;
            border-color: #ffffff26;
            zl := HorizontalLayout {
                x: 12px;
                height: parent.height;
                spacing: 8px;
                Text {
                    text: (root.phone ? "" : @tr("Zoom : ")) + round(root.disp-w / (root.full-w * 1px) * 100) + " %";
                    font-size: 11px;
                    color: #ffffffe6;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 24px;
                    y: 4px;
                    height: 24px;
                    border-radius: 12px * Theme.round;
                    background: (Theme.hover-fx && fta.has-hover) ? #ffffff26 : #ffffff0d;
                    GlyphIcon {
                        glyph: "\u{f065}";
                        size: 11px;
                        tint: #ffffff;
                    }
                    fta := TouchArea {
                        clicked => {
                            root.zoom = 1;
                            root.pan-x = 0;
                            root.pan-y = 0;
                        }
                    }
                }
                Rectangle {
                    y: 4px;
                    height: 24px;
                    width: tl.preferred-width + 34px;
                    border-radius: 12px * Theme.round;
                    background: root.fx-off ? #e74c3c : (Theme.hover-fx && tta.has-hover) ? #ffffff33 : #ffffff1a;
                    GlyphIcon {
                        x: 9px;
                        width: 12px;
                        glyph: "\u{e2ca}";
                        size: 11px;
                        tint: #ffffff;
                        on-accent: root.fx-off;
                    }
                    tl := Text {
                        x: 26px;
                        text: root.fx-off ? @tr("OFF") : @tr("ON");
                        font-size: 10px;
                        font-weight: 700;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                    tta := TouchArea {
                        clicked => {
                            root.action("fx");
                        }
                    }
                }
            }
        }
    }

    // ================= pellicule =================
    if root.photos.length > 0: Rectangle {
        x: 0;
        y: root.head-h + root.view-h;
        width: root.main-w;
        height: root.film-h;
        background: #1e1e1e;
        Rectangle {
            y: 0;
            height: 1px;
            background: #333333;
        }
        Flickable {
            content-width: fl.width;
            content-height: self.height;
            fl := HorizontalLayout {
                x: 0;
                y: 0;
                width: self.preferred-width;
                height: root.film-h;
                padding: root.phone ? 6px : 12px;
                spacing: 10px;
                for p[i] in root.photos: Rectangle {
                    width: root.phone ? 80px : 100px;
                    border-radius: 4px * Theme.round;
                    background: p.active ? #333333 : (Theme.hover-fx && pta.has-hover) ? #222222 : #000000;
                    border-width: 2px;
                    border-color: p.active ? Theme.accent : (Theme.hover-fx && pta.has-hover) ? #555555 : #333333;
                    clip: true;
                    Image {
                        width: parent.width - 4px;
                        height: parent.height - 4px;
                        source: p.thumb;
                        image-fit: contain;
                        opacity: p.active || (Theme.hover-fx && pta.has-hover) ? 1 : 0.7;
                    }
                    pta := TouchArea {
                        clicked => {
                            root.select(i);
                        }
                    }
                    if p.modified: Rectangle {
                        x: parent.width - 14px;
                        y: 6px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px * Theme.round;
                        background: #ffaa00;
                    }
                    if p.active || root.phone || pta.has-hover: Rectangle {
                        x: 4px;
                        y: 4px;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px * Theme.round;
                        background: (Theme.hover-fx && xta.has-hover) ? #ff4d4d : #00000099;
                        FaIcon {
                            glyph: "\u{f00d}";
                            size: 9px;
                            color: #ffffff;
                        }
                        xta := TouchArea {
                            clicked => {
                                root.remove(i);
                            }
                        }
                    }
                }
            }
        }
    }

    // ================= réglages =================
    Rectangle {
        x: root.phone ? 0 : root.main-w;
        y: root.phone ? root.head-h + root.main-h : root.head-h;
        width: root.side-w;
        height: root.phone ? root.body-h - root.main-h : root.body-h;
        background: #252526;
        Rectangle {
            x: 0;
            y: 0;
            width: root.phone ? parent.width : 1px;
            height: root.phone ? 2px : parent.height;
            background: root.phone ? #444444 : #333333;
        }
        sfl := Flickable {
            x: root.phone ? 0 : 1px;
            y: root.phone ? 2px : 0;
            width: parent.width - (root.phone ? 0 : 1px);
            height: parent.height - (root.phone ? 2px : 0);
            content-height: side.preferred-height;
            // souris : molette ou barre de défilement seulement (un glisser sur un curseur
            // faisait défiler la colonne) ; doigt : glisser, sauf pendant un réglage
            interactive: root.phone && !root.held;
            side := VerticalLayout {
                x: 0;
                width: parent.width - (root.phone ? 0px : 10px);
                alignment: start;
                // ---- Filtres & Reset ----
                PmSectionHead {
                    title: @tr("FILTRES & RESET");
                    resettable: false;
                    collapsed: root.folded[0];
                    toggle => {
                        root.folded[0] = !root.folded[0];
                    }
                }
                if !root.folded[0]: VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    Text {
                        text: @tr("Préréglages créatifs");
                        font-size: Theme.font-size;
                        color: Pm.label;
                    }
                    pcombo := Rectangle {
                        height: 26px;
                        border-radius: Theme.ctl-radius;
                        background: (Theme.hover-fx && cta.has-hover) ? #262626 : Pm.field;
                        border-width: 1px;
                        border-color: (Theme.hover-fx && cta.has-hover) ? Pm.accent : Pm.field-border;
                        Text {
                            x: 8px;
                            width: parent.width - 30px;
                            text: root.presets[root.preset];
                            font-size: Theme.font-size;
                            color: Pm.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        FaIcon {
                            x: parent.width - 20px;
                            width: 12px;
                            glyph: "\u{f078}";
                            size: 9px;
                            color: #b0b0b0;
                        }
                        cta := TouchArea {
                            clicked => {
                                plist.show();
                            }
                        }
                        plist := PopupWindow {
                            x: 0;
                            y: parent.height + 2px;
                            width: parent.width;
                            Rectangle {
                                background: #2b2b2b;
                                border-width: 1px;
                                border-color: #454545;
                                border-radius: Theme.ctl-radius > 0 ? Theme.ctl-radius + 2px : 0px;
                                drop-shadow-blur: 8px;
                                drop-shadow-offset-y: 2px;
                                drop-shadow-color: Theme.shadows ? (#00000080) : transparent;
                                VerticalLayout {
                                    padding: 3px;
                                    for n[k] in root.presets: Rectangle {
                                        height: 24px;
                                        border-radius: Theme.ctl-radius;
                                        background: (Theme.hover-fx && ita.has-hover) ? #3d3d3d : k == root.preset ? #353535 : transparent;
                                        if k == root.preset: Rectangle {
                                            x: 0;
                                            y: 6px;
                                            width: 3px;
                                            height: parent.height - 12px;
                                            border-radius: 1.5px;
                                            background: Pm.accent;
                                        }
                                        Text {
                                            x: 10px;
                                            text: n;
                                            font-size: Theme.font-size;
                                            color: Pm.text;
                                            vertical-alignment: center;
                                        }
                                        ita := TouchArea {
                                            clicked => {
                                                root.preset-chosen(k);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        height: 26px;
                        PmButton {
                            horizontal-stretch: 1;
                            glyph: "\u{f0e2}";
                            text: @tr("Réinitialiser");
                            kind: 1;
                            clicked => {
                                root.action("reset");
                            }
                        }
                        PmButton {
                            horizontal-stretch: 1;
                            glyph: "\u{f2f9}";
                            text: @tr("Rotation");
                            clicked => {
                                root.action("rotate");
                            }
                        }
                    }
                }
                // ---- sections de curseurs (indices du moteur Camera Raw) ----
                for sec[si] in [
                    { title: @tr("LUMIÈRE"), auto: true, sliders: [
                        { i: 0, l: @tr("Exposition"), mn: -150, mx: 150 }, { i: 18, l: @tr("Contraste"), mn: -80, mx: 80 },
                        { i: 5, l: @tr("Hautes lumières"), mn: -170, mx: 170 }, { i: 3, l: @tr("Ombres"), mn: -170, mx: 170 },
                        { i: 6, l: @tr("Blancs"), mn: -140, mx: 140 }, { i: 4, l: @tr("Noirs"), mn: -140, mx: 140 }] },
                    { title: @tr("COULEUR ET SATURATION"), auto: false, sliders: [
                        { i: 1, l: @tr("Température"), mn: -100, mx: 100 }, { i: 2, l: @tr("Teinte"), mn: -100, mx: 100 },
                        { i: 20, l: @tr("Vibrance"), mn: -90, mx: 90 }, { i: 19, l: @tr("Saturation"), mn: -80, mx: 80 }] },
                    { title: @tr("PRÉSENCE ET DÉTAIL"), auto: false, sliders: [
                        { i: 16, l: @tr("Clarté (micro-contraste)"), mn: -70, mx: 70 }, { i: 17, l: @tr("Correction du voile"), mn: -70, mx: 70 },
                        { i: 22, l: @tr("Vignettage"), mn: -85, mx: 85 }, { i: 21, l: @tr("Netteté (piqué)"), mn: 0, mx: 100 },
                        { i: 23, l: @tr("Grain film"), mn: 0, mx: 100 }, { i: 24, l: @tr("Piqué du grain"), mn: 0, mx: 100 }] },
                    { title: @tr("COLOR GRADING (RVB)"), auto: false, sliders: [
                        { i: 7, l: @tr("Rouge"), mn: -80, mx: 80 }, { i: 8, l: @tr("Rouge — hautes lumières"), mn: -70, mx: 70 }, { i: 9, l: @tr("Rouge — ombres"), mn: -70, mx: 70 },
                        { i: 10, l: @tr("Vert"), mn: -80, mx: 80 }, { i: 11, l: @tr("Vert — hautes lumières"), mn: -70, mx: 70 }, { i: 12, l: @tr("Vert — ombres"), mn: -70, mx: 70 },
                        { i: 13, l: @tr("Bleu"), mn: -80, mx: 80 }, { i: 14, l: @tr("Bleu — hautes lumières"), mn: -70, mx: 70 }, { i: 15, l: @tr("Bleu — ombres"), mn: -70, mx: 70 }] },
                ]: VerticalLayout {
                    PmSectionHead {
                        title: sec.title;
                        collapsed: root.folded[si + 1];
                        toggle => {
                            root.folded[si + 1] = !root.folded[si + 1];
                        }
                        reset => {
                            root.action("reset-section:" + si);
                        }
                    }
                    if !root.folded[si + 1]: VerticalLayout {
                        padding: 14px;
                        padding-top: 10px;
                        spacing: 4px;
                        if sec.auto: HorizontalLayout {
                            alignment: end;
                            PmButton {
                                glyph: "\u{e2ca}";
                                text: @tr("Auto");
                                kind: 1;
                                clicked => {
                                    root.action("auto");
                                }
                            }
                        }
                        for s in sec.sliders: PmSlider {
                            label: s.l;
                            minimum: s.mn;
                            maximum: s.mx;
                            reset-value: s.i == 24 ? 50 : 0;
                            value: root.values[s.i];
                            changed(v) => {
                                root.set(s.i, v);
                            }
                            hold(b) => {
                                root.held = b;
                            }
                        }
                    }
                }
                // ---- mélangeur TSL : une couleur à la fois ----
                PmSectionHead {
                    title: @tr("MÉLANGEUR DE COULEURS (TSL)");
                    collapsed: root.folded[5];
                    toggle => {
                        root.folded[5] = !root.folded[5];
                    }
                    reset => {
                        root.action("reset-section:4");
                    }
                }
                if !root.folded[5]: VerticalLayout {
                    padding: 14px;
                    padding-top: 10px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 6px;
                        height: 24px;
                        for c[ci] in [#e53935, #fb8c00, #fdd835, #43a047, #00acc1, #1e88e5, #8e24aa, #d81b60]: Rectangle {
                            horizontal-stretch: 1;
                            border-radius: Theme.ctl-radius;
                            background: c;
                            border-width: ci == root.hsl-band ? 2px : 1px;
                            border-color: ci == root.hsl-band ? #ffffff : #00000060;
                            TouchArea {
                                clicked => {
                                    root.hsl-band = ci;
                                }
                            }
                        }
                    }
                    Text {
                        font-size: Theme.font-size;
                        text: [@tr("Rouges"), @tr("Oranges"), @tr("Jaunes"), @tr("Verts"), @tr("Aquas"), @tr("Bleus"), @tr("Violets"), @tr("Magentas")][root.hsl-band];
                        font-weight: 600;
                        color: Pm.text;
                    }
                    PmSlider {
                        label: @tr("Teinte");
                        value: root.values[30 + root.hsl-band];
                        changed(v) => {
                            root.set(30 + root.hsl-band, v);
                        }
                        hold(b) => {
                            root.held = b;
                        }
                    }
                    PmSlider {
                        label: @tr("Saturation");
                        value: root.values[38 + root.hsl-band];
                        changed(v) => {
                            root.set(38 + root.hsl-band, v);
                        }
                        hold(b) => {
                            root.held = b;
                        }
                    }
                    PmSlider {
                        label: @tr("Luminance");
                        value: root.values[46 + root.hsl-band];
                        changed(v) => {
                            root.set(46 + root.hsl-band, v);
                        }
                        hold(b) => {
                            root.held = b;
                        }
                    }
                }
                Rectangle {
                    height: 24px;
                }
            }
        }
        if !root.phone && sfl.content-height > sfl.height: Rectangle {
            property <length> track-h: sfl.height - 8px;
            property <length> thumb-h: max(30px, self.track-h * sfl.height / sfl.content-height);
            property <length> room: sfl.content-height - sfl.height;
            x: parent.width - 9px;
            y: 4px;
            width: 6px;
            height: self.track-h;
            border-radius: 3px;
            background: (Theme.hover-fx && bta.has-hover) || bta.pressed ? #ffffff14 : transparent;
            Rectangle {
                y: -sfl.content-y / parent.room * (parent.track-h - parent.thumb-h);
                height: parent.thumb-h;
                width: bta.has-hover || bta.pressed ? 6px : 3px;
                x: parent.width - self.width;
                border-radius: 3px;
                background: bta.pressed ? #a0a0a0 : #7a7a7a;
            }
            bta := TouchArea {
                property <length> start-y;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        self.start-y = -sfl.content-y;
                    }
                }
                moved => {
                    if (self.pressed) {
                        sfl.content-y = -clamp(self.start-y + (self.mouse-y - self.pressed-y) * parent.room / max(1px, parent.track-h - parent.thumb-h), 0px, parent.room);
                    }
                }
            }
        }
    }
}
