    callback anim-cell(int, int);
    callback anim-cell-op(string, int, int);
    callback anim-set(string, int);
    // pelure d'oignon : images voisines teintées, alpha déjà estompé
    in property <image> onion-image;
    in property <bool> onion-shown;
    // hauteur de la frise (0 : mode animation coupé ou frise réduite)
    property <length> anim-h: root.anim-on && root.anim-open ? (root.phone ? 150px : min(220px, max(118px, 58px + root.anim-rows.length * 22px))) : 0px;
    // contenu hors toile (pixels du document : position, taille)
    in property <image> outside-image;
    in property <float> outside-x;
    in property <float> outside-y;
    in property <float> outside-w;
    in property <float> outside-h;
    in property <image> wheel-image;
    in property <int> doc-width: 1280;
    in property <int> doc-height: 720;
    in-out property <float> zoom: 0.82;
    /// zone du document visible à l'écran (x0, y0, x1, y1 en pixels du document)
    // projet SVG : la vue a bougé (zoom, déplacement, fenêtre) → retracer la toile
    property <float> vec-sig: root.vec-on ? canvas.x / 1px * 1.37 + canvas.y / 1px * 3.1 + root.zoom * 1009 + ws.width / 1px * 7 + ws.height / 1px * 13 : 0;
    changed vec-sig => {
        root.vec-view-moved();
    }
    out property <[float]> visible-rect: [-canvas.x / (root.zoom * 1px), -canvas.y / (root.zoom * 1px), (ws.width - canvas.x) / (root.zoom * 1px), (ws.height - canvas.y) / (root.zoom * 1px)];
    /// déplacement de la vue (aperçu d'effet limité à la zone visible)
    callback view-moved();
    changed pan-x => {
        root.view-moved();
    }
    changed pan-y => {
        root.view-moved();
    }
    /// zoom modifié : l'affichage réduit des grandes images est recomposé si son pas change
