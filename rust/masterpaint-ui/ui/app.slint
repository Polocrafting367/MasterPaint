                }
            }
        }
        if !root.classic: Row {
            ToggleButton {
                colspan: 3;
                glyph: "\u{f1fc}";
                text: "Lissé";
                checked: ToolOpts.antialias;
                clicked => {
                    ToolOpts.antialias = !ToolOpts.antialias;
                    Actions.ribbon("text-opts");
                }
            }
        }
