export struct HistoryItem {
    label: string,
    fa: string,
}

/// Tuile de la toile mise à jour pendant un geste : chaque zone est dessinée une fois,
/// et seules les tuiles touchées repartent vers la carte graphique.
export struct CanvasTile {
    x: int,
    y: int,
    w: int,
    h: int,
    img: image,
}


export struct Handle {
    x: float,
    y: float,
    round: bool,
}

export struct LayerRow {
    index: int,
    name: string,
    visible: bool,
    thumb: image,
    has-mask: bool,   // masque α lié
    dyn-on: bool,     // filtre dynamique ƒ actif
    is-mask-doc: bool, // onglet de masque α : pas de boutons α / ƒ
    depth: int,       // dossiers au-dessus (retrait)
    is-group: bool,   // dossier de calques
    collapsed: bool,  // dossier replié
    locked: bool,     // cadenas
    is-text: bool,    // calque texte (modifiable, effets non destructifs)
    vec-shapes: bool, // calque SVG avec des formes (pastille « objets » au lieu de « T »)
    fx-count: int,    // effets posés sur le calque texte
}

/// Effet de la pile d'un calque texte (fenêtre « Effets du calque texte »).
export struct TextFxRow {
    label: string,
    on: bool,
}

export struct AppliedFxRow {
    label: string,
    on: bool,
    strength: float,
    editable: bool,
    quick-label: string,
    quick-value: float,
    quick-min: float,
    quick-max: float,
}

/// Petit bouton d'une ligne de calque (α, corbeille, ƒ).
component LayerMiniButton inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <string> tip;
    in property <bool> bold;
    in property <bool> on;
    in property <bool> enabled: true;
    callback clicked();
    width: 20px;
    height: 20px;
    border-radius: Theme.ctl-radius;
    // actif (masque présent, filtre allumé) : pastille pleine à l'accent, bien visible
    background: root.on ? (ta.has-hover ? Theme.accent.brighter(0.15) : Theme.accent) : ta.has-hover && root.enabled ? Theme.accent-14 : transparent;
    border-width: root.on || (ta.has-hover && root.enabled) ? 1px : 0px;
    border-color: root.on ? Theme.accent.darker(0.2) : Theme.accent;
    opacity: root.enabled ? 1 : 0.4;
    if root.glyph != "": GlyphIcon {
        glyph: root.glyph;
        size: 10px;
        tint: root.on ? Theme.on-accent : Theme.text;
        on-accent: root.on;
    }
    if root.glyph == "": Text {
        text: root.label;
        font-size: root.on ? 12px : 11px;
        font-weight: root.on || root.bold ? 700 : 400;
        color: root.on ? Theme.on-accent : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Timer {
        interval: 600ms;
        running: ta.has-hover && root.tip != "" && !(Tip.shown && Tip.text == root.tip);
        triggered => {
            Tip.text = root.tip;
            Tip.x = root.absolute-position.x;
            Tip.y = root.absolute-position.y + root.height + 4px;
            Tip.shown = true;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            Tip.shown = false;
            root.clicked();
        }
        changed has-hover => {
            if (!self.has-hover && Tip.text == root.tip) {
                Tip.shown = false;
            }
        }
    }
}

/// Position et taille enregistrées d'une palette (Outils, Historique, Couleurs, Calques) ;
/// `set` faux : place d'origine.
export struct PalGeom {
    set: bool,
    x: length,
    y: length,
    w: length,
    h: length,
}

/// Réglages des outils, partagés par le ruban, la barre classique et le Rust.
export global ToolOpts {
    in property <float> brush-size-max: 500;
    in property <float> line-width-max: 100;
    in property <float> corner-radius-max: 200;
    in property <float> font-size-max: 400;
    in-out property <float> brush-size: 2;
    in-out property <float> hardness: 100;
    in-out property <int> brush-shape: 0;  // 0 rond, 1 doux, 2 spray, 3 carré
    in-out property <bool> sym-x;
    in-out property <bool> sym-y;
    // position des axes de symétrie (pixels du document ; -1 = centre de l'image)
    in-out property <float> sym-cx: -1;
    in-out property <float> sym-cy: -1;
    in-out property <float> tolerance: 32;
    in-out property <bool> contiguous: true;
    // lasso magnétique : force d'attraction aux bords (%) et écart entre ancres (pixels)
    in-out property <float> magnet-strength: 60;
    in-out property <float> magnet-freq: 32;
    in-out property <int> sel-mode: 0;  // 0 nouvelle, 1 ajout, 2 retrait, 3 intersection
    in-out property <int> shape-style: 0;  // 0 contour, 1 plein, 2 les deux
    in-out property <float> line-width: 2;
    in-out property <int> gradient-kind: 0;  // 0 linéaire, 1 radial, 2 losange, 3 conique
    in-out property <string> shape-kind: "rect";
    // rayon des coins du rectangle arrondi (pixels du document)
    in-out property <float> corner-radius: 16;
    // polygone : nombre de côtés ; étoile : nombre de branches
    in-out property <float> shape-sides: 5;
    in-out property <float> star-points: 5;
    // ligne : 0 droite, 1 courbe (deux points intermédiaires après le tracé) ; bouts (0 droit,
    // 1 rond, 2 flèche pleine, 3 flèche vide, 4 losange) ; trait (0 continu, 1 tirets, 2 pointillés)
    in-out property <int> line-mode: 1;
    in-out property <int> cap-start: 1;
    in-out property <int> cap-end: 1;
    in-out property <int> line-dash: 0;
    // les formes tracées restent des objets modifiables (calque SVG) au lieu de pixels
    in-out property <bool> shape-layer: true;
    in-out property <bool> pixel-grid;
    in-out property <bool> rulers;
    in-out property <bool> outside-canvas;
    in-out property <bool> snap;
    // texte
    in-out property <int> font-index: 0;
    in-out property <float> font-size: 32;
    in-out property <int> text-align: 0;  // 0 gauche, 1 centre, 2 droite
    in-out property <bool> antialias: true;
    // le texte crée un calque texte (modifiable ensuite, effets non destructifs)
    in-out property <bool> text-layer: true;
}

/// Polices proposées par l'outil Texte (Selawik, polices MasterPaint, polices du système).
export global FontList {
    in property <[string]> names: ["Selawik"];
    /// aperçu de chaque nom dans sa police (même ordre ; image vide tant que la police n'est pas lue)
    in property <[image]> previews: [];
}

/// Choix de la police : liste défilante (hauteur limitée), chaque nom affiché dans sa police.
component FontCombo inherits Rectangle {
    in-out property <int> current-index;
    callback selected(int);
    height: 22px;
    border-radius: Theme.ctl-radius;
    background: Theme.field-bg;
    border-width: 1px;
    border-color: fta.has-hover ? Theme.accent : Theme.field-border;
    Text {
        x: 7px;
        width: parent.width - 26px;
        height: parent.height;
        text: FontList.names[root.current-index];
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    FaIcon {
        x: parent.width - 18px;
        width: 14px;
        height: parent.height;
        glyph: "\u{f078}";
        size: 9px;
    }
    HoverTip { y: parent.height; hovered: fta.has-hover && !fta.pressed; text: FontList.names[root.current-index]; }
    fta := TouchArea {
        clicked => {
            popup.show();
        }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height;
        width: max(root.width, 280px);
        height: min(FontList.names.length * 28px + 8px, 340px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.field-bg;
            border-width: 1px;
            border-color: Theme.field-border;
            border-radius: Theme.ctl-radius > 0 ? Theme.ctl-radius + 2px : 0px;
            drop-shadow-blur: 8px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: Theme.window-shadow;
            ListView {
                x: 3px;
                y: 3px;
                width: parent.width - 6px;
                height: parent.height - 6px;
                for name[i] in FontList.names: Rectangle {
                    height: 28px;
                    border-radius: Theme.ctl-radius;
                    background: ita.has-hover ? Theme.accent-14 : i == root.current-index ? Theme.accent-12 : transparent;
                    // aperçu dans la police (rendu par le Rust), sinon le nom en police d'interface
                    if i < FontList.previews.length && FontList.previews[i].width > 0: Image {
                        x: 8px;
                        y: (parent.height - self.height) / 2;
                        height: 22px;
                        width: min(self.source.width * 1px, parent.width - 16px);
                        image-fit: contain;
                        horizontal-alignment: left;
                        source: FontList.previews[i];
                        colorize: Theme.text;
                    }
                    if !(i < FontList.previews.length && FontList.previews[i].width > 0): Text {
                        x: 8px;
                        text: name;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    ita := TouchArea {
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

/// État des options à bascule, pour les cases cochées des menus (mises à jour en direct).
export global MenuState {
    in-out property <bool> tools: true;
    in-out property <bool> colors: true;
    in-out property <bool> layers: true;
    in-out property <bool> history: true;
    in-out property <int> layout: 0;
    /// interface téléphone affichée (choisie ou automatique sur un écran étroit)
    in-out property <bool> phone: false;
    in-out property <int> toolbar-mode: 0;
    /// espace de couleur du projet actif (0 Bitmap, 1 CMJN, 2 RAL, 3 Tramé)
    in-out property <int> color-mode: 0;
    /// calque actif qui refuse les pixels : "" (aucun), "calque texte", "verrouillé", "dossier"
    in-out property <string> layer-block;
    /// bouton du ruban qui modifie les pixels du calque actif (grisé selon `layer-block`)
    public pure function ribbon-blocked(id: string) -> bool {
        return root.layer-block != "" && (id == "opt-sel-clear-ribbon" || id == "opt-sel-align-left"
            || id == "opt-sel-center-h" || id == "opt-sel-align-right" || id == "opt-sel-align-top"
            || id == "opt-sel-center-v" || id == "opt-sel-align-bottom" || id == "opt-sel-center-both");
    }
    /// entrée à cocher (bascule) : la case est affichée, cochée selon `checked`
    public pure function checkable(action: string, label: string) -> bool {
        return action == "fn:EditorManager.convertActiveProjectToPixel()" || action == "fn:EditorManager.convertActiveProjectToRal()"
            || action == "fn:EditorManager.convertActiveProjectToCmjn()"
            || action == "fn:window.toggleIlluPixelGrid()" || action == "fn:window.toggleIlluRulers()"
            || action == "fn:window.toggleIlluSnapToEdges && window.toggleIlluSnapToEdges()"
            || action == "fn:window.toggleIlluShowAllRibbonOptions()"
            || action == "fn:window.toggleIlluAllowOutsideCanvas && window.toggleIlluAllowOutsideCanvas()"
            || action == "fn:window.toggleFloatingPaletteVisibility('win-tools')"
            || action == "fn:window.toggleFloatingPaletteVisibility('win-colors')"
            || action == "fn:window.toggleFloatingPaletteVisibility('win-layers')"
            || action == "fn:window.toggleFloatingPaletteVisibility('win-history')"
            || label == @tr("Interface : mode téléphone (menu ☰, palettes en colonnes)")
            || label == @tr("Palettes : ancrage fixe (style Adobe)") || label == @tr("Palettes volantes (Paint.NET)");
    }
    public pure function checked(action: string, label: string) -> bool {
        return action == "fn:EditorManager.convertActiveProjectToPixel()" ? root.color-mode == 0
            : action == "fn:EditorManager.convertActiveProjectToCmjn()" ? root.color-mode == 1
            : action == "fn:EditorManager.convertActiveProjectToRal()" ? root.color-mode == 2
            : action == "fn:window.toggleIlluPixelGrid()" ? ToolOpts.pixel-grid
            : action == "fn:window.toggleIlluRulers()" ? ToolOpts.rulers
            : action == "fn:window.toggleIlluSnapToEdges && window.toggleIlluSnapToEdges()" ? ToolOpts.snap
            : action == "fn:window.toggleIlluShowAllRibbonOptions()" ? root.toolbar-mode == 1
            : action == "fn:window.toggleIlluAllowOutsideCanvas && window.toggleIlluAllowOutsideCanvas()" ? ToolOpts.outside-canvas
            : action == "fn:window.toggleFloatingPaletteVisibility('win-tools')" ? root.tools
            : action == "fn:window.toggleFloatingPaletteVisibility('win-colors')" ? root.colors
            : action == "fn:window.toggleFloatingPaletteVisibility('win-layers')" ? root.layers
            : action == "fn:window.toggleFloatingPaletteVisibility('win-history')" ? root.history
            : label == @tr("Interface : mode téléphone (menu ☰, palettes en colonnes)") ? root.phone
            : label == @tr("Palettes : ancrage fixe (style Adobe)") ? root.layout == 1 && !root.phone
            : label == @tr("Palettes volantes (Paint.NET)") ? root.layout == 0 && !root.phone
            : false;
    }
}

/// Actions de l'interface, traitées par le Rust.
export global Actions {
    callback ribbon(string);
}

/// Bouton du ruban d'après le relevé de la version web (index dans Generated.ribbon).
component RB inherits FlatButton {
    in property <int> idx;
    in property <bool> labelled;
    icon: Generated.ribbon[idx].icon;
    label: Generated.ribbon[idx].label;
    // effacer / aligner le contenu : grisé sur un calque texte, verrouillé ou un dossier
    enabled: !MenuState.ribbon-blocked(Generated.ribbon[idx].id);
    tip: self.enabled ? Generated.ribbon[idx].title
        : Generated.ribbon[idx].title + (MenuState.layer-block == "calque texte" ? @tr(" — Pixelliser le calque pour l'utiliser") : @tr(" — indisponible sur ce calque"));
    show-label: labelled && !RibbonFit.tight;
    icon-size: 14px;
    width: labelled && !RibbonFit.tight ? 66px : 26px;
    height: 26px;
    clicked => {
        Actions.ribbon(Generated.ribbon[idx].id);
    }
}

/// Ligne d'un menu déroulant : icône (ou case cochée en direct pour une option à bascule),
/// libellé, marqueur « à venir », raccourci, flèche de sous-menu.
component MenuRow inherits Rectangle {
    in property <string> label;
    in property <string> fa;
    in property <int> fa-weight: 900;
    in property <string> shortcut;
    in property <string> action;
    in property <string> badge;
    in property <bool> separator;
    in property <bool> submenu;
    in property <bool> highlighted;
    callback activate();
    callback hovered();
    // entrée indisponible pour le calque actif (calque texte, verrouillé, dossier) : grisée,
    // sans effet au clic, info-bulle qui dit quoi faire (marqueur posé par le Rust)
    property <bool> blocked: !root.submenu && (root.badge == @tr("calque texte") || root.badge == @tr("verrouillé") || root.badge == @tr("dossier"));
    property <string> blocked-tip: root.badge == @tr("calque texte") ? @tr("Pixelliser le calque pour utiliser cet effet")
        : root.badge == @tr("verrouillé") ? @tr("Déverrouiller le calque pour utiliser cet effet")
        : @tr("Choisir un calque (pas un dossier) pour utiliser cet effet");
    height: root.separator ? 7px : 24px;
    border-radius: Theme.ctl-radius;
    background: !root.separator && !root.blocked && (ta.has-hover || root.highlighted) ? Theme.accent-14 : transparent;
    border-width: !root.separator && !root.blocked && (ta.has-hover || root.highlighted) ? 1px : 0px;
    border-color: Theme.accent-60;
    if root.separator: Rectangle {
        x: 32px;
        width: parent.width - 36px;
        y: 3px;
        height: 1px;
        background: Theme.window-border;
    }
    if !root.separator: HorizontalLayout {
        padding-right: 8px;
        opacity: root.blocked ? 0.45 : 1;
        // colonne des icônes (30 px, = MenuGutter) : icône maison, glyphe ou case à cocher, tous
        // dans la même case de 16 × 16 px posée au même endroit (libellés alignés) ; 8 px de plus
        // que la gouttière pour décoller le libellé du trait vertical
        mic := Rectangle {
            width: 38px;
            property <int> mp: MpIcons.for-menu(root.label, root.fa);
            if !MenuState.checkable(root.action, root.label) && mic.mp >= 0: Image {
                x: 7px;
                y: (parent.height - 16px) / 2;
                width: 16px;
                height: 16px;
                source: MpIcons.images[mic.mp];
                image-fit: contain;
            }
            if !MenuState.checkable(root.action, root.label) && mic.mp < 0: FaIcon {
                x: 7px;
                y: (parent.height - 16px) / 2;
                width: 16px;
                height: 16px;
                glyph: root.fa;
                weight: root.fa-weight;
                size: 12px;
                color: Theme.text;
            }
            if MenuState.checkable(root.action, root.label): Rectangle {
                x: 8px;
                y: (parent.height - 14px) / 2;
                width: 14px;
                height: 14px;
                border-radius: 2px * Theme.round;
                background: MenuState.checked(root.action, root.label) ? Theme.accent : Theme.field-bg;
                border-width: 1px;
                border-color: MenuState.checked(root.action, root.label) ? Theme.accent : Theme.field-border;
                if MenuState.checked(root.action, root.label): FaIcon {
                    glyph: "\u{f00c}";
                    size: 9px;
                    color: Theme.on-accent;
                }
            }
        }
        Text {
            text: root.label;
            font-size: Theme.menu-font-size;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        // marqueur : fonction pas encore transférée en Rust
        if root.badge != "": Rectangle {
            width: 58px;
            Rectangle {
                x: 2px;
                y: 5px;
                width: 52px;
                height: 14px;
                border-radius: 3px * Theme.round;
                background: #f59e0b30;
                border-width: 1px;
                border-color: #d97706;
                Text {
                    text: root.badge;
                    font-size: 9px;
                    color: #b45309;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.shortcut;
            font-size: Theme.menu-font-size;
            color: Theme.text-inactive;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        // colonne des flèches de sous-menu, réservée sur toutes les lignes : raccourcis et
        // flèches tombent sur le même bord droit
        Rectangle {
            width: 14px;
            if root.submenu: FaIcon {
                width: parent.width;
                height: parent.height;
                glyph: "\u{f054}";
                size: 9px;
            }
        }
    }
    ta := TouchArea {
        enabled: !root.separator;
        clicked => {
            if (!root.blocked) {
                root.activate();
            }
        }
        changed has-hover => {
            if (self.has-hover) {
                root.hovered();
            } else if (root.blocked && Tip.text == root.blocked-tip) {
                Tip.shown = false;
            }
        }
    }
    Timer {
        interval: 450ms;
        running: root.blocked && ta.has-hover && !(Tip.shown && Tip.text == root.blocked-tip);
        triggered => {
            Tip.text = root.blocked-tip;
            Tip.x = root.absolute-position.x + 32px;
            Tip.y = root.absolute-position.y + root.height + 2px;
            Tip.shown = true;
        }
    }
}

/// Colonne des icônes d'un menu déroulant (comme Paint.NET / paintdotjs) : fond à part et
/// trait vertical entre icônes et libellés. Posée sous les lignes (`pad` = marge du menu).
component MenuGutter inherits Rectangle {
    in property <length> pad: 4px;
    x: root.pad;
    y: root.pad;
    width: 30px;
    border-top-left-radius: Theme.ctl-radius;
    border-bottom-left-radius: Theme.ctl-radius;
    background: Theme.menu-gutter;
    Rectangle {
        x: parent.width + 1px;
        width: 1px;
        background: Theme.window-border;
    }
}

/// Titre de la barre de menus. Comme sous Windows : un clic ouvre le menu, puis le survol
/// d'un autre titre bascule vers son menu.
component MenuBarItem inherits Rectangle {
    in property <MenuSpec> menu;
    in property <bool> open;
    in property <bool> any-open;
    callback toggle(length);
    callback switch-to(length);
    width: label.preferred-width + 16px;
    // arrondi comme les menus qu'il ouvre (Windows 11)
    border-radius: Theme.ctl-radius;
    background: root.open ? Theme.accent-20 : ta.has-hover ? Theme.accent-14 : transparent;
    border-width: root.open || ta.has-hover ? 1px : 0px;
    border-color: Theme.accent-60;
    label := Text {
        text: root.menu.title;
        font-size: Theme.menu-font-size;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => {
            root.toggle(root.absolute-position.x);
        }
        changed has-hover => {
            if (self.has-hover && root.any-open && !root.open) {
                root.switch-to(root.absolute-position.x);
            }
        }
    }
}

/// Champ numérique de dialogue : « Libellé [valeur] ».
component Field inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> value;
    spacing: 8px;
    height: 26px;
    Text {
        width: 90px;
        text: root.label;
        color: Theme.text;
        vertical-alignment: center;
    }
    W10LineEdit {
        text <=> root.value;
        input-type: number;
    }
}

/// Groupe « Sélection » du ruban (2 rangées ou 1 rangée en barre classique).
component SelectionGroup inherits RibbonGroup {
    label: @tr("Sélection");
    if !root.classic: VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            RB {
                idx: 0;
                labelled: true;
            }
            RB {
                idx: 1;
                labelled: true;
            }
            RB {
                idx: 2;
                labelled: true;
            }
        }
        HorizontalLayout {
            RB {
                idx: 3;
                labelled: true;
                checked: ToolOpts.sel-mode == 0;
            }
            RB {
                idx: 4;
                labelled: true;
                checked: ToolOpts.sel-mode == 1;
            }
            RB {
                idx: 5;
                labelled: true;
                checked: ToolOpts.sel-mode == 2;
            }
        }
    }
    if root.classic: HorizontalLayout {
        RB {
            idx: 0;
        }
        RB {
            idx: 1;
        }
        RB {
            idx: 2;
        }
        RB {
            idx: 3;
            checked: ToolOpts.sel-mode == 0;
        }
        RB {
            idx: 4;
            checked: ToolOpts.sel-mode == 1;
        }
        RB {
            idx: 5;
            checked: ToolOpts.sel-mode == 2;
        }
    }
}

component EditGroup inherits RibbonGroup {
    label: @tr("Édition");
    if !root.classic: VerticalLayout {
        spacing: 4px;
        padding-top: 3px;
        RB {
            idx: 6;
            labelled: true;
        }
        RB {
            idx: 7;
            labelled: true;
        }
    }
    if root.classic: HorizontalLayout {
        RB {
            idx: 6;
        }
        RB {
            idx: 7;
        }
    }
}

component AlignGroup inherits RibbonGroup {
    in property <bool> has-selection;
    label: @tr("Ajustements");
    if !root.classic: VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            for i in [8, 9, 10, 11]: RB {
                idx: i;
                enabled: root.has-selection;
            }
        }
        HorizontalLayout {
            for i in [12, 13, 14, 15]: RB {
                idx: i;
                enabled: root.has-selection;
            }
        }
    }
    if root.classic: HorizontalLayout {
        for i in [8, 9, 10, 11, 12, 13, 14, 15]: RB {
            idx: i;
            enabled: root.has-selection;
        }
    }
}

component ViewGroup inherits RibbonGroup {
    label: @tr("Affichage");
    if !root.classic: VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            RB {
                idx: 16;
                checked: ToolOpts.pixel-grid;
            }
            RB {
                idx: 17;
                checked: ToolOpts.rulers;
            }
        }
        HorizontalLayout {
            RB {
                idx: 18;
                checked: ToolOpts.outside-canvas;
            }
            RB {
                idx: 19;
                checked: ToolOpts.snap;
            }
        }
    }
    if root.classic: HorizontalLayout {
        RB {
            idx: 16;
            checked: ToolOpts.pixel-grid;
        }
        RB {
            idx: 17;
            checked: ToolOpts.rulers;
        }
        RB {
            idx: 18;
            checked: ToolOpts.outside-canvas;
        }
        RB {
            idx: 19;
            checked: ToolOpts.snap;
        }
    }
}

/// Contiguïté + tolérance (baguette, pot de peinture).
component RegionGroup inherits RibbonGroup {
    in property <string> other-label: @tr("Calque");
    in property <string> other-glyph: "\u{f03e}";
    in property <float> tol-max: 100;
    if !root.classic: VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            ToggleButton {
                glyph: "\u{f5fd}";
                img: Sprite.mode-contiguous;
                text: @tr("Contigu");
                checked: ToolOpts.contiguous;
                clicked => {
                    ToolOpts.contiguous = true;
                }
            }
            ToggleButton {
                glyph: root.other-glyph;
                img: root.other-label == "Calque" ? Sprite.mode-layer : Sprite.mode-layer;
                text: root.other-label;
                checked: !ToolOpts.contiguous;
                clicked => {
                    ToolOpts.contiguous = false;
                }
            }
        }
        Gauge {
            label: @tr("Tol.");
            label-width: 30px;
            minimum: 0;
            maximum: root.tol-max;
            value <=> ToolOpts.tolerance;
        }
    }
    if root.classic: HorizontalLayout {
        spacing: 4px;
        ToggleButton {
            compact: true;
            glyph: "\u{f5fd}";
            img: Sprite.mode-contiguous;
            tip: Tips.desc(@tr("Contigu")) != "" ? Tips.desc(@tr("Contigu")) : @tr("Contigu");
            checked: ToolOpts.contiguous;
            clicked => {
                ToolOpts.contiguous = !ToolOpts.contiguous;
            }
        }
        Gauge {
            label: @tr("Tol.");
            label-width: 26px;
            bar-width: 80px;
            minimum: 0;
            maximum: root.tol-max;
            value <=> ToolOpts.tolerance;
        }
    }
}

/// Lasso magnétique : force d'attraction aux bords (0 % = lasso libre) et écart entre les
/// ancres posées automatiquement en glissant.
component MagnetGroup inherits RibbonGroup {
    if !root.classic: VerticalLayout {
        spacing: 6px;
        alignment: center;
        Gauge {
            label: @tr("Force");
            tip: @tr("Force du lasso magnétique : 0 % = lasso libre, 100 % = colle fort aux bords");
            label-width: 44px;
            minimum: 0;
            maximum: 100;
            unit: "%";
            value <=> ToolOpts.magnet-strength;
            changed(v) => {
                Actions.ribbon("magnet-opts");
            }
        }
        Gauge {
            label: @tr("Ancres");
            tip: @tr("Écart entre deux ancres automatiques (pixels) : plus petit = tracé plus fidèle");
            label-width: 44px;
            minimum: 8;
            maximum: 120;
            unit: "px";
            value <=> ToolOpts.magnet-freq;
            changed(v) => {
                Actions.ribbon("magnet-opts");
            }
        }
    }
    if root.classic: HorizontalLayout {
        spacing: 4px;
        Gauge {
            label: @tr("Force");
            tip: @tr("Force du lasso magnétique : 0 % = lasso libre, 100 % = colle fort aux bords");
            label-width: 34px;
            bar-width: 80px;
            minimum: 0;
            maximum: 100;
            unit: "%";
            value <=> ToolOpts.magnet-strength;
            changed(v) => {
                Actions.ribbon("magnet-opts");
            }
        }
    }
}

component SizeGroup inherits RibbonGroup {
    label: @tr("Taille / trait");
    if !root.classic: VerticalLayout {
        spacing: 8px;
        padding-top: 2px;
        Gauge {
            label: @tr("Taille");
            minimum: 1;
            maximum: ToolOpts.brush-size-max;
            progressive: true;
            value <=> ToolOpts.brush-size;
        }
        Gauge {
            label: @tr("Dureté");
            minimum: 0;
            maximum: 100;
            value <=> ToolOpts.hardness;
        }
    }
    if root.classic: HorizontalLayout {
        spacing: 8px;
        Gauge {
            label: @tr("Taille");
            label-width: 34px;
            bar-width: 80px;
            minimum: 1;
            maximum: ToolOpts.brush-size-max;
            progressive: true;
            value <=> ToolOpts.brush-size;
        }
        Gauge {
            label: @tr("Dureté");
            label-width: 38px;
            bar-width: 80px;
            minimum: 0;
            maximum: 100;
            value <=> ToolOpts.hardness;
        }
    }
}

component SymmetryGroup inherits RibbonGroup {
    label: @tr("Symétrie");
    if !root.classic: VerticalLayout {
        spacing: 4px;
        ToggleButton {
            glyph: "\u{f07e}";
            img: Sprite.sym-x;
            text: @tr("Sym. X");
            checked: ToolOpts.sym-x;
            clicked => {
                ToolOpts.sym-x = !ToolOpts.sym-x;
                ToolOpts.rulers = ToolOpts.rulers || ToolOpts.sym-x;
            }
        }
        ToggleButton {
            glyph: "\u{f07d}";
            img: Sprite.sym-y;
            text: @tr("Sym. Y");
            checked: ToolOpts.sym-y;
            clicked => {
                ToolOpts.sym-y = !ToolOpts.sym-y;
                ToolOpts.rulers = ToolOpts.rulers || ToolOpts.sym-y;
            }
        }
    }
    if root.classic: HorizontalLayout {
        spacing: 2px;
        ToggleButton {
            compact: true;
            glyph: "\u{f07e}";
            img: Sprite.sym-x;
            tip: Tips.desc(@tr("Sym. X")) != "" ? Tips.desc(@tr("Sym. X")) : @tr("Sym. X");
            checked: ToolOpts.sym-x;
            clicked => {
                ToolOpts.sym-x = !ToolOpts.sym-x;
                ToolOpts.rulers = ToolOpts.rulers || ToolOpts.sym-x;
            }
        }
        ToggleButton {
            compact: true;
            glyph: "\u{f07d}";
            img: Sprite.sym-y;
            tip: Tips.desc(@tr("Sym. Y")) != "" ? Tips.desc(@tr("Sym. Y")) : @tr("Sym. Y");
            checked: ToolOpts.sym-y;
            clicked => {
                ToolOpts.sym-y = !ToolOpts.sym-y;
                ToolOpts.rulers = ToolOpts.rulers || ToolOpts.sym-y;
            }
        }
    }
}

component BrushGroup inherits RibbonGroup {
    in property <bool> pencil;
    label: root.pencil ? @tr("Crayon") : @tr("Pinceau");
    GridLayout {
        spacing: 2px;
        Row {
            for k[i] in [{ g: "\u{f111}", t: @tr("Rond") }, { g: "\u{f192}", t: @tr("Doux") }]: ToggleButton {
                compact: root.classic;
                glyph: k.g;
                img: i == 0 ? Sprite.brush-round : Sprite.brush-soft;
                text: k.t;
                checked: ToolOpts.brush-shape == i;
                clicked => {
                    ToolOpts.brush-shape = i;
                }
            }
        }
        Row {
            for k[i] in [{ g: "\u{f5c7}", t: @tr("Spray") }, { g: "\u{f0c8}", t: @tr("Carré") }]: ToggleButton {
                compact: root.classic;
                glyph: k.g;
                img: i == 0 ? Sprite.brush-spray : Sprite.brush-square;
                text: k.t;
                checked: ToolOpts.brush-shape == i + 2;
                clicked => {
                    ToolOpts.brush-shape = i + 2;
                }
            }
        }
    }
}

component ShapeKindGroup inherits RibbonGroup {
    label: @tr("Forme");
    // icônes du sprite MasterPaint (icons/illu-sprite.svg), comme la version web ; deux rangées
    // de 7 dans le ruban, une seule ligne dans la barre Paint.NET. Polygone et étoile : nombre de
    // côtés / branches réglé par le curseur du groupe suivant (ShapeParamGroup)
    GridLayout {
        spacing: 2px;
        for k[i] in [
            { id: "rect", n: @tr("Rectangle"), img: Sprite.shape-stroke },
            { id: "roundrect", n: @tr("Rectangle à coins arrondis (rayon réglable)"), img: Sprite.shape-round },
            { id: "ellipse", n: @tr("Ellipse / cercle"), img: Sprite.shape-ellipse },
            { id: "ngon", n: @tr("Polygone (nombre de côtés réglable : 3 = triangle)"), img: Sprite.shape-pentagon },
            { id: "star", n: @tr("Étoile (nombre de branches réglable)"), img: Sprite.shape-star-5 },
            { id: "triangle-right", n: @tr("Triangle rectangle"), img: Sprite.shape-triangle-right },
            { id: "diamond", n: @tr("Losange"), img: Sprite.shape-diamond },
            { id: "trapezoid", n: @tr("Trapèze"), img: Sprite.shape-trapezoid },
            { id: "parallelogram", n: @tr("Parallélogramme"), img: Sprite.shape-parallelogram },
            { id: "arrow", n: @tr("Flèche"), img: Sprite.shape-arrow },
            { id: "cross", n: @tr("Croix"), img: Sprite.shape-cross },
            { id: "heart", n: @tr("Cœur"), img: Sprite.shape-heart },
            { id: "callout-rect", n: @tr("Bulle rectangulaire"), img: Sprite.shape-callout-rect },
            { id: "callout-oval", n: @tr("Bulle ovale"), img: Sprite.shape-callout-oval },
        ]: ToggleButton {
            col: root.classic ? i : mod(i, 7);
            row: root.classic ? 0 : floor(i / 7);
            compact: true;
            img: k.img;
            tip: k.n;
            checked: ToolOpts.shape-kind == k.id;
            clicked => {
                ToolOpts.shape-kind = k.id;
            }
        }
    }
}

/// Objets modifiables (calque SVG) : formes et textes restent des objets qu'on retouche ensuite
/// (outil Texte, Déplacer, Pot de peinture, panneau Objets SVG) ; éteint : pixels du calque actif.
/// Objets modifiables (calque SVG) : formes et textes restent des objets qu'on retouche ensuite
/// (outil Texte, Déplacer, Pot de peinture, panneau Objets SVG) ; éteint : pixels du calque actif.
/// Formes : le réglage de la forme choisie (rayon des coins, nombre de côtés ou de branches) se
/// place sous le bouton, dans la même alvéole (plus compact que deux groupes).
component VectorGroup inherits RibbonGroup {
    in property <bool> text;
    /// réglage affiché sous le bouton : -1 aucun, 0 coins, 1 côtés, 2 branches, 3 épaisseur (Ligne)
    in property <int> param: -1;
    label: root.param == 0 ? @tr("Calque SVG · coins") : root.param == 1 ? @tr("Calque SVG · polygone")
        : root.param == 2 ? @tr("Calque SVG · étoile") : root.param == 3 ? @tr("Calque SVG · trait") : @tr("Calque SVG");
    property <bool> on: root.text ? ToolOpts.text-layer : ToolOpts.shape-layer;
    VerticalLayout {
        spacing: 6px;
        alignment: start;
        HorizontalLayout {
            alignment: start;
            ToggleButton {
                compact: root.classic;
                img: root.text ? Sprite.vec-text : Sprite.vec-shape;
                // libellé fixe (sinon le bouton change de largeur) : l'état se lit au bouton enfoncé
                text: @tr("Modifiable");
                tip: root.text
                    ? (root.on ? @tr("Activé : chaque texte reste modifiable sur un calque SVG (recliquez-le avec l'outil Texte, déplacez-le, effets non destructifs). Cliquer pour peindre le texte en pixels dans le calque actif.")
                        : @tr("Désactivé : le texte est peint en pixels dans le calque actif. Cliquer pour garder les textes modifiables (calque SVG)."))
                    : (root.on ? @tr("Activé : chaque forme reste un objet modifiable sur un calque SVG (déplacer, recolorer, exporter en SVG). Cliquer pour tracer en pixels dans le calque actif.")
                        : @tr("Désactivé : la forme est tracée en pixels dans le calque actif. Cliquer pour garder les formes modifiables (calque SVG)."));
                checked: root.on;
                clicked => {
                    if (root.text) {
                        ToolOpts.text-layer = !ToolOpts.text-layer;
                        Actions.ribbon("text-layer");
                    } else {
                        ToolOpts.shape-layer = !ToolOpts.shape-layer;
                        Actions.ribbon("shape-layer");
                    }
                }
            }
        }
        if root.param == 0 && !root.classic: Gauge {
            label: @tr("Rayon");
            label-width: 52px;
            bar-width: 70px;
            minimum: 0;
            maximum: ToolOpts.corner-radius-max;
            progressive: true;
            value <=> ToolOpts.corner-radius;
        }
        if root.param == 1 && !root.classic: Gauge {
            label: @tr("Côtés");
            label-width: 52px;
            bar-width: 70px;
            minimum: 3;
            maximum: 12;
            value <=> ToolOpts.shape-sides;
        }
        if root.param == 3 && !root.classic: Gauge {
            label: @tr("Épaisseur");
            label-width: 58px;
            bar-width: 70px;
            minimum: 1;
            maximum: ToolOpts.line-width-max;
            value <=> ToolOpts.line-width;
        }
        if root.param == 2 && !root.classic: Gauge {
            label: @tr("Branches");
            label-width: 52px;
            bar-width: 70px;
            minimum: 3;
            maximum: 12;
            value <=> ToolOpts.star-points;
        }
    }
}

/// Barre Paint.NET (une seule ligne) : le réglage de forme garde sa propre alvéole.
component ShapeParamGroup inherits RibbonGroup {
    in property <int> kind;  // 0 coins, 1 côtés, 2 branches
    label: root.kind == 0 ? @tr("Coins") : root.kind == 1 ? @tr("Polygone") : @tr("Étoile");
    if root.kind == 0: Gauge {
        label: @tr("Rayon");
        label-width: 52px;
        bar-width: 70px;
        minimum: 0;
        maximum: ToolOpts.corner-radius-max;
        progressive: true;
        value <=> ToolOpts.corner-radius;
    }
    if root.kind == 1: Gauge {
        label: @tr("Côtés");
        label-width: 52px;
        bar-width: 70px;
        minimum: 3;
        maximum: 12;
        value <=> ToolOpts.shape-sides;
    }
    if root.kind == 2: Gauge {
        label: @tr("Branches");
        label-width: 52px;
        bar-width: 70px;
        minimum: 3;
        maximum: 12;
        value <=> ToolOpts.star-points;
    }
}

/// Aperçu d'un trait : continu, tirets ou pointillés.
component DashPreview inherits Rectangle {
    in property <int> dash;
    width: 30px;
    height: 16px;
    if root.dash == 0: Rectangle { x: 2px; y: 7px; width: 26px; height: 2px; background: Theme.ribbon-fg; }
    if root.dash == 1: HorizontalLayout {
        x: 2px; y: 7px; width: 26px; height: 2px; spacing: 3px;
        for k in 4: Rectangle { width: 4.25px; background: Theme.ribbon-fg; }
    }
    if root.dash == 2: HorizontalLayout {
        x: 2px; y: 6px; width: 26px; height: 3px; spacing: 3px;
        for k in 5: Rectangle { width: 3px; border-radius: 1.5px; background: Theme.ribbon-fg; }
    }
}

/// Choix d'un bout ou du trait d'une ligne : bouton qui montre l'aperçu du choix courant et
/// ouvre la liste des choix avec leur aperçu (comme la version HTML).
component LineStylePicker inherits Rectangle {
    /// 0 bout de début, 1 bout de fin, 2 trait
    in property <int> what;
    in property <string> tip;
    in-out property <int> value;
    callback picked(int);
    property <[{n: string, img: image}]> caps: [
        { n: @tr("Droit"), img: Sprite.cap-none },
        { n: @tr("Rond"), img: Sprite.cap-round },
        { n: @tr("Flèche pleine"), img: Sprite.cap-arrow },
        { n: @tr("Flèche vide"), img: Sprite.cap-arrow-hollow },
        { n: @tr("Losange"), img: Sprite.cap-diamond },
    ];
    property <[string]> dashes: [@tr("Continu"), @tr("Tirets"), @tr("Pointillés")];
    width: root.what == 2 ? 48px : 38px;
    height: 24px;
    border-radius: Theme.ctl-radius;
    background: pta.has-hover ? Theme.accent-12 : Theme.field-bg;
    border-width: 1px;
    border-color: pta.has-hover ? Theme.accent : Theme.field-border;
    if root.what < 2: Image {
        x: 4px;
        y: 4px;
        width: 16px;
        height: 16px;
        source: root.caps[root.value].img;
        // les icônes montrent un bout de fin (vers la droite) : retournées pour le début
        rotation-angle: root.what == 0 ? 180deg : 0deg;
    }
    if root.what == 2: DashPreview {
        x: 3px;
        y: 4px;
        dash: root.value;
    }
    FaIcon {
        x: parent.width - 12px;
        glyph: "\u{f078}";
        size: 7px;
        color: Theme.ribbon-label;
    }
    HoverTip { y: parent.height; hovered: pta.has-hover && !pta.pressed; text: root.tip; }
    pta := TouchArea {
        clicked => { pop.show(); }
    }
    pop := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: 150px;
        height: (root.what == 2 ? 3 : 5) * 28px + 8px;
        Rectangle {
            background: Theme.menu-bg;
            border-radius: Theme.ctl-radius + 2px;
            border-width: 1px;
            border-color: Theme.window-border;
            drop-shadow-blur: 6px;
            drop-shadow-color: Theme.window-shadow;
            VerticalLayout {
                padding: 4px;
                for i in (root.what == 2 ? 3 : 5): Rectangle {
                    height: 28px;
                    border-radius: Theme.ctl-radius;
                    background: i == root.value ? Theme.accent-14 : ita.has-hover ? Theme.accent-12 : transparent;
                    if root.what < 2: Image {
                        x: 8px;
                        y: 6px;
                        width: 16px;
                        height: 16px;
                        source: root.caps[i].img;
                        rotation-angle: root.what == 0 ? 180deg : 0deg;
                    }
                    if root.what == 2: DashPreview {
                        x: 6px;
                        y: 6px;
                        dash: i;
                    }
                    Text {
                        x: 42px;
                        height: parent.height;
                        text: root.what == 2 ? root.dashes[i] : root.caps[i].n;
                        color: Theme.text;
                        font-weight: i == root.value ? 700 : 400;
                        vertical-alignment: center;
                    }
                    ita := TouchArea {
                        clicked => {
                            root.value = i;
                            root.picked(i);
                        }
                    }
                }
            }
        }
    }
}

/// Outil Ligne : droite ou courbe (deux points intermédiaires après le tracé), bouts de début et
/// de fin, trait continu / tirets / pointillés.
component LineGroup inherits RibbonGroup {
    label: @tr("Ligne");
    if !root.classic: VerticalLayout {
        spacing: 6px;
        alignment: start;
        HorizontalLayout {
            spacing: 2px;
            alignment: start;
            for m[i] in [{ g: "\u{f068}", t: @tr("Droite") }, { g: "\u{f1e0}", t: @tr("Courbe") }]: ToggleButton {
                glyph: m.g;
                text: m.t;
                tip: i == 0 ? @tr("Ligne droite entre deux points") : @tr("Courbe : après le tracé, deux points intermédiaires permettent de la courber");
                checked: ToolOpts.line-mode == i;
                clicked => { ToolOpts.line-mode = i; }
            }
        }
        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            // dans l'ordre de la ligne : bout de gauche, trait, bout de droite
            LineStylePicker { what: 0; tip: @tr("Début de ligne"); value <=> ToolOpts.cap-start; }
            LineStylePicker { what: 2; tip: @tr("Style du trait"); value <=> ToolOpts.line-dash; }
            LineStylePicker { what: 1; tip: @tr("Fin de ligne"); value <=> ToolOpts.cap-end; }
        }
    }
    if root.classic: HorizontalLayout {
        spacing: 4px;
        for m[i] in [{ g: "\u{f068}", t: @tr("Droite") }, { g: "\u{f1e0}", t: @tr("Courbe") }]: ToggleButton {
            compact: true;
            glyph: m.g;
            tip: m.t;
            checked: ToolOpts.line-mode == i;
            clicked => { ToolOpts.line-mode = i; }
        }
        LineStylePicker { y: 1px; what: 0; tip: @tr("Début de ligne"); value <=> ToolOpts.cap-start; }
        LineStylePicker { y: 1px; what: 2; tip: @tr("Style du trait"); value <=> ToolOpts.line-dash; }
        LineStylePicker { y: 1px; what: 1; tip: @tr("Fin de ligne"); value <=> ToolOpts.cap-end; }
    }
}

component StrokeGroup inherits RibbonGroup {
    in property <bool> line;
    label: @tr("Trait");
    if !root.classic: VerticalLayout {
        spacing: 6px;
        if !root.line: HorizontalLayout {
            spacing: 2px;
            ToggleButton {
                glyph: "\u{f0c8}";
                weight: 400;
                img: Sprite.shape-stroke;
                text: @tr("Contour");
                checked: ToolOpts.shape-style == 0;
                clicked => {
                    ToolOpts.shape-style = 0;
                }
            }
            ToggleButton {
                glyph: "\u{f0c8}";
                img: Sprite.shape-fill;
                text: @tr("Plein");
                checked: ToolOpts.shape-style == 1;
                clicked => {
                    ToolOpts.shape-style = 1;
                }
            }
            ToggleButton {
                glyph: "\u{f5fd}";
                img: Sprite.shape-both;
                text: @tr("Les deux");
                checked: ToolOpts.shape-style == 2;
                clicked => {
                    ToolOpts.shape-style = 2;
                }
            }
        }
        Gauge {
            label: @tr("Épaisseur");
            label-width: 58px;
            minimum: 1;
            maximum: ToolOpts.line-width-max;
            progressive: true;
            value <=> ToolOpts.line-width;
        }
    }
    if root.classic: HorizontalLayout {
        spacing: 2px;
        if !root.line: ToggleButton {
            compact: true;
            glyph: "\u{f0c8}";
            weight: 400;
            img: Sprite.shape-stroke;
            tip: Tips.desc(@tr("Contour")) != "" ? Tips.desc(@tr("Contour")) : @tr("Contour");
            checked: ToolOpts.shape-style == 0;
            clicked => {
                ToolOpts.shape-style = 0;
            }
        }
        if !root.line: ToggleButton {
            compact: true;
            glyph: "\u{f0c8}";
            img: Sprite.shape-fill;
            tip: Tips.desc(@tr("Plein")) != "" ? Tips.desc(@tr("Plein")) : @tr("Plein");
            checked: ToolOpts.shape-style == 1;
            clicked => {
                ToolOpts.shape-style = 1;
            }
        }
        if !root.line: ToggleButton {
            compact: true;
            glyph: "\u{f5fd}";
            img: Sprite.shape-both;
            tip: Tips.desc(@tr("Les deux")) != "" ? Tips.desc(@tr("Les deux")) : @tr("Les deux");
            checked: ToolOpts.shape-style == 2;
            clicked => {
                ToolOpts.shape-style = 2;
            }
        }
        Gauge {
            label: @tr("Épaisseur");
            label-width: 56px;
            bar-width: 70px;
            minimum: 1;
            maximum: ToolOpts.line-width-max;
            progressive: true;
            value <=> ToolOpts.line-width;
        }
    }
}

component TextGroup inherits RibbonGroup {
    label: @tr("Texte");
    if !root.classic: VerticalLayout {
        spacing: 4px;
        alignment: center;
        FontCombo {
            width: 200px;
            current-index <=> ToolOpts.font-index;
            selected(i) => {
                Actions.ribbon("text-opts");
            }
        }
        HorizontalLayout {
            height: 26px;
            spacing: 4px;
            // même largeur que la liste des polices au-dessus (le « + » tombe sous son bord droit)
            Gauge {
                label: @tr("Taille");
                label-width: 34px;
                bar-width: 122px;
                minimum: 6;
                maximum: ToolOpts.font-size-max;
                progressive: true;
                value <=> ToolOpts.font-size;
                changed(v) => {
                    Actions.ribbon("text-opts");
                }
            }
        }
    }
    if root.classic: HorizontalLayout {
        spacing: 4px;
        FontCombo {
            y: 2px;
            width: 160px;
            current-index <=> ToolOpts.font-index;
            selected(i) => {
                Actions.ribbon("text-opts");
            }
        }
        Gauge {
            label: @tr("Taille");
            label-width: 34px;
            bar-width: 64px;
            minimum: 6;
            maximum: ToolOpts.font-size-max;
            progressive: true;
            value <=> ToolOpts.font-size;
            changed(v) => {
                Actions.ribbon("text-opts");
            }
        }
    }
}

component TextStyleGroup inherits RibbonGroup {
    label: @tr("Paragraphe");
    GridLayout {
        spacing: 2px;
        Row {
            for k[i] in ["\u{f036}", "\u{f037}", "\u{f038}"]: ToggleButton {
                compact: true;
                glyph: k;
                tip: i == 0 ? @tr("Aligner le texte à gauche") : i == 1 ? @tr("Centrer le texte") : @tr("Aligner le texte à droite");
                checked: ToolOpts.text-align == i;
                clicked => {
                    ToolOpts.text-align = i;
                    Actions.ribbon("text-opts");
                }
            }
        }
        if !root.classic: Row {
            ToggleButton {
                colspan: 3;
                // même largeur que les trois boutons d'alignement au-dessus
                width: 3 * 26px + 2 * 2px;
                glyph: "\u{f1fc}";
                text: @tr("Lissé");
                checked: ToolOpts.antialias;
                clicked => {
                    ToolOpts.antialias = !ToolOpts.antialias;
                    Actions.ribbon("text-opts");
                }
            }
        }
    }
}

component GradientGroup inherits RibbonGroup {
    label: @tr("Dégradé");
    GridLayout {
        spacing: 2px;
        Row {
            for k[i] in [{ g: "\u{f337}", t: @tr("Linéaire") }, { g: "\u{f192}", t: @tr("Radial") }]: ToggleButton {
                compact: root.classic;
                glyph: k.g;
                img: i == 0 ? Sprite.grad-linear : Sprite.grad-radial;
                text: k.t;
                checked: ToolOpts.gradient-kind == i;
                clicked => {
                    ToolOpts.gradient-kind = i;
                }
            }
        }
        Row {
            for k[i] in [{ g: "\u{f219}", t: @tr("Losange") }, { g: "\u{f1ce}", t: @tr("Conique") }]: ToggleButton {
                compact: root.classic;
                glyph: k.g;
                text: k.t;
                checked: ToolOpts.gradient-kind == i + 2;
                clicked => {
                    ToolOpts.gradient-kind = i + 2;
                }
            }
        }
    }
}

/// Paramètres : titre de page et introduction. Les textes renvoyés à la ligne ont une largeur
/// imposée (`text-w`) : la hauteur de la page suit, le défilement atteint bien le bas.
/// Maillon entre largeur et hauteur : enfoncé = proportions conservées (Nouvelle image,
/// Redimensionner, Taille de la zone de travail).
component LinkToggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 30px;
    border-radius: Theme.ctl-radius;
    background: root.checked ? Theme.accent-14 : lka.has-hover ? Theme.accent-12 : transparent;
    border-width: 1px;
    border-color: root.checked ? Theme.accent : Theme.window-border;
    GlyphIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: root.checked ? "\u{f0c1}" : "\u{f127}";
        size: 12px;
        tint: root.checked ? Theme.accent : Theme.text-inactive;
    }
    HoverTip { y: parent.height; hovered: lka.has-hover; text: root.checked ? @tr("Proportions conservées (cliquer pour délier)") : @tr("Conserver les proportions"); }
    lka := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component PreferenceColor inherits HorizontalLayout {
    in property <string> label;
    /// rang de la couleur (Paramètres › Toile et couleurs)
    in property <int> index;
    in property <string> hex;
    in property <color> value;
    in property <length> row-width;
    callback edited(string);
    callback picked(color);
    width: root.row-width;
    height: max(28px, labeltext.preferred-height + 4px);
    spacing: 8px;
    labeltext := Text {
        width: max(60px, root.row-width - 144px);
        text: root.label; color: Theme.text; vertical-alignment: center; wrap: word-wrap;
    }
    Rectangle {
        width: 28px; height: 22px; background: root.value; border-width: 1px; border-color: Theme.field-border; border-radius: Theme.ctl-radius;
        HoverTip { y: parent.height; hovered: swatch.has-hover; text: @tr("Choisir une couleur"); }
        swatch := TouchArea { clicked => { ColorPop.show("appearance:" + root.index, root.value, self.absolute-position.x, self.absolute-position.y, self.height); } }
    }
    W10LineEdit { width: 100px; tip: root.label + " — " + @tr("Code couleur hexadécimal (RVB)."); text: root.hex; edited(t) => { root.edited(t); } }
}

component SetTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> intro;
    in property <length> text-w;
    padding-bottom: 10px;
    spacing: 6px;
    Text {
        text: root.title;
        font-size: Theme.font-size + 4px;
        font-weight: 700;
        color: Theme.text;
    }
    if root.intro != "": Text {
        width: root.text-w;
        text: root.intro;
        wrap: word-wrap;
        color: Theme.text-inactive;
    }
}

/// Paramètres : intitulé d'un réglage et son explication.
component SetHead inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    in property <length> text-w;
    padding-top: 8px;
    spacing: 2px;
    Text {
        width: root.text-w;
        text: root.title;
        font-weight: 600;
        color: Theme.text;
        wrap: word-wrap;
    }
    if root.hint != "": Text {
        width: root.text-w;
        text: root.hint;
        wrap: word-wrap;
        color: Theme.text-inactive;
        font-size: Theme.small-font-size;
    }
}

/// Paramètres : réglage Oui / Non (intitulé et explication à gauche, choix à droite).
component SetYesNo inherits HorizontalLayout {
    in property <bool> compact;
    in property <string> title;
    in property <string> hint;
    in property <length> text-w;
    in-out property <bool> value;
    callback changed(bool);
    width: root.text-w;
    horizontal-stretch: 0;
    padding-top: root.compact ? 2px : 8px;
    spacing: 10px;
    VerticalLayout {
        spacing: 2px;
        alignment: center;
        Text {
            width: max(0px, root.text-w - 122px);
            text: root.title;
            font-weight: 600;
            color: Theme.text;
            wrap: word-wrap;
        }
        if root.hint != "" && !root.compact: Text {
            width: max(0px, root.text-w - 122px);
            text: root.hint;
            wrap: word-wrap;
            color: Theme.text-inactive;
            font-size: Theme.small-font-size;
        }
    }
    VerticalLayout {
        width: 112px;
        horizontal-stretch: 0;
        alignment: center;
        Segmented {
            width: 112px;
            tip: root.hint != "" ? root.hint : root.title;
            options: [@tr("Non"), @tr("Oui")];
            index: root.value ? 1 : 0;
            selected(i) => {
                root.value = i == 1;
                root.changed(root.value);
            }
        }
    }
}

export component AppWindow inherits Window {
    // taille logique de la fenêtre (zoom de l'interface : lib.rs::fit_ui_zoom_size la corrige)
    out property <length> win-w: self.width;
    out property <length> win-h: self.height;
    callback ui-resized();
    changed height => { root.ui-resized(); }
    in-out property <[color]> appearance-colors: [#ffffff, #cccccc, #cfcfcf, #000000, #ffffff];
    in-out property <[string]> appearance-hex: ["#FFFFFF", "#CCCCCC", "#CFCFCF", "#000000", "#FFFFFF"];
    in-out property <float> checker-size: 8;
    in-out property <bool> workspace-custom;
    in property <image> checker-image;
    out property <float> checker-view-w: root.usable-width / 1px;
    out property <float> checker-view-h: root.usable-height / 1px;
    changed checker-view-w => { root.appearance-changed(); }
    changed checker-view-h => { root.appearance-changed(); }
    callback appearance-color-edited(int, string);
    callback appearance-color-picked(int, color);
    callback appearance-reset();
    callback appearance-changed();

    title: @tr("MasterPaint");
    // logo MasterPaint (le même que le site et les installateurs)
    icon: @image-url("../../desktop/icons/128x128.png");
    // bureau : fenêtre sans cadre, les menus et les onglets forment la barre de titre
    no-frame: root.custom-frame;
    preferred-width: 1600px;
    preferred-height: 1000px;
    min-width: 320px;
    min-height: 400px;
    default-font-family: Theme.font;
    default-font-size: Theme.font-size;
    background: root.platform-insets ? Theme.mob-accent-dark : Theme.workspace-bg;
    in property <bool> platform-insets;
    property <length> system-left: root.platform-insets ? root.safe-area-insets.left : 0px;
    property <length> system-top: root.platform-insets ? root.safe-area-insets.top : 0px;
    property <length> usable-width: max(1px, root.width - root.system-left - (root.platform-insets ? root.safe-area-insets.right : 0px));
    property <length> usable-height: max(1px, root.height - root.system-top - (root.platform-insets ? root.safe-area-insets.bottom : 0px));
    forward-focus: fs;

    // ---- état fourni par le Rust ----
    in property <image> canvas-image;
    in property <string> gpu-text;
    // barre de titre intégrée (bureau) : déplacer, réduire, agrandir, fermer
    in property <bool> custom-frame;
    /// version navigateur (sinon application de bureau)
    in property <bool> web;
    /// l'image active est un masque α : interface limitée aux niveaux de gris
    in property <bool> mask-doc;
    in property <string> app-version: "3.2.0";
    in property <bool> maximized;
    callback window-action(string);
    // fenêtre de choix façon Paint.NET (modifications non enregistrées, glisser-déposer, coller
    // une image plus grande que la toile) : boutons de commande, vignettes ; -1 = fermée
    in-out property <bool> show-task;
    in property <string> task-title;
    in property <string> task-intro;
    in property <string> task-info;
    in property <string> task-list-header;
    in property <[TaskCommand]> task-commands;
    in property <[TaskThumb]> task-thumbs;
    callback task-result(int);
    callback task-thumb(int);
    // fond du haut : image active floutée (voir header_background) sous un voile d'accent
    in property <image> header-bg;
    in property <[CanvasTile]> canvas-tiles: [];
    /// aucun projet ouvert (dernier onglet fermé) : toile masquée, palettes grisées
    in property <bool> no-doc;
    // largeur du bloc menus + barre rapide (les onglets commencent après) : 400 px au moins,
    // plus si les titres de menus ne tiennent pas
    property <length> menu-zone: max(456px, menu-row.preferred-width + 12px, 368px + bug-label-measure.preferred-width);
    // ---- mode Animation (frise, voir anim.slint / anim.rs) ----
    in property <bool> anim-on;
    in-out property <bool> anim-open: true;
    in property <bool> anim-playing;
    in property <int> anim-frame;
    in property <int> anim-duration: 24;
    in property <int> anim-fps: 12;
    in property <bool> anim-loop: true;
    in property <bool> anim-pingpong;
    in property <bool> anim-onion;
    in property <bool> anim-onion-all;
    in property <bool> anim-draw-step;
    in property <bool> anim-has-clip;
    in property <[AnimRow]> anim-rows;
    callback anim-action(string);
    callback anim-cell(int, int);
    callback anim-cell-op(string, int, int);
    callback anim-set(string, int);
    // pelure d'oignon : images voisines teintées, alpha déjà estompé
    in property <image> onion-image;
    in property <bool> onion-shown;
    // hauteur de la frise (0 : mode animation coupé ou frise réduite)
    property <length> anim-h: root.anim-on && root.anim-open ? (root.phone ? 150px : min(220px, max(118px, 58px + root.anim-rows.length * 22px))) : 0px;
    // contenu hors toile (pixels du document : position, taille)
    in property <image> outside-image;
    in property <float> outside-x;
    in property <float> outside-y;
    in property <float> outside-w;
    in property <float> outside-h;
    in property <image> wheel-image;
    in property <int> doc-width: 1280;
    in property <int> doc-height: 720;
    in-out property <float> zoom: 0.82;
    /// zone du document visible à l'écran (x0, y0, x1, y1 en pixels du document)
    out property <[float]> visible-rect: [-canvas.x / (root.zoom * 1px), -canvas.y / (root.zoom * 1px), (ws.width - canvas.x) / (root.zoom * 1px), (ws.height - canvas.y) / (root.zoom * 1px)];
    /// déplacement de la vue (aperçu d'effet limité à la zone visible)
    callback view-moved();
    changed pan-x => {
        root.view-moved();
    }
    changed pan-y => {
        root.view-moved();
    }
    /// zoom modifié : l'affichage réduit des grandes images est recomposé si son pas change
    callback zoom-changed();
    changed zoom => {
        root.zoom-changed();
    }
    in-out property <length> pan-x: 0;
    in-out property <length> pan-y: 0;
    in property <string> doc-title: @tr("Sans titre 1");
    in property <[HistoryItem]> history: [];
    in property <[MenuSpec]> menus: [];
    in property <[DocTab]> tabs: [];
    callback tab-clicked(int);
    callback tab-close(int);
    in property <int> history-index: 0;
    in property <[LayerRow]> layers: [];
    in property <int> active-layer: 0;
    in-out property <float> layer-opacity: 100;
    in-out property <int> layer-blend: 0;
    in-out property <string> current-tool: "tool-select";
    in property <string> tool-title: @tr("Sélection rectangulaire");
    in-out property <int> toolbar-mode <=> MenuState.toolbar-mode;  // 0 ruban, 1 classique Paint.NET
    in-out property <color> primary-color: #000000;
    in-out property <color> secondary-color: #ffffff;
    in property <bool> has-selection: false;
    in property <string> status-text: "";
    in property <string> cursor-text: @tr("0, 0 px");
    in property <string> selection-text: "";
    in property <string> overlay-path: "";
    in property <string> pixel-grid-path: "";
    /// zone (pixels du document) couverte par la grille de pixels : la partie visible
    in property <int> grid-x;
    in property <int> grid-y;
    in property <int> grid-w;
    in property <int> grid-h;
    // poignées des outils de transformation (coordonnées document)
    in property <[Handle]> handles: [];
    // recadrage interactif : cadre (pixels du document), panneau des rapports
    in property <bool> crop-active;
    in property <float> crop-x;
    in property <float> crop-y;
    in property <float> crop-w;
    in property <float> crop-h;
    in-out property <bool> show-crop;
    in-out property <int> crop-ratio: -1;
    callback crop-action(string);
    in-out property <bool> rotate-layer;
    /// portée des effets : 0 sélection (calque actif), 1 calque actif entier, 2 tous les calques
    in-out property <int> effect-scope: 0;
    callback effect-scope-changed();
    // Aperçu de la toile en 1:1 (fenêtre)
    in-out property <bool> show-live;
    in property <image> live-image;
    // Visionneuse d'icônes
    in-out property <bool> show-icons;
    in property <[IconEntry]> icon-entries;
    // Calque actif : position et taille
    in-out property <bool> show-bounds;
    in-out property <string> bd-x: "0";
    in-out property <string> bd-y: "0";
    in-out property <string> bd-w: "1";
    in-out property <string> bd-h: "1";
    in-out property <bool> bd-lock: true;
    in property <int> bd-orig-w: 1;
    in property <int> bd-orig-h: 1;
    callback bounds-apply(string, string, string, string);
    /// image vide (icône du sprite absente)
    property <image> no-image;
    // forme vivante (lib.rs, shape_edit) : un réglage du ruban ou la couleur principale changent
    callback shape-opts-changed();
    property <string> shape-sig: ToolOpts.shape-kind + "|" + ToolOpts.shape-style + "|" + ToolOpts.line-width + "|" + ToolOpts.corner-radius
        + "|" + ToolOpts.shape-sides + "|" + ToolOpts.star-points + "|" + root.primary-color.red + "," + root.primary-color.green + ","
        + root.primary-color.blue + "," + root.primary-color.alpha + "|" + root.secondary-color.red + "," + root.secondary-color.green + ","
        + root.secondary-color.blue + "," + root.secondary-color.alpha + "|" + ToolOpts.line-mode + "|" + ToolOpts.cap-start + "|"
        + ToolOpts.cap-end + "|" + ToolOpts.line-dash;
    changed shape-sig => { root.shape-opts-changed(); }
    // curseur de l'outil actif sur la toile (croix + icône, rendu par lib.rs::tool_cursor)
    in property <image> tool-cursor;
    in property <bool> tool-cursor-on;
    // Exporter (comme la version web) : format, nom, qualité JPEG, profondeur, périmètre .illu
    in-out property <bool> show-export;
    in-out property <string> ex-name;
    in property <int> ex-tabs: 1;
    in-out property <bool> ex-more;
    in-out property <int> ex-fmt: 0;
    in-out property <float> ex-quality: 90;
    in-out property <int> ex-bits: 4;
    in-out property <bool> ex-all;
    callback export-run(string, string, int, string, bool);
    // Bordure d'image : position, marges (uniformes ou par côté), couleur, destination
    in-out property <bool> show-border;
    in property <int> bd-doc-w;
    in property <int> bd-doc-h;
    in-out property <bool> bd-outside: true;
    in-out property <bool> bd-uniform: true;
    in-out property <string> bd-all: "12";
    in-out property <string> bd-t: "12";
    in-out property <string> bd-l: "12";
    in-out property <string> bd-r: "12";
    in-out property <string> bd-b: "12";
    in-out property <bool> bd-secondary;
    in-out property <bool> bd-new-layer: true;
    callback border-apply();
    // Paramètres aimantation : grille 1/N, force d'attraction, grille visible, repères magenta
    in-out property <bool> show-snap;
    in-out property <float> set-snap-div: 48;
    in-out property <float> set-snap-thresh: 50;
    in-out property <bool> set-snap-always;
    in-out property <bool> set-snap-guides: true;
    in property <string> snap-grid-path: "";
    in property <float> snap-guide-x: -1;
    in property <float> snap-guide-y: -1;
    callback snap-changed();
    // Supprimer le fond (IA) : réglages puis progression
    in-out property <bool> show-rmbg;
    in-out property <int> rmbg-model: 0;
    in-out property <float> rmbg-feather: 0;
    in-out property <bool> rmbg-busy;
    in property <float> rmbg-progress;
    in property <string> rmbg-text;
    in property <string> rmbg-warn;
    callback rmbg-start();
    callback rmbg-cancel();
    callback snap-ok();
    callback snap-cancel();
    in property <int> canvas-cursor: 0;  // 0 croix, 1 déplacer, 2 poignée, 3 rotation
    in property <bool> rotate-hint;
    // zone de saisie de l'outil Texte (coordonnées document)
    in-out property <bool> text-active;
    // incrémenté à chaque nouvelle saisie : la zone de texte reprend le focus
    in-out property <int> text-serial;
    in property <float> text-x;
    in property <float> text-y;
    callback text-move(float, float);  // nouvelle position du texte (coordonnées document)
    in-out property <string> text-value;
    in property <float> text-w: 40;
    in property <float> text-h: 32;
    callback text-edited(string);

    callback menu-action(string, string);
    callback effect-field-changed(int, float, string);
    /// couleur choisie dans la fenêtre surgissante d'un champ couleur d'effet
    callback effect-color-picked(int, color);
    callback effect-ok();
    callback effect-cancel();
    callback effect-reset();
    callback quick-action(string);
    callback tool-selected(string);
    callback wheel-picked(length, length, length, bool);
    callback color-component(int, float);
    callback color-hex-edited(string);
    /// couleurs favorites (Paramètres : favColors) ; fav-action("add" | "remove", index)
    in-out property <[color]> fav-colors: [];
    callback fav-action(string, int);
    /// 8 dernières couleurs peintes (Paramètres : recentColors), la plus récente en tête
    in-out property <[color]> recent-colors: [];
    /// fenêtre Couleurs : la roue, le carré et les curseurs modifient la secondaire
    in-out property <bool> color-edit-secondary;
    changed color-edit-secondary => {
        // champs RVB / TSV / hexa relus pour la couleur choisie
        root.primary-changed();
    }
    // roue / carré retenu dans les Paramètres (colorSquare)
    changed colors-grid => {
        root.settings-changed();
    }
    /// (teinte 0..360, saturation 0..1, valeur 0..1, secondaire) : carré S × V, barres de teinte
    /// et de valeur (alpha gardé)
    callback hsv-picked(float, float, float, bool);
    /// palettes : géométrie enregistrée (Paramètres : palettes) ; palette-geometry(nom, x, y, w, h)
    /// à la fin d'un déplacement ou d'un redimensionnement
    in-out property <PalGeom> geom-tools;
    in-out property <PalGeom> geom-history;
    in-out property <PalGeom> geom-colors;
    in-out property <PalGeom> geom-layers;
    callback palette-geometry(string, length, length, length, length);
    /// calque actif qui refuse les pixels (MenuState.layer-block, tenu par le Rust) : les outils
    /// qui peignent / déforment sont grisés (et les entrées de menu, voir MenuRow)
    property <string> layer-block: MenuState.layer-block;
    pure function tool-blocked(id: string) -> bool {
        // calque SVG (texte / formes) : Formes, Ligne et Pot de peinture y ajoutent ou recolorent
        // des objets, seuls les outils qui peignent des pixels sont grisés
        let shapes = id == "tool-fill" || id == "tool-shapes-family" || id == "tool-round-3" || id == "tool-line";
        return root.layer-block != "" && !(shapes && root.layer-block == "calque texte")
            && (id == "tool-brush" || id == "tool-pencil" || id == "tool-eraser" || id == "tool-gradient"
            || shapes || id == "tool-deform" || id == "tool-warp-4"
            || (id == "tool-move" && root.layer-block == "verrouillé"));
    }
    pure function tool-blocked-tip(title: string) -> string {
        return title + (root.layer-block == "calque texte" ? @tr(" — indisponible sur un calque SVG (Calques › Pixelliser le calque)")
            : root.layer-block == "verrouillé" ? @tr(" — calque verrouillé (cliquer le cadenas pour le déverrouiller)")
            : @tr(" — choisir un calque (pas un dossier)"));
    }
    callback primary-changed();
    in property <image> color-grid-image;
    in-out property <bool> colors-expanded;
    in-out property <bool> colors-grid;
    in property <[float]> color-comps: [0, 0, 0, 255, 0, 0, 0];
    in property <string> color-hex: "000000";
    /// espace de couleur du projet actif : nuancier imposé, nom de la couleur, barre d'état
    in property <[color]> mode-palette: [];
    in property <string> color-info;
    /// RAL le plus proche de la couleur principale (ruban de la pipette)
    in property <string> color-ral;
    in property <string> mode-text: @tr("Pixel");
    // mode de travail du projet après l'espace de couleur : « · SVG », « · Animation »…
    in property <string> work-mode;
    callback secondary-changed();
    changed primary-color => {
        root.primary-changed();
    }
    changed secondary-color => {
        root.secondary-changed();
    }
    callback apply-theme(bool, color);
    callback history-picked(int);
    in property <bool> native-touch: false;
    callback native-pinch(bool);
    callback canvas-pointer(int, float, float, int, bool, bool, bool);
    callback canvas-double-click();
    callback key-pressed(string, bool, bool, bool) -> bool;
    callback layer-clicked(int);
    callback layer-visibility(int, bool);
    callback layer-action(string);
    callback layer-props(float, int);
    callback layer-drag(int, int);  // position affichée de départ → d'arrivée
    callback layer-alpha(int, bool);  // ouvrir / créer le masque α (false) ou le supprimer (true)
    callback layer-filter-toggle(int);
    callback applied-fx-open(int);
    callback applied-fx-action(int, string);
    callback applied-fx-value(int, bool, float, bool);
    in-out property <bool> show-applied-fx;
    in property <[AppliedFxRow]> applied-fx;
    in property <string> applied-fx-layer;
    in-out property <string> applied-fx-uid;
    in-out property <bool> gray-palette;
    in-out property <color> gray-original-primary;
    in-out property <color> gray-original-secondary;
    in property <int> applied-fx-mode;
    in property <bool> applied-fx-zone;
    callback applied-fx-scope(int);
    callback applied-fx-zone-toggle();
    callback layer-rename(int);
    callback layer-toggle(int, string);  // "lock", "collapse" (dossier), "text-fx" (effets du texte)
    // calque texte : effets non destructifs (fenêtre « Effets du calque texte »)
    in property <[TextFxRow]> text-fx: [];
    in-out property <bool> show-text-fx: false;
    callback text-fx-action(int, string);  // "toggle", "up", "down", "delete"
    // fenêtre « Courbes » : courbe, points et histogramme en coordonnées 0..255 (y vers le haut)
    in-out property <bool> show-curves;
    in property <bool> curves-dynamic-edit;
    in property <int> curves-channel;
    in property <string> curves-path;
    in property <string> curves-hist;
    in property <[Handle]> curves-points: [];
    callback curves-pointer(int, float, float, bool);  // 0 appui, 1 glisser, 2 relâcher ; x, y ; clic droit
    callback curves-action(string, int);  // channel / reset / ok / cancel
    property <int> drag-from: -1;
    property <int> drag-to: -1;
    callback new-image(string, string, int, int);  // largeur, hauteur, fond, espace de couleur
    /// largeur, hauteur, zone de travail ?, ancrage (0..8 : haut-gauche … bas-droite)
    callback resize-image(string, string, bool, int);
    // Redimensionner / Taille de la zone de travail : taille d'origine, proportions, préréglages
    in property <int> rs-orig-w: 1280;
    in property <int> rs-orig-h: 720;
    in property <int> rs-layers: 1;
    in property <[SizePreset]> rs-presets;
    in property <[string]> rs-preset-labels;
    in-out property <bool> rs-keep: true;
    in-out property <bool> rs-by-pct;
    in-out property <string> rs-pct: "100";
    in-out property <int> rs-anchor: 4;
    callback download(string);

    // ---- Mode Photo Pro (pellicule, réglages Camera Raw par photo) ----
    in-out property <bool> pm-open;
    in property <image> pm-image;
    in property <int> pm-img-w: 1;
    in property <int> pm-img-h: 1;
    in property <int> pm-full-w: 1;
    in property <[PmThumb]> pm-photos: [];
    in property <[float]> pm-values: [];
    in property <[string]> pm-presets: [];
    in property <int> pm-preset;
    in property <bool> pm-fx-off;
    in property <string> pm-info;
    in property <bool> pm-busy;
    // zone visible rendue en haute résolution (coordonnées 0..1 de l'image), posée sur l'aperçu
    in property <image> pm-hq-image;
    in property <float> pm-hq-x0;
    in property <float> pm-hq-y0;
    in property <float> pm-hq-x1: 1;
    in property <float> pm-hq-y1: 1;
    in property <bool> pm-hq-shown;
    /// zone visible de la photo (0..1) et largeur affichée de l'image entière (pixels logiques)
    callback pm-view(float, float, float, float, float);
    // chargement d'un fichier lourd en tâche de fond (RAW, grande image) : fenêtre de progression
    in property <bool> loading;
    // menu contextuel (clic droit) : entrées choisies par l'application selon l'endroit
    in property <[MenuItemSpec]> ctx-items;
    in-out property <bool> ctx-open;
    in property <length> ctx-x;
    in property <length> ctx-y;
    /// retourne vrai si un menu a été ouvert (le clic n'est alors pas transmis aux outils)
    callback context-request(string, int, length, length, bool) -> bool;
    in property <string> load-title;
    in property <string> load-detail;
    in property <float> load-progress;
    callback pm-action(string);
    callback pm-select(int);
    callback pm-remove(int);
    callback pm-set(int, float);
    callback pm-preset-chosen(int);

    // ---- fenêtres volantes et dialogues ----
    in-out property <bool> show-tools <=> MenuState.tools;
    in-out property <bool> show-colors <=> MenuState.colors;
    in-out property <bool> show-layers <=> MenuState.layers;
    in-out property <bool> show-history <=> MenuState.history;
    in-out property <bool> show-settings: false;
    in-out property <bool> show-shortcuts: false;
    // onglet de la fenêtre Aide et raccourcis (0 raccourcis, 1 ƒ, 2 α, 3 texte, 4 SVG)
    in-out property <int> info-tab: 0;
    /// fenêtre de bienvenue (deux premières ouvertures : `welcome-count`, sauf `welcome-hide`)
    in-out property <bool> show-welcome: false;
    in-out property <int> welcome-count: 0;
    in-out property <bool> welcome-hide: false;
    in-out property <bool> show-changelog: false;
    in-out property <bool> show-contact: false;
    in-out property <int> contact-kind: 0;
    in-out property <string> contact-message;
    in-out property <string> contact-info;
    in property <string> contact-status;
    callback contact-send(int, string, string);
    // fenêtre d'erreur : contexte, message, détails (appareil, journal) ; « Signaler l'erreur »
    in-out property <bool> show-error;
    in property <string> error-context;
    in property <string> error-message;
    in property <string> error-details;
    in-out property <bool> error-more;
    in property <string> changelog-text;
    in-out property <int> set-language: 0;
    /// langue choisie (Paramètres › Apparence) : traduction appliquée tout de suite
    callback language-chosen(int);
    in-out property <int> set-layout <=> MenuState.layout;
    /// interface tactile automatique sous 600 px (« Non » ou disposition choisie sur un écran
    /// étroit : la disposition Paint.NET / Photoshop est gardée)
    in-out property <bool> set-layout-auto: true;
    in-out property <int> set-theme-style: 0;
    in-out property <int> settings-page: 0;
    in-out property <float> set-ui-zoom: 100;
    in-out property <int> set-default-zoom: 0;
    in-out property <int> set-default-tool: 0;
    in-out property <bool> set-autosave: true;
    in-out property <bool> set-use-gpu: true;
    in-out property <int> set-paste-mode: 0;
    in-out property <bool> set-paste-ask: true;
    // apparence (comme « Effets Windows 11 » et « Aperçu de l'onglet » de la version web)
    in-out property <bool> set-rounded: true;
    in-out property <bool> set-glass: true;
    in-out property <bool> set-title-transparent: true;
    in-out property <bool> set-title-blurred: false;
    in-out property <bool> set-header-preview: true;
    /// image zoomée lissée (sinon pixels nets au-delà de 200 %)
    in-out property <bool> set-zoom-smooth: false;
    /// Paramètres › Infos techniques
    in property <string> tech-info;
    in property <[string]> tool-titles: [];
    callback apply-ui-zoom(float);
    /// Paramètres : réglages d'une page remis à leurs valeurs d'origine (0 apparence, 1 toile et
    /// outils, 2 édition, 3 performances, 4 données)
    callback settings-reset(int);
    in-out property <int> set-wheel-mode: 0;  // 0 zoom, 1 défilement
    in-out property <float> set-history-max: 40;
    in-out property <float> set-autosave-min: 0;
    in property <[{keys: string, what: string}]> shortcut-list: [];
    callback settings-changed();
    in-out property <bool> show-new: false;
    in-out property <bool> show-resize: false;
    in-out property <bool> resize-canvas-mode: false;
    in-out property <bool> show-download: false;
    in-out property <bool> show-rotate: false;
    in-out property <bool> show-prompt: false;
    in property <string> prompt-title;
    in property <string> prompt-label;
    in property <string> prompt-kind;
    in-out property <string> prompt-value: "0";
    callback prompt-ok(string, string);
    in-out property <bool> show-effect: false;
    in property <bool> effect-dynamic-layer;
    in property <bool> effect-dynamic-edit;
    callback effect-remove();
    in property <string> effect-title;
    in property <[EffectField]> effect-fields: [];
    in property <string> effect-info;
    in-out property <string> dlg-w: "1280";
    in-out property <string> dlg-h: "720";
    // Nouvelle image : proportions conservées (largeur / hauteur retenue), projet animé
    in-out property <bool> new-keep: false;
    property <float> new-ratio: 16 / 9;
    // type du nouveau projet : 0 pixel, 1 SVG, 2 animation pixel, 3 animation SVG
    in-out property <int> new-kind: 0;
    in-out property <int> dlg-bg: 0;
    in-out property <int> dlg-mode: 0;
    property <float> top-z: 10;
    property <float> z-tools: 1;
    property <float> z-colors: 2;
    property <float> z-layers: 3;
    property <float> z-history: 4;
    property <float> z-dialog: 50;

    // mode téléphone : choisi dans les Paramètres, ou automatique sur un écran étroit.
    // Même disposition que la version web (ui/phone.slint) : barre du haut, capsule annuler /
    // rétablir et ruban flottants, bande d'outils, pilules, barre du bas, panneaux, tiroir ☰.
    out property <bool> phone: root.set-layout == 2 || (root.set-layout-auto && root.usable-width < 600px);
    // passage téléphone ↔ bureau (largeur, disposition) : palettes fermées / rouvertes. Au
    // démarrage du bureau, la fenêtre a d'abord une largeur nulle (téléphone) : elles se
    // rouvrent dès qu'elle prend sa taille.
    changed phone => {
        PhoneDock.on = root.phone;
        PhoneDock.inset = root.strip-height;
        PhoneDock.max-h = root.phone ? root.mob-sheet-max : 100000px;
        MenuState.phone = root.phone;
        root.show-tools = !root.phone;
        root.show-colors = !root.phone;
        root.show-layers = !root.phone;
        root.show-history = !root.phone;
    }
    // tiroir ☰ ouvert ; menu et sous-menu dépliés dans le tiroir
    in-out property <bool> phone-menu;
    property <int> drawer-open: -1;
    property <int> pm-sub: -1;
    // panneau de menu ouvert depuis la barre du bas (« adjust », « deform », « effects »)
    in-out property <string> phone-sheet;
    in property <[SheetRow]> phone-sheet-rows: [];
    callback phone-sheet-open(string);
    in-out property <bool> phone-tools-open: true;
    // barre du bas : icônes seules quand une fenêtre d'effet est ouverte
    property <length> strip-height: !root.phone ? 0px : root.show-effect ? 52px : 66px;
    // rangées flottantes du haut (coordonnées de la fenêtre) : capsule + ruban, bande d'outils
    property <length> mob-row-y: root.top-height + 4px;
    property <length> mob-ribbon-h: root.classic ? 36px : 84px;
    property <length> mob-tools-y: root.mob-row-y + root.mob-ribbon-h + 6px;
    // panneau du bas ouvert : les pilules s'effacent
    property <bool> mob-sheet-open: root.show-colors || root.show-layers || root.show-history || root.phone-sheet != "" || root.show-effect;
    // fenêtre par-dessus tout (paramètres, nouvelle image…) : le ruban flottant passe dessous
    property <bool> modal-open: root.show-settings || root.show-new || root.show-export || root.show-border || root.show-resize || root.show-rotate || root.show-prompt
        || root.show-changelog || root.show-shortcuts || root.show-contact || root.show-download || root.show-task
        || root.show-curves || root.show-welcome || root.show-applied-fx;
    // panneaux du bas (téléphone) : jamais plus hauts que l'espace sous le ruban flottant et la
    // bande d'outils (ils passaient dessous) ; la barre du bas flotte sur la toile, ils se posent
    // au-dessus d'elle
    property <length> mob-sheet-max: max(140px, ws.height - root.strip-height - root.view-top - 8px);
    changed mob-sheet-max => {
        PhoneDock.max-h = root.phone ? root.mob-sheet-max : 100000px;
    }
    changed strip-height => {
        PhoneDock.inset = root.strip-height;
    }
    // panneau du bas (mode téléphone) : hauteur commune Calques / Historique
    property <length> sheet-h: min(min(ws.height * 0.62, 400px), root.mob-sheet-max);
    // fenêtre d'effet en panneau du bas (téléphone) : hauteur approchée, pour cadrer la toile au-dessus
    property <length> effect-sheet-h: min(min(root.effect-fields.length * 27px + 80px, ws.height * 0.55), root.mob-sheet-max);
    // disposition Photoshop : palettes ancrées en colonnes (outils à gauche, le reste à droite)
    property <bool> docked: root.set-layout == 1 && !root.phone;
    // règles affichées : bande de 18 px en haut et à gauche que les palettes évitent
    property <length> rul-off: ToolOpts.rulers ? 18px : 0px;
    property <length> dock-left: root.docked && root.show-tools ? 60px : 0px;
    property <length> dock-right: root.docked && (root.show-colors || root.show-layers || root.show-history) ? 262px : 0px;
    /// largeur des palettes Calques et Historique (volantes) : la barre de boutons des calques
    /// y tient avec des marges égales
    property <length> side-pal-w: 230px;
    // hauteur de la fenêtre Couleurs ancrée : celle que demande son contenu à cette largeur, ou
    // celle choisie au séparateur (ps-h-colors)
    // jamais sous la hauteur de son contenu (roue, palette) : rien ne déborde sur la voisine
    property <length> dock-colors-h: root.show-colors
        ? max(root.colors-want-h, min(root.ps-h-colors > 0px ? root.ps-h-colors : root.colors-want-h, ws.height - root.ps-hist-fixed - root.ps-tail-min))
        : 0px;
    /// hauteur demandée par la fenêtre Couleurs (ColorsPanel.wanted-height, titre compris)
    in-out property <length> colors-want-h: 260px;
    property <length> dock-history-h: root.show-history
        ? clamp(root.ps-h-history, 70px, max(70px, ws.height - (root.show-colors ? root.colors-want-h : 0px) - (root.show-layers ? root.ps-layers-min : 0px)))
        : 0px;
    // zones de sécurité de la colonne : Calques garde de quoi montrer sa liste et ses boutons,
    // Historique quelques lignes ; une palette ne peut pas en écraser une autre
    property <length> ps-layers-min: 170px;
    property <length> ps-hist-fixed: root.show-history && root.show-layers ? root.dock-history-h : 0px;
    property <length> ps-tail-min: root.show-layers ? root.ps-layers-min : root.show-history ? 70px : 0px;
    // ---- colonne de droite (Photoshop) : ordre et hauteurs réglables, enregistrés (psDock) ----
    // place de chaque palette dans la colonne (0 = en haut) : 0 Couleurs, 1 Historique, 2 Calques
    in-out property <int> ps-pos-colors: 0;
    in-out property <int> ps-pos-history: 1;
    in-out property <int> ps-pos-layers: 2;
    /// hauteurs choisies au séparateur (Couleurs : 0 = hauteur demandée par son contenu) ; la
    /// dernière palette « de remplissage » (Calques, sinon Historique, sinon Couleurs) prend le reste
    in-out property <length> ps-h-colors: 0px;
    in-out property <length> ps-h-history: 150px;
    // hauteurs effectives dans la colonne
    property <length> eff-colors-h: !root.show-colors ? 0px : root.show-layers || root.show-history ? root.dock-colors-h : ws.height;
    property <length> eff-history-h: !root.show-history ? 0px : root.show-layers ? root.dock-history-h : max(0px, ws.height - root.dock-colors-h);
    property <length> eff-layers-h: !root.show-layers ? 0px : max(0px, ws.height - root.dock-colors-h - root.dock-history-h);
    property <int> ps-filler: root.show-layers ? 2 : root.show-history ? 1 : 0;
    // palette glissée (-1 : aucune) et position du pointeur
    property <int> ps-drag-id: -1;
    property <length> ps-drag-y;
    pure function ps-pos(id: int) -> int {
        return id == 0 ? root.ps-pos-colors : id == 1 ? root.ps-pos-history : root.ps-pos-layers;
    }
    pure function ps-hh(id: int) -> length {
        return id == 0 ? root.eff-colors-h : id == 1 ? root.eff-history-h : root.eff-layers-h;
    }
    pure function ps-shown(id: int) -> bool {
        return id == 0 ? root.show-colors : id == 1 ? root.show-history : root.show-layers;
    }
    /// haut de la palette placée en `pos` : somme des palettes au-dessus
    pure function ps-y(pos: int) -> length {
        return (root.ps-pos-colors < pos ? root.eff-colors-h : 0px) + (root.ps-pos-history < pos ? root.eff-history-h : 0px)
            + (root.ps-pos-layers < pos ? root.eff-layers-h : 0px);
    }
    pure function ps-top(id: int) -> length {
        return root.ps-y(root.ps-pos(id));
    }
    pure function ps-center(id: int) -> length {
        return root.ps-top(id) + root.ps-hh(id) / 2;
    }
    // les deux autres palettes, dans l'ordre actuel de la colonne (a au-dessus de b)
    pure function ps-other-a(id: int) -> int {
        return root.ps-pos(id == 0 ? 1 : 0) < root.ps-pos(id == 2 ? 1 : 2) ? (id == 0 ? 1 : 0) : (id == 2 ? 1 : 2);
    }
    pure function ps-other-b(id: int) -> int {
        return root.ps-other-a(id) == (id == 0 ? 1 : 0) ? (id == 2 ? 1 : 2) : (id == 0 ? 1 : 0);
    }
    /// rang d'insertion (0..2) de la palette glissée parmi les deux autres
    pure function ps-slot(id: int, y: length) -> int {
        return (root.ps-shown(root.ps-other-a(id)) && root.ps-center(root.ps-other-a(id)) < y ? 1 : 0)
            + (root.ps-shown(root.ps-other-b(id)) && root.ps-center(root.ps-other-b(id)) < y ? 1 : 0);
    }
    /// repère d'insertion : bord entre deux palettes visibles
    pure function ps-marker-y(id: int, y: length) -> length {
        return root.ps-slot(id, y) == 0 ? 0px
            : root.ps-slot(id, y) == 1 ? (root.ps-shown(root.ps-other-a(id)) && root.ps-center(root.ps-other-a(id)) < y
                ? root.ps-top(root.ps-other-a(id)) + root.ps-hh(root.ps-other-a(id)) : root.ps-top(root.ps-other-b(id)) + root.ps-hh(root.ps-other-b(id)))
            : max(root.ps-top(root.ps-other-a(id)) + root.ps-hh(root.ps-other-a(id)), root.ps-top(root.ps-other-b(id)) + root.ps-hh(root.ps-other-b(id)));
    }
    function ps-set(id: int, p: int) {
        if (id == 0) {
            root.ps-pos-colors = p;
        } else if (id == 1) {
            root.ps-pos-history = p;
        } else {
            root.ps-pos-layers = p;
        }
    }
    /// relâchement d'une palette glissée : nouvel ordre de la colonne, enregistré
    function ps-drop(id: int, y: length) {
        let a = root.ps-other-a(id);
        let b = root.ps-other-b(id);
        let k = root.ps-slot(id, y);
        root.ps-set(a, k == 0 ? 1 : 0);
        root.ps-set(b, k == 2 ? 1 : 2);
        root.ps-set(id, k);
        root.ps-drag-id = -1;
        root.settings-changed();
    }
    // séparateurs de hauteur : palette réglable (Couleurs / Historique) et ses voisines
    pure function ps-below-any(id: int) -> bool {
        return (id != 0 && root.show-colors && root.ps-pos-colors > root.ps-pos(id))
            || (id != 1 && root.show-history && root.ps-pos-history > root.ps-pos(id))
            || (id != 2 && root.show-layers && root.ps-pos-layers > root.ps-pos(id));
    }
    /// la palette juste au-dessus de `id` est celle de remplissage (le séparateur du haut règle `id`)
    pure function ps-filler-above(id: int) -> bool {
        return root.ps-filler != id && root.ps-pos(root.ps-filler) < root.ps-pos(id)
            && !(root.ps-shown(3 - id - root.ps-filler) && 3 - id - root.ps-filler != root.ps-filler
                && root.ps-pos(root.ps-filler) < root.ps-pos(3 - id - root.ps-filler) && root.ps-pos(3 - id - root.ps-filler) < root.ps-pos(id));
    }
    /// nouvelle hauteur d'une palette réglable, bornée : Couleurs pas plus petite que son
    /// contenu, Historique au moins 70 px, la palette de remplissage garde sa zone de sécurité
    function ps-resize(id: int, dh: length) {
        if (id == 0) {
            root.ps-h-colors = clamp(root.dock-colors-h + dh, root.colors-want-h, max(root.colors-want-h, ws.height - root.ps-hist-fixed - root.ps-tail-min));
        } else if (id == 1) {
            root.ps-h-history = clamp(root.dock-history-h + dh, 70px, max(70px, ws.height - root.dock-colors-h - (root.show-layers ? root.ps-layers-min : 0px)));
        }
    }
    // zone visible de la toile : entre les colonnes (Photoshop) ; en téléphone, sous les rangées
    // flottantes et au-dessus des pilules (ou de la fenêtre d'effet)
    property <length> view-w: ws.width - root.dock-left - root.dock-right;
    property <length> view-top: root.phone ? root.mob-tools-y + 40px - ws.y : 0px;
    // téléphone : toile cadrée entre le ruban et la fenêtre posée en bas
    property <length> view-bottom: !root.phone ? ws.height - root.anim-h : root.show-effect ? ws.height - root.strip-height - root.effect-sheet-h - 12px
        : root.modal-open || root.show-crop ? ws.height - PhoneDock.inset - PhoneDock.sheet-h - 8px : ws.height - root.strip-height - 50px - root.anim-h;
    property <length> view-h: max(40px, root.view-bottom - root.view-top);

    // menu déroulant ouvert (index dans menus), sa position, sous-menu ouvert
    in-out property <int> open-menu: -1;
    property <length> menu-x;
    property <int> open-sub: -1;
    property <length> sub-y;
    // zone de sécurité des sous-menus (comme Windows) : changement différé quand un sous-menu
    // est ouvert, annulé si la souris atteint le sous-menu
    property <int> pending-sub: -1;
    property <length> pending-sub-y;
    property <bool> sub-switch-pending;
    property <length> top-height: root.phone ? 48px : 52px;
    // téléphone : le ruban flotte au-dessus de la toile (pas de bande réservée)
    property <length> bar-height: root.phone ? 0px : toolbar-mode == 0 ? 88px : root.classic-wrap ? 64px : 32px;
    // fenêtre étroite : ruban MasterPaint resserré (libellés masqués), barre Paint.NET sur deux
    // lignes (Édition, Ajustements et Affichage passent à la ligne)
    property <bool> classic-wrap: toolbar-mode == 1 && root.usable-width < 1100px;
    changed width => {
        RibbonFit.tight = toolbar-mode == 0 && root.usable-width < 1180px;
        RibbonFit.narrow = root.usable-width < 900px;
        root.ui-resized();
    }
    changed toolbar-mode => {
        RibbonFit.tight = toolbar-mode == 0 && root.usable-width < 1180px;
    }
    init => {
        PhoneDock.on = root.phone;
        PhoneDock.inset = root.strip-height;
        PhoneDock.max-h = root.phone ? root.mob-sheet-max : 100000px;
        MenuState.phone = root.phone;
        RibbonFit.tight = toolbar-mode == 0 && root.usable-width < 1180px;
        RibbonFit.narrow = root.usable-width < 900px;
    }
    property <length> status-height: root.phone ? 0px : 26px;
    property <bool> classic: toolbar-mode == 1;
    property <bool> space-down;
    property <bool> panning;
    property <length> pan-sx;
    property <length> pan-sy;

    // catégories d'outils (choix des groupes du ruban, comme la version web)
    pure function is-sel-tool(t: string) -> bool {
        return t == "tool-select" || t == "tool-direct-select" || t == "tool-poly-lasso" || t == "tool-magnetic-lasso"
            || t == "btn-deselect" || t == "tool-warp-4" || t == "tool-deform" || t == "tool-move";
    }
    pure function is-brush(t: string) -> bool {
        return t == "tool-brush" || t == "tool-eraser";
    }
    pure function is-shape(t: string) -> bool {
        return t == "tool-shapes-family" || t == "tool-round-3" || t == "tool-line";
    }

    /// Zoom autour d'un point du document (outil Zoom, molette).
    public function zoom-doc(factor: float, dx: float, dy: float) {
        let nz = clamp(root.zoom * factor, 0.05, 32);
        let cx = (root.view-w - root.doc-width * root.zoom * 1px) / 2 + root.pan-x;
        let cy = (root.view-h - root.doc-height * root.zoom * 1px) / 2 + root.pan-y;
        let sx = cx + dx * root.zoom * 1px;
        let sy = cy + dy * root.zoom * 1px;
        root.zoom = nz;
        root.pan-x = sx - dx * nz * 1px - (root.view-w - root.doc-width * nz * 1px) / 2;
        root.pan-y = sy - dy * nz * 1px - (root.view-h - root.doc-height * nz * 1px) / 2;
    }

    public function zoom-fit() {
        if (ws.width < 100px || ws.height < 100px) {
            return;
        }
        let margin = root.phone ? 20px : 80px;
        root.zoom = max(0.05, min((root.view-w - margin) / (root.doc-width * 1px), (root.view-h - margin) / (root.doc-height * 1px), 1));
        root.pan-x = 0;
        root.pan-y = 0;
    }

    /// Pincement à deux doigts (web) : zoom autour du point (sx, sy) de la fenêtre, puis décalage.
    public function pinch(factor: float, sx: length, sy: length, dx: length, dy: length) {
        root.zoom-doc(factor, (sx - canvas.x) / (root.zoom * 1px), (sy - ws.y - canvas.y) / (root.zoom * 1px));
        root.pan-x += dx;
        root.pan-y += dy;
    }

    /// Zoom à l'ouverture d'une image (Paramètres › Toile et outils).
    public function zoom-open() {
        if (root.set-default-zoom == 1) {
            root.zoom = 1;
            root.pan-x = 0;
            root.pan-y = 0;
        } else {
            root.zoom-fit();
        }
    }

    public function focus-canvas() {
        fs.focus();
    }

    /// Boutons du mode téléphone (barre du bas, pilules, tiroir) : un seul panneau à la fois.
    function phone-do(a: string) {
        if (a == "colors" || a == "layers" || a == "history") {
            let c = a == "colors" && !root.show-colors;
            let l = a == "layers" && !root.show-layers;
            let h = a == "history" && !root.show-history;
            root.phone-sheet = "";
            root.show-colors = c;
            root.show-layers = l;
            root.show-history = h;
            return;
        }
        root.show-colors = false;
        root.show-layers = false;
        root.show-history = false;
        if (a == "adjust" || a == "deform" || a == "effects") {
            if (root.phone-sheet == a) {
                root.phone-sheet = "";
            } else {
                root.phone-sheet-open(a);
                root.phone-sheet = a;
            }
            return;
        }
        root.phone-sheet = "";
        if (a == "fit") {
            root.zoom-fit();
        } else if (a == "rotate") {
            root.show-rotate = true;
        } else if (a == "new") {
            root.menu-action("fn:showNewProjectDialog()", @tr("Nouveau…"));
        } else if (a == "open") {
            root.menu-action("fn:illuTriggerFileImport()", @tr("Ouvrir"));
        } else if (a == "export") {
            root.menu-action("fn:WorkspaceIO&&WorkspaceIO.showExportDialog()", @tr("Exporter…"));
        } else if (a == "gallery") {
            root.menu-action("fn:FilterManager.showInstantFilterGallery()", @tr("Galerie de Filtres…"));
        } else if (a == "crop") {
            root.menu-action("fn:startIlluInteractiveCrop()", @tr("Recadrage"));
        } else if (a == "close-doc") {
            root.menu-action("fn:EditorManager.requestCloseActiveDocumentFromMenu()", @tr("Fermer le projet actif…"));
        } else if (a == "brightness") {
            root.menu-action("fx:brightness", @tr("Luminosité / Contraste…"));
        } else if (a == "hsv") {
            root.menu-action("fx:hsv", @tr("Teinte / Saturation…"));
        } else if (a == "invert") {
            root.menu-action("fx:invert", @tr("Inverser les couleurs"));
        } else if (a == "grayscale") {
            root.menu-action("fx:grayscale", @tr("Noir et blanc"));
        }
    }

    fs := FocusScope {
        x: root.system-left;
        y: root.system-top;
        width: root.usable-width;
        height: root.usable-height;
        key-pressed(e) => {
            // Échap ferme d'abord le menu contextuel et les menus ouverts
            if ((root.open-menu >= 0 || root.ctx-open) && e.text == Key.Escape) {
                root.open-menu = -1;
                root.ctx-open = false;
                return accept;
            }
            if (e.text == " ") {
                root.space-down = true;
                return accept;
            }
            if (root.key-pressed(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt)) {
                return accept;
            }
            reject
        }
        key-released(e) => {
            if (e.text == " ") {
                root.space-down = false;
            }
            reject
        }

        // ================= barre de menus + barre rapide =================
        Rectangle {
            x: 0;
            y: 0;
            width: root.usable-width;
            height: root.top-height;
            visible: !root.phone;
            background: Theme.menubar-bg;
            // barre de titre translucide (Paramètres › Apparence) : effet Mica de Windows 11 sur
            // toute la bande — la même petite image floutée (header-bg, 64 × 6 px étirée) sous un
            // voile de la surface ; aucun calcul en plus, l'image sert déjà aux onglets
            if Theme.glass && !root.pm-open: Image {
                width: parent.width;
                height: parent.height;
                source: root.header-bg;
                image-fit: fill;
                image-rendering: smooth;
            }
            if Theme.glass && !root.pm-open: Rectangle {
                background: Theme.menubar-bg.with-alpha(Theme.dark ? 0.8 : 0.76);
            }
            // Le creux arrondi découvre la même surface accentuée que la barre rapide.
            Rectangle {
                x: root.menu-zone;
                y: root.top-height - 10px;
                width: 10px;
                height: 10px;
                background: Theme.glass ? Theme.accent-12.with-alpha(0.55) : Theme.accent-12;
            }
            // zone des onglets (comme MasterPaint) : creux arrondi à droite du bloc menus + barre
            // rapide, avec l'image active floutée sous un voile d'accent ; le bloc de gauche garde
            // sa couleur fixe
            Rectangle {
                x: root.menu-zone;
                width: parent.width - self.x;
                height: parent.height;
                // un seul arrondi, en bas à gauche, collé au bout de la barre rapide
                border-bottom-left-radius: 10px * Theme.round;
                clip: true;
                background: Theme.menubar-bg;
                // zone libre de la barre de titre : déplacer la fenêtre, double-clic = agrandir
                if root.custom-frame: TouchArea {
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            root.window-action("drag");
                        }
                    }
                    double-clicked => {
                        root.window-action("maximize");
                    }
                }
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.header-bg;
                    visible: root.set-header-preview && !root.pm-open;
                    image-fit: fill;
                    image-rendering: smooth;
                }
                // voile de l'accent (≈ color-mix de la version web) : le texte reste lisible
                Rectangle {
                    // voile clair : une pointe d'accent, l'aperçu flouté reste discret
                    background: Theme.dark ? Theme.menubar-bg.with-alpha(0.74) : Theme.accent.mix(#ffffff, 0.14).with-alpha(0.78);
                }
                // fine bordure qui détache la zone des onglets du bloc des menus
                Rectangle {
                    x: 0;
                    y: -1px;
                    width: parent.width + 1px;
                    height: parent.height + 1px;
                    border-bottom-left-radius: 10px * Theme.round;
                    border-width: 1px;
                    border-color: Theme.window-border;
                }
            }
            menu-row := HorizontalLayout {
                x: 4px;
                y: 2px;
                height: 21px;
                for m[i] in root.menus: MenuBarItem {
                    menu: m;
                    open: root.open-menu == i;
                    any-open: root.open-menu >= 0;
                    toggle(x) => {
                        root.open-menu = root.open-menu == i ? -1 : i;
                        root.menu-x = x;
                        root.open-sub = -1;
                    }
                    switch-to(x) => {
                        root.open-menu = i;
                        root.menu-x = x;
                        root.open-sub = -1;
                    }
                }
            }
            Rectangle {
                visible: !root.pm-open;
                x: 0;
                y: 26px;
                width: root.menu-zone;
                height: 26px;
                background: Theme.glass ? Theme.accent-12.with-alpha(0.55) : Theme.accent-12;
                bug-label-measure := Text {
                    visible: false;
                    text: @tr("Signaler un bug");
                    font-size: Theme.small-font-size;
                    font-weight: 600;
                }
                // Groupes Fichier, historique et zoom ; signalement ancré à droite.
                for separator-x in [112px, 178px, 312px]: Rectangle {
                    x: separator-x;
                    y: 5px;
                    width: 1px;
                    height: 17px;
                    background: Theme.text-inactive.with-alpha(0.5);
                }
                for q in Generated.quick: Rectangle {
                    x: q.label != "" ? parent.width - self.width - 8px
                        : q.id == "illu-tb-new" ? 2px
                        : q.id == "illu-tb-open" ? 28px
                        : q.id == "illu-tb-save" ? 54px
                        : q.id == "illu-tb-print" ? 80px
                        : q.id == "illu-tb-undo" ? 120px
                        : q.id == "illu-tb-redo" ? 146px
                        : q.id == "illu-tb-zoom-out" ? 186px
                        : q.id == "illu-tb-zoom-in" ? 251px : 277px;
                    y: 2px;
                    width: q.label != "" ? max(116px, bug-label-measure.preferred-width + 32px) : 26px;
                    height: 23px;
                    if q.label == "": FlatButton {
                        width: parent.width;
                        height: parent.height;
                        icon: q.icon;
                        tip: q.title;
                        icon-size: 14px;
                        clicked => {
                            root.quick-action(q.id);
                        }
                    }
                    if q.label != "": Rectangle {
                        border-radius: Theme.ctl-radius;
                        background: bta.has-hover ? Theme.accent.darker(15%) : Theme.accent;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Icon {
                                y: 5px;
                                spec: q.icon;
                                size: 12px;
                                tint: Theme.on-accent;
                            }
                            Text {
                                text: q.label;
                                color: Theme.on-accent;
                                font-size: Theme.small-font-size;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        bta := TouchArea {
                            clicked => {
                                root.quick-action(q.id);
                            }
                        }
                    }
                }
                Text {
                    x: 212px;
                    y: 2px;
                    width: 38px;
                    height: 23px;
                    text: round(root.zoom * 100) + "%";
                    font-size: Theme.small-font-size;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            // onglets des images ouvertes (multi-projet), comme la version web ; masqués pendant
            // le Mode Photo Pro
            HorizontalLayout {
                visible: !root.pm-open;
                x: root.menu-zone + 18px;
                y: 0;
                height: root.top-height + 3px;
                spacing: 2px;
                for tab[ti] in root.tabs: Rectangle {
                    width: 80px;
                    background: tab.mask ? (tab.active ? #6d4a9a : tta.has-hover ? #8a68b8 : #5b3f80) : tab.active ? Theme.accent-32 : tta.has-hover ? Theme.accent-12 : transparent;
                    border-width: tab.active || tta.has-hover || tab.mask ? 1px : 0px;
                    border-color: tab.mask ? #b79be0 : Theme.accent-60;
                    Image {
                        x: 6px;
                        y: 4px;
                        width: parent.width - 12px;
                        height: parent.height - 8px;
                        source: tab.thumb;
                        image-fit: contain;
                    }
                    // type du projet (animation, SVG) : pastille en bas à gauche ; rien en pixel
                    if tab.kind != "": Rectangle {
                        x: 3px;
                        y: parent.height - self.height - 3px;
                        width: kt.preferred-width + 8px;
                        height: 13px;
                        border-radius: 3px * Theme.round;
                        background: Theme.accent;
                        kt := Text {
                            text: tab.kind;
                            font-size: 8px;
                            font-weight: 800;
                            color: Theme.on-accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    // masque α : pastille « α » dans le coin
                    if tab.mask: Rectangle {
                        x: 3px;
                        y: 3px;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px * Theme.round;
                        background: #8a4fd0;
                        Text {
                            text: "α";
                            font-size: 10px;
                            font-weight: 700;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Timer {
                        interval: 600ms;
                        running: tta.has-hover && !tta.pressed && !cla.has-hover && !(Tip.shown && Tip.text == tab.title);
                        triggered => {
                            Tip.text = tab.title;
                            Tip.x = parent.absolute-position.x;
                            Tip.y = parent.absolute-position.y + parent.height + 4px;
                            Tip.shown = true;
                        }
                    }
                    tta := TouchArea {
                        clicked => {
                            Tip.shown = false;
                            root.tab-clicked(ti);
                            fs.focus();
                        }
                        changed has-hover => {
                            if (!self.has-hover && Tip.text == tab.title) {
                                Tip.shown = false;
                            }
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                Tip.shown = false;
                                root.tab-clicked(ti);
                                root.context-request("tab", ti, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, false);
                            }
                        }
                    }
                    // projet et son masque α : un contour à l'accent les réunit (comme la version web)
                    if tab.linked: Rectangle {
                        Rectangle { y: 0; height: 2px; background: Theme.accent; }
                        Rectangle { y: parent.height - 2px; height: 2px; background: Theme.accent; }
                        if !tab.link-left: Rectangle { x: 0; width: 2px; background: Theme.accent; }
                        if !tab.link-right: Rectangle { x: parent.width - 2px; width: 2px; background: Theme.accent; }
                        if tab.link-right: Rectangle { x: parent.width; width: 2px; y: 0; height: 2px; background: Theme.accent; }
                        if tab.link-right: Rectangle { x: parent.width; width: 2px; y: parent.height - 2px; height: 2px; background: Theme.accent; }
                    }
                    Rectangle {
                        visible: tab.active || tta.has-hover || cla.has-hover;
                        x: parent.width - 16px;
                        y: 2px;
                        width: 14px;
                        height: 14px;
                        background: cla.has-hover ? Theme.close-hover : Theme.close-bg;
                        FaIcon {
                            glyph: "\u{f00d}";
                            size: 9px;
                            color: #ffffff;
                        }
                        cla := TouchArea {
                            clicked => {
                                root.tab-close(ti);
                                fs.focus();
                            }
                        }
                    }
                }
            }
            // Aide et raccourcis : à gauche de « Télécharger l'application » (seul sur le bureau)
            Rectangle {
                x: root.web ? dlr.x - self.width - 6px : parent.width - self.width - 8px;
                y: 28px;
                width: inf.preferred-width + 34px;
                height: 22px;
                border-radius: Theme.ctl-radius;
                background: infota.has-hover || root.show-shortcuts ? Theme.accent-14 : transparent;
                border-width: 1px;
                border-color: infota.has-hover ? Theme.accent : Theme.window-border;
                GlyphIcon {
                    x: 8px;
                    width: 14px;
                    glyph: "\u{f05a}";
                    size: 11px;
                }
                inf := Text {
                    x: 26px;
                    height: parent.height;
                    text: @tr("Info");
                    font-size: Theme.small-font-size;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                infota := TouchArea {
                    clicked => {
                        root.show-shortcuts = !root.show-shortcuts;
                    }
                }
            }
            // téléchargement de l'application (exe, Flatpak…) : inutile dans l'application de bureau
            dlr := Rectangle {
                visible: root.web;
                x: parent.width - self.width - 8px;
                y: 28px;
                width: dl.preferred-width + 34px;
                height: 22px;
                border-radius: Theme.ctl-radius;
                background: dta.has-hover ? Theme.accent-14 : transparent;
                border-width: 1px;
                border-color: dta.has-hover ? Theme.accent : Theme.window-border;
                GlyphIcon {
                    x: 8px;
                    width: 14px;
                    glyph: "\u{f019}";
                    size: 11px;
                }
                dl := Text {
                    x: 26px;
                    height: parent.height;
                    text: @tr("Télécharger l'application");
                    font-size: Theme.small-font-size;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                dta := TouchArea {
                    clicked => {
                        root.show-download = true;
                    }
                }
            }
            // boutons de la fenêtre (barre de titre intégrée, bureau)
            if root.custom-frame: HorizontalLayout {
                x: parent.width - self.width;
                y: 0;
                width: 138px;
                height: 27px;
                for b[bi] in [
                    { id: "minimize", g: "\u{f068}" },
                    { id: "maximize", g: "\u{f2d0}" },
                    { id: "close", g: "\u{f00d}" },
                ]: Rectangle {
                    width: 46px;
                    background: wba.pressed ? (b.id == "close" ? #c42b1c : Theme.accent-20) : wba.has-hover ? (b.id == "close" ? #e81123 : Theme.accent-14) : transparent;
                    FaIcon {
                        glyph: b.id == "maximize" && root.maximized ? "\u{f24d}" : b.g;
                        weight: b.id == "maximize" ? 400 : 900;
                        size: 11px;
                        color: wba.has-hover && b.id == "close" ? #ffffff : Theme.text;
                    }
                    wba := TouchArea {
                        clicked => {
                            root.window-action(b.id);
                        }
                    }
                }
            }
        }

        // ================= ruban / barre classique =================
        // téléphone : carte flottante au-dessus de la toile, à droite de la capsule annuler /
        // rétablir (comme la version web) ; les groupes qui dépassent défilent au doigt
        Rectangle {
            x: root.phone ? 46px : 0;
            y: root.phone ? root.mob-row-y : root.top-height;
            width: root.phone ? root.usable-width - 50px : root.usable-width;
            height: root.phone ? root.mob-ribbon-h : root.bar-height;
            z: root.phone && !root.modal-open && !root.phone-menu ? 1 : 0;
            background: root.phone ? Theme.mob-card : Theme.ribbon-bg;
            border-radius: root.phone ? 12px : 0px;
            drop-shadow-blur: root.phone ? 10px : 0px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: #00000024;
            clip: true;
            // trait sous la barre de menus / onglets : le ruban se détache de la bande du haut
            if !root.phone: Rectangle {
                y: 0;
                height: 1px;
                background: Theme.statusbar-border;
            }
            Flickable {
                interactive: root.phone;
                viewport-width: ribbon-row.width;
                viewport-height: self.height;
            ribbon-row := HorizontalLayout {
                x: 0;
                y: 0;
                width: max(self.preferred-width, root.phone ? root.usable-width - 50px : root.usable-width);
                height: root.phone ? root.mob-ribbon-h : root.classic-wrap ? 32px : root.bar-height;
                alignment: start;
                padding-left: 2px;

                // ---- Outil : sélecteur ----
                RibbonGroup {
                    label: @tr("Outil");
                    classic: root.classic;
                    Rectangle {
                        width: root.classic ? 28px : 56px;
                        // bouton arrondi comme son menu (Windows 11)
                        border-radius: Theme.ctl-radius;
                        background: pta.pressed ? Theme.accent-20 : pta.has-hover ? Theme.accent-12 : transparent;
                        border-width: pta.has-hover ? 1px : 0px;
                        border-color: Theme.accent-60;
                        for t in Generated.tools: Icon {
                            x: (parent.width - 16px) / 2;
                            y: root.classic ? 5px : 8px;
                            visible: t.id == root.current-tool;
                            spec: t.icon;
                            size: 16px;
                        }
                        if !root.classic: Text {
                            y: 28px;
                            width: parent.width;
                            text: root.tool-title;
                            font-size: Theme.small-font-size;
                            color: Theme.ribbon-fg;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        if !root.classic: FaIcon {
                            y: 44px;
                            width: parent.width;
                            glyph: "\u{f078}";
                            size: 7px;
                            color: Theme.ribbon-label;
                        }
                        pta := TouchArea {
                            clicked => {
                                picker.show();
                            }
                        }
                        // même grille que la palette Outils : boutons centrés, séparateurs gravés
                        picker := PopupWindow {
                            x: (parent.width - self.width) / 2;
                            y: parent.height;
                            width: 61px;
                            height: 312px;
                            Rectangle {
                                background: Theme.menu-bg;
                                border-radius: Theme.ctl-radius > 0 ? Theme.ctl-radius + 2px : 0px;
                                border-width: 1px;
                                border-color: Theme.window-border;
                                drop-shadow-blur: 6px;
                                drop-shadow-color: Theme.window-shadow;
                                for sy in [85px, 167px, 249px]: Rectangle {
                                    x: 6px;
                                    y: sy;
                                    width: parent.width - 12px;
                                    height: 2px;
                                    Rectangle { y: 0; height: 1px; background: Theme.window-border.darker(15%); }
                                    Rectangle { y: 1px; height: 1px; background: Theme.dark ? #00000040 : #ffffff; }
                                }
                                for t in Generated.tools: FlatButton {
                                    enabled: !root.tool-blocked(t.id);
                                    tip: self.enabled ? t.title : root.tool-blocked-tip(t.title);
                                    x: 4px + t.x;
                                    y: 4px + t.y;
                                    width: t.w;
                                    height: t.h;
                                    icon: t.icon;
                                    show-label: false;
                                    icon-size: 15px;
                                    checked: t.id == root.current-tool;
                                    clicked => {
                                        root.current-tool = t.id;
                                        root.tool-selected(t.id);
                                    }
                                }
                            }
                        }
                    }
                }

                if root.current-tool == "tool-wand": RegionGroup {
                    label: @tr("Baguette");
                    classic: root.classic;
                }
                if root.current-tool == "tool-magnetic-lasso": MagnetGroup {
                    label: @tr("Lasso magnétique");
                    classic: root.classic;
                }
                if root.current-tool == "tool-fill": RegionGroup {
                    label: @tr("Remplissage");
                    classic: root.classic;
                    other-label: @tr("Global");
                    other-glyph: "\u{f0ac}";
                    tol-max: 128;
                }
                // taille : pinceau, gomme et crayon (crayon : 1 px par défaut, taille mémorisée à part)
                if root.is-brush(root.current-tool) || root.current-tool == "tool-pencil": SizeGroup {
                    classic: root.classic;
                }
                if root.current-tool == "tool-shapes-family": ShapeKindGroup {
                    classic: root.classic;
                }
                // pipette : couleur prélevée, HEX / RVB / RAL (comme la version web)
                if root.current-tool == "tool-eyedropper": RibbonGroup {
                    classic: root.classic;
                    label: @tr("Couleur prélevée");
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Rectangle {
                            width: root.classic ? 22px : 40px;
                            height: root.classic ? 22px : 40px;
                            border-radius: Theme.ctl-radius;
                            border-width: 1px;
                            border-color: Theme.window-border;
                            background: root.primary-color;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            HorizontalLayout {
                                spacing: 6px;
                                Text { width: 28px; text: @tr("HEX"); color: Theme.ribbon-label; font-size: Theme.small-font-size; vertical-alignment: center; }
                                Text { text: "#" + root.color-hex; color: Theme.text; font-family: "monospace"; vertical-alignment: center; }
                                if root.classic: Text { text: @tr("  RVB ") + root.color-comps[0] + " · " + root.color-comps[1] + " · " + root.color-comps[2] + "   " + root.color-ral; color: Theme.text; vertical-alignment: center; }
                            }
                            if !root.classic: HorizontalLayout {
                                spacing: 6px;
                                Text { width: 28px; text: @tr("RVB"); color: Theme.ribbon-label; font-size: Theme.small-font-size; vertical-alignment: center; }
                                Text { text: root.color-comps[0] + " · " + root.color-comps[1] + " · " + root.color-comps[2]; color: Theme.text; vertical-alignment: center; }
                            }
                            if !root.classic: HorizontalLayout {
                                spacing: 6px;
                                Text { width: 28px; text: @tr("RAL"); color: Theme.ribbon-label; font-size: Theme.small-font-size; vertical-alignment: center; }
                                Text { text: root.color-ral; color: Theme.text; vertical-alignment: center; overflow: elide; max-width: 220px; }
                            }
                        }
                    }
                }
                // Ligne (ruban) : l'épaisseur passe sous « Modifiable » (groupe Calque SVG)
                if root.is-shape(root.current-tool) && (root.classic || root.current-tool != "tool-line"): StrokeGroup {
                    classic: root.classic;
                    line: root.current-tool == "tool-line";
                }
                // barre Paint.NET : réglage de forme dans sa propre alvéole ; ruban : sous « Modifiable »
                if root.classic && (root.current-tool == "tool-round-3" || (root.current-tool == "tool-shapes-family" && (ToolOpts.shape-kind == "roundrect" || ToolOpts.shape-kind == "ngon" || ToolOpts.shape-kind == "star"))): ShapeParamGroup {
                    classic: root.classic;
                    kind: root.current-tool == "tool-round-3" || ToolOpts.shape-kind == "roundrect" ? 0 : ToolOpts.shape-kind == "ngon" ? 1 : 2;
                }
                if root.current-tool == "tool-line": LineGroup {
                    classic: root.classic;
                }
                if root.is-shape(root.current-tool): VectorGroup {
                    classic: root.classic;
                    param: root.current-tool == "tool-line" ? 3
                        : root.current-tool == "tool-round-3" || (root.current-tool == "tool-shapes-family" && ToolOpts.shape-kind == "roundrect") ? 0
                        : root.current-tool == "tool-shapes-family" && ToolOpts.shape-kind == "ngon" ? 1
                        : root.current-tool == "tool-shapes-family" && ToolOpts.shape-kind == "star" ? 2 : -1;
                }
                if root.current-tool == "tool-gradient": GradientGroup {
                    classic: root.classic;
                }
                if root.current-tool == "tool-text": TextGroup {
                    classic: root.classic;
                }
                if root.current-tool == "tool-text": TextStyleGroup {
                    classic: root.classic;
                }
                if root.current-tool == "tool-text": VectorGroup {
                    classic: root.classic;
                    text: true;
                }
                if root.is-brush(root.current-tool) || root.current-tool == "tool-pencil": SymmetryGroup {
                    classic: root.classic;
                }
                if root.is-sel-tool(root.current-tool) || root.current-tool == "tool-wand": SelectionGroup {
                    classic: root.classic;
                }
                // Image : recadrer, pivoter, retourner (ruban MasterPaint seulement : la barre
                // Paint.NET a déjà assez d'icônes)
                if !root.classic && !RibbonFit.narrow && (root.is-sel-tool(root.current-tool) || root.current-tool == "tool-wand"): RibbonGroup {
                    label: @tr("Image");
                    VerticalLayout {
                        spacing: 4px;
                        ToggleButton {
                            glyph: "\u{f125}";
                            img: Sprite.img-crop;
                            text: @tr("Recadrer…");
                            tip: @tr("Recadrer l'image (poignées sur la toile)");
                            clicked => {
                                root.menu-action("fn:startIlluInteractiveCrop()", @tr("Recadrer"));
                            }
                        }
                        HorizontalLayout {
                            spacing: 2px;
                            for r in [
                                { id: "rot-ccw", img: Sprite.img-rot-ccw, t: @tr("Pivoter l'image de 90° vers la gauche") },
                                { id: "rot-cw", img: Sprite.img-rot-cw, t: @tr("Pivoter l'image de 90° vers la droite") },
                                { id: "flip-h", img: Sprite.img-flip-h, t: @tr("Retourner l'image horizontalement (miroir)") },
                                { id: "flip-v", img: Sprite.img-flip-v, t: @tr("Retourner l'image verticalement (miroir)") },
                            ]: ToggleButton {
                                compact: true;
                                img: r.img;
                                tip: r.t;
                                clicked => {
                                    Actions.ribbon(r.id);
                                }
                            }
                        }
                    }
                }
                if !root.classic-wrap && (root.is-sel-tool(root.current-tool) || root.current-tool == "tool-wand" || root.current-tool == "tool-eyedropper"
                    || root.current-tool == "tool-zoom" || root.current-tool == "tool-text"): EditGroup {
                    classic: root.classic;
                }
                if !root.classic-wrap && !RibbonFit.narrow && root.is-sel-tool(root.current-tool): AlignGroup {
                    classic: root.classic;
                    has-selection: root.has-selection;
                }
                if !root.classic-wrap: ViewGroup {
                    classic: root.classic;
                }
                if root.current-tool == "tool-brush" || root.current-tool == "tool-pencil": BrushGroup {
                    pencil: root.current-tool == "tool-pencil";
                    classic: root.classic;
                }
            }
            }
            // barre Paint.NET étroite : deuxième ligne
            if root.classic-wrap && !root.phone: HorizontalLayout {
                x: 0;
                y: 32px;
                height: 32px;
                alignment: start;
                padding-left: 2px;
                if root.is-sel-tool(root.current-tool) || root.current-tool == "tool-wand" || root.current-tool == "tool-eyedropper"
                    || root.current-tool == "tool-zoom" || root.current-tool == "tool-text": EditGroup {
                    classic: true;
                }
                if root.is-sel-tool(root.current-tool): AlignGroup {
                    classic: true;
                    has-selection: root.has-selection;
                }
                ViewGroup {
                    classic: true;
                }
            }
            if !root.phone: Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.statusbar-border;
            }
                    // réduire le ruban en barre compacte (^) ou le redévelopper (v), comme Office
            if !root.phone: Rectangle {
                x: parent.width - 26px;
                y: 3px;
                width: 20px;
                height: 18px;
                border-radius: 3px * Theme.round;
                background: ribbon-toggle.has-hover ? Theme.accent-14 : transparent;
                FaIcon {
                    glyph: root.toolbar-mode == 0 ? "\u{f077}" : "\u{f078}";
                    size: 10px;
                    color: Theme.ribbon-fg;
                }
                ribbon-toggle := TouchArea {
                    clicked => {
                        root.toolbar-mode = root.toolbar-mode == 0 ? 1 : 0;
                        root.settings-changed();
                    }
                }
            }
        }

        // ================= barre d'état =================
        Rectangle {
            x: 0;
            y: root.usable-height - root.status-height;
            width: root.usable-width;
            height: root.status-height;
            visible: !root.phone;
            background: Theme.statusbar-bg;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.statusbar-border;
            }
            Rectangle {
                x: 12px;
                y: 5px;
                width: 2px;
                height: 16px;
                background: Theme.accent;
            }
            Text {
                x: 22px;
                width: parent.width - 30px - status-row.width;
                height: parent.height;
                text: root.doc-title;
                font-weight: 600;
                font-size: Theme.font-size;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
            // comme la version web : moins d'éléments quand la fenêtre se rétrécit ; un message
            // (status-text) remplace temporairement les moins utiles
            status-row := HorizontalLayout {
                x: parent.width - self.width - 15px;
                width: self.preferred-width;
                height: parent.height;
                spacing: root.usable-width < 900px ? 14px : 24px;
                if root.status-text != "": Text {
                    text: root.status-text;
                    vertical-alignment: center;
                    color: Theme.text-inactive;
                    overflow: elide;
                    max-width: max(120px, root.usable-width * 0.35);
                }
                if root.usable-width >= 560px: Text {
                    text: root.cursor-text;
                    vertical-alignment: center;
                    color: Theme.text;
                }
                if root.selection-text != "" && root.usable-width >= 700px: Text {
                    text: root.selection-text;
                    vertical-alignment: center;
                    color: Theme.text;
                }
                if root.usable-width >= 760px: Text {
                    text: (root.usable-width >= 1000px ? @tr("Document : ") : "") + root.doc-width + @tr(" × ") + root.doc-height + @tr(" px");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                Text {
                    text: (root.usable-width >= 1000px ? @tr("Zoom : ") : "") + round(root.zoom * 100) + " %";
                    vertical-alignment: center;
                    color: Theme.text;
                }
                if root.usable-width >= 900px && root.status-text == "": Text {
                    text: @tr("Mode : ") + root.mode-text + root.work-mode;
                    vertical-alignment: center;
                    color: Theme.text;
                }
                if root.usable-width >= 1180px && root.status-text == "": HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: @tr("MasterPaint par");
                        vertical-alignment: center;
                        color: Theme.text;
                    }
                    Text {
                        text: @tr("Polocrafting 367");
                        font-weight: 700;
                        vertical-alignment: center;
                        color: Theme.accent;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.quick-action("open-author");
                            }
                        }
                    }
                    Text {
                        text: "v" + root.app-version;
                        vertical-alignment: center;
                        color: Theme.text;
                    }
                }
            }
        }

        // ================= espace de travail =================
        ws := Rectangle {
            x: 0;
            y: root.top-height + root.bar-height;
            width: root.usable-width;
            // téléphone : la barre du bas flotte sur la toile (plus de bande grise dessous)
            height: root.usable-height - self.y - root.status-height;
            // masque α : fond violet sombre, pour ne pas le confondre avec le projet
            background: root.mask-doc ? (Theme.dark ? #2b2140 : #8e79b3) : root.workspace-custom ? root.appearance-colors[2] : root.phone ? Theme.mob-surface-deep : Theme.workspace-bg;
            if root.mask-doc: Rectangle {
                y: 6px;
                height: 22px;
                width: mask-lbl.preferred-width + 24px;
                x: (parent.width - self.width) / 2;
                z: 2;
                border-radius: 11px * Theme.round;
                background: #6d3fb5;
                mask-lbl := Text {
                    text: @tr("Masque α — blanc = visible, noir = masqué (niveaux de gris)");
                    font-size: Theme.small-font-size;
                    font-weight: 600;
                    color: #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // toile et ce qui s'y rattache : découpés à l'espace de travail (les fenêtres, elles,
            // peuvent aller sur le ruban et la barre d'état) ; aucun projet : rien
            Rectangle {
                visible: !root.no-doc;
                clip: true;
                // ombre de la toile, bornée à la partie visible : une ombre (ou une opacité) à la
                // taille de la toile zoomée fait calculer une image géante, de plus en plus lente
                // à mesure qu'on zoome
                Rectangle {
                    x: max(canvas.x, -8px);
                    y: max(canvas.y, -8px);
                    width: max(0px, min(canvas.x + canvas.width, parent.width + 8px) - self.x);
                    height: max(0px, min(canvas.y + canvas.height, parent.height + 8px) - self.y);
                    background: root.appearance-colors[0];
                    drop-shadow-blur: 3px;
                    drop-shadow-color: #00000030;
                    clip: true;
                    Image {
                        width: root.usable-width;
                        height: root.usable-height;
                        source: root.checker-image;
                        image-fit: fill;
                    }
                }
                canvas := Rectangle {
                    width: root.doc-width * root.zoom * 1px;
                    height: root.doc-height * root.zoom * 1px;
                    x: root.dock-left + (root.view-w - self.width) / 2 + root.pan-x;
                    y: root.view-top + (root.view-h - self.height) / 2 + root.pan-y;
                    // « Hors toile » : contenu au dehors, estompé autour de la toile (déjà à demi
                    // transparent dans l'image : pas d'opacité, qui coûterait une image à la
                    // taille zoomée)
                    if root.outside-w > 0: Image {
                        x: root.outside-x * root.zoom * 1px;
                        y: root.outside-y * root.zoom * 1px;
                        width: root.outside-w * root.zoom * 1px;
                        height: root.outside-h * root.zoom * 1px;
                        source: root.outside-image;
                        image-rendering: root.zoom >= 2 && !root.set-zoom-smooth ? pixelated : smooth;
                    }
                    if root.canvas-tiles.length == 0: Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.canvas-image;
                        image-rendering: root.zoom >= 2 && !root.set-zoom-smooth ? pixelated : smooth;
                    }
                    for t in root.canvas-tiles: Rectangle {
                        // Snap shared tile edges to physical pixels without overlapping alpha.
                        property <length> origin-x: canvas.absolute-position.x;
                        property <length> origin-y: canvas.absolute-position.y;
                        x: round((self.origin-x + t.x * root.zoom * 1px) / 1phx) * 1phx - self.origin-x;
                        y: round((self.origin-y + t.y * root.zoom * 1px) / 1phx) * 1phx - self.origin-y;
                        width: round((self.origin-x + (t.x + t.w) * root.zoom * 1px) / 1phx) * 1phx - self.origin-x - self.x;
                        height: round((self.origin-y + (t.y + t.h) * root.zoom * 1px) / 1phx) * 1phx - self.origin-y - self.y;
                        clip: true;
                        Image {
                            // The sampling gutter moves image-edge antialiasing outside
                            // this physical-pixel-aligned clip, preserving alpha exactly once.
                            x: -32 * parent.width / max(1, t.img.width - 64);
                            y: -32 * parent.height / max(1, t.img.height - 64);
                            width: parent.width - 2 * self.x;
                            height: parent.height - 2 * self.y;
                            source: t.img;
                            image-rendering: root.zoom >= 2 && !root.set-zoom-smooth ? pixelated : smooth;
                        }
                    }
                    // pelure d'oignon (mode animation) : alpha déjà estompé dans l'image
                    if root.anim-on && root.onion-shown: Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.onion-image;
                        image-rendering: smooth;
                    }
                    // grille de pixels (à partir de 400 %)
                    // axes de symétrie (pinceau, crayon) : lignes au centre et poignées aux extrémités
                    if (ToolOpts.sym-x || ToolOpts.sym-y) && (root.is-brush(root.current-tool) || root.current-tool == "tool-pencil"): Rectangle {
                        property <length> ax: ToolOpts.sym-cx < 0 ? parent.width / 2 : ToolOpts.sym-cx * root.zoom * 1px;
                        property <length> ay: ToolOpts.sym-cy < 0 ? parent.height / 2 : ToolOpts.sym-cy * root.zoom * 1px;
                        if ToolOpts.sym-x: Rectangle {
                            x: parent.ax - 0.5px;
                            width: 1px;
                            height: parent.height;
                            background: #e0409a;
                        }
                        if ToolOpts.sym-x: Rectangle { x: parent.ax - 6px; y: -6px; width: 12px; height: 12px; border-radius: 6px * Theme.round; background: #e0409a; border-width: 2px; border-color: #ffffff; }
                        if ToolOpts.sym-x: Rectangle { x: parent.ax - 6px; y: parent.height - 6px; width: 12px; height: 12px; border-radius: 6px * Theme.round; background: #e0409a; border-width: 2px; border-color: #ffffff; }
                        if ToolOpts.sym-y: Rectangle {
                            y: parent.ay - 0.5px;
                            height: 1px;
                            width: parent.width;
                            background: #e0409a;
                        }
                        if ToolOpts.sym-y: Rectangle { y: parent.ay - 6px; x: -6px; width: 12px; height: 12px; border-radius: 6px * Theme.round; background: #e0409a; border-width: 2px; border-color: #ffffff; }
                        if ToolOpts.sym-y: Rectangle { y: parent.ay - 6px; x: parent.width - 6px; width: 12px; height: 12px; border-radius: 6px * Theme.round; background: #e0409a; border-width: 2px; border-color: #ffffff; }
                    }
                    // grille de pixels : seulement sur la partie visible (voir grid-x… côté Rust)
                    if ToolOpts.pixel-grid && root.zoom >= 4 && root.pixel-grid-path != "" && root.grid-w > 0: Path {
                        x: root.grid-x * root.zoom * 1px;
                        y: root.grid-y * root.zoom * 1px;
                        width: root.grid-w * root.zoom * 1px;
                        height: root.grid-h * root.zoom * 1px;
                        viewbox-width: root.grid-w;
                        viewbox-height: root.grid-h;
                        commands: root.pixel-grid-path;
                        stroke: #80808070;
                        stroke-width: 1px;
                    }
                    // aimantation : grille de prévisualisation et repères d'accroche
                    if (root.show-snap || (root.set-snap-always && ToolOpts.snap)) && root.snap-grid-path != "": Path {
                        width: parent.width;
                        height: parent.height;
                        viewbox-width: root.doc-width;
                        viewbox-height: root.doc-height;
                        commands: root.snap-grid-path;
                        stroke: #a78bfa90;
                        stroke-width: 1px;
                    }
                    if root.snap-guide-x >= 0: Rectangle {
                        x: root.snap-guide-x * root.zoom * 1px - 0.5px;
                        width: 1px;
                        height: parent.height;
                        background: #ff00ff;
                    }
                    if root.snap-guide-y >= 0: Rectangle {
                        y: root.snap-guide-y * root.zoom * 1px - 0.5px;
                        height: 1px;
                        width: parent.width;
                        background: #ff00ff;
                    }
                    // recadrage : extérieur du cadre assombri
                    if root.crop-active: Rectangle {
                        property <length> u: root.zoom * 1px;
                        Rectangle { x: 0; y: 0; width: parent.width; height: root.crop-y * u; background: #00000080; }
                        Rectangle { x: 0; y: (root.crop-y + root.crop-h) * u; width: parent.width; height: parent.height - self.y; background: #00000080; }
                        Rectangle { x: 0; y: root.crop-y * u; width: root.crop-x * u; height: root.crop-h * u; background: #00000080; }
                        Rectangle { x: (root.crop-x + root.crop-w) * u; y: root.crop-y * u; width: parent.width - self.x; height: root.crop-h * u; background: #00000080; }
                    }
                    if root.overlay-path != "": Path {
                        width: parent.width;
                        height: parent.height;
                        viewbox-width: root.doc-width;
                        viewbox-height: root.doc-height;
                        commands: root.overlay-path;
                        stroke: Theme.accent;
                        stroke-width: 1.5px;
                    }
                }

                ScaleRotateGestureHandler {
                    enabled: root.native-touch;
                    property <float> previous-scale: 1;
                    property <Point> previous-center;
                    started => {
                        self.previous-scale = 1;
                        self.previous-center = self.center;
                        root.native-pinch(true);
                    }
                    updated => {
                        root.pinch(self.scale / max(0.001, self.previous-scale), self.absolute-position.x + self.center.x,
                            self.absolute-position.y + self.center.y, self.center.x - self.previous-center.x, self.center.y - self.previous-center.y);
                        self.previous-scale = self.scale;
                        self.previous-center = self.center;
                    }
                    ended => { root.native-pinch(false); }
                    cancelled => { root.native-pinch(false); }
                cta := TouchArea {
                    mouse-cursor: root.panning || root.space-down ? MouseCursor.grab
                        : root.canvas-cursor == 1 ? MouseCursor.move
                        : root.canvas-cursor == 2 ? MouseCursor.grab
                        : root.canvas-cursor == 3 ? MouseCursor.alias
                        : root.current-tool == "tool-zoom" ? MouseCursor.pointer
                        : root.current-tool == "tool-text" ? MouseCursor.text
                        : root.tool-cursor-on && !root.phone ? MouseCursor.none : MouseCursor.crosshair;
                    pure function dx() -> float {
                        return (self.mouse-x - canvas.x) / (root.zoom * 1px);
                    }
                    pure function dy() -> float {
                        return (self.mouse-y - canvas.y) / (root.zoom * 1px);
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            fs.focus();
                            if (e.button == PointerEventButton.middle || root.space-down) {
                                root.panning = true;
                                root.pan-sx = self.mouse-x - root.pan-x;
                                root.pan-sy = self.mouse-y - root.pan-y;
                                return;
                            }
                            if (e.button == PointerEventButton.right && root.context-request("canvas", -1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, e.modifiers.control)) {
                                return;
                            }
                            root.canvas-pointer(0, self.dx(), self.dy(), e.button == PointerEventButton.right ? 1 : 0, e.modifiers.control, e.modifiers.shift, e.modifiers.alt);
                        } else if (e.kind == PointerEventKind.up) {
                            if (root.panning) {
                                root.panning = false;
                                return;
                            }
                            if (e.button == PointerEventButton.right && root.ctx-open) {
                                return;
                            }
                            root.canvas-pointer(2, self.dx(), self.dy(), e.button == PointerEventButton.right ? 1 : 0, e.modifiers.control, e.modifiers.shift, e.modifiers.alt);
                        } else if (e.kind == PointerEventKind.move) {
                            if (root.panning) {
                                root.pan-x = self.mouse-x - root.pan-sx;
                                root.pan-y = self.mouse-y - root.pan-sy;
                                return;
                            }
                            root.canvas-pointer(1, self.dx(), self.dy(), 0, e.modifiers.control, e.modifiers.shift, e.modifiers.alt);
                        }
                    }
                    double-clicked => {
                        root.canvas-double-click();
                    }
                    scroll-event(e) => {
                        if (e.modifiers.shift && !e.modifiers.control) {
                            root.pan-x += e.delta-y;
                        } else if (e.modifiers.control || root.set-wheel-mode == 0) {
                            root.zoom-doc(e.delta-y > 0 ? 1.12 : 1 / 1.12, self.dx(), self.dy());
                        } else {
                            root.pan-x += e.delta-x;
                            root.pan-y += e.delta-y;
                        }
                        accept
                    }
                }

                } // native pinch recognition wraps the canvas input, leaving palettes outside.

                // zone de saisie du texte : le rendu réel est dessiné par le Rust sur la toile
                if root.text-active: Rectangle {
                    x: canvas.x + root.text-x * root.zoom * 1px - 3px;
                    y: canvas.y + root.text-y * root.zoom * 1px - 3px;
                    width: max(root.text-w * root.zoom * 1px, 24px) + 6px;
                    height: max(root.text-h * root.zoom * 1px, 16px) + 6px;
                    border-width: 1px;
                    border-color: Theme.accent;
                    background: transparent;
                    tin := TextInput {
                        x: 3px;
                        y: 3px;
                        width: parent.width - 6px;
                        height: parent.height - 6px;
                        text <=> root.text-value;
                        single-line: false;
                        font-size: max(ToolOpts.font-size * root.zoom * 1px, 6px);
                        color: transparent;
                        selection-background-color: Theme.accent.with-alpha(0.3);
                        // nouvelle saisie sans que la zone disparaisse (clic ailleurs : le texte
                        // précédent est validé, un autre commence) : le focus revient ici
                        property <int> serial: root.text-serial;
                        changed serial => {
                            self.focus();
                        }
                        edited => {
                            root.text-edited(self.text);
                        }
                        init => {
                            self.focus();
                        }
                    }
                    // curseur de saisie (le texte de la zone est invisible)
                    Rectangle {
                        x: parent.width - 4px;
                        y: 3px;
                        width: 1px;
                        height: parent.height - 6px;
                        background: Theme.accent;
                    }
                }
                // poignée de déplacement du texte en cours d'écriture
                if root.text-active: Rectangle {
                    property <length> sx;
                    property <length> sy;
                    property <float> tx;
                    property <float> ty;
                    x: canvas.x + root.text-x * root.zoom * 1px - 22px;
                    y: canvas.y + root.text-y * root.zoom * 1px - 22px;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px * Theme.round;
                    background: Theme.accent;
                    FaIcon {
                        glyph: "\u{f047}";
                        size: 10px;
                        color: Theme.on-accent;
                    }
                    TouchArea {
                        mouse-cursor: move;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                parent.sx = self.absolute-position.x + self.mouse-x;
                                parent.sy = self.absolute-position.y + self.mouse-y;
                                parent.tx = root.text-x;
                                parent.ty = root.text-y;
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                root.text-move(parent.tx + (self.absolute-position.x + self.mouse-x - parent.sx) / (root.zoom * 1px),
                                    parent.ty + (self.absolute-position.y + self.mouse-y - parent.sy) / (root.zoom * 1px));
                            }
                        }
                    }
                }

                // règles (Affichage › Règles) : graduations adaptées au zoom, en pixels du document
                if ToolOpts.rulers: rul := Rectangle {
                    property <float> step: root.zoom * 1 >= 50 ? 1 : root.zoom * 2 >= 50 ? 2 : root.zoom * 5 >= 50 ? 5 : root.zoom * 10 >= 50 ? 10
                        : root.zoom * 20 >= 50 ? 20 : root.zoom * 50 >= 50 ? 50 : root.zoom * 100 >= 50 ? 100 : root.zoom * 250 >= 50 ? 250 : 500;
                    property <length> unit: self.step * root.zoom * 1px;
                    property <int> start-x: floor(-canvas.x / self.unit);
                    property <int> start-y: floor(-canvas.y / self.unit);
                    z: 0.5;
                    // règle horizontale
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: ws.width;
                        height: 18px;
                        background: Theme.window-bg;
                        clip: true;
                        for i in ceil(ws.width / rul.unit) + 2: Rectangle {
                            x: canvas.x + (rul.start-x + i) * rul.unit;
                            width: rul.unit;
                            Rectangle {
                                x: 0;
                                width: 1px;
                                background: Theme.text-inactive;
                            }
                            for k in 4: Rectangle {
                                x: (k + 1) * parent.width / 5;
                                y: parent.height - 5px;
                                width: 1px;
                                height: 5px;
                                background: Theme.text-inactive;
                            }
                            Text {
                                x: 3px;
                                y: 1px;
                                text: (rul.start-x + i) * rul.step;
                                font-size: 9px;
                                color: Theme.text;
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.window-border;
                        }
                    }
                    // règle verticale
                    Rectangle {
                        x: 0;
                        y: 18px;
                        width: 18px;
                        height: ws.height - 18px;
                        background: Theme.window-bg;
                        clip: true;
                        for i in ceil(ws.height / rul.unit) + 2: Rectangle {
                            y: canvas.y - 18px + (rul.start-y + i) * rul.unit;
                            height: rul.unit;
                            Rectangle {
                                y: 0;
                                height: 1px;
                                background: Theme.text-inactive;
                            }
                            for k in 4: Rectangle {
                                y: (k + 1) * parent.height / 5;
                                x: parent.width - 5px;
                                height: 1px;
                                width: 5px;
                                background: Theme.text-inactive;
                            }
                            Text {
                                x: 2px;
                                y: 2px;
                                text: (rul.start-y + i) * rul.step;
                                font-size: 8px;
                                color: Theme.text;
                            }
                        }
                        Rectangle {
                            x: parent.width - 1px;
                            width: 1px;
                            background: Theme.window-border;
                        }
                    }
                }

                // poignées (Déplacer, Déformation, 4 coins) : taille fixe à l'écran, comme Paint.NET
                for hd in root.handles: Rectangle {
                    x: canvas.x + hd.x * root.zoom * 1px - 5px;
                    y: canvas.y + hd.y * root.zoom * 1px - 5px;
                    width: 10px;
                    height: 10px;
                    border-radius: hd.round ? 5px : 0px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #202020;
                }
                // indicateur de rotation (hors du cadre)
                if root.rotate-hint && cta.has-hover: GlyphIcon {
                    x: cta.mouse-x + 10px;
                    y: cta.mouse-y - 18px;
                    width: 16px;
                    height: 16px;
                    glyph: "\u{f2f1}";
                    size: 13px;
                    tint: Theme.accent;
                }

                // curseur de l'outil (croix + icône, lib.rs::tool_cursor) dessiné sous le pointeur, le
                // curseur système étant masqué sur la toile : même rendu dans le navigateur et
                // sur le bureau (les curseurs image de Slint ne passent pas partout)
                if root.tool-cursor-on && !root.phone && cta.has-hover && !root.panning && !root.space-down && root.canvas-cursor == 0
                    && root.current-tool != "tool-text" && root.current-tool != "tool-zoom": Image {
                    x: cta.mouse-x - 7px;
                    y: cta.mouse-y - 7px;
                    width: 32px;
                    height: 32px;
                    source: root.tool-cursor;
                }
                // contour du pinceau sous la souris
                if cta.has-hover && !root.panning && (root.is-brush(root.current-tool) || (root.current-tool == "tool-pencil" && ToolOpts.brush-size > 1)): Rectangle {
                    property <length> d: max(ToolOpts.brush-size * root.zoom * 1px, 4px);
                    x: cta.mouse-x - self.d / 2;
                    y: cta.mouse-y - self.d / 2;
                    width: self.d;
                    height: self.d;
                    border-radius: ToolOpts.brush-shape == 3 ? 0 : self.d / 2;
                    border-width: 1px;
                    border-color: #80808080;
                }
            }

            // ---- aucun projet ouvert : fond de l'espace de travail et deux actions ----
            if root.no-doc: Rectangle {
                width: min(parent.width - 32px, 340px);
                height: nd-col.preferred-height;
                x: root.dock-left + (root.view-w - self.width) / 2;
                y: root.view-top + (root.view-h - self.height) / 2;
                nd-col := VerticalLayout {
                    spacing: 10px;
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        GlyphIcon {
                            glyph: "\u{f03e}";
                            size: 40px;
                            tint: Theme.text-inactive;
                        }
                    }
                    Text {
                        text: @tr("Aucun projet ouvert");
                        font-size: Theme.font-size + 5px;
                        font-weight: 700;
                        color: Theme.text;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: @tr("Créez une image, ouvrez un fichier ou collez une image (Ctrl+V).");
                        color: Theme.text-inactive;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        W10Button {
                            text: @tr("Nouvelle image…");
                            primary: true;
                            clicked => { root.quick-action("illu-tb-new"); }
                        }
                        W10Button {
                            text: @tr("Ouvrir…");
                            clicked => { root.quick-action("illu-tb-open"); }
                        }
                    }
                }
            }

            // ---- frise du mode Animation : sous la toile, entre les colonnes ancrées ----
            if root.anim-on && root.anim-open: AnimPanel {
                x: root.dock-left;
                y: root.view-bottom;
                width: root.view-w;
                height: root.anim-h;
                touch: root.phone;
                rows: root.anim-rows;
                frame: root.anim-frame;
                duration: root.anim-duration;
                fps: root.anim-fps;
                playing: root.anim-playing;
                looping: root.anim-loop;
                pingpong: root.anim-pingpong;
                onion: root.anim-onion;
                onion-all: root.anim-onion-all;
                draw-step: root.anim-draw-step;
                has-clip: root.anim-has-clip;
                action(a) => {
                    if (a == "collapse") {
                        root.anim-open = false;
                    } else {
                        root.anim-action(a);
                    }
                }
                cell(l, f) => { root.anim-cell(l, f); }
                cell-op(op, l, f) => { root.anim-cell-op(op, l, f); }
                set-value(k, v) => { root.anim-set(k, v); }
            }
            // frise réduite : bouton pour la rouvrir
            if root.anim-on && !root.anim-open: Rectangle {
                x: root.dock-left + 8px;
                y: root.view-bottom - 34px;
                width: reopen-t.preferred-width + 34px;
                height: 26px;
                border-radius: 13px * Theme.round;
                background: Theme.accent;
                GlyphIcon { x: 8px; y: (parent.height - self.height) / 2; glyph: "\u{f008}"; size: 11px; tint: Theme.on-accent; on-accent: true; }
                reopen-t := Text { x: 26px; height: parent.height; text: @tr("Frise") + " · " + (root.anim-frame + 1) + "/" + root.anim-duration; color: Theme.on-accent; font-weight: 600; vertical-alignment: center; }
                TouchArea { clicked => { root.anim-open = true; } }
            }

            // ---- Outils ----
            if root.show-tools && !root.phone: tw := FloatWindow {
                docked: root.docked;
                grip: true;
                dock-x: 0px;
                dock-y: 0px;
                dock-w: 60px;
                dock-h: ws.height;
                // place d'origine (aimantée), décalée sous les règles quand elles sont affichées
                snap-home: true;
                locked: root.no-doc;
                home-x: 8px + root.rul-off;
                home-y: 8px + root.rul-off;
                min-x: root.rul-off;
                min-y: root.rul-off;
                float-x: root.geom-tools.set ? root.geom-tools.x : self.home-x;
                float-y: root.geom-tools.set ? root.geom-tools.y : self.home-y;
                z: root.z-tools;
                // taille fixe : 2 colonnes d'outils groupées comme Paint.NET (pas redimensionnable)
                float-w: 57px;
                float-h: 333px;
                title: @tr("Outils");
                bounds-width: ws.width;
                // palettes flottantes : au-dessus de la frise d'animation, jamais dessus
                bounds-height: root.phone ? ws.height : ws.height - root.anim-h;
                keep-inside: !root.phone && root.anim-h > 0px;
                close => {
                    root.show-tools = false;
                }
                raised => {
                    root.top-z += 1;
                    root.z-tools = root.top-z;
                }
                geometry-changed => {
                    root.palette-geometry("tools", self.float-x, self.float-y, self.float-w, self.float-h);
                }
                // séparateurs des groupes d'outils (gravés, comme sous Windows)
                for sy in [85px, 167px, 249px]: Rectangle {
                    x: 5px;
                    y: sy;
                    width: parent.width - 10px;
                    height: 2px;
                    Rectangle { y: 0; height: 1px; background: Theme.window-border.darker(15%); }
                    Rectangle { y: 1px; height: 1px; background: Theme.dark ? #00000040 : #ffffff; }
                }
                for t[ti] in Generated.tools: FlatButton {
                    // grisé si le calque actif refuse les pixels (calque texte, verrou, dossier)
                    enabled: !root.tool-blocked(t.id);
                    tip: self.enabled ? t.title : root.tool-blocked-tip(t.title);
                    x: t.x + 2px;
                    y: t.y + 4px;
                    width: t.w;
                    height: t.h;
                    icon: t.icon;
                    show-label: false;
                    icon-size: 15px;
                    checked: root.current-tool == t.id;
                    clicked => {
                        if (t.id != "btn-deselect" && t.id != "illu-tb-zoom-fit-2") {
                            root.current-tool = t.id;
                        }
                        root.tool-selected(t.id);
                        fs.focus();
                    }
                }
            }

            // ---- Historique ----
            if root.show-history: FloatWindow {
                docked: root.docked || root.phone;
                sheet: root.phone;
                grip: true;
                dock-movable: root.docked;
                dock-x: root.phone ? 5px : ws.width - root.dock-right;
                dock-y: root.phone ? ws.height - root.strip-height - root.sheet-h - 6px : root.ps-top(1);
                dock-w: root.phone ? ws.width - 10px : root.dock-right;
                dock-h: root.phone ? root.sheet-h : root.eff-history-h;
                dock-drag(y) => {
                    root.ps-drag-id = 1;
                    root.ps-drag-y = y;
                }
                dock-drop(y) => {
                    root.ps-drop(1, y);
                }
                snap-home: true;
                locked: root.no-doc;
                home-x: ws.width - root.side-pal-w - 8px;
                home-y: 8px + root.rul-off;
                min-x: root.rul-off;
                min-y: root.rul-off;
                float-x: root.geom-history.set ? root.geom-history.x : self.home-x;
                float-y: root.geom-history.set ? root.geom-history.y : self.home-y;
                z: root.phone ? 30 : root.z-history;
                // largeur fixe (celle des Calques) ; hauteur réglable par le haut et le bas (mémorisée)
                float-w: root.side-pal-w;
                float-h: root.geom-history.set ? root.geom-history.h : 142px;
                home-h: 142px;
                resizable: true;
                min-window-height: 70px;
                title: @tr("Historique");
                bounds-width: ws.width;
                // palettes flottantes : au-dessus de la frise d'animation, jamais dessus
                bounds-height: root.phone ? ws.height : ws.height - root.anim-h;
                keep-inside: !root.phone && root.anim-h > 0px;
                close => {
                    root.show-history = false;
                }
                raised => {
                    root.top-z += 1;
                    root.z-history = root.top-z;
                }
                geometry-changed => {
                    root.palette-geometry("history", self.float-x, self.float-y, self.float-w, self.float-h);
                }
                ListView {
                    for h[i] in root.history: Rectangle {
                        height: root.phone ? 40px : 20px;
                        background: i == root.history-index ? Theme.accent-27 : hta.has-hover ? Theme.accent-12 : transparent;
                        border-width: i == root.history-index ? 1px : 0px;
                        border-color: Theme.accent-60;
                        // téléphone : trait d'accent sur l'étape courante (comme la version web)
                        if root.phone && i == root.history-index: Rectangle {
                            x: 0;
                            width: 3px;
                            background: Theme.accent;
                        }
                        // icône du type d'action (comme l'historique de paintdotjs)
                        GlyphIcon {
                            x: root.phone ? 12px : 4px;
                            width: root.phone ? 22px : 16px;
                            opacity: i > root.history-index ? 0.45 : 1;
                            glyph: h.fa;
                            size: root.phone ? 14px : 11px;
                            tint: i > root.history-index ? Theme.text-inactive : Theme.accent;
                        }
                        Text {
                            x: root.phone ? 40px : 24px;
                            text: h.label;
                            font-size: root.phone ? 15px : Theme.font-size;
                            font-weight: root.phone && i == root.history-index ? 600 : 400;
                            color: i > root.history-index ? Theme.text-inactive : Theme.text;
                            vertical-alignment: center;
                        }
                        hta := TouchArea {
                            clicked => {
                                root.history-picked(i);
                                fs.focus();
                            }
                        }
                    }
                }
            }

            // ---- Couleurs ----
            if root.show-colors && !root.phone: FloatWindow {
                docked: root.docked;
                grip: true;
                dock-movable: root.docked;
                dock-x: root.phone ? 0px : ws.width - root.dock-right;
                dock-y: root.phone ? ws.height - root.sheet-h : root.ps-top(0);
                dock-w: root.phone ? ws.width : root.dock-right;
                dock-h: root.phone ? root.sheet-h : root.eff-colors-h;
                dock-drag(y) => {
                    root.ps-drag-id = 0;
                    root.ps-drag-y = y;
                }
                dock-drop(y) => {
                    root.ps-drop(0, y);
                }
                snap-home: true;
                locked: root.no-doc;
                home-x: 8px + root.rul-off;
                home-y: root.view-bottom - cpanel.wanted-height - 8px;
                min-x: root.rul-off;
                min-y: root.rul-off;
                float-x: root.geom-colors.set ? root.geom-colors.x : self.home-x;
                float-y: root.geom-colors.set ? root.geom-colors.y : self.home-y;
                z: root.z-colors;
                // largeur fixe selon le mode (compact / « Plus »), pas redimensionnable
                geometry-changed => {
                    root.palette-geometry("colors", self.float-x, self.float-y, self.float-w, self.float-h);
                }
                float-w: root.colors-expanded ? 534px : 197px;
                // hauteur demandée par le contenu à la largeur courante
                float-h: cpanel.wanted-height;
                title: @tr("Couleurs");
                bounds-width: ws.width;
                // palettes flottantes : au-dessus de la frise d'animation, jamais dessus
                bounds-height: root.phone ? ws.height : ws.height - root.anim-h;
                keep-inside: !root.phone && root.anim-h > 0px;
                close => {
                    root.show-colors = false;
                }
                raised => {
                    root.top-z += 1;
                    root.z-colors = root.top-z;
                }
                cpanel := ColorsPanel {
                    wheel: root.wheel-image;
                    grid-image: root.color-grid-image;
                    mode-palette: root.mode-palette;
                    gray: root.gray-palette;
                    info: root.color-info;
                    favorites: root.fav-colors;
                    recents: root.recent-colors;
                    full-palette: Palettes.full;
                    fav-add => {
                        root.fav-action("add", -1);
                    }
                    fav-remove(i) => {
                        root.fav-action("remove", i);
                    }
                    primary <=> root.primary-color;
                    secondary <=> root.secondary-color;
                    edit-secondary <=> root.color-edit-secondary;
                    expanded <=> root.colors-expanded;
                    square <=> root.colors-grid;
                    comps: root.color-comps;
                    hex: root.color-hex;
                    wheel-picked(x, y, s, r) => {
                        root.wheel-picked(x, y, s, r);
                    }
                    hsv-picked(h, s, v, r) => {
                        root.hsv-picked(h, s, v, r);
                    }
                    component-changed(i, v) => {
                        root.color-component(i, v);
                    }
                    hex-edited(t) => {
                        root.color-hex-edited(t);
                    }
                    pick-screen => {
                        root.tool-selected("tool-eyedropper");
                    }
                    // hauteur de la colonne ancrée (Photoshop) : celle que demande le contenu
                    init => {
                        root.colors-want-h = self.wanted-height;
                    }
                    changed wanted-height => {
                        root.colors-want-h = self.wanted-height;
                    }
                }
            }

            // ---- téléphone : panneaux du bas (Couleurs, menus), fermés par un appui à côté ----
            if root.phone && (root.show-colors || root.show-layers || root.show-history || root.phone-sheet != ""): TouchArea {
                z: 25;
                clicked => {
                    root.show-colors = false;
                    root.show-layers = false;
                    root.show-history = false;
                    root.phone-sheet = "";
                }
            }
            if root.phone && root.show-colors: MobSheet {
                x: 5px;
                z: 30;
                width: ws.width - 10px;
                height: min(root.mob-sheet-max,mcol.wanted-height + 18px + 50px);
                y: ws.height - root.strip-height - self.height - 6px;
                close => {
                    root.show-colors = false;
                }
                mcol := MobColors {
                    wheel: root.wheel-image;
                    grid-image: root.color-grid-image;
                    grid <=> root.colors-grid;
                    primary <=> root.primary-color;
                    secondary <=> root.secondary-color;
                    mode-palette: root.mode-palette;
                    gray: root.gray-palette;
                    info: root.color-info;
                    favorites: root.fav-colors;
                    recents: root.recent-colors;
                    edit-secondary <=> root.color-edit-secondary;
                    comps: root.color-comps;
                    hex: root.color-hex;
                    fav-add => {
                        root.fav-action("add", -1);
                    }
                    fav-remove(i) => {
                        root.fav-action("remove", i);
                    }
                    wheel-picked(x, y, s, r) => {
                        root.wheel-picked(x, y, s, r);
                    }
                    hsv-picked(h, s, v, r) => {
                        root.hsv-picked(h, s, v, r);
                    }
                    component-changed(i, v) => {
                        root.color-component(i, v);
                    }
                    hex-edited(t) => {
                        root.color-hex-edited(t);
                    }
                    pick-screen => {
                        // la pipette se pose sur la toile : panneau fermé
                        root.show-colors = false;
                        root.tool-selected("tool-eyedropper");
                    }
                    quick(q) => {
                        root.phone-do(q);
                    }
                }
            }
            if root.phone && root.phone-sheet != "": MobSheet {
                x: 5px;
                z: 30;
                width: ws.width - 10px;
                height: min(root.mob-sheet-max,msl.wanted-height + 26px);
                y: ws.height - root.strip-height - self.height - 6px;
                footer: false;
                msl := MobMenuList {
                    rows: root.phone-sheet-rows;
                    activate(a, l) => {
                        root.phone-sheet = "";
                        root.menu-action(a, l);
                    }
                }
            }

            // ---- Calques ----
            if root.show-layers: FloatWindow {
                docked: root.docked || root.phone;
                sheet: root.phone;
                grip: true;
                dock-movable: root.docked;
                dock-x: root.phone ? 5px : ws.width - root.dock-right;
                dock-y: root.phone ? ws.height - root.strip-height - root.sheet-h - 6px : root.ps-top(2);
                dock-w: root.phone ? ws.width - 10px : root.dock-right;
                dock-h: root.phone ? root.sheet-h : root.eff-layers-h;
                dock-drag(y) => {
                    root.ps-drag-id = 2;
                    root.ps-drag-y = y;
                }
                dock-drop(y) => {
                    root.ps-drop(2, y);
                }
                snap-home: true;
                locked: root.no-doc;
                home-x: ws.width - root.side-pal-w - 8px;
                home-y: root.view-bottom - 262px;
                min-x: root.rul-off;
                min-y: root.rul-off;
                float-x: root.geom-layers.set ? root.geom-layers.x : self.home-x;
                float-y: root.geom-layers.set ? root.geom-layers.y : self.home-y;
                z: root.phone ? 30 : root.z-layers;
                // largeur fixe (= Historique) ; hauteur réglable par le haut et le bas (mémorisée)
                float-w: root.side-pal-w;
                float-h: root.geom-layers.set ? root.geom-layers.h : 254px;
                home-h: 254px;
                resizable: true;
                min-window-height: 190px;
                title: @tr("Calques");
                bounds-width: ws.width;
                // palettes flottantes : au-dessus de la frise d'animation, jamais dessus
                bounds-height: root.phone ? ws.height : ws.height - root.anim-h;
                keep-inside: !root.phone && root.anim-h > 0px;
                close => {
                    root.show-layers = false;
                }
                raised => {
                    root.top-z += 1;
                    root.z-layers = root.top-z;
                }
                geometry-changed => {
                    root.palette-geometry("layers", self.float-x, self.float-y, self.float-w, self.float-h);
                }
                ListView {
                    y: 2px;
                    height: parent.content-height - 100px;
                    for l[row] in root.layers: lrow := Rectangle {
                        height: 28px;
                        // filtre dynamique ƒ : ligne dorée ; masque α : ligne violette (plus vives
                        // quand le calque est actif, texte blanc)
                        property <bool> act: l.index == root.active-layer;
                        property <int> mark: l.dyn-on ? 1 : l.has-mask && !l.is-mask-doc ? 2 : 0;
                        background: self.mark == 1
                            ? (self.act ? @linear-gradient(180deg, #e0b23a 0%, #a87c0c 100%)
                                : Theme.dark ? @linear-gradient(180deg, #d4a01738 0%, #d4a01722 100%) : @linear-gradient(180deg, #fff8e6 0%, #ffecc4 100%))
                            : self.mark == 2
                            ? (self.act ? @linear-gradient(180deg, #7b5fd9 0%, #4a3a82 100%)
                                : Theme.dark ? @linear-gradient(180deg, #8b6fe93a 0%, #8b6fe922 100%) : @linear-gradient(180deg, #ebe6f7 0%, #ddd4f2 100%))
                            : self.act ? Theme.accent.with-alpha(0.3) : lta.has-hover ? Theme.accent-12 : transparent;
                        // liseré à gauche (comme la version web)
                        if lrow.mark != 0: Rectangle {
                            x: 0;
                            width: 3px;
                            background: lrow.mark == 1 ? (lrow.act ? #ffdf7e : #d4a017) : (lrow.act ? #b9a6ff : #6b4fc9);
                        }
                        opacity: root.drag-from == row && root.drag-to != row ? 0.5 : 1;
                        // glisser-déposer pour réordonner (appui maintenu puis déplacement)
                        lta := TouchArea {
                            clicked => {
                                root.layer-clicked(l.index);
                                fs.focus();
                            }
                            // double-clic : renommer le calque
                            double-clicked => {
                                root.layer-rename(l.index);
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                    root.layer-clicked(l.index);
                                    root.context-request("layer", l.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, false);
                                } else if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                    root.drag-from = row;
                                    root.drag-to = row;
                                } else if (e.kind == PointerEventKind.up) {
                                    if (root.drag-from >= 0 && root.drag-to != root.drag-from) {
                                        root.layer-drag(root.drag-from, root.drag-to);
                                    }
                                    root.drag-from = -1;
                                    root.drag-to = -1;
                                }
                            }
                            moved => {
                                if (self.pressed && root.drag-from >= 0) {
                                    root.drag-to = clamp(row + floor(self.mouse-y / 28px), 0, root.layers.length - 1);
                                }
                            }
                            mouse-cursor: root.drag-from >= 0 && root.drag-to != root.drag-from ? MouseCursor.grabbing : MouseCursor.default;
                        }
                        // repère d'insertion
                        if root.drag-from >= 0 && root.drag-to == row && root.drag-to != root.drag-from: Rectangle {
                            y: root.drag-to < root.drag-from ? 0px : parent.height - 2px;
                            height: 2px;
                            background: Theme.accent;
                        }
                        // contenu d'un dossier : retrait de 12 px par niveau
                        property <length> ind: l.depth * 12px;
                        // petits boutons à droite : cadenas, puis α / corbeille / ƒ / fx
                        property <int> nbtn: 1 + (l.is-mask-doc ? 0
                            : (!l.dyn-on && !l.is-group ? 1 : 0) + (l.has-mask ? 1 : 0)
                              + (!l.is-group && !l.is-text ? 1 : 0) + (l.dyn-on ? 1 : 0) + (l.is-text && l.fx-count > 0 ? 1 : 0));
                        W10CheckBox {
                            x: 6px + parent.ind;
                            tip: @tr("Afficher / masquer le calque");
                            checked: l.visible;
                            toggled(v) => {
                                root.layer-visibility(l.index, v);
                            }
                        }
                        // dossier : chevron replier / déplier et icône de dossier
                        if l.is-group: Rectangle {
                            x: 28px + parent.ind;
                            y: 4px;
                            width: 16px;
                            height: 20px;
                            border-radius: Theme.ctl-radius;
                            background: chev.has-hover ? Theme.accent-14 : transparent;
                            FaIcon {
                                glyph: l.collapsed ? "\u{f054}" : "\u{f078}";
                                size: 9px;
                                color: Theme.text;
                            }
                            chev := TouchArea {
                                clicked => {
                                    root.layer-toggle(l.index, "collapse");
                                }
                            }
                        }
                        if l.is-group: GlyphIcon {
                            x: 46px + parent.ind;
                            y: 4px;
                            width: 22px;
                            height: 20px;
                            glyph: l.collapsed ? "\u{f07b}" : "\u{f07c}";
                            size: 14px;
                            tint: Theme.accent;
                        }
                        if !l.is-group: Rectangle {
                            x: 30px + parent.ind;
                            y: 4px;
                            width: 38px;
                            height: 20px;
                            border-width: 1px;
                            border-color: #c0c0c0;
                            Image {
                                source: l.thumb;
                                width: parent.width - 2px;
                                height: parent.height - 2px;
                                image-fit: contain;
                            }
                            // calque SVG : pastille « T » (textes) ou objets à poignées (formes)
                            if l.is-text: Rectangle {
                                x: parent.width - 12px;
                                y: parent.height - 11px;
                                width: 12px;
                                height: 11px;
                                border-radius: 2px * Theme.round;
                                background: Theme.accent;
                                Rectangle {
                                    visible: l.vec-shapes;
                                    width: 9px;
                                    height: 9px;
                                    border-radius: 4.5px;
                                    border-width: 1.5px;
                                    border-color: Theme.on-accent;
                                }
                                Text {
                                    visible: !l.vec-shapes;
                                    text: "T";
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: Theme.on-accent;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Text {
                            x: 74px + parent.ind;
                            width: max(10px, parent.width - 80px - parent.ind - parent.nbtn * 22px);
                            text: l.name;
                            font-size: Theme.font-size;
                            font-weight: l.is-group || (lrow.mark != 0 && lrow.act) ? 600 : 400;
                            color: lrow.mark != 0 && lrow.act ? #ffffff : Theme.text;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            x: parent.width - self.preferred-width - 4px;
                            y: 4px;
                            height: 20px;
                            spacing: 2px;
                            LayerMiniButton {
                                glyph: l.locked ? "\u{f023}" : "\u{f09c}";
                                on: l.locked;
                                opacity: l.locked || lta.has-hover ? 1 : 0.35;
                                tip: l.locked ? @tr("Calque verrouillé — cliquer pour le déverrouiller") : @tr("Verrouiller le calque (ni dessin, ni effet, ni déplacement)");
                                clicked => {
                                    root.layer-toggle(l.index, "lock");
                                }
                            }
                            if l.is-text && l.fx-count > 0 && !l.is-mask-doc: LayerMiniButton {
                                label: "fx";
                                bold: true;
                                tip: @tr("Effets du calque texte (non destructifs) : activer, ordre, supprimer");
                                clicked => {
                                    root.layer-toggle(l.index, "text-fx");
                                }
                            }
                            if !l.dyn-on && !l.is-group && !l.is-mask-doc: LayerMiniButton {
                                label: "α";
                                on: l.has-mask;
                                tip: l.has-mask ? @tr("Masque alpha (actif) — éditer") : @tr("Créer / ouvrir le masque alpha");
                                clicked => {
                                    root.layer-alpha(l.index, false);
                                }
                            }
                            if l.has-mask && !l.is-mask-doc: LayerMiniButton {
                                glyph: "\u{f2ed}";
                                tip: @tr("Supprimer le masque α");
                                clicked => {
                                    root.layer-alpha(l.index, true);
                                }
                            }
                            if l.dyn-on && !l.is-mask-doc: LayerMiniButton {
                                glyph: "\u{f1de}";
                                tip: @tr("Effets appliqués : ordre, puissance et réglages");
                                clicked => { root.applied-fx-open(l.index); }
                            }
                            if !l.is-group && !l.is-text && !l.is-mask-doc: LayerMiniButton {
                                label: "ƒ";
                                bold: l.dyn-on;
                                on: l.dyn-on;
                                enabled: !l.has-mask;
                                tip: l.has-mask ? @tr("Masque α actif : retirez-le pour utiliser le filtre dynamique (ƒ).") : @tr("Activer ou désactiver le calque de filtres dynamiques. Ajoutez et réglez ses effets depuis le menu Effets.");
                                clicked => {
                                    root.layer-filter-toggle(l.index);
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    y: parent.content-height - 96px;
                    height: 1px;
                    background: Theme.window-border;
                }
                Text {
                    x: 6px;
                    y: parent.content-height - 88px;
                    height: 22px;
                    text: @tr("Fusion");
                    font-size: Theme.font-size;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                W10ComboBox {
                    x: 55px;
                    y: parent.content-height - 88px;
                    // suit la largeur de la palette (redimensionnable)
                    width: max(132px, parent.width - 61px);
                    model: [@tr("Normal"), @tr("Multiplier"), @tr("Écran"), @tr("Superposition"), @tr("Lumière douce"), @tr("Lumière dure"), @tr("Assombrir"), @tr("Éclaircir"), @tr("Lumière crue"), @tr("Densité couleur +"), @tr("Différence"), @tr("Exclusion"), @tr("Teinte"), @tr("Saturation"), @tr("Couleur"), @tr("Luminosité")];
                    tip: @tr("Définit comment les couleurs du calque se mélangent avec les calques situés dessous.");
                    current-index <=> root.layer-blend;
                    selected(i) => {
                        root.layer-props(root.layer-opacity, i);
                    }
                }
                Text {
                    x: 6px;
                    y: parent.content-height - 62px;
                    height: 20px;
                    text: @tr("Opacité");
                    font-size: Theme.font-size;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                W10Slider {
                    x: 55px;
                    y: parent.content-height - 62px;
                    width: max(85px, parent.width - 108px);
                    tip: @tr("Règle la transparence du calque entier, sans modifier ses pixels.");
                    value <=> root.layer-opacity;
                    changed(v) => {
                        root.layer-props(v, root.layer-blend);
                    }
                }
                Text {
                    x: max(146px, parent.width - 47px);
                    y: parent.content-height - 62px;
                    height: 20px;
                    text: round(root.layer-opacity) + " %";
                    font-size: Theme.font-size;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Rectangle {
                    y: parent.content-height - 34px;
                    height: 1px;
                    background: Theme.window-border;
                }
                // barre d'outils calques : 7 boutons de 24 px répartis régulièrement sur la largeur
                // (ajouter, supprimer, nouveau dossier, dupliquer, fusionner, monter, descendre)
                HorizontalLayout {
                    x: 6px;
                    width: parent.width - 12px;
                    y: parent.content-height - 29px;
                    height: 24px;
                    alignment: space-between;
                    for a in [
                        { id: "add", g: "\u{f067}", t: @tr("Ajouter un calque") },          // ajouter un calque
                        { id: "delete", g: "\u{f068}", t: @tr("Supprimer le calque") },       // supprimer le calque actif (−)
                        { id: "group-new", g: "\u{f65e}", t: @tr("Nouveau dossier") },    // nouveau dossier
                        { id: "duplicate", g: "\u{f24d}", t: @tr("Dupliquer le calque") },    // dupliquer
                        { id: "merge", g: "\u{f0ec}", t: @tr("Fusionner le calque") },        // fusionner
                        { id: "up", g: "\u{f062}", t: @tr("Monter le calque") },           // monter
                        { id: "down", g: "\u{f063}", t: @tr("Descendre le calque") },         // descendre
                    ]: FlatButton {
                        width: 24px;
                        height: 24px;
                        icon: { svg-index: -1, fa: a.g, fa-weight: 900 };
                        // fusionner : icône du sprite (comme la version web) ; « − » : icône maison
                        // (le glyphe seul serait pris pour l'outil Ligne par MpIcons.for-spec)
                        img: a.id == "merge" ? Sprite.layer-merge : a.id == "delete" ? MpIcons.images[MpIcons.for-glyph(a.g)] : root.no-image;
                        show-label: false;
                        icon-size: 12px;
                        tip: Tips.desc(a.t) != "" ? Tips.desc(a.t) : a.t;
                        enabled: a.id == "merge" ? root.active-layer > 0
                            : a.id == "delete" ? root.layers.length > 1
                            : a.id == "down" ? root.active-layer > 0
                            : a.id == "up" ? root.active-layer < root.layers.length - 1
                            : true;
                        clicked => {
                            root.layer-action(a.id);
                            fs.focus();
                        }
                    }
                }
            }

            // ---- colonne de droite (Photoshop) : séparateurs de hauteur et repère d'insertion ----
            // Couleurs (0) et Historique (1) se règlent au séparateur ; la palette de remplissage
            // prend le reste. Séparateur du bas : la palette grandit vers le bas ; séparateur du
            // haut (palette de remplissage au-dessus) : elle grandit vers le haut.
            for id in [0, 1]: Rectangle {
                visible: root.docked && root.ps-shown(id) && root.ps-filler != id;
                x: ws.width - root.dock-right;
                y: 0px;
                width: root.dock-right;
                // toute la hauteur (sans fond ni zone tactile : les clics passent aux palettes)
                height: ws.height;
                z: root.top-z + 1;
                if root.ps-below-any(id): TouchArea {
                    y: root.ps-top(id) + root.ps-hh(id) - 3px;
                    height: 6px;
                    mouse-cursor: ns-resize;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.up) {
                            root.settings-changed();
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.ps-resize(id, self.mouse-y - self.pressed-y);
                        }
                    }
                }
                if root.ps-filler-above(id): TouchArea {
                    y: root.ps-top(id) - 3px;
                    height: 6px;
                    mouse-cursor: ns-resize;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.up) {
                            root.settings-changed();
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.ps-resize(id, self.pressed-y - self.mouse-y);
                        }
                    }
                }
            }
            if root.docked && root.ps-drag-id >= 0: Rectangle {
                x: ws.width - root.dock-right + 4px;
                width: root.dock-right - 8px;
                y: clamp(root.ps-marker-y(root.ps-drag-id, root.ps-drag-y) - 1.5px, 0px, ws.height - 3px);
                height: 3px;
                border-radius: 1.5px * Theme.round;
                background: Theme.accent;
                z: root.top-z + 2;
            }

            // ---- Effets du calque texte (non destructifs, rejoués sur le rendu du texte) ----
            if root.show-text-fx: FloatWindow {
                float-x: max(10px, ws.width - 560px);
                float-y: 40px;
                z: root.z-dialog;
                float-w: 300px;
                float-h: 280px;
                title: @tr("Effets du calque texte");
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.show-text-fx = false;
                    fs.focus();
                }
                Text {
                    x: 10px;
                    y: 6px;
                    width: parent.width - 20px;
                    height: 30px;
                    text: @tr("Appliqués dans l'ordre, de haut en bas. Un effet du menu choisi sur ce calque s'ajoute ici.");
                    wrap: word-wrap;
                    font-size: Theme.small-font-size;
                    color: Theme.text-inactive;
                }
                ListView {
                    x: 6px;
                    y: 40px;
                    width: parent.width - 12px;
                    height: parent.content-height - 40px - 48px;
                    for f[i] in root.text-fx: Rectangle {
                        height: 28px;
                        border-radius: Theme.ctl-radius;
                        background: fta.has-hover ? Theme.accent-12 : transparent;
                        fta := TouchArea { }
                        W10CheckBox {
                            x: 4px;
                            checked: f.on;
                            tip: @tr("Activer / désactiver l'effet");
                            toggled => {
                                root.text-fx-action(i, "toggle");
                            }
                        }
                        Text {
                            x: 28px;
                            width: parent.width - 28px - 70px;
                            text: f.label;
                            font-size: Theme.font-size;
                            color: f.on ? Theme.text : Theme.text-inactive;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            x: parent.width - self.preferred-width - 2px;
                            y: 4px;
                            height: 20px;
                            spacing: 2px;
                            LayerMiniButton {
                                glyph: "\u{f062}";
                                enabled: i > 0;
                                tip: @tr("Plus tôt dans la pile");
                                clicked => {
                                    root.text-fx-action(i, "up");
                                }
                            }
                            LayerMiniButton {
                                glyph: "\u{f063}";
                                enabled: i < root.text-fx.length - 1;
                                tip: @tr("Plus tard dans la pile");
                                clicked => {
                                    root.text-fx-action(i, "down");
                                }
                            }
                            LayerMiniButton {
                                glyph: "\u{f2ed}";
                                tip: @tr("Retirer l'effet");
                                clicked => {
                                    root.text-fx-action(i, "delete");
                                }
                            }
                        }
                    }
                }
                if root.text-fx.length == 0: Text {
                    x: 10px;
                    y: 48px;
                    text: @tr("Aucun effet sur ce calque.");
                    font-size: Theme.font-size;
                    color: Theme.text-inactive;
                }
                DialogFooter {
                    y: parent.content-height - 44px;
                    W10Button {
                        width: 76px;
                        text: @tr("Fermer");
                        primary: true;
                        clicked => {
                            root.show-text-fx = false;
                            fs.focus();
                        }
                    }
                }
            }

            // Applied effects only: adding new effects stays in the Effects menu.
            if root.show-applied-fx: FloatWindow {
                float-x: max(6px, ws.width - 690px);
                float-y: 30px;
                float-w: min(440px, ws.width - 12px);
                float-h: min(490px, root.usable-height - ws.y - 12px);
                title: @tr("Filtre dynamique") + " — " + root.applied-fx-layer;
                z: root.z-dialog;
                docked: root.phone;
                dock-x: 0px;
                dock-w: ws.width;
                dock-h: min(490px, root.mob-sheet-max);
                dock-y: ws.height - root.strip-height - self.dock-h - 6px;
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => { root.show-applied-fx = false; fs.focus(); }
                // présentation en cartes (comme l'ancienne fenêtre « Filtre dynamique ») : zone
                // d'action en haut, puis une carte par effet de la chaîne, appliqués de haut en bas
                Text {
                    x: 12px; y: 8px; width: parent.width - 24px; height: 34px;
                    text: @tr("Les effets s'appliquent à tout ce qui est sous ce calque, dans la zone peinte en blanc. Plusieurs effets se cumulent, de haut en bas.");
                    wrap: word-wrap; color: Theme.text;
                }
                HorizontalLayout {
                    x: 12px; y: 48px; width: parent.width - 24px; height: 30px; spacing: 10px;
                    W10CheckBox {
                        y: 5px;
                        checked: root.applied-fx-zone;
                        tip: @tr("Afficher la zone en noir et blanc (blanc = effet actif) pour la régler au pinceau");
                        toggled => { root.applied-fx-zone-toggle(); }
                    }
                    Text { text: @tr("Voir la zone"); color: Theme.text; vertical-alignment: center;
                        TouchArea { clicked => { root.applied-fx-zone-toggle(); } }
                    }
                    Segmented {
                        horizontal-stretch: 1;
                        options: [@tr("Zone dessinée"), @tr("Partout")];
                        index: root.applied-fx-mode == 2 ? 1 : 0;
                        selected(i) => { root.applied-fx-scope(i == 1 ? 2 : 0); }
                        tip: @tr("Appliquer les effets seulement dans la zone dessinée ou partout");
                    }
                }
                HorizontalLayout {
                    x: 12px; y: 88px; width: parent.width - 24px; height: 26px; spacing: 6px;
                    Text {
                        horizontal-stretch: 1;
                        text: @tr("Chaîne d'effets (12 au maximum)");
                        font-weight: 700; color: Theme.text; vertical-alignment: center;
                    }
                    W10Button {
                        text: @tr("+ Effet");
                        tip: @tr("Ouvre le menu Effets : l'effet choisi s'ajoute à la chaîne");
                        clicked => { root.applied-fx-action(-1, "add"); }
                    }
                }
                ListView {
                    x: 8px; y: 120px; width: parent.width - 16px;
                    height: max(30px, parent.content-height - 168px);
                    for f[i] in root.applied-fx: Rectangle {
                        height: f.quick-label != "" ? 134px : 106px;
                        Rectangle {
                            x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                            border-radius: Theme.ctl-radius;
                            border-width: 1px;
                            border-color: Theme.window-border;
                            background: Theme.dark ? Theme.window-bg.brighter(4%) : Theme.window-bg.darker(2%);
                            // en-tête : case on/off, « Effet N », ordre et suppression
                            HorizontalLayout {
                                x: 8px; y: 6px; width: parent.width - 16px; height: 26px; spacing: 4px;
                                W10CheckBox {
                                    y: 5px;
                                    checked: f.on;
                                    tip: @tr("Activer / désactiver l'effet");
                                    toggled => { root.applied-fx-action(i, "toggle"); }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: @tr("Effet ") + (i + 1);
                                    font-weight: 700; color: f.on ? Theme.text : Theme.text-inactive;
                                    vertical-alignment: center;
                                }
                                W10Button { width: 30px; text: "↑"; tip: @tr("Plus tôt dans la chaîne");
                                    clicked => { if (i > 0) { root.applied-fx-action(i, "up"); } }
                                }
                                W10Button { width: 30px; text: "↓"; tip: @tr("Plus tard dans la chaîne");
                                    clicked => { if (i < root.applied-fx.length - 1) { root.applied-fx-action(i, "down"); } }
                                }
                                W10Button { text: @tr("Supprimer"); tip: @tr("Retirer l'effet de la chaîne");
                                    clicked => { root.applied-fx-action(i, "delete"); }
                                }
                            }
                            // nom de l'effet (clic : ses réglages)
                            HorizontalLayout {
                                x: 8px; y: 38px; width: parent.width - 16px; height: 26px; spacing: 8px;
                                Text { width: 70px; text: @tr("Effet"); color: Theme.text; vertical-alignment: center; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: Theme.ctl-radius;
                                    background: Theme.field-bg;
                                    border-width: 1px;
                                    border-color: eta.has-hover && f.editable ? Theme.accent : Theme.field-border;
                                    Text {
                                        x: 8px; width: parent.width - 34px; height: parent.height;
                                        text: f.label; color: f.on ? Theme.text : Theme.text-inactive;
                                        overflow: elide; vertical-alignment: center;
                                    }
                                    if f.editable: GlyphIcon {
                                        x: parent.width - 24px; y: (parent.height - self.height) / 2;
                                        glyph: "\u{f1de}"; size: 11px;
                                    }
                                    HoverTip { y: parent.height; hovered: eta.has-hover && f.editable; text: @tr("Modifier les réglages de l'effet"); }
                                    eta := TouchArea {
                                        mouse-cursor: f.editable ? MouseCursor.pointer : MouseCursor.default;
                                        clicked => { if (f.editable) { root.applied-fx-action(i, "edit"); } }
                                    }
                                }
                            }
                            HorizontalLayout {
                                x: 8px; y: 70px; width: parent.width - 16px; height: 22px; spacing: 8px;
                                Text { width: 70px; text: @tr("Intensité"); color: Theme.text; vertical-alignment: center; }
                                W10Slider { controlled: true; value: f.strength;
                                    tip: @tr("Intensité de l'effet (0 à 100 %)");
                                    changed(v) => { root.applied-fx-value(i, false, v, false); }
                                    released(v) => { root.applied-fx-value(i, false, v, true); }
                                }
                                Text { width: 40px; text: round(f.strength) + " %"; color: Theme.text; horizontal-alignment: right; vertical-alignment: center; }
                            }
                            if f.quick-label != "": HorizontalLayout {
                                x: 8px; y: 98px; width: parent.width - 16px; height: 22px; spacing: 8px;
                                Text { width: 70px; text: f.quick-label; color: Theme.text; overflow: elide; vertical-alignment: center; }
                                W10Slider { controlled: true; minimum: f.quick-min; maximum: f.quick-max; value: f.quick-value; tip: f.quick-label;
                                    changed(v) => { root.applied-fx-value(i, true, v, false); }
                                    released(v) => { root.applied-fx-value(i, true, v, true); }
                                }
                                Text { width: 40px; text: round(f.quick-value * 100) / 100; color: Theme.text; horizontal-alignment: right; vertical-alignment: center; }
                            }
                        }
                    }
                }
                if root.applied-fx.length == 0: Text {
                    x: 12px; y: 130px; width: parent.width - 24px;
                    text: @tr("Aucun effet pour l'instant : « + Effet » ou le menu Effets en ajoute un.");
                    color: Theme.text-inactive; wrap: word-wrap;
                }
                DialogFooter { y: parent.content-height - 44px;
                    W10Button { text: @tr("Fermer"); primary: true;
                        clicked => { root.show-applied-fx = false; fs.focus(); }
                    }
                }
            }

            // ---- Objets SVG (bêta) : objets du calque vectoriel actif (ui/svg_objects.slint) ----
            if SvgPanel.open: FloatWindow {
                float-x: max(6px, ws.width - 640px);
                float-y: 60px;
                float-w: min(320px, ws.width - 12px);
                float-h: min(440px, root.usable-height - ws.y - 12px);
                title: @tr("Objets SVG (bêta)");
                z: root.z-dialog;
                docked: root.phone;
                dock-x: 0px;
                dock-w: ws.width;
                dock-h: min(440px, root.mob-sheet-max);
                dock-y: ws.height - root.strip-height - self.dock-h - 6px;
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => { SvgPanel.open = false; fs.focus(); }
                SvgObjectsContent {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.content-height;
                }
            }

            // ---- Courbes ----
            if root.show-curves: FloatWindow {
                float-x: max(10px, ws.width - 640px);
                float-y: 20px;
                z: root.z-dialog;
                float-w: 300px;
                float-h: 404px;
                title: @tr("Courbes");
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.curves-action("cancel", 0);
                    fs.focus();
                }
                Segmented {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: 24px;
                    options: [@tr("RVB"), @tr("Rouge"), @tr("Vert"), @tr("Bleu")];
                    index: root.curves-channel;
                    selected(i) => {
                        root.curves-action("channel", i);
                    }
                }
                curve-box := Rectangle {
                    x: 22px;
                    y: 40px;
                    width: 256px;
                    height: 256px;
                    background: Theme.dark ? #1e1e1e : #ffffff;
                    border-width: 1px;
                    border-color: Theme.window-border;
                    clip: true;
                    // histogramme du canal
                    Path {
                        width: parent.width;
                        height: parent.height;
                        viewbox-width: 255;
                        viewbox-height: 255;
                        commands: root.curves-hist;
                        fill: Theme.dark ? #ffffff28 : #00000020;
                    }
                    // quadrillage (quarts) et diagonale de référence
                    Path {
                        width: parent.width;
                        height: parent.height;
                        viewbox-width: 255;
                        viewbox-height: 255;
                        commands: "M 64 0 V 255 M 128 0 V 255 M 191 0 V 255 M 0 64 H 255 M 0 128 H 255 M 0 191 H 255 M 0 255 L 255 0";
                        stroke: Theme.dark ? #ffffff30 : #00000028;
                        stroke-width: 1px;
                    }
                    Path {
                        width: parent.width;
                        height: parent.height;
                        viewbox-width: 255;
                        viewbox-height: 255;
                        commands: root.curves-path;
                        stroke: root.curves-channel == 1 ? #d03030 : root.curves-channel == 2 ? #20a040 : root.curves-channel == 3 ? #3060e0 : Theme.text;
                        stroke-width: 1.5px;
                    }
                    for pt in root.curves-points: Rectangle {
                        x: pt.x / 255 * parent.width - 4px;
                        y: (255 - pt.y) / 255 * parent.height - 4px;
                        width: 8px;
                        height: 8px;
                        background: pt.round ? Theme.accent : Theme.window-bg;
                        border-width: 1px;
                        border-color: Theme.text;
                    }
                    TouchArea {
                        pointer-event(e) => {
                            let cx = self.mouse-x / self.width * 255;
                            let cy = 255 - self.mouse-y / self.height * 255;
                            if (e.kind == PointerEventKind.down) {
                                root.curves-pointer(0, cx, cy, e.button == PointerEventButton.right);
                            } else if (e.kind == PointerEventKind.up) {
                                root.curves-pointer(2, cx, cy, false);
                            } else if (e.kind == PointerEventKind.move && self.pressed) {
                                root.curves-pointer(1, cx, cy, false);
                            }
                        }
                    }
                }
                Text {
                    x: 10px;
                    y: 302px;
                    width: parent.width - 20px;
                    text: @tr("Clic : ajouter / déplacer un point · clic droit : supprimer");
                    font-size: Theme.font-size - 1px;
                    color: Theme.text;
                    opacity: 0.75;
                    horizontal-alignment: center;
                }
                DialogFooter {
                    y: parent.content-height - 44px;
                    if root.curves-dynamic-edit: W10Button {
                        width: 28px; text: "−"; tip: @tr("Supprimer");
                        clicked => { root.curves-action("remove",0); }
                    }
                    W10Button {
                        width: 28px; text: "↺"; tip: @tr("Réinitialiser");
                        clicked => {
                            root.curves-action("reset", 0);
                        }
                    }
                    W10Button {
                        text: @tr("OK");
                        primary: true;
                        clicked => {
                            root.curves-action("ok", 0);
                            fs.focus();
                        }
                    }
                    W10Button {
                        text: @tr("Annuler");
                        clicked => {
                            root.curves-action("cancel", 0);
                            fs.focus();
                        }
                    }
                }
            }

            // ---- Paramètres : sections à gauche (comme paintdotjs), réglages de la version web ----
            if root.show-settings: settingswin := FloatWindow {
                // largeur des textes de la page (explications renvoyées à la ligne)
                property <bool> compact: self.width < 600px;
                property <length> sidebar-width: self.compact ? 0px : 171px;
                property <length> heading-height: self.compact ? 42px : 0px;
                property <length> tw: max(230px, self.width - self.sidebar-width - 34px);
                float-x: (ws.width - 840px) / 2;
                float-y: (root.usable-height - min(660px, root.usable-height - 24px)) / 2 - ws.y;
                z: root.z-dialog;
                float-w: 840px;
                float-h: min(660px, root.usable-height - 24px);
                full-window-area: true;
                // taille fixe (la page défile) : seuls Calques, Historique, la Visionneuse et
                // l'Aperçu 1:1 se redimensionnent
                title: @tr("Paramètres");
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.show-settings = false;
                    root.settings-changed();
                    fs.focus();
                }
                // colonne des sections
                Rectangle {
                    visible: !parent.compact;
                    x: 0;
                    y: 0;
                    width: 170px;
                    height: parent.content-height - 44px;
                    background: Theme.dark ? Theme.list-bg : Theme.window-bg.darker(3%);
                    VerticalLayout {
                        height: max(0px, parent.height - 78px);
                        padding: 8px;
                        spacing: 2px;
                        alignment: start;
                        for sec in [
                            { g: "\u{f53f}", t: @tr("Apparence"), p: 0 },
                            { g: "\u{f1fc}", t: @tr("Toile et outils"), p: 1 },
                            { g: "\u{f0ea}", t: @tr("Édition"), p: 2 },
                            { g: "\u{f3fd}", t: @tr("Performances"), p: 3 },
                            { g: "\u{f0c7}", t: @tr("Données"), p: 4 },
                            { g: "\u{f11c}", t: @tr("Raccourcis"), p: 5 },
                            { g: "\u{f085}", t: @tr("Avancé et infos"), p: 6 },
                        ]: Rectangle {
                            property <int> si: sec.p;
                            height: 32px;
                            border-radius: Theme.ctl-radius;
                            background: root.settings-page == si ? Theme.accent-14 : secta.has-hover ? Theme.accent-12 : transparent;
                            Rectangle {
                                x: 0;
                                y: 7px;
                                width: 3px;
                                height: parent.height - 14px;
                                border-radius: 2px * Theme.round;
                                background: root.settings-page == si ? Theme.accent : transparent;
                            }
                            GlyphIcon {
                                x: 12px;
                                y: round((parent.height - self.height) / 2 / 1px) * 1px;
                                width: 18px;
                                glyph: sec.g;
                                size: 13px;
                                tint: root.settings-page == si ? Theme.accent : Theme.text;
                            }
                            Text {
                                x: 38px;
                                height: parent.height;
                                text: sec.t;
                                font-weight: root.settings-page == si ? 600 : 400;
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                            HoverTip { y: parent.height; hovered: secta.has-hover && !secta.pressed; text: sec.t; }
                            secta := TouchArea {
                                clicked => {
                                    root.settings-page = si;
                                }
                            }
                        }
                    }
                    Rectangle {
                        x: 8px;
                        y: parent.height - 108px;
                        width: parent.width - 16px;
                        height: 100px;
                        VerticalLayout {
                            spacing: 6px;
                            padding-top: 8px;
                            alignment: start;
                            Text { text: @tr("Langue"); color: Theme.text-inactive; font-size: Theme.small-font-size; }
                            W10ComboBox {
                                model: [@tr("Français"), @tr("English"), @tr("Español"), @tr("Deutsch"), @tr("Italiano"), @tr("Português")];
                                current-index: root.set-language;
                                selected(i) => {
                                    root.set-language = i;
                                    root.language-chosen(i);
                                    root.settings-changed();
                                }
                            }
                            // remet les réglages de la page affichée à leurs valeurs d'origine
                            if root.settings-page <= 4: W10Button {
                                text: @tr("↺ Réinitialiser la section");
                                tip: @tr("Remet les réglages de cette page à leurs valeurs d'origine");
                                clicked => {
                                    root.settings-reset(root.settings-page);
                                }
                            }
                        }
                    }
                }
                // trait entre les sections et la page : du haut jusqu'au pied (sans `y`, il
                // serait centré et dépasserait de 22 px dans le pied)
                Rectangle {
                    visible: !parent.compact;
                    x: 170px;
                    y: 0;
                    width: 1px;
                    height: parent.content-height - 44px;
                    background: Theme.window-border;
                }
                // page de la section choisie
                if self.compact: HorizontalLayout {
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    height: 28px;
                    spacing: 8px;
                    W10ComboBox {
                        horizontal-stretch: 2;
                        model: [@tr("Apparence"), @tr("Toile et outils"), @tr("Édition"), @tr("Performances"), @tr("Données"), @tr("Raccourcis"), @tr("Avancé et infos")];
                        current-index: root.settings-page;
                        selected(i) => { root.settings-page = i; }
                    }
                    W10ComboBox {
                        horizontal-stretch: 1;
                        model: [@tr("Français"), @tr("English"), @tr("Español"), @tr("Deutsch"), @tr("Italiano"), @tr("Português")];
                        current-index: root.set-language;
                        selected(i) => { root.set-language = i; root.language-chosen(i); root.settings-changed(); }
                    }
                }
                ScrollView {
                    x: parent.sidebar-width;
                    y: parent.heading-height;
                    width: parent.width - parent.sidebar-width;
                    height: parent.content-height - 44px - parent.heading-height;
                    content-height: pg.preferred-height + (root.settings-page == 0 ? 0px : 10px);
                    pg := VerticalLayout {
                        padding: root.settings-page == 0 ? 10px : 16px;
                        padding-right: 20px;
                        spacing: 4px;
                        alignment: start;
                        if root.settings-page == 0: VerticalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Text { text: @tr("MasterPaint"); font-size: Theme.font-size + 8px; font-weight: 700; color: Theme.text; }
                                    Text { text: @tr("version ") + root.app-version; color: Theme.text-inactive; vertical-alignment: bottom; }
                                }
                                Text {
                                    width: tw;
                                    text: @tr("Inspiré de Paint.NET, Photoshop et Illustrator : images bitmap et vectorielles au même endroit, sans publicité ni traceurs. Écrit en Rust, dans le navigateur comme en application.");
                                    wrap: word-wrap;
                                    font-size: Theme.small-font-size;
                                    color: Theme.text-inactive;
                                }
                                HorizontalLayout {
                                    spacing: 4px; alignment: start;
                                    Text { text: @tr("Développé par"); color: Theme.text-inactive; font-size: Theme.small-font-size; }
                                    Text {
                                        text: @tr("polocrafting 367"); color: Theme.accent; font-size: Theme.small-font-size;
                                        TouchArea { mouse-cursor: pointer; clicked => { root.quick-action("open-author"); } }
                                    }
                                }
                            }
                            Text { text: @tr("Apparence"); font-size: Theme.font-size + 3px; font-weight: 700; color: Theme.text; }

                            VerticalLayout {
                                spacing: 6px;
                                SetHead {
                                    padding-top: 0px;
                                    text-w: tw;
                                    title: @tr("Barre d'options");
                                }
                                Segmented {
                                    width: tw;
                                    horizontal-stretch: 0;
                                    options: [@tr("Ruban MasterPaint"), @tr("Style Paint.NET")];
                                    index <=> root.toolbar-mode;
                                    selected(i) => {
                                        root.settings-changed();
                                    }
                                }
                                SetYesNo {
                                    compact: true;
                                    text-w: tw;
                                    title: @tr("Thème sombre");
                                    hint: @tr("Le Mode Photo Pro est toujours sombre.");
                                    value: Theme.dark;
                                    changed(v) => {
                                        root.apply-theme(v, Theme.accent-base);
                                    }
                                }
                                SetHead {
                                    padding-top: 0px;
                                    text-w: tw;
                                    title: @tr("Couleur d'accentuation");
                                }
                                // Palette wraps at narrow widths; targets keep their full size.
                                Rectangle {
                                    property <int> cols: max(1, floor(tw / 29px));
                                    width: tw;
                                    height: ceil(Theme.accent-options.length / self.cols) * 29px - 5px;
                                    for a[i] in Theme.accent-options: Rectangle {
                                        x: mod(i, parent.cols) * 29px;
                                        y: floor(i / parent.cols) * 29px;
                                        width: 24px;
                                        height: 24px;
                                        border-radius: Theme.ctl-radius;
                                        background: a;
                                        border-width: Theme.accent-base == a ? 3px : 1px;
                                        border-color: Theme.accent-base == a ? Theme.text : #808080;
                                        TouchArea {
                                            clicked => {
                                                root.apply-theme(Theme.dark, a);
                                            }
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                padding-top: 20px;
                                spacing: 4px;
                                SetHead {
                                    padding-top: 0px;
                                    text-w: tw;
                                    title: @tr("Style de l'interface");
                                }
                                Segmented {
                                    width: tw;
                                    horizontal-stretch: 0;
                                    options: [@tr("Flat Design"), @tr("Windows 98")];
                                    index <=> root.set-theme-style;
                                    selected(i) => {
                                        root.apply-theme(Theme.dark, Theme.accent-base);
                                    }
                                }
                                SetYesNo {
                                    compact: true;
                                    text-w: tw;
                                    title: @tr("Coins arrondis");
                                    hint: @tr("Fenêtres, boutons et menus, comme Windows 11.");
                                    value <=> root.set-rounded;
                                    changed => {
                                        root.apply-theme(Theme.dark, Theme.accent-base);
                                    }
                                }
                                SetYesNo {
                                    compact: true;
                                    text-w: tw;
                                    title: @tr("Aperçu du projet derrière les onglets");
                                    hint: @tr("Le haut de l'image active, flouté, en fond de la barre des onglets.");
                                    value <=> root.set-header-preview;
                                    changed => {
                                        root.settings-changed();
                                    }
                                }
                                SetYesNo {
                                    compact: true;
                                    text-w: tw;
                                    title: @tr("Transparence active");
                                    hint: @tr("Fenêtres flottantes uniquement.");
                                    value <=> root.set-title-transparent;
                                    changed => { root.apply-theme(Theme.dark, Theme.accent-base); }
                                }
                                SetYesNo {
                                    compact: true;
                                    text-w: tw;
                                    title: @tr("Flou actif");
                                    hint: @tr("Floute le contenu derrière les barres de titre des fenêtres flottantes.");
                                    value <=> root.set-title-blurred;
                                    changed => { root.apply-theme(Theme.dark, Theme.accent-base); }
                                }
                            }
                        }
                        if root.settings-page == 1: VerticalLayout {
                            spacing: 8px;
                            SetTitle {
                                text-w: tw;
                                title: @tr("Toile et outils");
                                intro: @tr("Disposition de l'interface, puis comportement de la toile et des outils.");
                            }
                            SetHead {
                                text-w: tw;
                                title: @tr("Disposition de l'interface");
                                hint: @tr("Palettes flottantes (Paint.NET), colonnes ancrées (Photoshop) ou interface tactile.");
                            }
                            Segmented {
                                width: tw;
                                horizontal-stretch: 0;
                                options: [@tr("Paint.NET"), @tr("Photoshop (bêta)"), @tr("Téléphone (bêta)")];
                                index <=> root.set-layout;
                                selected(i) => {
                                    // choix explicite sur un écran étroit : il est respecté
                                    // (plus de passage automatique à l'interface tactile)
                                    if (i != 2 && root.usable-width < 600px) {
                                        root.set-layout-auto = false;
                                    }
                                    root.settings-changed();
                                    root.zoom-fit();
                                }
                            }
                            SetYesNo {
                                text-w: tw;
                                title: @tr("Interface tactile automatique sur écran étroit");
                                hint: @tr("Sous 600 px de large, passer à l'interface Téléphone. « Non » : la disposition choisie est gardée partout.");
                                value <=> root.set-layout-auto;
                                changed => {
                                    root.settings-changed();
                                }
                            }
                            SetHead {
                                text-w: tw;
                                title: @tr("Souris : molette");
                                hint: @tr("Zoom (Maj = défilement horizontal) ou défilement de la toile (Maj = horizontal, Ctrl = zoom). Réglage partagé avec la version HTML.");
                            }
                            Segmented {
                                width: tw;
                                horizontal-stretch: 0;
                                options: [@tr("Molette = zoom"), @tr("Molette = défilement")];
                                index <=> root.set-wheel-mode;
                            }
                            VerticalLayout {
                                padding-top: 16px;
                                spacing: 8px;
                                SetHead {
                                    text-w: tw;
                                    title: @tr("Toile et couleurs");
                                    hint: @tr("Le damier garde la même taille à l’écran, quel que soit le zoom. Ces couleurs d’affichage ne modifient pas l’image exportée.");
                                }
                                for pref[i] in [@tr("Damier : couleur claire"), @tr("Damier : couleur foncée"), @tr("Fond autour de la toile"), @tr("Couleur principale au démarrage"), @tr("Couleur secondaire au démarrage")]: PreferenceColor {
                                    row-width: tw;
                                    label: pref;
                                    value: root.appearance-colors[i];
                                    hex: root.appearance-hex[i];
                                    index: i;
                                    edited(t) => { root.appearance-color-edited(i, t); }
                                    picked(c) => { root.appearance-color-picked(i, c); }
                                }
                                SetHead { text-w: tw; title: @tr("Taille des cases du damier (pixels écran)"); }
                                GaugeBar {
                                    minimum: 2; maximum: 32; step: 1;
                                    value: root.checker-size;
                                    changed(v) => { root.checker-size = v; root.appearance-changed(); root.settings-changed(); }
                                }
                                W10Button {
                                    text: @tr("Réinitialiser les couleurs");
                                    clicked => { root.appearance-reset(); }
                                }
                            }
                            VerticalLayout {
                                padding-top: 16px;
                                spacing: 8px;
                                SetHead {
                                    text-w: tw;
                                    title: @tr("Zoom de l'interface : ") + round(root.set-ui-zoom) + " %";
                                    hint: @tr("Taille des textes et des boutons.");
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    GaugeBar {
                                        minimum: 75;
                                        maximum: 150;
                                        step: 5;
                                        value: root.set-ui-zoom;
                                        changed(v) => {
                                            root.set-ui-zoom = v;
                                        }
                                    }
                                    W10Button {
                                        text: @tr("Appliquer");
                                        clicked => {
                                            root.apply-ui-zoom(root.set-ui-zoom);
                                        }
                                    }
                                }
                                SetHead {
                                    text-w: tw;
                                    title: @tr("Zoom à l'ouverture d'une image");
                                }
                                Segmented {
                                    width: tw;
                                    horizontal-stretch: 0;
                                    options: [@tr("Ajuster à la fenêtre"), @tr("Taille réelle (100 %)")];
                                    index <=> root.set-default-zoom;
                                }
                                SetHead {
                                    text-w: tw;
                                    title: @tr("Outil sélectionné au démarrage");
                                }
                                W10ComboBox {
                                    model: root.tool-titles;
                                    current-index <=> root.set-default-tool;
                                }
                                SetYesNo {
                                    text-w: tw;
                                    title: @tr("Lisser l'image zoomée");
                                    hint: @tr("Au-delà de 200 %, les pixels sont affichés nets, comme dans Paint.NET ; « Oui » les lisse.");
                                    value <=> root.set-zoom-smooth;
                                    changed => {
                                        root.settings-changed();
                                    }
                                }
                            }
                        }
                        if root.settings-page == 2: VerticalLayout {
                            spacing: 8px;
                            SetTitle {
                                text-w: tw;
                                title: @tr("Édition");
                                intro: @tr("Presse-papiers et historique des modifications.");
                            }
                            SetHead {
                                text-w: tw;
                                title: @tr("Coller (Ctrl+V)");
                                hint: @tr("Dans la même image : à l'endroit de la copie. Dans une autre image : au centre.");
                            }
                            Segmented {
                                width: tw;
                                horizontal-stretch: 0;
                                options: [@tr("Dans un nouveau calque"), @tr("Dans le calque actif")];
                                index <=> root.set-paste-mode;
                            }
                            SetYesNo {
                                text-w: tw;
                                title: @tr("Demander où coller une image venue d'ailleurs");
                                hint: @tr("Capture, autre application ou fichier : ouvrir dans un nouvel onglet ou coller dans l'image actuelle.");
                                value <=> root.set-paste-ask;
                                changed => {
                                    root.settings-changed();
                                }
                            }
                            VerticalLayout {
                                padding-top: 16px;
                                spacing: 8px;
                                SetHead {
                                    text-w: tw;
                                    title: @tr("Étapes d'historique : ") + round(root.set-history-max);
                                    hint: @tr("Au-delà, les plus anciennes sont oubliées (moins de mémoire utilisée).");
                                }
                                GaugeBar {
                                    minimum: 5;
                                    maximum: 500;
                                    value: root.set-history-max;
                                    changed(v) => {
                                        root.set-history-max = v;
                                    }
                                }
                                SetHead {
                                    text-w: tw;
                                    title: @tr("Vider l'historique");
                                    hint: @tr("Libère la mémoire des étapes passées ; l'image reste telle quelle.");
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    W10Button {
                                        text: @tr("Onglet actif");
                                        clicked => {
                                            root.quick-action("clear-history");
                                        }
                                    }
                                    W10Button {
                                        text: @tr("Tous les onglets");
                                        clicked => {
                                            root.quick-action("clear-history-all");
                                        }
                                    }
                                }
                            }
                        }
                        if root.settings-page == 3: VerticalLayout {
                            spacing: 8px;
                            SetTitle {
                                text-w: tw;
                                title: @tr("Performances");
                                intro: @tr("Les calculs lourds (effets, Photo Mode Pro, photos RAW, décodage des images) tournent en arrière-plan : l'interface ne se fige pas. Sur les grandes images, seule la partie visible à l'écran est affichée, et les aperçus d'effet commencent à la résolution de l'écran.");
                            }
                            SetHead {
                                text-w: tw;
                                title: @tr("Accélération graphique");
                                hint: root.gpu-text;
                            }
                            SetYesNo {
                                text-w: tw;
                                title: @tr("Utiliser la carte graphique");
                                hint: @tr("Composition des calques à l'écran (grandes images), filtres dynamiques (ƒ) et effets simples (flous, netteté, pixeliser, réglages de couleur, teinte / saturation, vignette) : WebGPU dans le navigateur, Vulkan / Metal / DirectX sur le bureau. Non : tout est calculé par le processeur.");
                                value <=> root.set-use-gpu;
                                changed => {
                                    root.settings-changed();
                                }
                            }
                        }
                        if root.settings-page == 4: VerticalLayout {
                            spacing: 8px;
                            SetTitle {
                                text-w: tw;
                                title: @tr("Données");
                                intro: @tr("Les projets ouverts sont retrouvés à la réouverture (application : dossier de configuration de MasterPaint ; navigateur : stockage du site).");
                            }
                            SetYesNo {
                                text-w: tw;
                                title: @tr("Sauvegarde automatique");
                                hint: @tr("Enregistre les onglets ouverts quand ils changent.");
                                value <=> root.set-autosave;
                                changed => {
                                    root.settings-changed();
                                }
                            }
                            SetHead {
                                text-w: tw;
                                title: @tr("Fréquence : ") + (root.set-autosave-min < 1 ? @tr("en continu") : @tr("toutes les ") + round(root.set-autosave-min) + @tr(" min"));
                                hint: @tr("En continu : dès qu'un projet change (au plus toutes les 15 secondes).");
                            }
                            GaugeBar {
                                minimum: 0;
                                maximum: 60;
                                value: root.set-autosave-min;
                                changed(v) => {
                                    root.set-autosave-min = v;
                                }
                            }
                            HorizontalLayout {
                                padding-top: 8px;
                                alignment: start;
                                W10Button {
                                    text: @tr("Effacer la sauvegarde automatique");
                                    clicked => {
                                        root.quick-action("clear-autosave");
                                    }
                                }
                            }
                        }
                        if root.settings-page == 5: VerticalLayout {
                            spacing: 8px;
                            SetTitle {
                                text-w: tw;
                                title: @tr("Raccourcis clavier et souris");
                            }
                            for r in root.shortcut-list: HorizontalLayout {
                                spacing: 12px;
                                padding-top: r.keys == "" ? 12px : 0px;
                                min-height: r.keys == "" ? 34px : 24px;
                                if r.keys != "": Text {
                                    width: min(200px, tw * 0.36);
                                    text: r.keys;
                                    wrap: word-wrap;
                                    font-weight: 600;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }
                                Text {
                                    width: r.keys == "" ? tw : tw - min(200px, tw * 0.36) - 12px;
                                    text: r.what;
                                    wrap: word-wrap;
                                    font-weight: r.keys == "" ? 700 : 400;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if root.settings-page == 6: VerticalLayout {
                            spacing: 8px;
                            SetTitle {
                                text-w: tw;
                                title: @tr("Avancé et infos techniques");
                            }
                            SetHead {
                                text-w: tw;
                                title: @tr("Visionneuse d'icônes");
                                hint: @tr("Les icônes de MasterPaint (outils, menus, sprite) aux couleurs du thème, avec leur nom.");
                            }
                            HorizontalLayout {
                                alignment: start;
                                W10Button {
                                    text: @tr("Ouvrir la visionneuse d'icônes");
                                    clicked => {
                                        root.quick-action("icon-viewer");
                                    }
                                }
                            }
                            SetHead {
                                text-w: tw;
                                title: @tr("Version web classique");
                                hint: @tr("L'ancienne interface de MasterPaint (HTML). Elle n'est plus mise à jour : certaines fonctions récentes n'y sont pas.");
                            }
                            HorizontalLayout {
                                alignment: start;
                                W10Button {
                                    text: @tr("Ouvrir la version web classique");
                                    clicked => {
                                        root.quick-action("classic-web");
                                    }
                                }
                            }
                            VerticalLayout {
                                padding-top: 16px;
                                spacing: 8px;
                                SetHead {
                                    text-w: tw;
                                    title: @tr("Infos techniques");
                                    hint: @tr("Version, appareil, accélération et mémoire utilisée. Ces informations sont jointes aux rapports d'erreur.");
                                }
                                Rectangle {
                                    height: tech-txt.preferred-height + 16px;
                                    border-radius: Theme.ctl-radius;
                                    background: Theme.field-bg;
                                    border-width: 1px;
                                    border-color: Theme.field-border;
                                    tech-txt := Text {
                                        x: 8px;
                                        y: 8px;
                                        width: tw - 16px;
                                        text: root.tech-info;
                                        wrap: word-wrap;
                                        color: Theme.text;
                                        font-size: Theme.small-font-size;
                                    }
                                }
                                HorizontalLayout {
                                    padding-top: 8px;
                                    spacing: 8px;
                                    alignment: start;
                                    W10Button {
                                        text: @tr("Actualiser");
                                        clicked => {
                                            root.quick-action("tech-info");
                                        }
                                    }
                                    W10Button {
                                        text: @tr("Signaler un problème avec ces informations");
                                        clicked => {
                                            root.contact-message = root.tech-info;
                                            root.show-settings = false;
                                            root.show-contact = true;
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                padding-top: 16px;
                                spacing: 8px;
                                SetHead {
                                    text-w: tw;
                                    title: @tr("Fenêtre de plantage");
                                    hint: @tr("Affiche la fenêtre qui prend le relais si MasterPaint s'arrête (navigateur : page HTML de secours, avec envoi du signalement). Simple essai : l'application continue.");
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    W10Button {
                                        text: @tr("Essayer la fenêtre de plantage");
                                        clicked => {
                                            root.quick-action("crash-test");
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // pied : liens du projet à gauche, OK à droite
                DialogFooter {
                    y: parent.content-height - 44px;
                    if !settingswin.compact: W10Button {
                        text: @tr("Projet sur GitHub");
                        clicked => {
                            root.quick-action("open-github");
                        }
                    }
                    if !settingswin.compact: W10Button {
                        text: @tr("Notes de version");
                        clicked => {
                            root.quick-action("open-changelog");
                        }
                    }
                    if !settingswin.compact: W10Button {
                        text: @tr("Ouvrir le projet d'exemple");
                        icon: MpIcons.for-menu(@tr("Ouvrir / Importer image…"), "") >= 0 ? MpIcons.images[MpIcons.for-menu(@tr("Ouvrir / Importer image…"), "")] : root.no-image;
                        tip: @tr("Ouvre le projet d'exemple de MasterPaint (calques, effets) dans un nouvel onglet");
                        clicked => {
                            root.show-settings = false;
                            root.quick-action("open-example");
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    // remet les réglages de la page affichée à leurs valeurs d'origine (comme le
                    // bouton ↺ des fenêtres d'effet)
                    // téléphone (pas de colonne des sections) : dans le pied
                    if root.settings-page <= 4 && settingswin.compact: W10Button {
                        text: "↺";
                        tip: @tr("Remet les réglages de cette page à leurs valeurs d'origine");
                        clicked => {
                            root.settings-reset(root.settings-page);
                        }
                    }
                    W10Button {
                        text: @tr("OK");
                        primary: true;
                        clicked => {
                            root.show-settings = false;
                            root.settings-changed();
                            fs.focus();
                        }
                    }
                }
            }

            // ---- Signaler un bug (même formulaire que la version web) ----
            if root.show-contact: FloatWindow {
                float-x: (ws.width - 400px) / 2;
                float-y: 40px;
                z: root.z-dialog + 2;
                float-w: 400px;
                float-h: 346px;
                title: @tr("Signaler un bug");
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.show-contact = false;
                    fs.focus();
                }
                VerticalLayout {
                    padding: 14px;
                    padding-bottom: 56px;
                    spacing: 6px;
                    Text {
                        text: @tr("Objet :");
                        color: Theme.text;
                    }
                    W10ComboBox {
                        model: [@tr("🐛 Bug / Erreur"), @tr("💡 Idée / Amélioration"), @tr("📝 Remarque"), @tr("📂 Autre")];
                        current-index <=> root.contact-kind;
                    }
                    Text {
                        text: @tr("Message :");
                        color: Theme.text;
                    }
                    Rectangle {
                        height: 110px;
                        background: Theme.field-bg;
                        border-width: 1px;
                        border-color: msg.has-focus ? Theme.accent : Theme.field-border;
                        msg := TextInput {
                            x: 5px;
                            y: 4px;
                            width: parent.width - 10px;
                            height: parent.height - 8px;
                            text <=> root.contact-message;
                            single-line: false;
                            wrap: word-wrap;
                            color: Theme.text;
                            font-size: Theme.font-size;
                        }
                    }
                    Text {
                        text: @tr("Contact (optionnel) :");
                        color: Theme.text;
                    }
                    W10LineEdit {
                        text <=> root.contact-info;
                    }
                }
                DialogFooter {
                    y: parent.content-height - 44px;
                    Text {
                        text: root.contact-status;
                        color: Theme.text-inactive;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    W10Button {
                        text: @tr("Envoyer");
                        primary: true;
                        clicked => {
                            root.contact-send(root.contact-kind, root.contact-message, root.contact-info);
                        }
                    }
                    W10Button {
                        text: @tr("Redémarrer");
                        tip: root.web ? @tr("Recharger la page (les projets ouverts sont restaurés)") : @tr("Relancer MasterPaint");
                        clicked => {
                            root.quick-action("restart-app");
                        }
                    }
                    W10Button {
                        text: @tr("Annuler");
                        clicked => {
                            root.show-contact = false;
                            fs.focus();
                        }
                    }
                }
            }

            // ---- Notes de version ----
            if root.show-changelog: FloatWindow {
                float-x: (ws.width - 520px) / 2;
                float-y: 30px;
                z: root.z-dialog + 1;
                float-w: 520px;
                float-h: min(560px, ws.height - 40px);
                title: @tr("Notes de version");
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.show-changelog = false;
                }
                ScrollView {
                    content-height: clt.preferred-height + 20px;
                    clt := Text {
                        x: 10px;
                        y: 10px;
                        width: 480px;
                        text: root.changelog-text;
                        wrap: word-wrap;
                        color: Theme.text;
                    }
                }
            }

            // ---- Aide et raccourcis (bouton Info, Bienvenue › Raccourcis) ----
            if root.show-shortcuts: FloatWindow {
                float-x: (ws.width - 660px) / 2;
                float-y: 30px;
                z: root.z-dialog + 1;
                float-w: 660px;
                float-h: min(600px, ws.height - 40px);
                docked: root.phone;
                dock-x: 0px;
                dock-y: 0px;
                dock-w: ws.width;
                dock-h: ws.height - root.strip-height - 6px;
                title: @tr("Aide et raccourcis");
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.show-shortcuts = false;
                    fs.focus();
                }
                InfoContent {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.content-height;
                    phone: root.phone;
                    shortcuts: root.shortcut-list;
                    tab <=> root.info-tab;
                }
            }
            // ---- Bienvenue (deux premières ouvertures, Fichier › Bienvenue / Informations) ----
            if root.show-welcome && !root.pm-open: FloatWindow {
                float-x: (ws.width - 680px) / 2;
                float-y: max(10px, (ws.height - 580px) / 2);
                z: root.z-dialog;
                float-w: 680px;
                float-h: min(580px, root.usable-height - ws.y - 20px);
                // téléphone : panneau plein écran, le contenu défile ; il s'arrête au-dessus de la
                // barre du bas (sinon elle recouvre « Commencer »)
                docked: root.phone;
                dock-x: 0px;
                dock-y: 0px;
                dock-w: ws.width;
                dock-h: ws.height - root.strip-height - 6px;
                title: @tr("Bienvenue dans MasterPaint");
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.show-welcome = false;
                    root.settings-changed();
                    fs.focus();
                }
                WelcomeContent {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.content-height;
                    version: root.app-version;
                    phone: root.phone;
                    language <=> root.set-language;
                    language-chosen(i) => { root.language-chosen(i); }
                    toolbar-mode <=> root.toolbar-mode;
                    layout <=> root.set-layout;
                    layout-auto <=> root.set-layout-auto;
                    hide <=> root.welcome-hide;
                    theme(d, a) => {
                        root.apply-theme(d, a);
                    }
                    settings-changed => {
                        root.settings-changed();
                    }
                    layout-changed(i) => {
                        // même règle que les Paramètres : un choix explicite sur un écran étroit
                        // est respecté (plus de passage automatique à l'interface tactile)
                        if (i != 2 && root.usable-width < 600px) {
                            root.set-layout-auto = false;
                        }
                        root.settings-changed();
                        root.zoom-fit();
                    }
                    action(id) => {
                        if (id == "shortcuts") {
                            root.info-tab = 0;
                            root.show-shortcuts = true;
                        } else if (id == "github") {
                            root.quick-action("open-github");
                        } else {
                            root.show-welcome = false;
                            root.settings-changed();
                            if (id == "settings") {
                                root.show-settings = true;
                            } else {
                                root.quick-action(id == "new" ? "illu-tb-new" : id == "open" ? "illu-tb-open" : "open-example");
                            }
                        }
                    }
                    start => {
                        root.show-welcome = false;
                        root.settings-changed();
                        fs.focus();
                    }
                }
            }
            // ---- Nouvelle image ----
            // Nouvelle image : type de projet (cartes), espace de couleur, taille (préréglages
            // illustrés, largeur / hauteur liées), fond en pastilles et aperçu des proportions ;
            // deux colonnes, une seule sur un écran étroit
            if root.show-new: nwin := FloatWindow {
                property <bool> narrow: self.width < 560px;
                property <float> nw: root.dlg-w.is-float() ? max(1, root.dlg-w.to-float()) : 1;
                property <float> nh: root.dlg-h.is-float() ? max(1, root.dlg-h.to-float()) : 1;
                float-w: min(600px, ws.width - 12px);
                float-h: min(nlay.preferred-height + Theme.title-height + 56px, root.usable-height - ws.y - 12px);
                float-x: (ws.width - self.float-w) / 2;
                float-y: max(10px, (ws.height - self.float-h) / 3);
                docked: root.phone;
                dock-x: 0px;
                dock-y: 0px;
                dock-w: ws.width;
                dock-h: ws.height - root.strip-height - 6px;
                z: root.z-dialog;
                title: @tr("Nouvelle image");
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.show-new = false;
                    fs.focus();
                }
                Flickable {
                    // sans x / y, Slint centrerait la zone (vide en haut, aperçu sur le pied)
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.content-height - 52px;
                    content-width: self.width;
                    content-height: nlay.preferred-height;
                    nlay := GridLayout {
                        width: parent.width;
                        padding: 16px;
                        spacing: 20px;
                        // ---- à gauche : type de projet, espace de couleur, fond, aperçu ----
                        VerticalLayout {
                            row: 0;
                            col: 0;
                            spacing: 7px;
                            alignment: start;
                            Text { text: @tr("Type de projet"); font-weight: 700; color: Theme.text; }
                            // une ligne au style de « Espace de couleur », avec une icône par type
                            Rectangle {
                                height: 30px;
                                border-radius: Theme.ctl-radius + 2px;
                                background: Theme.track-bg;
                                border-width: 1px;
                                border-color: Theme.button-border;
                                HorizontalLayout {
                                    padding: 2px;
                                    spacing: 2px;
                                    for k[i] in [
                                        { g: "\u{f03e}", t: @tr("Pixel") },
                                        { g: "\u{f5ee}", t: @tr("SVG") },
                                        { g: "\u{f008}", t: @tr("Anim.") },
                                        { g: "\u{f008}", t: @tr("Anim. SVG") },
                                    ]: Rectangle {
                                        horizontal-stretch: 1;
                                        border-radius: Theme.ctl-radius;
                                        background: root.new-kind == i ? Theme.field-bg : kta.has-hover ? Theme.accent-12 : transparent;
                                        border-width: root.new-kind == i ? 1px : 0px;
                                        border-color: Theme.button-border;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 5px;
                                            GlyphIcon {
                                                y: (parent.height - self.height) / 2;
                                                glyph: k.g;
                                                size: 11px;
                                                tint: root.new-kind == i ? Theme.accent : Theme.text;
                                            }
                                            Text {
                                                text: k.t;
                                                font-weight: root.new-kind == i ? 700 : 400;
                                                color: root.new-kind == i ? Theme.accent : Theme.text;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Rectangle {
                                            visible: root.new-kind == i;
                                            x: (parent.width - self.width) / 2;
                                            y: parent.height - 3px;
                                            width: min(18px, parent.width - 8px);
                                            height: 3px;
                                            border-radius: 1.5px * Theme.round;
                                            background: Theme.accent;
                                        }
                                        kta := TouchArea {
                                            clicked => { root.new-kind = i; }
                                        }
                                    }
                                }
                            }
                            Rectangle { height: 2px; }
                            Text { text: @tr("Espace de couleur"); font-weight: 700; color: Theme.text; }
                            Segmented {
                                height: 30px;
                                options: [@tr("RVB"), @tr("CMJN"), @tr("RAL")];
                                index <=> root.dlg-mode;
                            }
                            Text {
                                text: root.dlg-mode == 1 ? @tr("Couleurs simulées avec de vraies encres d'imprimerie.")
                                    : root.dlg-mode == 2 ? @tr("Couleurs limitées au nuancier RAL Classic (216 teintes).")
                                    : @tr("Toutes les couleurs (RVB 8 bits).");
                                font-size: Theme.small-font-size;
                                color: Theme.text-inactive;
                                wrap: word-wrap;
                            }
                            Rectangle { height: 2px; }
                            Text { text: @tr("Fond"); font-weight: 700; color: Theme.text; }
                            HorizontalLayout {
                                spacing: 6px;
                                for b[i] in [@tr("Blanc"), @tr("Transparent"), @tr("Secondaire")]: Rectangle {
                                    horizontal-stretch: 1;
                                    height: 30px;
                                    border-radius: Theme.ctl-radius;
                                    background: root.dlg-bg == i ? Theme.accent-14 : bga.has-hover ? Theme.accent-12 : Theme.field-bg;
                                    border-width: root.dlg-bg == i ? 2px : 1px;
                                    border-color: root.dlg-bg == i ? Theme.accent : Theme.window-border;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        Rectangle {
                                            y: (parent.height - self.height) / 2;
                                            width: 14px;
                                            height: 14px;
                                            border-radius: 3px;
                                            border-width: 1px;
                                            border-color: Theme.window-border;
                                            clip: true;
                                            background: i == 2 ? root.secondary-color : #ffffff;
                                            if i == 1: Rectangle { x: 0; y: 0; width: 7px; height: 7px; background: #c8c8c8; }
                                            if i == 1: Rectangle { x: 7px; y: 7px; width: 7px; height: 7px; background: #c8c8c8; }
                                        }
                                        Text {
                                            text: b;
                                            font-size: Theme.small-font-size;
                                            color: Theme.text;
                                            vertical-alignment: center;
                                        }
                                    }
                                    bga := TouchArea {
                                        clicked => { root.dlg-bg = i; }
                                    }
                                }
                            }
                            Rectangle { height: 2px; }
                            // aperçu : proportions, fond et poids en mémoire
                            HorizontalLayout {
                                spacing: 12px;
                                height: 50px;
                                Rectangle {
                                    width: 72px;
                                    Rectangle {
                                        property <float> r: nwin.nw / nwin.nh;
                                        width: self.r >= 72 / 46 ? 72px : 46px * self.r;
                                        height: self.r >= 72 / 46 ? 72px / self.r : 46px;
                                        background: root.dlg-bg == 2 ? root.secondary-color : root.dlg-bg == 1 ? Theme.track-bg : #ffffff;
                                        border-width: 1px;
                                        border-color: Theme.window-border;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: round(nwin.nw) + " × " + round(nwin.nh) + " px"; font-weight: 600; color: Theme.text; }
                                    Text {
                                        text: round(nwin.nw * nwin.nh * 4 / 1048576 * 10) / 10 + @tr(" Mo par calque");
                                        font-size: Theme.small-font-size;
                                        color: Theme.text-inactive;
                                    }
                                }
                            }
                        }
                        // ---- à droite : taille (préréglages, largeur / hauteur liées) ----
                        VerticalLayout {
                            row: nwin.narrow ? 1 : 0;
                            col: nwin.narrow ? 0 : 1;
                            spacing: 7px;
                            alignment: start;
                            Text { text: @tr("Taille"); font-weight: 700; color: Theme.text; }
                            GridLayout {
                                spacing: 4px;
                                for p[i] in [{ n: "1080p", w: "1920", h: "1080" }, { n: "720p", w: "1280", h: "720" }, { n: "1:1", w: "1024", h: "1024" },
                                          { n: "4/3", w: "1024", h: "768" }, { n: "A4", w: "2480", h: "3508" }, { n: @tr("Letter"), w: "2550", h: "3300" }]: Rectangle {
                                    property <bool> on: root.dlg-w == p.w && root.dlg-h == p.h;
                                    property <float> r: p.w.to-float() / p.h.to-float();
                                    row: floor(i / 3);
                                    col: mod(i, 3);
                                    min-width: 72px;
                                    height: 40px;
                                    border-radius: Theme.ctl-radius;
                                    background: self.on ? Theme.accent-14 : npta.has-hover ? Theme.accent-12 : Theme.field-bg;
                                    border-width: self.on ? 2px : 1px;
                                    border-color: self.on ? Theme.accent : npta.has-hover ? Theme.accent-60 : Theme.window-border;
                                    // vignette aux proportions du format
                                    Rectangle {
                                        x: 8px + (18px - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: parent.r >= 1 ? 18px : 18px * parent.r;
                                        height: parent.r >= 1 ? 18px / parent.r : 18px;
                                        border-width: 1.5px;
                                        border-radius: 2px;
                                        border-color: parent.on ? Theme.accent : Theme.text-inactive;
                                    }
                                    Text { x: 32px; y: 5px; text: p.n; font-weight: 600; color: Theme.text; }
                                    Text { x: 32px; y: 21px; text: p.w + "×" + p.h; font-size: 9px; color: Theme.text-inactive; }
                                    npta := TouchArea {
                                        clicked => {
                                            root.dlg-w = p.w;
                                            root.dlg-h = p.h;
                                            // préréglage : ses proportions deviennent celles à garder
                                            root.new-ratio = p.w.to-float() / p.h.to-float();
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                height: 64px;
                                VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        height: 28px;
                                        Text { width: 60px; text: @tr("Largeur"); color: Theme.text; vertical-alignment: center; }
                                        W10LineEdit {
                                            text <=> root.dlg-w;
                                            input-type: number;
                                            edited(t) => {
                                                if (root.new-keep && t.is-float() && t.to-float() > 0) {
                                                    root.dlg-h = "" + max(1, round(t.to-float() / root.new-ratio));
                                                }
                                            }
                                        }
                                        Text { text: "px"; color: Theme.text-inactive; vertical-alignment: center; }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        height: 28px;
                                        Text { width: 60px; text: @tr("Hauteur"); color: Theme.text; vertical-alignment: center; }
                                        W10LineEdit {
                                            text <=> root.dlg-h;
                                            input-type: number;
                                            edited(t) => {
                                                if (root.new-keep && t.is-float() && t.to-float() > 0) {
                                                    root.dlg-w = "" + max(1, round(t.to-float() * root.new-ratio));
                                                }
                                            }
                                        }
                                        Text { text: "px"; color: Theme.text-inactive; vertical-alignment: center; }
                                    }
                                }
                                LinkToggle {
                                    checked <=> root.new-keep;
                                    // proportions retenues au moment où l'on lie
                                    toggled(on) => {
                                        if (on && root.dlg-w.is-float() && root.dlg-h.is-float() && root.dlg-h.to-float() > 0) {
                                            root.new-ratio = root.dlg-w.to-float() / root.dlg-h.to-float();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                DialogFooter {
                    y: parent.content-height - 44px;
                    W10Button {
                        text: @tr("Créer");
                        primary: true;
                        clicked => {
                            root.show-new = false;
                            root.new-image(root.dlg-w, root.dlg-h, root.dlg-bg, root.dlg-mode);
                            fs.focus();
                        }
                    }
                    W10Button {
                        text: @tr("Annuler");
                        clicked => {
                            root.show-new = false;
                            fs.focus();
                        }
                    }
                }
            }

            // ---- Redimensionner l'image / la zone de travail ----
            // Redimensionner / Taille de la zone de travail (paintdotjs : pourcentage ou taille
            // absolue, proportions conservées, taille en Mo ; ancrage pour la zone de travail)
            if root.show-resize: FloatWindow {
                property <float> nw: root.dlg-w.is-float() ? max(1, round(root.dlg-w.to-float())) : root.rs-orig-w;
                property <float> nh: root.dlg-h.is-float() ? max(1, round(root.dlg-h.to-float())) : root.rs-orig-h;
                float-w: 360px;
                float-h: rs-col.preferred-height + Theme.title-height;
                float-x: (ws.width - min(self.float-w, ws.width)) / 2;
                float-y: max(10px, (ws.height - self.float-h) / 2);
                z: root.z-dialog;
                title: root.resize-canvas-mode ? @tr("Taille de la zone de travail") : @tr("Redimensionner l'image");
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.show-resize = false;
                    fs.focus();
                }
                rs-col := VerticalLayout {
                    padding: 14px;
                    // place du pied (alvéole des boutons)
                    padding-bottom: 58px;
                    spacing: 8px;
                    Text {
                        text: @tr("Taille actuelle : ") + root.rs-orig-w + @tr(" × ") + root.rs-orig-h + @tr(" px   →   nouvelle taille : ")
                            + round(nw * nh * root.rs-layers * 4 / 1048576 * 10) / 10 + @tr(" Mo");
                        color: Theme.text-inactive;
                        font-size: Theme.small-font-size;
                    }
                    Segmented {
                        height: 26px;
                        options: [@tr("Par taille absolue"), @tr("Par pourcentage")];
                        index: root.rs-by-pct ? 1 : 0;
                        selected(i) => {
                            root.rs-by-pct = i == 1;
                        }
                    }
                    if root.rs-by-pct: HorizontalLayout {
                        spacing: 8px;
                        height: 24px;
                        Text {
                            width: 90px;
                            text: @tr("Pourcentage");
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        W10LineEdit {
                            text <=> root.rs-pct;
                            input-type: number;
                            edited(t) => {
                                if (t.is-float()) {
                                    root.dlg-w = "" + max(1, round(root.rs-orig-w * t.to-float() / 100));
                                    root.dlg-h = "" + max(1, round(root.rs-orig-h * t.to-float() / 100));
                                }
                            }
                        }
                        Text {
                            text: "%";
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                    if !root.rs-by-pct: HorizontalLayout {
                        spacing: 8px;
                        height: 24px;
                        Text {
                            width: 90px;
                            text: @tr("Préréglages");
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        W10ComboBox {
                            model: root.rs-preset-labels;
                            current-index: 0;
                            selected(i) => {
                                // 0 : « Choisir une taille… »
                                if (i > 0) {
                                    root.dlg-w = root.rs-presets[i - 1].w;
                                    root.dlg-h = root.rs-presets[i - 1].h;
                                }
                            }
                        }
                    }
                    // largeur / hauteur liées par le maillon (comme Nouvelle image)
                    if !root.rs-by-pct: HorizontalLayout {
                        spacing: 8px;
                        height: 56px;
                        VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                height: 24px;
                                Text { width: 90px; text: @tr("Largeur"); color: Theme.text; vertical-alignment: center; }
                                W10LineEdit {
                                    text <=> root.dlg-w;
                                    input-type: number;
                                    edited(t) => {
                                        if (root.rs-keep && t.is-float() && t.to-float() > 0) {
                                            root.dlg-h = "" + max(1, round(t.to-float() * root.rs-orig-h / root.rs-orig-w));
                                        }
                                    }
                                }
                                Text { width: 20px; text: "px"; color: Theme.text-inactive; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                height: 24px;
                                Text { width: 90px; text: @tr("Hauteur"); color: Theme.text; vertical-alignment: center; }
                                W10LineEdit {
                                    text <=> root.dlg-h;
                                    input-type: number;
                                    edited(t) => {
                                        if (root.rs-keep && t.is-float() && t.to-float() > 0) {
                                            root.dlg-w = "" + max(1, round(t.to-float() * root.rs-orig-w / root.rs-orig-h));
                                        }
                                    }
                                }
                                Text { width: 20px; text: "px"; color: Theme.text-inactive; vertical-alignment: center; }
                            }
                        }
                        LinkToggle {
                            checked <=> root.rs-keep;
                        }
                    }
                    // ancrage : où reste l'image dans la nouvelle zone de travail
                    if root.resize-canvas-mode: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 90px;
                            text: @tr("Ancrage");
                            color: Theme.text;
                        }
                        GridLayout {
                            spacing: 3px;
                            for a in 9: Rectangle {
                                col: mod(a, 3);
                                row: floor(a / 3);
                                width: 28px;
                                height: 28px;
                                border-radius: Theme.ctl-radius;
                                background: root.rs-anchor == a ? Theme.accent : anta.has-hover ? Theme.accent-12 : Theme.button-bg;
                                border-width: 1px;
                                border-color: root.rs-anchor == a ? Theme.accent : Theme.button-border;
                                FaIcon {
                                    glyph: root.rs-anchor == a ? "\u{f03e}" : "";
                                    size: 11px;
                                    color: Theme.on-accent;
                                }
                                anta := TouchArea {
                                    clicked => {
                                        root.rs-anchor = a;
                                    }
                                }
                            }
                        }
                    }
                }
                DialogFooter {
                    y: parent.content-height - 44px;
                    W10Button {
                        text: @tr("OK");
                        primary: true;
                        clicked => {
                            root.show-resize = false;
                            root.resize-image(root.dlg-w, root.dlg-h, root.resize-canvas-mode, root.rs-anchor);
                            fs.focus();
                        }
                    }
                    W10Button {
                        text: @tr("Annuler");
                        clicked => {
                            root.show-resize = false;
                            fs.focus();
                        }
                    }
                }
            }

            // ---- Fenêtre de choix (Paint.NET : TaskDialog à boutons de commande) ----
            if root.show-task: FloatWindow {
                property <bool> one-thumb: root.task-thumbs.length == 1 && root.task-list-header == "";
                // largeur utile du contenu : les textes à la ligne ont une largeur explicite, sinon
                // la hauteur de la fenêtre est calculée sur une seule ligne et le bas déborde
                property <length> col-w: min(self.float-w, ws.width) - 28px;
                float-w: 460px;
                float-h: task-col.preferred-height + Theme.title-height;
                float-x: (ws.width - min(self.float-w, ws.width)) / 2;
                float-y: max(10px, (ws.height - self.float-h) / 2);
                z: root.z-dialog + 5;
                title: root.task-title;
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.task-result(-1);
                }
                task-col := VerticalLayout {
                    padding: 14px;
                    padding-bottom: 10px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 12px;
                        if one-thumb: Rectangle {
                            width: 96px;
                            height: 72px;
                            border-width: 1px;
                            border-color: Theme.window-border;
                            background: Theme.field-bg;
                            Image {
                                width: parent.width - 6px;
                                height: parent.height - 6px;
                                source: root.task-thumbs[0].image;
                                image-fit: contain;
                            }
                        }
                        Text {
                            width: one-thumb ? col-w - 108px : col-w;
                            text: root.task-intro;
                            wrap: word-wrap;
                            font-size: 15px;
                            color: Theme.dark ? Theme.accent.brighter(0.5) : Theme.accent.darker(0.25);
                            vertical-alignment: one-thumb ? center : top;
                        }
                    }
                    if root.task-info != "": Text {
                        width: col-w;
                        text: root.task-info;
                        wrap: word-wrap;
                        color: Theme.text;
                    }
                    if root.task-list-header != "": Text {
                        text: root.task-list-header;
                        font-weight: 600;
                        color: Theme.text;
                    }
                    if root.task-list-header != "": Rectangle {
                        height: 104px;
                        border-width: 1px;
                        border-color: Theme.window-border;
                        background: Theme.field-bg;
                        Flickable {
                            x: 1px;
                            y: 1px;
                            width: parent.width - 2px;
                            height: parent.height - 2px;
                            content-width: max(self.width, root.task-thumbs.length * 100px + 8px);
                            for t[i] in root.task-thumbs: Rectangle {
                                x: 6px + i * 100px;
                                y: 6px;
                                width: 94px;
                                height: 90px;
                                border-radius: Theme.ctl-radius;
                                background: thumb-ta.has-hover ? Theme.accent-12 : transparent;
                                Image {
                                    x: 6px;
                                    y: 4px;
                                    width: parent.width - 12px;
                                    height: 62px;
                                    source: t.image;
                                    image-fit: contain;
                                }
                                Text {
                                    x: 3px;
                                    y: 68px;
                                    width: parent.width - 6px;
                                    height: 18px;
                                    text: t.name;
                                    font-size: Theme.small-font-size;
                                    color: Theme.text;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                                thumb-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.task-thumb(i);
                                    }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        for c[i] in root.task-commands: Rectangle {
                            border-radius: Theme.ctl-radius;
                            border-width: cmd-ta.has-hover ? 1px : 0px;
                            border-color: Theme.accent-60;
                            background: cmd-ta.pressed ? Theme.accent-20 : cmd-ta.has-hover ? Theme.accent-12 : transparent;
                            HorizontalLayout {
                                padding: 7px;
                                padding-left: 6px;
                                spacing: 8px;
                                FaIcon {
                                    width: 20px;
                                    glyph: c.glyph != "" ? c.glyph : "\u{f061}";
                                    size: 14px;
                                    color: Theme.dark ? #6ccf7a : #1e8a3a;
                                    vertical-alignment: top;
                                }
                                VerticalLayout {
                                    spacing: 1px;
                                    Text {
                                        text: c.title;
                                        font-size: 14px;
                                        color: Theme.dark ? Theme.accent.brighter(0.5) : Theme.accent.darker(0.25);
                                    }
                                    if c.text != "": Text {
                                        width: col-w - 48px;
                                        text: c.text;
                                        wrap: word-wrap;
                                        font-size: Theme.small-font-size;
                                        color: Theme.text-inactive;
                                    }
                                }
                            }
                            cmd-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.task-result(i);
                                }
                            }
                        }
                    }
                }
            }

            // ---- Recadrage (IlluCropInteractive.js) : rapports, Recadrer / Annuler ----
            if root.show-crop: FloatWindow {
                float-w: 300px;
                float-h: crop-col.preferred-height + Theme.title-height;
                float-x: ws.width - min(self.float-w, ws.width) - 12px;
                float-y: 12px;
                z: root.z-dialog;
                title: @tr("Recadrage");
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.crop-action("cancel");
                    fs.focus();
                }
                crop-col := VerticalLayout {
                    padding: 10px;
                    // place du pied (alvéole des boutons)
                    padding-bottom: 54px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 4px;
                        for q[i] in [
                            { n: "16:9", w: 26, h: 15 },
                            { n: "9:16", w: 12, h: 20 },
                            { n: "1:1", w: 18, h: 18 },
                            { n: "4:3", w: 22, h: 16 },
                            { n: @tr("Libre"), w: 0, h: 0 },
                        ]: Rectangle {
                            horizontal-stretch: 1;
                            height: 46px;
                            border-radius: Theme.ctl-radius;
                            background: root.crop-ratio == i || (i == 4 && root.crop-ratio < 0) ? Theme.accent-14 : qta.has-hover ? Theme.accent-12 : Theme.button-bg;
                            border-width: 1px;
                            border-color: root.crop-ratio == i || (i == 4 && root.crop-ratio < 0) ? Theme.accent : Theme.button-border;
                            Rectangle {
                                y: 6px;
                                width: q.w > 0 ? q.w * 1px : 20px;
                                height: q.h > 0 ? q.h * 1px : 16px;
                                border-width: 1.5px;
                                border-color: Theme.text;
                                border-radius: 2px * Theme.round;
                                background: q.w > 0 ? Theme.accent.with-alpha(0.25) : transparent;
                            }
                            Text {
                                y: parent.height - 16px;
                                text: q.n;
                                font-size: Theme.small-font-size;
                                color: Theme.text;
                            }
                            qta := TouchArea {
                                clicked => {
                                    root.crop-ratio = i == 4 ? -1 : i;
                                    root.crop-action("" + i);
                                }
                            }
                        }
                    }
                    Text {
                        text: @tr("Glissez les poignées ou le cadre sur l'image. Entrée : recadrer, Échap : annuler.");
                        wrap: word-wrap;
                        font-size: Theme.small-font-size;
                        color: Theme.text-inactive;
                    }
                }
                DialogFooter {
                    y: parent.content-height - 44px;
                    W10Button {
                        text: @tr("Recadrer");
                        primary: true;
                        clicked => {
                            root.crop-action("apply");
                            fs.focus();
                        }
                    }
                    W10Button {
                        text: @tr("Annuler");
                        clicked => {
                            root.crop-action("cancel");
                            fs.focus();
                        }
                    }
                }
            }

            // ---- Bordure d'image (comme la version web) ----
            if root.show-border: FloatWindow {
                pure function n(s: string) -> int {
                    return s.is-float() ? max(0, round(s.to-float())) : 0;
                }
                property <int> ml: root.bd-uniform ? n(root.bd-all) : n(root.bd-l);
                property <int> mr: root.bd-uniform ? n(root.bd-all) : n(root.bd-r);
                property <int> mt: root.bd-uniform ? n(root.bd-all) : n(root.bd-t);
                property <int> mb: root.bd-uniform ? n(root.bd-all) : n(root.bd-b);
                float-w: 360px;
                float-h: bd-col.preferred-height + Theme.title-height;
                float-x: (ws.width - min(self.float-w, ws.width)) / 2;
                float-y: max(10px, (ws.height - self.float-h) / 2);
                z: root.z-dialog;
                title: @tr("Bordure d'image");
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.show-border = false;
                    fs.focus();
                }
                bd-col := VerticalLayout {
                    padding: 14px;
                    // place du pied (alvéole des boutons)
                    padding-bottom: 58px;
                    spacing: 8px;
                    Text {
                        text: @tr("Ajoute un cadre de couleur autour de l'image.");
                        color: Theme.text-inactive;
                        font-size: Theme.small-font-size;
                    }
                    Segmented {
                        height: 26px;
                        options: [@tr("Autour (agrandit la toile)"), @tr("À l'intérieur")];
                        index: root.bd-outside ? 0 : 1;
                        selected(i) => {
                            root.bd-outside = i == 0;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        uni-cb := W10CheckBox {
                            y: 3px;
                            checked <=> root.bd-uniform;
                        }
                        Text {
                            text: @tr("Uniforme sur les 4 côtés");
                            color: Theme.text;
                            vertical-alignment: center;
                            TouchArea {
                                clicked => {
                                    uni-cb.toggle();
                                }
                            }
                        }
                    }
                    if root.bd-uniform: Field {
                        label: @tr("Taille (px)");
                        value <=> root.bd-all;
                    }
                    if !root.bd-uniform: Field {
                        label: @tr("Haut (px)");
                        value <=> root.bd-t;
                    }
                    if !root.bd-uniform: Field {
                        label: @tr("Gauche (px)");
                        value <=> root.bd-l;
                    }
                    if !root.bd-uniform: Field {
                        label: @tr("Droite (px)");
                        value <=> root.bd-r;
                    }
                    if !root.bd-uniform: Field {
                        label: @tr("Bas (px)");
                        value <=> root.bd-b;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 90px;
                            text: @tr("Couleur");
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: Theme.ctl-radius;
                            border-width: 1px;
                            border-color: Theme.window-border;
                            background: root.bd-secondary ? root.secondary-color : root.primary-color;
                        }
                        Segmented {
                            height: 26px;
                            options: [@tr("Principale"), @tr("Secondaire")];
                            index: root.bd-secondary ? 1 : 0;
                            selected(i) => {
                                root.bd-secondary = i == 1;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 90px;
                            text: @tr("Destination");
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        Segmented {
                            height: 26px;
                            options: [@tr("Nouveau calque"), @tr("Calque actif")];
                            index: root.bd-new-layer ? 0 : 1;
                            selected(i) => {
                                root.bd-new-layer = i == 0;
                            }
                        }
                    }
                    Text {
                        text: @tr("Nouvelle taille : ") + (root.bd-doc-w + (root.bd-outside ? ml + mr : 0)) + @tr(" × ") + (root.bd-doc-h + (root.bd-outside ? mt + mb : 0)) + @tr(" px");
                        color: Theme.text-inactive;
                    }
                }
                DialogFooter {
                    y: parent.content-height - 44px;
                    W10Button {
                        text: @tr("OK");
                        primary: true;
                        clicked => {
                            root.show-border = false;
                            root.border-apply();
                            fs.focus();
                        }
                    }
                    W10Button {
                        text: @tr("Annuler");
                        clicked => {
                            root.show-border = false;
                            fs.focus();
                        }
                    }
                }
            }

            // ---- Exporter : export rapide, autres formats et options ----
            if root.show-export: FloatWindow {
                property <[string]> fmts: ["png", "jpeg", "webp", "bmp", "gif", "illu", "svg"];
                property <[string]> exts: [".png", ".jpg", ".webp", ".bmp", ".gif", ".illu"];
                property <[string]> bits: ["bw", "1", "2", "4", "8"];
                float-w: 420px;
                float-h: ex-col.preferred-height + Theme.title-height;
                float-x: (ws.width - min(self.float-w, ws.width)) / 2;
                float-y: max(10px, (ws.height - self.float-h) / 2);
                z: root.z-dialog;
                title: @tr("Exporter");
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.show-export = false;
                    fs.focus();
                }
                ex-col := VerticalLayout {
                    padding: 14px;
                    // place du pied (alvéole des boutons)
                    padding-bottom: 58px;
                    spacing: 10px;
                    Text {
                        text: @tr("Un clic pour l'essentiel — ou plus de formats ci-dessous.");
                        color: Theme.text-inactive;
                    }
                    Text {
                        text: @tr("Nom du fichier");
                        font-weight: 600;
                        color: Theme.text;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        height: 24px;
                        W10LineEdit {
                            text <=> root.ex-name;
                        }
                        Text {
                            text: root.ex-more ? exts[root.ex-fmt] : ".png";
                            color: Theme.text-inactive;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        for q[i] in [
                            { g: "\u{f03e}", t: @tr("Image PNG"), h: @tr("Photo, réseaux, impression") },
                            { g: "\u{f0c7}", t: @tr("Projet .illu"), h: @tr("Reprendre dans MasterPaint") },
                        ]: Rectangle {
                            horizontal-stretch: 1;
                            height: 70px;
                            border-radius: Theme.ctl-radius + 2px * Theme.round;
                            background: exq.pressed ? Theme.accent-20 : exq.has-hover ? Theme.accent-12 : Theme.button-bg;
                            border-width: 1px;
                            border-color: exq.has-hover ? Theme.accent : Theme.button-border;
                            GlyphIcon {
                                y: 9px;
                                height: 22px;
                                glyph: q.g;
                                weight: i == 0 ? 400 : 900;
                                size: 18px;
                                tint: Theme.accent;
                            }
                            Text {
                                y: 34px;
                                text: q.t;
                                font-weight: 600;
                                color: Theme.text;
                            }
                            Text {
                                y: 51px;
                                text: q.h;
                                font-size: Theme.small-font-size;
                                color: Theme.text-inactive;
                            }
                            exq := TouchArea {
                                clicked => {
                                    root.export-run(i == 0 ? "png" : "illu", root.ex-name, 90, "8", false);
                                }
                            }
                        }
                    }
                    // autres formats : volet repliable
                    Rectangle {
                        height: 22px;
                        HorizontalLayout {
                            spacing: 6px;
                            FaIcon {
                                width: 12px;
                                glyph: root.ex-more ? "\u{f078}" : "\u{f054}";
                                size: 9px;
                                color: Theme.accent;
                            }
                            Text {
                                text: @tr("Autres formats et options…");
                                color: Theme.accent;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.ex-more = !root.ex-more;
                            }
                        }
                    }
                    if root.ex-more: VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            height: 24px;
                            Text { width: 110px; text: @tr("Format"); color: Theme.text; vertical-alignment: center; }
                            W10ComboBox {
                                model: [@tr("PNG (.png)"), @tr("JPEG (.jpg)"), @tr("WebP (.webp)"), @tr("BMP (.bmp)"), @tr("GIF (.gif)"), @tr("Projet Illu (.illu)"), @tr("SVG (.svg) — calques vectoriels gardés")];
                                current-index <=> root.ex-fmt;
                            }
                        }
                        if root.ex-fmt == 5 && root.ex-tabs > 1: HorizontalLayout {
                            spacing: 8px;
                            height: 26px;
                            Text { width: 110px; text: @tr("Périmètre"); color: Theme.text; vertical-alignment: center; }
                            Segmented {
                                options: [@tr("Onglet actuel"), @tr("Tous les onglets")];
                                index: root.ex-all ? 1 : 0;
                                selected(i) => {
                                    root.ex-all = i == 1;
                                }
                            }
                        }
                        if root.ex-fmt == 1: HorizontalLayout {
                            spacing: 8px;
                            height: 24px;
                            Text { width: 110px; text: @tr("Qualité JPEG"); color: Theme.text; vertical-alignment: center; }
                            W10Slider {
                                y: 2px;
                                minimum: 1;
                                maximum: 100;
                                value <=> root.ex-quality;
                            }
                            Text { width: 40px; text: round(root.ex-quality) + " %"; color: Theme.text; vertical-alignment: center; }
                        }
                        if root.ex-fmt == 0 || root.ex-fmt == 2: Text {
                            text: @tr("Image sans perte.");
                            font-size: Theme.small-font-size;
                            color: Theme.text-inactive;
                        }
                        if root.ex-fmt < 5: HorizontalLayout {
                            spacing: 8px;
                            height: 24px;
                            Text { width: 110px; text: @tr("Profondeur couleurs"); color: Theme.text; vertical-alignment: center; }
                            W10ComboBox {
                                model: [@tr("Noir & blanc (contraste auto)"), @tr("1 bit"), @tr("2 bits"), @tr("4 bits"), @tr("8 bits (standard)")];
                                current-index <=> root.ex-bits;
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            W10Button {
                                text: @tr("Télécharger");
                                primary: true;
                                clicked => {
                                    root.export-run(fmts[root.ex-fmt], root.ex-name, round(root.ex-quality), bits[root.ex-bits], root.ex-all);
                                }
                            }
                        }
                    }
                }
                // pied : case de sauvegarde automatique à gauche, Fermer à droite
                DialogFooter {
                    y: parent.content-height - 44px;
                    HorizontalLayout {
                        spacing: 8px;
                        horizontal-stretch: 1;
                        alignment: start;
                        ex-auto := W10CheckBox {
                            y: 4px;
                            checked <=> root.set-autosave;
                            toggled => {
                                root.settings-changed();
                            }
                        }
                        Text {
                            text: @tr("Sauvegarde automatique des onglets");
                            color: Theme.text;
                            vertical-alignment: center;
                            TouchArea {
                                clicked => {
                                    ex-auto.toggle();
                                }
                            }
                        }
                    }
                    W10Button {
                        text: @tr("Fermer");
                        clicked => {
                            root.show-export = false;
                            fs.focus();
                        }
                    }
                }
            }

            // ---- Erreur : message, détails, rapport ----
            if root.show-error: FloatWindow {
                float-w: 460px;
                float-h: err-col.preferred-height + Theme.title-height;
                float-x: (ws.width - min(self.float-w, ws.width)) / 2;
                float-y: max(10px, (ws.height - self.float-h) / 2);
                z: root.z-dialog + 6;
                title: @tr("Erreur — ") + root.error-context;
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.show-error = false;
                    fs.focus();
                }
                err-col := VerticalLayout {
                    padding: 14px;
                    // place du pied (alvéole des boutons)
                    padding-bottom: 58px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 12px;
                        FaIcon {
                            width: 28px;
                            glyph: "\u{f071}";
                            size: 22px;
                            color: #d97706;
                            vertical-alignment: top;
                        }
                        Text {
                            text: root.error-message;
                            wrap: word-wrap;
                            font-size: 13px;
                            color: Theme.text;
                        }
                    }
                    Rectangle {
                        height: 20px;
                        HorizontalLayout {
                            spacing: 6px;
                            FaIcon {
                                width: 12px;
                                glyph: root.error-more ? "\u{f078}" : "\u{f054}";
                                size: 9px;
                                color: Theme.accent;
                            }
                            Text {
                                text: @tr("Détails");
                                color: Theme.accent;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.error-more = !root.error-more;
                            }
                        }
                    }
                    if root.error-more: Rectangle {
                        height: 160px;
                        border-radius: Theme.ctl-radius;
                        border-width: 1px;
                        border-color: Theme.window-border;
                        background: Theme.field-bg;
                        ScrollView {
                            x: 1px;
                            y: 1px;
                            width: parent.width - 2px;
                            height: parent.height - 2px;
                            content-height: det.preferred-height + 12px;
                            det := Text {
                                x: 6px;
                                y: 6px;
                                width: parent.width - 20px;
                                text: root.error-details;
                                wrap: word-wrap;
                                font-size: Theme.small-font-size;
                                color: Theme.text;
                            }
                        }
                    }
                }
                DialogFooter {
                    y: parent.content-height - 44px;
                    W10Button {
                        text: @tr("Signaler l'erreur");
                        primary: true;
                        clicked => {
                            root.contact-kind = 0;
                            root.contact-message = root.error-details;
                            root.show-error = false;
                            root.show-contact = true;
                        }
                    }
                    W10Button {
                        text: root.web ? @tr("Redémarrer la page") : @tr("Redémarrer MasterPaint");
                        clicked => {
                            root.quick-action("restart-app");
                        }
                    }
                    W10Button {
                        text: @tr("Fermer");
                        clicked => {
                            root.show-error = false;
                            fs.focus();
                        }
                    }
                }
            }

            // ---- Aperçu de la toile en 1:1 ----
            if root.show-live: FloatWindow {
                resizable: true;
                resizable-w: true;
                min-window-width: 200px;
                float-w: 460px;
                float-h: 360px;
                float-x: ws.width - 480px;
                float-y: 40px;
                z: root.z-dialog;
                title: @tr("Aperçu 1:1");
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.show-live = false;
                }
                Flickable {
                    width: parent.width;
                    height: parent.content-height;
                    viewport-width: root.live-image.width * 1px;
                    viewport-height: root.live-image.height * 1px;
                    Image {
                        source: root.live-image;
                        image-rendering: pixelated;
                    }
                }
            }

            // ---- Visionneuse d'icônes ----
            if root.show-icons: FloatWindow {
                resizable: true;
                resizable-w: true;
                min-window-width: 200px;
                float-w: 520px;
                float-h: 420px;
                float-x: (ws.width - 520px) / 2;
                float-y: 40px;
                z: root.z-dialog;
                title: @tr("Visionneuse d'icônes — ") + root.icon-entries.length + @tr(" icônes MasterPaint");
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.show-icons = false;
                }
                Flickable {
                    width: parent.width;
                    height: parent.content-height;
                    property <int> cols: max(1, floor((self.width - 8px) / 92px));
                    viewport-height: ceil(root.icon-entries.length / self.cols) * 78px + 8px;
                    for e[i] in root.icon-entries: Rectangle {
                        x: 4px + mod(i, parent.cols) * 92px;
                        y: 4px + floor(i / parent.cols) * 78px;
                        width: 90px;
                        height: 76px;
                        border-radius: Theme.ctl-radius;
                        background: ita.has-hover ? Theme.accent-12 : transparent;
                        Image {
                            y: 6px;
                            width: 36px;
                            height: 36px;
                            source: e.image;
                        }
                        Text {
                            y: 46px;
                            width: parent.width - 4px;
                            height: 26px;
                            text: e.name;
                            font-size: 9px;
                            color: Theme.text;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            overflow: elide;
                        }
                        ita := TouchArea { }
                    }
                }
            }

            // ---- Calque actif : position et taille ----
            if root.show-bounds: FloatWindow {
                float-w: 340px;
                float-h: bnd-col.preferred-height + Theme.title-height;
                float-x: (ws.width - min(self.float-w, ws.width)) / 2;
                float-y: max(10px, (ws.height - self.float-h) / 2);
                z: root.z-dialog;
                title: @tr("Calque actif : position et taille");
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.show-bounds = false;
                    fs.focus();
                }
                bnd-col := VerticalLayout {
                    padding: 14px;
                    // place du pied (alvéole des boutons)
                    padding-bottom: 58px;
                    spacing: 8px;
                    Text {
                        text: @tr("Emprise du contenu du calque, en pixels du document.");
                        font-size: Theme.small-font-size;
                        color: Theme.text-inactive;
                    }
                    Field {
                        label: @tr("X");
                        value <=> root.bd-x;
                    }
                    Field {
                        label: @tr("Y");
                        value <=> root.bd-y;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: 26px;
                        Text {
                            width: 90px;
                            text: @tr("Largeur");
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        W10LineEdit {
                            text <=> root.bd-w;
                            input-type: number;
                            edited(t) => {
                                if (root.bd-lock && t.is-float() && t.to-float() > 0) {
                                    root.bd-h = "" + max(1, round(t.to-float() * root.bd-orig-h / root.bd-orig-w));
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: 26px;
                        Text {
                            width: 90px;
                            text: @tr("Hauteur");
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        W10LineEdit {
                            text <=> root.bd-h;
                            input-type: number;
                            edited(t) => {
                                if (root.bd-lock && t.is-float() && t.to-float() > 0) {
                                    root.bd-w = "" + max(1, round(t.to-float() * root.bd-orig-w / root.bd-orig-h));
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        lock-cb := W10CheckBox {
                            y: 3px;
                            checked <=> root.bd-lock;
                        }
                        Text {
                            text: @tr("Conserver les proportions");
                            color: Theme.text;
                            vertical-alignment: center;
                            TouchArea {
                                clicked => {
                                    lock-cb.toggle();
                                }
                            }
                        }
                    }
                }
                DialogFooter {
                    y: parent.content-height - 44px;
                    W10Button {
                        text: @tr("OK");
                        primary: true;
                        clicked => {
                            root.show-bounds = false;
                            root.bounds-apply(root.bd-x, root.bd-y, root.bd-w, root.bd-h);
                            fs.focus();
                        }
                    }
                    W10Button {
                        text: @tr("Annuler");
                        clicked => {
                            root.show-bounds = false;
                            fs.focus();
                        }
                    }
                }
            }

            // ---- Saisie d'une valeur (Étendre / réduire la sélection, Bordure…) ----
            if root.show-prompt: FloatWindow {
                float-x: (ws.width - 300px) / 2;
                float-y: 80px;
                z: root.z-dialog;
                float-w: 300px;
                float-h: 128px;
                title: root.prompt-title;
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.show-prompt = false;
                    fs.focus();
                }
                VerticalLayout {
                    padding: 12px;
                    padding-bottom: 56px;
                    alignment: start;
                    Field {
                        label: root.prompt-label;
                        value <=> root.prompt-value;
                    }
                }
                DialogFooter {
                    y: parent.content-height - 44px;
                    W10Button {
                        text: @tr("OK");
                        primary: true;
                        clicked => {
                            root.show-prompt = false;
                            root.prompt-ok(root.prompt-kind, root.prompt-value);
                            fs.focus();
                        }
                    }
                    W10Button {
                        text: @tr("Annuler");
                        clicked => {
                            root.show-prompt = false;
                            fs.focus();
                        }
                    }
                }
            }

            // ---- Supprimer le fond (IA) ----
            if root.show-rmbg: FloatWindow {
                float-w: 420px;
                float-h: rmbg-col.preferred-height + Theme.title-height;
                float-x: (ws.width - min(self.float-w, ws.width)) / 2;
                float-y: max(10px, (ws.height - self.float-h) / 2);
                z: root.z-dialog;
                title: @tr("Suppression du fond");
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    if (!root.rmbg-busy) {
                        root.show-rmbg = false;
                        fs.focus();
                    }
                }
                rmbg-col := VerticalLayout {
                    padding: 14px;
                    padding-bottom: 58px;
                    spacing: 10px;
                    if !root.rmbg-busy: Text {
                        text: @tr("Réglages puis lancement du traitement (premier usage : téléchargement du modèle).");
                        wrap: word-wrap;
                        color: Theme.text;
                    }
                    if !root.rmbg-busy: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 110px;
                            text: @tr("Modèle");
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        Segmented {
                            height: 26px;
                            options: [@tr("Petit"), @tr("Moyen"), @tr("Grand")];
                            index: root.rmbg-model;
                            selected(i) => {
                                root.rmbg-model = i;
                            }
                        }
                    }
                    if !root.rmbg-busy: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 110px;
                            text: @tr("Plume du détourage");
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        W10Slider {
                            minimum: 0;
                            maximum: 12;
                            value: root.rmbg-feather;
                            changed(v) => {
                                root.rmbg-feather = round(v);
                            }
                        }
                        Text {
                            width: 40px;
                            text: round(root.rmbg-feather) + @tr(" px");
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                    if !root.rmbg-busy: Text {
                        text: @tr("Plume : adoucit le bord du canal alpha après détourage. Modèle « petit » : plus léger, un peu moins précis.");
                        wrap: word-wrap;
                        font-size: Theme.small-font-size;
                        color: Theme.text-inactive;
                    }
                    if !root.rmbg-busy && root.rmbg-warn != "": Text {
                        text: root.rmbg-warn;
                        wrap: word-wrap;
                        font-size: Theme.small-font-size;
                        color: #d97706;
                    }
                    if root.rmbg-busy: Text {
                        text: root.rmbg-text;
                        wrap: word-wrap;
                        color: Theme.text;
                    }
                    if root.rmbg-busy: Rectangle {
                        height: 8px;
                        border-radius: 4px * Theme.round;
                        background: Theme.field-border;
                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(root.rmbg-progress, 0, 100) / 100;
                            border-radius: 4px * Theme.round;
                            background: Theme.accent;
                        }
                    }
                }
                DialogFooter {
                    y: parent.content-height - 44px;
                    if !root.rmbg-busy: W10Button {
                        text: @tr("Lancer");
                        primary: true;
                        clicked => {
                            root.rmbg-start();
                        }
                    }
                    W10Button {
                        text: root.rmbg-busy ? @tr("Annuler l'opération") : @tr("Annuler");
                        clicked => {
                            root.rmbg-cancel();
                            fs.focus();
                        }
                    }
                }
            }

            // ---- Paramètres aimantation ----
            if root.show-snap: FloatWindow {
                float-w: 400px;
                float-h: snap-col.preferred-height + Theme.title-height;
                float-x: (ws.width - min(self.float-w, ws.width)) / 2;
                float-y: max(10px, (ws.height - self.float-h) / 2);
                z: root.z-dialog;
                title: @tr("Paramètres aimantation");
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.snap-cancel();
                    fs.focus();
                }
                snap-col := VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    Text {
                        text: @tr("Taille des cases (1/N)");
                        color: Theme.text;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        W10Slider {
                            minimum: 4;
                            maximum: 128;
                            value: root.set-snap-div;
                            changed(v) => {
                                root.set-snap-div = round(v);
                                root.snap-changed();
                            }
                        }
                        Text {
                            width: 52px;
                            text: "1 / " + round(root.set-snap-div);
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: @tr("Force d'attraction (%)");
                        color: Theme.text;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        W10Slider {
                            minimum: 1;
                            maximum: 100;
                            value: root.set-snap-thresh;
                            changed(v) => {
                                root.set-snap-thresh = round(v);
                                root.snap-changed();
                            }
                        }
                        Text {
                            width: 52px;
                            text: round(root.set-snap-thresh) + " %";
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alwa-cb := W10CheckBox {
                            y: 2px;
                            checked <=> root.set-snap-always;
                            toggled(v) => {
                                root.snap-changed();
                            }
                        }
                        Text {
                            text: @tr("Toujours afficher la grille en arrière-plan");
                            color: Theme.text;
                            vertical-alignment: center;
                            TouchArea {
                                clicked => {
                                    alwa-cb.toggle();
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        guid-cb := W10CheckBox {
                            y: 2px;
                            checked <=> root.set-snap-guides;
                        }
                        Text {
                            text: @tr("Afficher les lignes magenta d'accroche (croix)");
                            color: Theme.text;
                            vertical-alignment: center;
                            TouchArea {
                                clicked => {
                                    guid-cb.toggle();
                                }
                            }
                        }
                    }
                    Text {
                        text: @tr("La grille de prévisualisation s'affiche sur la toile. Validez avec OK pour conserver les paramètres de l'aimantation.");
                        wrap: word-wrap;
                        font-size: Theme.small-font-size;
                        color: Theme.text-inactive;
                    }
                }
                DialogFooter {
                    y: parent.content-height - 44px;
                    W10Button {
                        text: @tr("OK");
                        primary: true;
                        clicked => {
                            root.snap-ok();
                            fs.focus();
                        }
                    }
                    W10Button {
                        text: @tr("Annuler");
                        clicked => {
                            root.snap-cancel();
                            fs.focus();
                        }
                    }
                }
            }

            // ---- Rotation et retournement ----
            if root.show-rotate: FloatWindow {
                float-w: 340px;
                float-h: rot-col.preferred-height + Theme.title-height;
                float-x: (ws.width - min(self.float-w, ws.width)) / 2;
                float-y: max(10px, (ws.height - self.float-h) / 2);
                z: root.z-dialog;
                title: @tr("Rotation et retournement");
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.show-rotate = false;
                    fs.focus();
                }
                rot-col := VerticalLayout {
                    padding: 14px;
                    padding-bottom: 58px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: @tr("Portée");
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        Segmented {
                            height: 26px;
                            options: [@tr("Image entière"), @tr("Calque actif")];
                            index: root.rotate-layer ? 1 : 0;
                            selected(i) => {
                                root.rotate-layer = i == 1;
                            }
                        }
                    }
                    // tuiles : icône et libellé, comme les boutons de la version web
                    GridLayout {
                        spacing: 6px;
                        for r[i] in [
                            { id: "rot-ccw", g: "", img: Sprite.img-rot-ccw, t: @tr("90° vers la gauche"), whole: true },
                            { id: "rot-cw", g: "", img: Sprite.img-rot-cw, t: @tr("90° vers la droite"), whole: true },
                            { id: "rot-180", g: "\u{f2f1}", img: root.no-image, t: @tr("Demi-tour (180°)"), whole: false },
                            { id: "flip-h", g: "", img: Sprite.img-flip-h, t: @tr("Miroir horizontal"), whole: false },
                            { id: "flip-v", g: "", img: Sprite.img-flip-v, t: @tr("Miroir vertical"), whole: false },
                        ]: Rectangle {
                            property <bool> off: r.whole && root.rotate-layer;
                            col: mod(i, 3);
                            row: floor(i / 3);
                            height: 64px;
                            border-radius: Theme.ctl-radius;
                            background: off ? transparent : rot-ta.pressed ? Theme.accent-20 : rot-ta.has-hover ? Theme.accent-12 : Theme.button-bg;
                            border-width: 1px;
                            border-color: rot-ta.has-hover && !off ? Theme.accent : Theme.button-border;
                            opacity: off ? 0.4 : 1;
                            if r.g != "": GlyphIcon {
                                y: 10px;
                                height: 24px;
                                glyph: r.g;
                                size: 20px;
                                tint: Theme.accent;
                            }
                            if r.g == "": Image {
                                y: 10px;
                                width: 24px;
                                height: 24px;
                                source: r.img;
                            }
                            Text {
                                y: 40px;
                                height: 16px;
                                text: r.t;
                                font-size: Theme.small-font-size;
                                color: Theme.text;
                                horizontal-alignment: center;
                            }
                            rot-ta := TouchArea {
                                enabled: !off;
                                clicked => {
                                    Actions.ribbon(r.id);
                                }
                            }
                        }
                    }
                    Text {
                        text: root.rotate-layer ? @tr("Calque actif : retournements et demi-tour (la rotation à 90° change la taille de la toile).") : @tr("Toute l'image : tous les calques et la sélection.");
                        wrap: word-wrap;
                        font-size: Theme.small-font-size;
                        color: Theme.text-inactive;
                    }
                }
                DialogFooter {
                    y: parent.content-height - 44px;
                    W10Button {
                        text: @tr("Fermer");
                        clicked => {
                            root.show-rotate = false;
                            fs.focus();
                        }
                    }
                }
            }

            // ---- Fenêtre d'effet (champs relevés sur la version web) ----
            if root.show-effect: FloatWindow {
                property <length> rows-h: efl.preferred-height;
                sheet: root.phone;
                sheet-footer: false;
                docked: root.phone;
                dock-x: 5px;
                dock-w: ws.width - 10px;
                dock-h: min(min(self.rows-h + 18px + 56px, ws.height * 0.55), root.mob-sheet-max);
                dock-y: ws.height - root.strip-height - self.dock-h - 6px;
                float-x: min(ws.width - 450px, ws.width * 0.5);
                float-y: 16px;
                z: root.z-dialog;
                float-w: 430px;
                float-h: min(self.rows-h + 26px + 56px, ws.height - 32px);
                // taille fixe (la liste des réglages défile si elle dépasse)
                title: root.effect-title;
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.effect-cancel();
                    fs.focus();
                }
                ScrollView {
                    y: 0;
                    height: parent.content-height - 46px;
                    content-height: efl.preferred-height;
                    efl := VerticalLayout {
                        padding: 8px;
                        padding-right: 14px;
                        spacing: 3px;
                        alignment: start;
                        // portée de l'effet (comme la version web)
                        if !root.effect-dynamic-layer: HorizontalLayout {
                            spacing: 6px;
                            height: 26px;
                            Text {
                                text: @tr("Portée");
                                color: Theme.text-inactive;
                                font-size: Theme.small-font-size;
                                vertical-alignment: center;
                            }
                            Segmented {
                                height: 24px;
                                options: [@tr("Sélection"), @tr("Calque actif"), @tr("Tous les calques")];
                                index <=> root.effect-scope;
                                selected(i) => {
                                    root.effect-scope-changed();
                                }
                            }
                        }
                        if root.effect-fields.length == 0: Text {
                            text: @tr("Aucun réglage pour cet effet.");
                            color: Theme.text;
                        }
                        for f[i] in root.effect-fields: Rectangle {
                            // curseur au libellé long : libellé au-dessus (comme Paint.NET), jamais tronqué
                            height: f.kind == 5 ? 26px : f.kind == 6 ? 30px : f.kind == 0 && f.label.character-count > 22 ? 42px : 25px;
                            // titre de section : clic = replier / déplier
                            if f.kind == 5: Rectangle {
                                y: 3px;
                                height: parent.height - 3px;
                                background: sta.has-hover ? Theme.accent-14 : Theme.accent-12;
                                border-radius: 3px * Theme.round;
                                FaIcon {
                                    x: 6px;
                                    width: 12px;
                                    glyph: f.collapsed ? "\u{f054}" : "\u{f078}";
                                    size: 9px;
                                    color: Theme.accent;
                                }
                                Text {
                                    x: 22px;
                                    text: f.section;
                                    font-weight: 700;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                sta := TouchArea {
                                    clicked => {
                                        root.effect-field-changed(i, 0, "toggle");
                                    }
                                }
                            }
                            // curseur : libellé (double-clic : valeur par défaut, en gras si modifié),
                            // piste (dégradé si utile), valeur saisissable, cadran des angles,
                            // remise à zéro (allumée si la valeur a changé)
                            if f.kind == 0: frow := VerticalLayout {
                              property <bool> modified: abs(f.value - f.default-value) > max(f.step, 0.0001) * 0.5;
                              if f.label.character-count > 22: Text {
                                height: 16px;
                                text: f.label;
                                color: Theme.text;
                                font-weight: frow.modified ? 600 : 400;
                                overflow: elide;
                                TouchArea {
                                    double-clicked => { root.effect-field-changed(i, f.default-value, ""); }
                                }
                              }
                              HorizontalLayout {
                                spacing: 6px;
                                if f.label.character-count <= 22: Text {
                                    width: 128px;
                                    text: f.label;
                                    color: Theme.text;
                                    font-weight: frow.modified ? 600 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    TouchArea {
                                        double-clicked => { root.effect-field-changed(i, f.default-value, ""); }
                                    }
                                }
                                GaugeBar {
                                    minimum: f.minimum;
                                    maximum: f.maximum;
                                    step: f.step;
                                    value: f.value;
                                    gradient: f.track-kind > 0;
                                    track: f.track-kind == 2
                                        ? @linear-gradient(90deg, #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%)
                                        : @linear-gradient(90deg, f.track-a 0%, f.track-b 100%);
                                    changed(v) => {
                                        root.effect-field-changed(i, v, "");
                                    }
                                }
                                // cadran (angles) : glisser pour orienter, comme Paint.NET
                                if f.angle: Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    y: 1px;
                                    border-radius: 11px;
                                    background: Theme.field-bg;
                                    border-width: 1px;
                                    border-color: dial.has-hover ? Theme.accent : Theme.field-border;
                                    Path {
                                        width: 22px;
                                        height: 22px;
                                        viewbox-width: 22;
                                        viewbox-height: 22;
                                        // coordonnées arrondies : jamais d'écriture scientifique (1.2e-16) dans le tracé
                                        commands: "M 11 11 L " + round((11 + 8 * cos(f.value * 1deg)) * 10) / 10 + " " + round((11 - 8 * sin(f.value * 1deg)) * 10) / 10;
                                        stroke: Theme.accent;
                                        stroke-width: 2px;
                                    }
                                    Rectangle { width: 4px; height: 4px; border-radius: 2px; background: Theme.accent; }
                                    dial := TouchArea {
                                        mouse-cursor: pointer;
                                        // angle en degrés (0 à droite, sens trigonométrique), ramené dans la plage
                                        function set-from(px: length, py: length) {
                                            if (abs(px - 11px) + abs(py - 11px) < 2px) { return; }
                                            let a = atan2((11px - py) / 1px, (px - 11px) / 1px) / 1deg;
                                            let v = a < f.minimum ? a + 360 : a > f.maximum ? a - 360 : a;
                                            root.effect-field-changed(i, round(clamp(v, f.minimum, f.maximum)), "");
                                        }
                                        pointer-event(e) => {
                                            if (e.kind == PointerEventKind.down) { self.set-from(self.mouse-x, self.mouse-y); }
                                        }
                                        moved => { if (self.pressed) { self.set-from(self.mouse-x, self.mouse-y); } }
                                        double-clicked => { root.effect-field-changed(i, f.default-value, ""); }
                                    }
                                }
                                FlatButton {
                                    width: 22px;
                                    icon: { svg-index: -1, fa: "\u{f2ea}", fa-weight: 900 };
                                    icon-size: 10px;
                                    show-label: false;
                                    checked: frow.modified;
                                    tip: frow.modified ? @tr("Revenir à la valeur par défaut") + " (" + round(f.default-value * 100) / 100 + ")" : @tr("Valeur par défaut");
                                    clicked => {
                                        root.effect-field-changed(i, f.default-value, "");
                                    }
                                }
                              }
                            }
                            if f.kind == 1: HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                fx-cb := W10CheckBox {
                                    y: 5px;
                                    checked: f.value > 0;
                                    toggled(v) => {
                                        root.effect-field-changed(i, v ? 1 : 0, "");
                                    }
                                }
                                Text {
                                    text: f.label;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    TouchArea {
                                        clicked => {
                                            fx-cb.toggle();
                                        }
                                    }
                                }
                            }
                            if f.kind == 2: HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    width: 128px;
                                    text: f.label;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                W10ComboBox {
                                    model: f.options;
                                    current-index: f.value;
                                    selected(k) => {
                                        root.effect-field-changed(i, k, "");
                                    }
                                }
                            }
                            // couleur simple (clic : couleur principale) et couleur R/V/B (hexa + pipette)
                            if f.kind == 3 || f.kind == 6: HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Text {
                                    width: 128px;
                                    text: f.label;
                                    color: Theme.text;
                                    font-weight: f.kind == 6 ? 600 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle {
                                    width: 46px;
                                    background: f.swatch;
                                    border-width: 1px;
                                    border-color: #808080;
                                    HoverTip { y: parent.height; hovered: esa.has-hover; text: @tr("Choisir la couleur"); }
                                    esa := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            ColorPop.show("effect:" + i, f.swatch, self.absolute-position.x, self.absolute-position.y, self.height);
                                        }
                                    }
                                }
                                if f.kind == 6: W10LineEdit {
                                    width: 76px;
                                    text: f.text;
                                    accepted(t) => {
                                        root.effect-field-changed(i, 0, t);
                                    }
                                }
                                W10Button {
                                    text: @tr("Pipette");
                                    clicked => {
                                        root.effect-field-changed(i, 0, "pick");
                                    }
                                }
                            }
                            if f.kind == 4: HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    width: 128px;
                                    text: f.label;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                W10LineEdit {
                                    text: f.text;
                                    edited(t) => {
                                        root.effect-field-changed(i, 0, t);
                                    }
                                }
                            }
                            // bouton d'action (ex. « Auto » de l'incrustation : couleur du fond détectée)
                            if f.kind == 7: HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Text {
                                    width: 128px;
                                    text: f.label;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                W10Button {
                                    text: f.text;
                                    clicked => {
                                        root.effect-field-changed(i, 1, "button");
                                    }
                                }
                            }
                        }
                    }
                }
                // pied commun des fenêtres (alvéole des boutons) ; état du calcul à gauche
                effect-footer := DialogFooter {
                    y: parent.content-height - 44px;
                    if effect-footer.width >= 520px: Text {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        text: root.effect-info;
                        color: Theme.text-inactive;
                        font-size: Theme.small-font-size;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    if effect-footer.width < 520px: Rectangle { horizontal-stretch: 1; }
                    if root.effect-dynamic-edit: W10Button {
                        width: effect-footer.width < 420px ? 28px : 80px;
                        text: effect-footer.width < 420px ? "−" : @tr("Supprimer");
                        tip: @tr("Supprimer");
                        clicked => { root.effect-remove(); }
                    }
                    W10Button {
                        width: effect-footer.width < 420px ? 28px : 104px;
                        text: effect-footer.width < 420px ? "↺" : @tr("Réinitialiser");
                        tip: @tr("Réinitialiser");
                        clicked => {
                            root.effect-reset();
                        }
                    }
                    W10Button {
                        text: @tr("OK");
                        primary: true;
                        clicked => {
                            root.effect-ok();
                            fs.focus();
                        }
                    }
                    W10Button {
                        text: @tr("Annuler");
                        clicked => {
                            root.effect-cancel();
                            fs.focus();
                        }
                    }
                }
            }

            // ---- Télécharger l'application ----
            if root.show-download: FloatWindow {
                float-x: (ws.width - 340px) / 2;
                float-y: 60px;
                z: root.z-dialog;
                float-w: 340px;
                // hauteur du contenu (avant : 352 px fixes, la dernière ligne débordait)
                float-h: min(dlcol.preferred-height + Theme.title-height + 4px, root.usable-height - ws.y - 12px);
                title: @tr("Télécharger MasterPaint");
                bounds-width: ws.width;
                bounds-height: root.usable-height - ws.y;
                min-y: 0px - ws.y;
                close => {
                    root.show-download = false;
                    fs.focus();
                }
                dlcol := VerticalLayout {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    padding: 12px;
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: @tr("Version installable, plus rapide (tous les cœurs du processeur) :");
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    for d in [
                        { id: "windows-exe", g: "\u{f17a}", t: @tr("Windows — application portable (.exe)"), ok: true },
                        { id: "windows-setup", g: "\u{f17a}", t: @tr("Windows — installeur (setup)"), ok: true },
                        { id: "linux-appimage", g: "\u{f17c}", t: @tr("Linux — AppImage"), ok: true },
                        { id: "linux-tar", g: "\u{f17c}", t: @tr("Linux — archive .tar.gz"), ok: true },
                        { id: "linux-flatpak", g: "\u{f17c}", t: @tr("Linux — Flatpak"), ok: true },
                        { id: "macos-dmg", g: "\u{f179}", t: @tr("macOS — .dmg"), ok: false },
                        { id: "android", g: "\u{f17b}", t: @tr("Android — .apk"), ok: true },
                        { id: "ios", g: "\u{f179}", t: @tr("iOS / iPadOS"), ok: false },
                    ]: Rectangle {
                        height: 30px;
                        opacity: d.ok ? 1 : 0.55;
                        background: d.ok && dlta.has-hover ? Theme.accent-14 : Theme.button-bg;
                        border-width: 1px;
                        border-color: d.ok && dlta.has-hover ? Theme.accent : Theme.button-border;
                        // pas encore compilée pour cette plateforme
                        if !d.ok: Text {
                            x: parent.width - 86px;
                            width: 78px;
                            height: parent.height;
                            text: @tr("indisponible");
                            font-size: Theme.small-font-size;
                            color: #b45309;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        Text {
                            x: 10px;
                            width: 18px;
                            height: parent.height;
                            text: d.g;
                            font-family: "Font Awesome 6 Brands";
                            font-size: 14px;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        Text {
                            x: 36px;
                            height: parent.height;
                            text: d.t;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        dlta := TouchArea {
                            enabled: d.ok;
                            clicked => {
                                root.download(d.id);
                            }
                        }
                    }
                }
            }
        }

        // ================= fenêtre Couleurs surgissante (ColorPop) =================
        // la vraie fenêtre Couleurs (roue / carré, « Plus », favoris, récentes) posée contre la
        // case cliquée — dessous, sinon dessus — qui modifie la couleur de cette case ; un clic
        // ailleurs ou la croix la ferme
        if ColorPop.open: TouchArea {
            z: 19;
            clicked => { ColorPop.open = false; }
        }
        if ColorPop.open: cpop := Rectangle {
            property <length> pw: root.colors-expanded ? 534px : 197px;
            property <length> ph: popanel.wanted-height;
            property <color> c <=> ColorPop.color;
            changed c => { ColorPop.changed(self.c); }
            z: 19;
            x: clamp(ColorPop.anchor-x, 4px, max(4px, root.width - self.pw - 4px));
            y: ColorPop.anchor-y + ColorPop.anchor-h + 4px + self.ph <= root.height - 4px
                ? ColorPop.anchor-y + ColorPop.anchor-h + 4px
                : max(4px, ColorPop.anchor-y - self.ph - 4px);
            width: self.pw;
            height: self.ph;
            border-radius: Theme.window-radius;
            background: Theme.window-bg;
            border-width: 1px;
            border-color: Theme.window-border;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.window-shadow;
            // le clic dans la fenêtre ne la ferme pas
            TouchArea { }
            Rectangle {
                y: 0;
                height: Theme.title-height;
                border-top-left-radius: Theme.window-radius;
                border-top-right-radius: Theme.window-radius;
                background: Theme.window-title-bg;
                Text {
                    x: 10px;
                    text: @tr("Couleurs");
                    color: Theme.text;
                    vertical-alignment: center;
                }
                CloseButton {
                    x: parent.width - self.width - 4px;
                    y: (parent.height - self.height) / 2;
                    clicked => { ColorPop.open = false; }
                }
            }
            popanel := ColorsPanel {
                y: Theme.title-height;
                width: parent.width;
                height: parent.height - Theme.title-height;
                wheel: root.wheel-image;
                grid-image: root.color-grid-image;
                mode-palette: root.mode-palette;
                gray: root.gray-palette;
                favorites: root.fav-colors;
                recents: root.recent-colors;
                full-palette: Palettes.full;
                primary <=> ColorPop.color;
                secondary: root.secondary-color;
                expanded <=> root.colors-expanded;
                square <=> root.colors-grid;
                comps: ColorPop.comps;
                hex: ColorPop.hex;
                fav-add => { root.fav-action("add", -1); }
                fav-remove(i) => { root.fav-action("remove", i); }
                wheel-picked(x, y, sz, r) => { ColorPop.wheel-picked(x, y, sz); }
                hsv-picked(h, sv, v, r) => { ColorPop.hsv-picked(h, sv, v); }
                component-changed(i, v) => { ColorPop.component-changed(i, v); }
                hex-edited(t) => { ColorPop.hex-edited(t); }
                pick-screen => {
                    ColorPop.open = false;
                    root.tool-selected("tool-eyedropper");
                }
            }
        }

        // ================= menus déroulants (au-dessus de tout) =================
        if root.open-menu >= 0 && !root.phone: Rectangle {
            // au-dessus du Mode Photo Pro (z 10) et des barres du mode téléphone
            z: 20;
            // clic hors du menu : fermeture (la rangée des titres reste active pour changer de menu)
            TouchArea {
                y: 24px;
                height: root.usable-height - 24px;
                clicked => {
                    root.open-menu = -1;
                }
            }
            TouchArea {
                x: root.menu-zone;
                width: root.usable-width - root.menu-zone;
                height: 24px;
                clicked => {
                    root.open-menu = -1;
                }
            }
            Rectangle {
                x: root.menu-x;
                y: 23px;
                width: 300px;
                height: ddl.preferred-height;
                background: Theme.menu-bg;
                border-radius: 7px * Theme.round;
                border-width: 1px;
                border-color: Theme.field-border;
                drop-shadow-blur: 6px;
                drop-shadow-offset-y: 2px;
                drop-shadow-color: Theme.window-shadow;
                TouchArea { }
                if !Theme.win98: MenuGutter { height: parent.height - 2 * self.pad; }
                ddl := VerticalLayout {
                    padding: Theme.win98 ? 2px : 4px;
                    for it[i] in root.menus[root.open-menu].items: MenuRow {
                        label: it.label;
                        fa: it.fa;
                        fa-weight: it.fa-weight;
                        shortcut: it.shortcut;
                        action: it.action;
                        badge: it.badge;
                        separator: it.separator;
                        submenu: it.submenu;
                        highlighted: it.submenu && root.open-sub == i;
                        hovered => {
                            // sous-menu : ouvert au survol, comme sous Windows ; si un autre
                            // sous-menu est ouvert, le changement attend un peu (diagonale)
                            if (root.open-sub < 0) {
                                if (it.submenu) {
                                    root.open-sub = i;
                                    root.sub-y = self.absolute-position.y;
                                }
                            } else if (root.open-sub != i) {
                                root.pending-sub = it.submenu ? i : -1;
                                root.pending-sub-y = self.absolute-position.y;
                                root.sub-switch-pending = true;
                            } else {
                                root.sub-switch-pending = false;
                            }
                        }
                        activate => {
                            if (it.submenu) {
                                root.open-sub = i;
                                root.sub-y = self.absolute-position.y;
                            } else {
                                root.open-menu = -1;
                                root.menu-action(it.action, it.label);
                                fs.focus();
                            }
                        }
                    }
                }
            }
            Timer {
                interval: 400ms;
                running: root.sub-switch-pending;
                triggered => {
                    root.sub-switch-pending = false;
                    root.open-sub = root.pending-sub;
                    root.sub-y = root.pending-sub-y;
                }
            }
            if root.open-sub >= 0: Rectangle {
                x: min(root.menu-x + 298px, root.usable-width - 284px);
                y: min(root.sub-y - 3px, root.usable-height - self.height - 4px);
                width: 280px;
                height: sdl.preferred-height;
                background: Theme.menu-bg;
                border-radius: 7px * Theme.round;
                border-width: 1px;
                border-color: Theme.field-border;
                drop-shadow-blur: 6px;
                drop-shadow-offset-y: 2px;
                drop-shadow-color: Theme.window-shadow;
                TouchArea {
                    changed has-hover => {
                        if (self.has-hover) {
                            root.sub-switch-pending = false;
                        }
                    }
                }
                if !Theme.win98: MenuGutter { height: parent.height - 2 * self.pad; }
                sdl := VerticalLayout {
                    padding: Theme.win98 ? 2px : 4px;
                    for c in root.menus[root.open-menu].items[root.open-sub].children: MenuRow {
                        label: c.label;
                        fa: c.fa;
                        fa-weight: c.fa-weight;
                        action: c.action;
                        badge: c.badge;
                        activate => {
                            root.open-menu = -1;
                            root.open-sub = -1;
                            root.menu-action(c.action, c.label);
                            fs.focus();
                        }
                    }
                }
            }
        }

        // ================= mode téléphone : disposition de la version web =================
        if root.phone: MobTopBar {
            x: 0;
            y: 0;
            z: 4;
            width: root.usable-width;
            height: root.top-height;
            title: root.doc-title;
            resolution: root.doc-width + @tr("×") + root.doc-height;
            menu => {
                root.phone-sheet = "";
                root.phone-menu = true;
            }
        }
        if root.phone && !root.modal-open: MobUndoCapsule {
            x: 4px;
            y: root.mob-row-y;
            z: 2;
            height: root.mob-ribbon-h;
            undo => {
                root.quick-action("illu-tb-undo");
            }
            redo => {
                root.quick-action("illu-tb-redo");
            }
        }
        if root.phone && !root.modal-open: MobToolRow {
            x: 4px;
            y: root.mob-tools-y;
            z: 2;
            width: root.usable-width - 8px;
            current-tool <=> root.current-tool;
            open <=> root.phone-tools-open;
            layer-block: root.layer-block;
            tool-selected(id) => {
                root.tool-selected(id);
                fs.focus();
            }
        }
        if root.phone && !root.mob-sheet-open && !root.modal-open: MobPills {
            x: 8px;
            y: root.usable-height - root.strip-height - 46px;
            z: 2;
            width: root.usable-width - 16px;
            colors: root.show-colors;
            layers: root.show-layers;
            history: root.show-history;
            action(a) => {
                root.phone-do(a);
            }
        }
        if root.phone: MobDock {
            x: 6px;
            y: root.usable-height - root.strip-height + 3px;
            z: 2;
            width: root.usable-width - 12px;
            height: root.strip-height - 7px;
            compact: root.show-effect;
            active: root.phone-sheet;
            action(a) => {
                root.phone-do(a);
            }
        }
        if root.phone && root.phone-menu: MobDrawer {
            x: 0;
            y: 0;
            z: 8;
            width: root.usable-width;
            height: root.usable-height;
            menus: root.menus;
            tabs: root.tabs;
            open-menu <=> root.drawer-open;
            open-sub <=> root.pm-sub;
            close => {
                root.phone-menu = false;
            }
            menu-action(a, l) => {
                root.phone-menu = false;
                root.menu-action(a, l);
            }
            tab-clicked(i) => {
                root.phone-menu = false;
                root.tab-clicked(i);
            }
            tab-close(i) => {
                root.tab-close(i);
            }
            quick(q) => {
                root.phone-menu = false;
                if (q == "bug") {
                    root.show-contact = true;
                } else if (q == "classic-web") {
                    root.quick-action("classic-web");
                } else {
                    root.phone-do(q);
                }
            }
        }

        // ================= Mode Photo Pro : par-dessus l'éditeur (sous les menus sur le bureau) =================
        if root.pm-open: PhotoMode {
            x: 0;
            // sous la barre de menus seulement (onglets et barre rapide masqués, comme la version web)
            y: root.phone ? 0 : 26px;
            z: 10;
            width: root.usable-width;
            height: root.usable-height - self.y - root.status-height;
            phone: root.phone;
            image: root.pm-image;
            img-w: root.pm-img-w;
            img-h: root.pm-img-h;
            full-w: root.pm-full-w;
            photos: root.pm-photos;
            values: root.pm-values;
            presets: root.pm-presets;
            preset: root.pm-preset;
            fx-off: root.pm-fx-off;
            info: root.pm-info;
            busy: root.pm-busy;
            hq-image: root.pm-hq-image;
            hq-x0: root.pm-hq-x0;
            hq-y0: root.pm-hq-y0;
            hq-x1: root.pm-hq-x1;
            hq-y1: root.pm-hq-y1;
            hq-shown: root.pm-hq-shown;
            view-changed(x0, y0, x1, y1, d) => {
                root.pm-view(x0, y0, x1, y1, d);
            }
            action(a) => {
                root.pm-action(a);
            }
            select(i) => {
                root.pm-select(i);
            }
            remove(i) => {
                root.pm-remove(i);
            }
            set(i, v) => {
                root.pm-set(i, v);
            }
            preset-chosen(k) => {
                root.pm-preset-chosen(k);
            }
        }
    }
    // ---- menu contextuel (clic droit) ----
    if root.ctx-open: Rectangle {
        z: 800;
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.ctx-open = false;
                }
            }
        }
        Rectangle {
            x: max(4px, min(root.ctx-x, root.usable-width - self.width - 4px));
            y: max(4px, min(root.ctx-y, root.usable-height - self.height - 4px));
            width: 290px;
            height: ctx-col.preferred-height;
            background: Theme.menu-bg;
            border-radius: 7px * Theme.round;
            border-width: 1px;
            border-color: Theme.field-border;
            drop-shadow-blur: 10px;
            drop-shadow-offset-y: 3px;
            drop-shadow-color: Theme.window-shadow;
            TouchArea { }
            if !Theme.win98: MenuGutter { height: parent.height - 2 * self.pad; }
            ctx-col := VerticalLayout {
                padding: Theme.win98 ? 2px : 4px;
                for it in root.ctx-items: MenuRow {
                    label: it.label;
                    fa: it.fa;
                    fa-weight: it.fa-weight;
                    shortcut: it.shortcut;
                    action: it.action;
                    badge: it.badge;
                    separator: it.separator;
                    activate => {
                        root.ctx-open = false;
                        root.menu-action(it.action, it.label);
                        fs.focus();
                    }
                }
            }
        }
    }
    // ---- chargement en cours : l'interface reste vivante, la fenêtre bloque les clics ----
    if root.loading: Rectangle {
        z: 900;
        background: #00000050;
        TouchArea {}
        Rectangle {
            width: min(380px, root.usable-width - 24px);
            height: load-col.preferred-height + 28px;
            border-radius: Theme.ctl-radius + 3px * Theme.round;
            background: Theme.window-bg;
            border-width: 1px;
            border-color: Theme.window-border;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.window-shadow;
            load-col := VerticalLayout {
                padding: 14px;
                spacing: 8px;
                Text {
                    text: root.load-title;
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    text: root.load-detail;
                    font-size: Theme.small-font-size;
                    color: Theme.text-inactive;
                    overflow: elide;
                }
                Rectangle {
                    height: 8px;
                    border-radius: 4px * Theme.round;
                    background: Theme.accent-20;
                    clip: true;
                    Rectangle {
                        x: 0px;
                        width: parent.width * clamp(root.load-progress, 0.03, 1.0);
                        height: parent.height;
                        border-radius: 4px * Theme.round;
                        background: Theme.accent;
                        animate width { duration: 1800ms; easing: ease-out; }
                    }
                }
                Text {
                    text: round(clamp(root.load-progress, 0.0, 1.0) * 100) + " %";
                    font-size: Theme.small-font-size;
                    color: Theme.text-inactive;
                    horizontal-alignment: right;
                }
            }
        }
    }
    // info-bulle commune (voir Tip) : par-dessus tout, gardée dans la fenêtre
    if Tip.shown && Tip.text != "": Rectangle {
        x: max(4px, min(Tip.x, root.usable-width - self.width - 4px));
        y: Tip.y + self.height > root.usable-height - 4px ? Tip.y - self.height - 34px : Tip.y;
        width: min(300px, max(tip-title.preferred-width, tip-desc.preferred-width) + 18px);
        height: tip-col.preferred-height;
        z: 1000;
        border-radius: Theme.ctl-radius + 1px * Theme.round;
        background: Theme.window-bg;
        border-width: 1px;
        border-color: Theme.window-border;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: Theme.window-shadow;
        tip-col := VerticalLayout {
            padding-left: 9px;
            padding-right: 9px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 3px;
            tip-title := Text {
                text: Tip.text;
                font-size: Theme.small-font-size + 1px;
                font-weight: Tips.desc(Tip.text) != "" ? 700 : 400;
                color: Theme.text;
                wrap: word-wrap;
            }
            tip-desc := Text {
                visible: Tips.desc(Tip.text) != "";
                height: self.visible ? self.preferred-height : 0px;
                text: Tips.desc(Tip.text);
                font-size: Theme.small-font-size;
                color: Theme.text-inactive;
                wrap: word-wrap;
            }
        }
    }
}
