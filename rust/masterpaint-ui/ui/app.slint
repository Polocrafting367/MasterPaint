export struct HistoryItem {
    label: string,
    fa: string,
}

/// Tuile de la toile mise à jour pendant un geste : chaque zone est dessinée une fois,
/// et seules les tuiles touchées repartent vers la carte graphique.
export struct CanvasTile {
    x: int,
    y: int,
    w: int,
    h: int,
    img: image,
}


export struct Handle {
    x: float,
    y: float,
    round: bool,
}

export struct LayerRow {
    index: int,
    name: string,
    visible: bool,
    thumb: image,
    has-mask: bool,   // masque α lié
    dyn-on: bool,     // filtre dynamique ƒ actif
    is-mask-doc: bool, // onglet de masque α : pas de boutons α / ƒ
    depth: int,       // dossiers au-dessus (retrait)
    is-group: bool,   // dossier de calques
    collapsed: bool,  // dossier replié
    locked: bool,     // cadenas
    is-text: bool,    // calque texte (modifiable, effets non destructifs)
    vec-shapes: bool, // calque SVG avec des formes (pastille « objets » au lieu de « T »)
    fx-count: int,    // effets posés sur le calque texte
}

/// Effet de la pile d'un calque texte (fenêtre « Effets du calque texte »).
export struct TextFxRow {
    label: string,
    on: bool,
}

export struct AppliedFxRow {
    label: string,
    on: bool,
    strength: float,
    editable: bool,
    quick-label: string,
    quick-value: float,
    quick-min: float,
    quick-max: float,
}

/// Petit bouton d'une ligne de calque (α, corbeille, ƒ).
component LayerMiniButton inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <string> tip;
    in property <bool> bold;
    in property <bool> on;
    in property <bool> enabled: true;
    callback clicked();
    width: 20px;
    height: 20px;
    border-radius: Theme.ctl-radius;
    // actif (masque présent, filtre allumé) : pastille pleine à l'accent, bien visible
    background: root.on ? ((Theme.hover-fx && ta.has-hover) ? Theme.accent.brighter(0.15) : Theme.accent) : (Theme.hover-fx && ta.has-hover) && root.enabled ? Theme.accent-14 : transparent;
    border-width: root.on || ((Theme.hover-fx && ta.has-hover) && root.enabled) ? 1px : 0px;
    border-color: root.on ? Theme.accent.darker(0.2) : Theme.accent;
    opacity: root.enabled ? 1 : 0.4;
    if root.glyph != "": GlyphIcon {
        glyph: root.glyph;
        size: 10px;
        tint: root.on ? Theme.on-accent : Theme.text;
        on-accent: root.on;
    }
    if root.glyph == "": Text {
        text: root.label;
        font-size: root.on ? 12px : 11px;
        font-weight: root.on || root.bold ? 700 : 400;
        color: root.on ? Theme.on-accent : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Timer {
        interval: 600ms;
        running: ta.has-hover && root.tip != "" && !(Tip.shown && Tip.text == root.tip);
        triggered => {
            Tip.text = root.tip;
            Tip.x = root.absolute-position.x;
            Tip.y = root.absolute-position.y + root.height + 4px;
            Tip.shown = true;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            Tip.shown = false;
            root.clicked();
        }
        changed has-hover => {
            if (!self.has-hover && Tip.text == root.tip) {
                Tip.shown = false;
            }
        }
    }
}

/// Position et taille enregistrées d'une palette (Outils, Historique, Couleurs, Calques) ;
/// `set` faux : place d'origine.
export struct PalGeom {
    set: bool,
    x: length,
    y: length,
    w: length,
    h: length,
}

/// Réglages des outils, partagés par le ruban, la barre classique et le Rust.
export global ToolOpts {
    /// résolution de rendu de la toile : boutons visibles, réduction du projet (1 : pleine),
    /// rendu complet affiché (« Rendre maintenant »)
    in property <bool> render-ctl;
    // plus forte réduction permise par la taille du projet (÷2 toujours, ÷4 dès 4 Mpx, ÷8 dès 16 Mpx)
    in property <int> render-max: 2;
    in property <int> render-div: 1;
    in property <bool> render-full;
    in property <float> brush-size-max: 500;
    in property <float> line-width-max: 100;
    in property <float> corner-radius-max: 200;
    in property <float> font-size-max: 400;
    in-out property <float> brush-size: 2;
    in-out property <float> hardness: 100;
    in-out property <int> brush-shape: 0;  // 0 rond, 1 doux, 2 spray, 3 carré
    in-out property <bool> sym-x;
    in-out property <bool> sym-y;
    // position des axes de symétrie (pixels du document ; -1 = centre de l'image)
    in-out property <float> sym-cx: -1;
    in-out property <float> sym-cy: -1;
    in-out property <float> tolerance: 32;
    in-out property <bool> contiguous: true;
    // lasso magnétique : force d'attraction aux bords (%) et écart entre ancres (pixels)
    in-out property <float> magnet-strength: 60;
    in-out property <float> magnet-freq: 32;
    in-out property <int> sel-mode: 0;  // 0 nouvelle, 1 ajout, 2 retrait, 3 intersection
    in-out property <int> shape-style: 0;  // 0 contour, 1 plein, 2 les deux
    in-out property <float> line-width: 2;
    in-out property <int> gradient-kind: 0;  // 0 linéaire, 1 radial, 2 losange, 3 conique
    // remplissage des formes, comme la version HTML : 0 uni, 1 dégradé de la couleur principale à
    // la secondaire ; 0 linéaire, 1 radial ; angle en degrés ; mélange par la teinte (« Intelligent »)
    in-out property <int> shape-fill-type: 0;
    in-out property <int> shape-grad-type: 0;
    in-out property <float> shape-grad-angle: 0;
    in-out property <bool> shape-grad-smart: false;
    in-out property <string> shape-kind: "rect";
    // rayon des coins du rectangle arrondi (pixels du document)
    in-out property <float> corner-radius: 16;
    // polygone : nombre de côtés ; étoile : nombre de branches
    in-out property <float> shape-sides: 5;
    in-out property <float> star-points: 5;
    // ligne : 0 droite, 1 courbe (deux points intermédiaires après le tracé) ; bouts (0 droit,
    // 1 rond, 2 flèche pleine, 3 flèche vide, 4 losange) ; trait (0 continu, 1 tirets, 2 pointillés)
    in-out property <int> line-mode: 1;
    in-out property <int> cap-start: 1;
    in-out property <int> cap-end: 1;
    in-out property <int> line-dash: 0;
    // les formes tracées restent des objets modifiables (calque SVG) au lieu de pixels
    in-out property <bool> shape-layer: true;
    in-out property <bool> pixel-grid;
    in-out property <bool> rulers;
    in-out property <bool> outside-canvas;
    in-out property <bool> snap;
    // texte
    in-out property <int> font-index: 0;
    in-out property <float> font-size: 32;
    in-out property <int> text-align: 0;  // 0 gauche, 1 centre, 2 droite
    in-out property <bool> antialias: true;
    // le texte crée un calque texte (modifiable ensuite, effets non destructifs)
    in-out property <bool> text-layer: true;
}

/// Polices proposées par l'outil Texte (Selawik, polices MasterPaint, polices du système).
export global FontList {
    in property <[string]> names: ["Selawik"];
    /// aperçu de chaque nom dans sa police (même ordre ; image vide tant que la police n'est pas lue)
    in property <[image]> previews: [];
}

/// Choix de la police : liste défilante (hauteur limitée), chaque nom affiché dans sa police.
component FontCombo inherits Rectangle {
    in-out property <int> current-index;
    callback selected(int);
    height: 22px;
    border-radius: Theme.ctl-radius;
    background: Theme.field-bg;
    border-width: 1px;
    border-color: (Theme.hover-fx && fta.has-hover) ? Theme.accent : Theme.field-border;
    Text {
        x: 7px;
        width: parent.width - 26px;
        height: parent.height;
        text: FontList.names[root.current-index];
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    FaIcon {
        x: parent.width - 18px;
        width: 14px;
        height: parent.height;
        glyph: "\u{f078}";
        size: 9px;
    }
    HoverTip { y: parent.height; hovered: fta.has-hover && !fta.pressed; text: FontList.names[root.current-index]; }
    fta := TouchArea {
        clicked => {
            popup.show();
        }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height;
        width: max(root.width, 280px);
        height: min(FontList.names.length * 28px + 8px, 340px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.field-bg;
            border-width: 1px;
            border-color: Theme.field-border;
            border-radius: Theme.ctl-radius > 0 ? Theme.ctl-radius + 2px : 0px;
            drop-shadow-blur: 8px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: Theme.shadows ? (Theme.window-shadow) : transparent;
            ListView {
                x: 3px;
                y: 3px;
                width: parent.width - 6px;
                height: parent.height - 6px;
                for name[i] in FontList.names: Rectangle {
                    height: 28px;
                    border-radius: Theme.ctl-radius;
                    background: (Theme.hover-fx && ita.has-hover) ? Theme.accent-14 : i == root.current-index ? Theme.accent-12 : transparent;
                    // aperçu dans la police (rendu par le Rust), sinon le nom en police d'interface
                    if i < FontList.previews.length && FontList.previews[i].width > 0: Image {
                        x: 8px;
                        y: (parent.height - self.height) / 2;
                        height: 22px;
                        width: min(self.source.width * 1px, parent.width - 16px);
                        image-fit: contain;
                        horizontal-alignment: left;
                        source: FontList.previews[i];
                        colorize: Theme.text;
                    }
                    if !(i < FontList.previews.length && FontList.previews[i].width > 0): Text {
                        x: 8px;
                        text: name;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    ita := TouchArea {
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

/// État des options à bascule, pour les cases cochées des menus (mises à jour en direct).
export global MenuState {
    in-out property <bool> tools: true;
    in-out property <bool> colors: true;
    in-out property <bool> layers: true;
    in-out property <bool> history: true;
    in-out property <int> layout: 0;
    /// interface téléphone affichée (choisie ou automatique sur un écran étroit)
    in-out property <bool> phone: false;
    in-out property <int> toolbar-mode: 0;
    /// espace de couleur du projet actif (0 Bitmap, 1 CMJN, 2 RAL, 3 Tramé)
    in-out property <int> color-mode: 0;
    /// calque actif qui refuse les pixels : "" (aucun), "calque texte", "verrouillé", "dossier"
    in-out property <string> layer-block;
    /// bouton du ruban qui modifie les pixels du calque actif (grisé selon `layer-block`)
    public pure function ribbon-blocked(id: string) -> bool {
        return root.layer-block != "" && (id == "opt-sel-clear-ribbon" || id == "opt-sel-align-left"
            || id == "opt-sel-center-h" || id == "opt-sel-align-right" || id == "opt-sel-align-top"
            || id == "opt-sel-center-v" || id == "opt-sel-align-bottom" || id == "opt-sel-center-both");
    }
    /// entrée à cocher (bascule) : la case est affichée, cochée selon `checked`
    public pure function checkable(action: string, label: string) -> bool {
        return action == "fn:EditorManager.convertActiveProjectToPixel()" || action == "fn:EditorManager.convertActiveProjectToRal()"
            || action == "fn:EditorManager.convertActiveProjectToCmjn()"
            || action == "fn:window.toggleIlluPixelGrid()" || action == "fn:window.toggleIlluRulers()"
            || action == "fn:window.toggleIlluSnapToEdges && window.toggleIlluSnapToEdges()"
            || action == "fn:window.toggleIlluShowAllRibbonOptions()"
            || action == "fn:window.toggleIlluAllowOutsideCanvas && window.toggleIlluAllowOutsideCanvas()"
            || action == "fn:window.toggleFloatingPaletteVisibility('win-tools')"
            || action == "fn:window.toggleFloatingPaletteVisibility('win-colors')"
            || action == "fn:window.toggleFloatingPaletteVisibility('win-layers')"
            || action == "fn:window.toggleFloatingPaletteVisibility('win-history')"
            || label == @tr("Interface : mode téléphone (menu ☰, palettes en colonnes)")
            || label == @tr("Palettes : ancrage fixe (style Adobe)") || label == @tr("Palettes volantes (Paint.NET)");
    }
    public pure function checked(action: string, label: string) -> bool {
        return action == "fn:EditorManager.convertActiveProjectToPixel()" ? root.color-mode == 0
            : action == "fn:EditorManager.convertActiveProjectToCmjn()" ? root.color-mode == 1
            : action == "fn:EditorManager.convertActiveProjectToRal()" ? root.color-mode == 2
            : action == "fn:window.toggleIlluPixelGrid()" ? ToolOpts.pixel-grid
            : action == "fn:window.toggleIlluRulers()" ? ToolOpts.rulers
            : action == "fn:window.toggleIlluSnapToEdges && window.toggleIlluSnapToEdges()" ? ToolOpts.snap
            : action == "fn:window.toggleIlluShowAllRibbonOptions()" ? root.toolbar-mode == 1
            : action == "fn:window.toggleIlluAllowOutsideCanvas && window.toggleIlluAllowOutsideCanvas()" ? ToolOpts.outside-canvas
            : action == "fn:window.toggleFloatingPaletteVisibility('win-tools')" ? root.tools
            : action == "fn:window.toggleFloatingPaletteVisibility('win-colors')" ? root.colors
            : action == "fn:window.toggleFloatingPaletteVisibility('win-layers')" ? root.layers
            : action == "fn:window.toggleFloatingPaletteVisibility('win-history')" ? root.history
            : label == @tr("Interface : mode téléphone (menu ☰, palettes en colonnes)") ? root.phone
            : label == @tr("Palettes : ancrage fixe (style Adobe)") ? root.layout == 1 && !root.phone
            : label == @tr("Palettes volantes (Paint.NET)") ? root.layout == 0 && !root.phone
            : false;
    }
}

/// Actions de l'interface, traitées par le Rust.
export global Actions {
    callback ribbon(string);
}

/// Bouton du ruban d'après le relevé de la version web (index dans Generated.ribbon).
component RB inherits FlatButton {
    in property <int> idx;
    in property <bool> labelled;
    icon: Generated.ribbon[idx].icon;
    label: Generated.ribbon[idx].label;
    // effacer / aligner le contenu : grisé sur un calque texte, verrouillé ou un dossier
    enabled: !MenuState.ribbon-blocked(Generated.ribbon[idx].id);
    tip: self.enabled ? Generated.ribbon[idx].title
        : Generated.ribbon[idx].title + (MenuState.layer-block == "calque texte" ? @tr(" — Pixelliser le calque pour l'utiliser") : @tr(" — indisponible sur ce calque"));
    show-label: labelled && !RibbonFit.tight;
    icon-size: 14px;
    width: labelled && !RibbonFit.tight ? 66px : 26px;
    height: 26px;
    clicked => {
        Actions.ribbon(Generated.ribbon[idx].id);
    }
}

/// Ligne d'un menu déroulant : icône (ou case cochée en direct pour une option à bascule),
/// libellé, marqueur « à venir », raccourci, flèche de sous-menu.
component MenuRow inherits Rectangle {
    in property <string> label;
    in property <string> fa;
    in property <int> fa-weight: 900;
    in property <string> shortcut;
    in property <string> action;
    in property <string> badge;
    in property <bool> separator;
    in property <bool> submenu;
    in property <bool> highlighted;
    /// la surbrillance de survol est dessinée par le menu (rectangle unique sous les lignes)
    in property <bool> moving-hover;
    callback activate();
    callback hovered();
    callback unhovered();
    // entrée indisponible pour le calque actif (calque texte, verrouillé, dossier) : grisée,
    // sans effet au clic, info-bulle qui dit quoi faire (marqueur posé par le Rust)
    out property <bool> blocked: !root.submenu && (root.badge == @tr("calque texte") || root.badge == @tr("verrouillé") || root.badge == @tr("dossier"));
    property <string> blocked-tip: root.badge == @tr("calque texte") ? @tr("Pixelliser le calque pour utiliser cet effet")
        : root.badge == @tr("verrouillé") ? @tr("Déverrouiller le calque pour utiliser cet effet")
        : @tr("Choisir un calque (pas un dossier) pour utiliser cet effet");
    height: root.separator ? 7px : 24px;
    border-radius: Theme.ctl-radius;
    background: !root.separator && !root.blocked && (root.highlighted || (!root.moving-hover && ta.has-hover)) ? Theme.accent-14 : transparent;
    border-width: !root.separator && !root.blocked && (root.highlighted || (!root.moving-hover && ta.has-hover)) ? 1px : 0px;
    border-color: Theme.accent-60;
    if root.separator: Rectangle {
        x: 32px;
        width: parent.width - 36px;
        y: 3px;
        height: 1px;
        background: Theme.window-border;
    }
    if !root.separator: HorizontalLayout {
        padding-right: 8px;
        opacity: root.blocked ? 0.45 : 1;
        // colonne des icônes (30 px, = MenuGutter) : icône maison, glyphe ou case à cocher, tous
        // dans la même case de 16 × 16 px posée au même endroit (libellés alignés) ; 8 px de plus
        // que la gouttière pour décoller le libellé du trait vertical
        mic := Rectangle {
            width: 38px;
            property <int> mp: MpIcons.for-menu(root.label, root.fa);
            if !MenuState.checkable(root.action, root.label) && mic.mp >= 0: Image {
                x: 7px;
                y: (parent.height - 16px) / 2;
                width: 16px;
                height: 16px;
                source: MpIcons.images[mic.mp];
                image-fit: contain;
            }
            if !MenuState.checkable(root.action, root.label) && mic.mp < 0: FaIcon {
                x: 7px;
                y: (parent.height - 16px) / 2;
                width: 16px;
                height: 16px;
                glyph: root.fa;
                weight: root.fa-weight;
                size: 12px;
                color: Theme.text;
            }
            if MenuState.checkable(root.action, root.label): Rectangle {
                x: 8px;
                y: (parent.height - 14px) / 2;
                width: 14px;
                height: 14px;
                border-radius: 2px * Theme.round;
                background: MenuState.checked(root.action, root.label) ? Theme.accent : Theme.field-bg;
                border-width: 1px;
                border-color: MenuState.checked(root.action, root.label) ? Theme.accent : Theme.field-border;
                if MenuState.checked(root.action, root.label): FaIcon {
                    glyph: "\u{f00c}";
                    size: 9px;
                    color: Theme.on-accent;
                }
            }
        }
        Text {
            text: root.label;
            font-size: Theme.menu-font-size;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        // marqueur : fonction pas encore transférée en Rust
        if root.badge != "": Rectangle {
            width: 58px;
            Rectangle {
                x: 2px;
                y: 5px;
                width: 52px;
                height: 14px;
                border-radius: 3px * Theme.round;
                background: #f59e0b30;
                border-width: 1px;
                border-color: #d97706;
                Text {
                    text: root.badge;
                    font-size: 9px;
                    color: #b45309;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.shortcut;
            font-size: Theme.menu-font-size;
            color: Theme.text-inactive;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        // colonne des flèches de sous-menu, réservée sur toutes les lignes : raccourcis et
        // flèches tombent sur le même bord droit
        Rectangle {
            width: 14px;
            if root.submenu: FaIcon {
                width: parent.width;
                height: parent.height;
                glyph: "\u{f054}";
                size: 9px;
            }
        }
    }
    ta := TouchArea {
        enabled: !root.separator;
        clicked => {
            if (!root.blocked) {
                root.activate();
            }
        }
        changed has-hover => {
            if (self.has-hover) {
                root.hovered();
            } else {
                root.unhovered();
                if (root.blocked && Tip.text == root.blocked-tip) {
                    Tip.shown = false;
                }
            }
        }
    }
    Timer {
        interval: 450ms;
        running: root.blocked && ta.has-hover && !(Tip.shown && Tip.text == root.blocked-tip);
        triggered => {
            Tip.text = root.blocked-tip;
            Tip.x = root.absolute-position.x + 32px;
            Tip.y = root.absolute-position.y + root.height + 2px;
            Tip.shown = true;
        }
    }
}

/// Colonne des icônes d'un menu déroulant (comme Paint.NET / paintdotjs) : fond à part et
/// trait vertical entre icônes et libellés. Posée sous les lignes (`pad` = marge du menu).
component MenuGutter inherits Rectangle {
    in property <length> pad: 4px;
    x: root.pad;
    y: root.pad;
    width: 30px;
    border-top-left-radius: Theme.ctl-radius;
    border-bottom-left-radius: Theme.ctl-radius;
    background: Theme.menu-gutter;
    Rectangle {
        x: parent.width + 1px;
        width: 1px;
        background: Theme.window-border;
    }
}

/// Titre de la barre de menus. Comme sous Windows : un clic ouvre le menu, puis le survol
/// d'un autre titre bascule vers son menu.
component MenuBarItem inherits Rectangle {
    in property <MenuSpec> menu;
    in property <bool> open;
    in property <bool> any-open;
    callback toggle(length);
    callback switch-to(length);
    width: label.preferred-width + 16px;
    // arrondi comme les menus qu'il ouvre (Windows 11)
    border-radius: Theme.ctl-radius;
    background: root.open ? Theme.accent-20 : (Theme.hover-fx && ta.has-hover) ? Theme.accent-14 : transparent;
    border-width: root.open || (Theme.hover-fx && ta.has-hover) ? 1px : 0px;
    border-color: Theme.accent-60;
    label := Text {
        text: root.menu.title;
        font-size: Theme.menu-font-size;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => {
            root.toggle(root.absolute-position.x);
        }
        changed has-hover => {
            if (self.has-hover && root.any-open && !root.open) {
                root.switch-to(root.absolute-position.x);
            }
        }
    }
}

/// Champ numérique de dialogue : « Libellé [valeur] ».
component Field inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> value;
    spacing: 8px;
    height: 26px;
    Text {
        width: 90px;
        text: root.label;
        color: Theme.text;
        vertical-alignment: center;
    }
    W10LineEdit {
        text <=> root.value;
        input-type: number;
    }
}

/// Groupe « Sélection » du ruban (2 rangées ou 1 rangée en barre classique).
component SelectionGroup inherits RibbonGroup {
    label: @tr("Sélection");
    if !root.classic: VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            RB {
                idx: 0;
                labelled: true;
            }
            RB {
                idx: 1;
                labelled: true;
            }
            RB {
                idx: 2;
                labelled: true;
            }
        }
        HorizontalLayout {
            RB {
                idx: 3;
                labelled: true;
                checked: ToolOpts.sel-mode == 0;
            }
            RB {
                idx: 4;
                labelled: true;
                checked: ToolOpts.sel-mode == 1;
            }
            RB {
                idx: 5;
                labelled: true;
                checked: ToolOpts.sel-mode == 2;
            }
        }
    }
    if root.classic: HorizontalLayout {
        RB {
            idx: 0;
        }
        RB {
            idx: 1;
        }
        RB {
            idx: 2;
        }
        RB {
            idx: 3;
            checked: ToolOpts.sel-mode == 0;
        }
        RB {
            idx: 4;
            checked: ToolOpts.sel-mode == 1;
        }
        RB {
            idx: 5;
            checked: ToolOpts.sel-mode == 2;
        }
    }
}

component EditGroup inherits RibbonGroup {
    label: @tr("Édition");
    if !root.classic: VerticalLayout {
        spacing: 4px;
        padding-top: 3px;
        RB {
            idx: 6;
            labelled: true;
        }
        RB {
            idx: 7;
            labelled: true;
        }
    }
    if root.classic: HorizontalLayout {
        RB {
            idx: 6;
        }
        RB {
            idx: 7;
        }
    }
}

component AlignGroup inherits RibbonGroup {
    in property <bool> has-selection;
    label: @tr("Ajustements");
    if !root.classic: VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            for i in [8, 9, 10, 11]: RB {
                idx: i;
                enabled: root.has-selection;
            }
        }
        HorizontalLayout {
            for i in [12, 13, 14, 15]: RB {
                idx: i;
                enabled: root.has-selection;
            }
        }
    }
    if root.classic: HorizontalLayout {
        for i in [8, 9, 10, 11, 12, 13, 14, 15]: RB {
            idx: i;
            enabled: root.has-selection;
        }
    }
}

/// Résolution de rendu de la toile : chaque clic passe à la réduction suivante.
component RenderDivButton inherits Rectangle {
    width: 26px;
    height: 26px;
    FlatButton {
        width: 26px;
        height: 26px;
        icon-size: 14px;
        show-label: false;
        img: MpIcons.images[MpIcons.for-menu(@tr("Résolution de rendu de la toile"), "")];
        checked: ToolOpts.render-div > 1;
        tip: ToolOpts.render-div > 1
            ? @tr("Toile rendue ÷{} : plus fluide, l'enregistrement reste en pleine résolution. Clic : réduction suivante.", ToolOpts.render-div)
            : ToolOpts.render-max >= 8 ? @tr("Résolution de rendu de la toile : pleine. Clic : ÷2, puis ÷4, puis ÷8. L'enregistrement reste en pleine résolution.")
            : ToolOpts.render-max >= 4 ? @tr("Résolution de rendu de la toile : pleine. Clic : ÷2, puis ÷4 (÷8 dès 16 Mpx). L'enregistrement reste en pleine résolution.")
            : @tr("Résolution de rendu de la toile : pleine. Clic : ÷2 (÷4 dès 4 Mpx, ÷8 dès 16 Mpx). L'enregistrement reste en pleine résolution.");
        clicked => { Actions.ribbon("render-cycle"); }
    }
    if ToolOpts.render-div > 1: Rectangle {
        x: parent.width - self.width;
        y: parent.height - self.height;
        width: 15px;
        height: 11px;
        border-radius: 3px * Theme.round;
        background: Theme.accent;
        Text {
            text: "÷" + ToolOpts.render-div;
            font-size: 8px;
            font-weight: 700;
            color: Theme.on-accent;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

/// Rendu complet tout de suite, jusqu'à la prochaine modification.
component RenderNowButton inherits FlatButton {
    width: 26px;
    height: 26px;
    icon-size: 14px;
    show-label: false;
    img: MpIcons.images[MpIcons.for-menu(@tr("Rendre maintenant"), "")];
    enabled: ToolOpts.render-div > 1 && !ToolOpts.render-full;
    checked: ToolOpts.render-full;
    tip: ToolOpts.render-full ? @tr("Rendu complet affiché, jusqu'à la prochaine modification.") : @tr("Rendre maintenant : affiche l'image en pleine résolution, jusqu'à la prochaine modification.");
    clicked => { Actions.ribbon("render-now"); }
}

component ViewGroup inherits RibbonGroup {
    label: @tr("Affichage");
    if !root.classic: VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            RB {
                idx: 16;
                checked: ToolOpts.pixel-grid;
            }
            RB {
                idx: 17;
                checked: ToolOpts.rulers;
            }
            if ToolOpts.render-ctl: RenderDivButton { }
        }
        HorizontalLayout {
            RB {
                idx: 18;
                checked: ToolOpts.outside-canvas;
            }
            RB {
                idx: 19;
                checked: ToolOpts.snap;
            }
            if ToolOpts.render-ctl: RenderNowButton { }
        }
    }
    if root.classic: HorizontalLayout {
        RB {
            idx: 16;
            checked: ToolOpts.pixel-grid;
        }
        RB {
            idx: 17;
            checked: ToolOpts.rulers;
        }
        RB {
            idx: 18;
            checked: ToolOpts.outside-canvas;
        }
        RB {
            idx: 19;
            checked: ToolOpts.snap;
        }
        if ToolOpts.render-ctl: RenderDivButton { }
        if ToolOpts.render-ctl: RenderNowButton { }
    }
}

/// Contiguïté + tolérance (baguette, pot de peinture).
component RegionGroup inherits RibbonGroup {
    in property <string> other-label: @tr("Calque");
    in property <string> other-glyph: "\u{f03e}";
    in property <float> tol-max: 100;
    if !root.classic: VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            ToggleButton {
                glyph: "\u{f5fd}";
                img: Sprite.mode-contiguous;
                text: @tr("Contigu");
                checked: ToolOpts.contiguous;
                clicked => {
                    ToolOpts.contiguous = true;
                }
            }
            ToggleButton {
                glyph: root.other-glyph;
                img: root.other-label == "Calque" ? Sprite.mode-layer : Sprite.mode-layer;
                text: root.other-label;
                checked: !ToolOpts.contiguous;
                clicked => {
                    ToolOpts.contiguous = false;
                }
            }
        }
        Gauge {
            label: @tr("Tol.");
            label-width: 30px;
            minimum: 0;
            maximum: root.tol-max;
            value <=> ToolOpts.tolerance;
        }
    }
    if root.classic: HorizontalLayout {
        spacing: 4px;
        ToggleButton {
            compact: true;
            glyph: "\u{f5fd}";
            img: Sprite.mode-contiguous;
            tip: Tips.desc(@tr("Contigu")) != "" ? Tips.desc(@tr("Contigu")) : @tr("Contigu");
            checked: ToolOpts.contiguous;
            clicked => {
                ToolOpts.contiguous = !ToolOpts.contiguous;
            }
        }
        Gauge {
            label: @tr("Tol.");
            label-width: 26px;
            bar-width: 80px;
            minimum: 0;
            maximum: root.tol-max;
            value <=> ToolOpts.tolerance;
        }
    }
}

/// Lasso magnétique : force d'attraction aux bords (0 % = lasso libre) et écart entre les
/// ancres posées automatiquement en glissant.
component MagnetGroup inherits RibbonGroup {
    if !root.classic: VerticalLayout {
        spacing: 6px;
        alignment: center;
        Gauge {
            label: @tr("Force");
            tip: @tr("Force du lasso magnétique : 0 % = lasso libre, 100 % = colle fort aux bords");
            label-width: 44px;
            minimum: 0;
            maximum: 100;
            unit: "%";
            value <=> ToolOpts.magnet-strength;
            changed(v) => {
                Actions.ribbon("magnet-opts");
            }
        }
        Gauge {
            label: @tr("Ancres");
            tip: @tr("Écart entre deux ancres automatiques (pixels) : plus petit = tracé plus fidèle");
            label-width: 44px;
            minimum: 8;
            maximum: 120;
            unit: "px";
            value <=> ToolOpts.magnet-freq;
            changed(v) => {
                Actions.ribbon("magnet-opts");
            }
        }
    }
    if root.classic: HorizontalLayout {
        spacing: 4px;
        Gauge {
            label: @tr("Force");
            tip: @tr("Force du lasso magnétique : 0 % = lasso libre, 100 % = colle fort aux bords");
            label-width: 34px;
            bar-width: 80px;
            minimum: 0;
            maximum: 100;
            unit: "%";
            value <=> ToolOpts.magnet-strength;
            changed(v) => {
                Actions.ribbon("magnet-opts");
            }
        }
    }
}

component SizeGroup inherits RibbonGroup {
    label: @tr("Taille / trait");
    if !root.classic: VerticalLayout {
        spacing: 8px;
        padding-top: 2px;
        Gauge {
            label: @tr("Taille");
            minimum: 1;
            maximum: ToolOpts.brush-size-max;
            progressive: true;
            value <=> ToolOpts.brush-size;
        }
        Gauge {
            label: @tr("Dureté");
            minimum: 0;
            maximum: 100;
            value <=> ToolOpts.hardness;
        }
    }
    if root.classic: HorizontalLayout {
        spacing: 8px;
        Gauge {
            label: @tr("Taille");
            label-width: 34px;
            bar-width: 80px;
            minimum: 1;
            maximum: ToolOpts.brush-size-max;
            progressive: true;
            value <=> ToolOpts.brush-size;
        }
        Gauge {
            label: @tr("Dureté");
            label-width: 38px;
            bar-width: 80px;
            minimum: 0;
            maximum: 100;
            value <=> ToolOpts.hardness;
        }
    }
}

component SymmetryGroup inherits RibbonGroup {
    label: @tr("Symétrie");
    if !root.classic: VerticalLayout {
        spacing: 4px;
        ToggleButton {
            glyph: "\u{f07e}";
            img: Sprite.sym-x;
            text: @tr("Sym. X");
            checked: ToolOpts.sym-x;
            clicked => {
                ToolOpts.sym-x = !ToolOpts.sym-x;
                ToolOpts.rulers = ToolOpts.rulers || ToolOpts.sym-x;
            }
        }
        ToggleButton {
            glyph: "\u{f07d}";
            img: Sprite.sym-y;
            text: @tr("Sym. Y");
            checked: ToolOpts.sym-y;
            clicked => {
                ToolOpts.sym-y = !ToolOpts.sym-y;
                ToolOpts.rulers = ToolOpts.rulers || ToolOpts.sym-y;
            }
        }
    }
    if root.classic: HorizontalLayout {
        spacing: 2px;
        ToggleButton {
            compact: true;
            glyph: "\u{f07e}";
            img: Sprite.sym-x;
            tip: Tips.desc(@tr("Sym. X")) != "" ? Tips.desc(@tr("Sym. X")) : @tr("Sym. X");
            checked: ToolOpts.sym-x;
            clicked => {
                ToolOpts.sym-x = !ToolOpts.sym-x;
                ToolOpts.rulers = ToolOpts.rulers || ToolOpts.sym-x;
            }
        }
        ToggleButton {
            compact: true;
            glyph: "\u{f07d}";
            img: Sprite.sym-y;
            tip: Tips.desc(@tr("Sym. Y")) != "" ? Tips.desc(@tr("Sym. Y")) : @tr("Sym. Y");
            checked: ToolOpts.sym-y;
            clicked => {
                ToolOpts.sym-y = !ToolOpts.sym-y;
                ToolOpts.rulers = ToolOpts.rulers || ToolOpts.sym-y;
            }
        }
    }
}

component BrushGroup inherits RibbonGroup {
    in property <bool> pencil;
    label: root.pencil ? @tr("Crayon") : @tr("Pinceau");
    GridLayout {
        spacing: 2px;
        Row {
            for k[i] in [{ g: "\u{f111}", t: @tr("Rond") }, { g: "\u{f192}", t: @tr("Doux") }]: ToggleButton {
                compact: root.classic;
                glyph: k.g;
                img: i == 0 ? Sprite.brush-round : Sprite.brush-soft;
                text: k.t;
                checked: ToolOpts.brush-shape == i;
                clicked => {
                    ToolOpts.brush-shape = i;
                }
            }
        }
        Row {
            for k[i] in [{ g: "\u{f5c7}", t: @tr("Spray") }, { g: "\u{f0c8}", t: @tr("Carré") }]: ToggleButton {
                compact: root.classic;
                glyph: k.g;
                img: i == 0 ? Sprite.brush-spray : Sprite.brush-square;
                text: k.t;
                checked: ToolOpts.brush-shape == i + 2;
                clicked => {
                    ToolOpts.brush-shape = i + 2;
                }
            }
        }
    }
}

component ShapeKindGroup inherits RibbonGroup {
    label: @tr("Forme");
    // icônes du sprite MasterPaint (icons/illu-sprite.svg), comme la version web ; deux rangées
    // de 7 dans le ruban, une seule ligne dans la barre Paint.NET. Polygone et étoile : nombre de
    // côtés / branches réglé par le curseur du groupe suivant (ShapeParamGroup)
    GridLayout {
        spacing: 2px;
        for k[i] in [
            { id: "rect", n: @tr("Rectangle"), img: Sprite.shape-stroke },
            { id: "roundrect", n: @tr("Rectangle à coins arrondis (rayon réglable)"), img: Sprite.shape-round },
            { id: "ellipse", n: @tr("Ellipse / cercle"), img: Sprite.shape-ellipse },
            { id: "ngon", n: @tr("Polygone (nombre de côtés réglable : 3 = triangle)"), img: Sprite.shape-pentagon },
            { id: "star", n: @tr("Étoile (nombre de branches réglable)"), img: Sprite.shape-star-5 },
            { id: "triangle-right", n: @tr("Triangle rectangle"), img: Sprite.shape-triangle-right },
            { id: "diamond", n: @tr("Losange"), img: Sprite.shape-diamond },
            { id: "trapezoid", n: @tr("Trapèze"), img: Sprite.shape-trapezoid },
            { id: "parallelogram", n: @tr("Parallélogramme"), img: Sprite.shape-parallelogram },
            { id: "arrow", n: @tr("Flèche"), img: Sprite.shape-arrow },
            { id: "cross", n: @tr("Croix"), img: Sprite.shape-cross },
            { id: "heart", n: @tr("Cœur"), img: Sprite.shape-heart },
            { id: "callout-rect", n: @tr("Bulle rectangulaire"), img: Sprite.shape-callout-rect },
            { id: "callout-oval", n: @tr("Bulle ovale"), img: Sprite.shape-callout-oval },
        ]: ToggleButton {
            col: root.classic ? i : mod(i, 7);
            row: root.classic ? 0 : floor(i / 7);
            compact: true;
            img: k.img;
            tip: k.n;
            checked: ToolOpts.shape-kind == k.id;
            clicked => {
                ToolOpts.shape-kind = k.id;
            }
        }
    }
}

/// Objets modifiables (calque SVG) : formes et textes restent des objets qu'on retouche ensuite
/// (outil Texte, Déplacer, Pot de peinture, panneau Objets SVG) ; éteint : pixels du calque actif.
/// Objets modifiables (calque SVG) : formes et textes restent des objets qu'on retouche ensuite
/// (outil Texte, Déplacer, Pot de peinture, panneau Objets SVG) ; éteint : pixels du calque actif.
/// Formes : le réglage de la forme choisie (rayon des coins, nombre de côtés ou de branches) se
/// place sous le bouton, dans la même alvéole (plus compact que deux groupes).
component VectorGroup inherits RibbonGroup {
    in property <bool> text;
    /// réglage affiché sous le bouton : -1 aucun, 0 coins, 1 côtés, 2 branches, 3 épaisseur (Ligne)
    in property <int> param: -1;
    label: root.param == 0 ? @tr("Calque SVG · coins") : root.param == 1 ? @tr("Calque SVG · polygone")
        : root.param == 2 ? @tr("Calque SVG · étoile") : root.param == 3 ? @tr("Calque SVG · trait") : @tr("Calque SVG");
    property <bool> on: root.text ? ToolOpts.text-layer : ToolOpts.shape-layer;
    VerticalLayout {
        spacing: 6px;
        alignment: start;
        HorizontalLayout {
            alignment: start;
            ToggleButton {
                compact: root.classic;
                img: root.text ? Sprite.vec-text : Sprite.vec-shape;
                // libellé fixe (sinon le bouton change de largeur) : l'état se lit au bouton enfoncé
                text: @tr("Modifiable");
                tip: root.text
                    ? (root.on ? @tr("Activé : chaque texte reste modifiable sur un calque SVG (recliquez-le avec l'outil Texte, déplacez-le, effets non destructifs). Cliquer pour peindre le texte en pixels dans le calque actif.")
                        : @tr("Désactivé : le texte est peint en pixels dans le calque actif. Cliquer pour garder les textes modifiables (calque SVG)."))
                    : (root.on ? @tr("Activé : chaque forme reste un objet modifiable sur un calque SVG (déplacer, recolorer, exporter en SVG). Cliquer pour tracer en pixels dans le calque actif.")
                        : @tr("Désactivé : la forme est tracée en pixels dans le calque actif. Cliquer pour garder les formes modifiables (calque SVG)."));
                checked: root.on;
                clicked => {
                    if (root.text) {
                        ToolOpts.text-layer = !ToolOpts.text-layer;
                        Actions.ribbon("text-layer");
                    } else {
                        ToolOpts.shape-layer = !ToolOpts.shape-layer;
                        Actions.ribbon("shape-layer");
                    }
                }
            }
        }
        if root.param == 0 && !root.classic: Gauge {
            label: @tr("Rayon");
            label-width: 52px;
            bar-width: 70px;
            minimum: 0;
            maximum: ToolOpts.corner-radius-max;
            progressive: true;
            value <=> ToolOpts.corner-radius;
        }
        if root.param == 1 && !root.classic: Gauge {
            label: @tr("Côtés");
            label-width: 52px;
            bar-width: 70px;
            minimum: 3;
            maximum: 12;
            value <=> ToolOpts.shape-sides;
        }
        if root.param == 3 && !root.classic: Gauge {
            label: @tr("Épaisseur");
            label-width: 58px;
            bar-width: 70px;
            minimum: 1;
            maximum: ToolOpts.line-width-max;
            value <=> ToolOpts.line-width;
        }
        if root.param == 2 && !root.classic: Gauge {
            label: @tr("Branches");
            label-width: 52px;
            bar-width: 70px;
            minimum: 3;
            maximum: 12;
            value <=> ToolOpts.star-points;
        }
    }
}

/// Barre Paint.NET (une seule ligne) : le réglage de forme garde sa propre alvéole.
component ShapeParamGroup inherits RibbonGroup {
    in property <int> kind;  // 0 coins, 1 côtés, 2 branches
    label: root.kind == 0 ? @tr("Coins") : root.kind == 1 ? @tr("Polygone") : @tr("Étoile");
    if root.kind == 0: Gauge {
        label: @tr("Rayon");
        label-width: 52px;
        bar-width: 70px;
        minimum: 0;
        maximum: ToolOpts.corner-radius-max;
        progressive: true;
        value <=> ToolOpts.corner-radius;
    }
    if root.kind == 1: Gauge {
        label: @tr("Côtés");
        label-width: 52px;
        bar-width: 70px;
        minimum: 3;
        maximum: 12;
        value <=> ToolOpts.shape-sides;
    }
    if root.kind == 2: Gauge {
        label: @tr("Branches");
        label-width: 52px;
        bar-width: 70px;
        minimum: 3;
        maximum: 12;
        value <=> ToolOpts.star-points;
    }
}

/// Aperçu d'un trait : continu, tirets ou pointillés.
component DashPreview inherits Rectangle {
    in property <int> dash;
    width: 30px;
    height: 16px;
    if root.dash == 0: Rectangle { x: 2px; y: 7px; width: 26px; height: 2px; background: Theme.ribbon-fg; }
    if root.dash == 1: HorizontalLayout {
        x: 2px; y: 7px; width: 26px; height: 2px; spacing: 3px;
        for k in 4: Rectangle { width: 4.25px; background: Theme.ribbon-fg; }
    }
    if root.dash == 2: HorizontalLayout {
        x: 2px; y: 6px; width: 26px; height: 3px; spacing: 3px;
        for k in 5: Rectangle { width: 3px; border-radius: 1.5px; background: Theme.ribbon-fg; }
    }
}

/// Choix d'un bout ou du trait d'une ligne : bouton qui montre l'aperçu du choix courant et
/// ouvre la liste des choix avec leur aperçu (comme la version HTML).
component LineStylePicker inherits Rectangle {
    /// 0 bout de début, 1 bout de fin, 2 trait
    in property <int> what;
    in property <string> tip;
    in-out property <int> value;
    callback picked(int);
    property <[{n: string, img: image}]> caps: [
        { n: @tr("Droit"), img: Sprite.cap-none },
        { n: @tr("Rond"), img: Sprite.cap-round },
        { n: @tr("Flèche pleine"), img: Sprite.cap-arrow },
        { n: @tr("Flèche vide"), img: Sprite.cap-arrow-hollow },
        { n: @tr("Losange"), img: Sprite.cap-diamond },
    ];
    property <[string]> dashes: [@tr("Continu"), @tr("Tirets"), @tr("Pointillés")];
    width: root.what == 2 ? 48px : 38px;
    height: 24px;
    border-radius: Theme.ctl-radius;
    background: (Theme.hover-fx && pta.has-hover) ? Theme.accent-12 : Theme.field-bg;
    border-width: 1px;
    border-color: (Theme.hover-fx && pta.has-hover) ? Theme.accent : Theme.field-border;
    if root.what < 2: Image {
        x: 4px;
        y: 4px;
        width: 16px;
        height: 16px;
        source: root.caps[root.value].img;
        // les icônes montrent un bout de fin (vers la droite) : retournées pour le début
        transform-rotation: root.what == 0 ? 180deg : 0deg;
    }
    if root.what == 2: DashPreview {
        x: 3px;
        y: 4px;
        dash: root.value;
    }
    FaIcon {
        x: parent.width - 12px;
        glyph: "\u{f078}";
        size: 7px;
        color: Theme.ribbon-label;
    }
    HoverTip { y: parent.height; hovered: pta.has-hover && !pta.pressed; text: root.tip; }
    pta := TouchArea {
        clicked => { pop.show(); }
    }
    pop := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: 150px;
        height: (root.what == 2 ? 3 : 5) * 28px + 8px;
        Rectangle {
            background: Theme.menu-bg;
            border-radius: Theme.ctl-radius + 2px;
            border-width: 1px;
            border-color: Theme.window-border;
            drop-shadow-blur: 6px;
            drop-shadow-color: Theme.shadows ? (Theme.window-shadow) : transparent;
            VerticalLayout {
                padding: 4px;
                for i in (root.what == 2 ? 3 : 5): Rectangle {
                    height: 28px;
                    border-radius: Theme.ctl-radius;
                    background: i == root.value ? Theme.accent-14 : (Theme.hover-fx && ita.has-hover) ? Theme.accent-12 : transparent;
                    if root.what < 2: Image {
                        x: 8px;
                        y: 6px;
                        width: 16px;
                        height: 16px;
                        source: root.caps[i].img;
                        transform-rotation: root.what == 0 ? 180deg : 0deg;
                    }
                    if root.what == 2: DashPreview {
                        x: 6px;
                        y: 6px;
                        dash: i;
                    }
                    Text {
                        x: 42px;
                        height: parent.height;
                        text: root.what == 2 ? root.dashes[i] : root.caps[i].n;
                        color: Theme.text;
                        font-weight: i == root.value ? 700 : 400;
                        vertical-alignment: center;
                    }
                    ita := TouchArea {
                        clicked => {
                            root.value = i;
                            root.picked(i);
                        }
                    }
                }
            }
        }
    }
}

/// Outil Ligne : droite ou courbe (deux points intermédiaires après le tracé), bouts de début et
/// de fin, trait continu / tirets / pointillés.
component LineGroup inherits RibbonGroup {
    label: @tr("Ligne");
    if !root.classic: VerticalLayout {
        spacing: 6px;
        alignment: start;
        HorizontalLayout {
            spacing: 2px;
            alignment: start;
            for m[i] in [{ g: "\u{f068}", t: @tr("Droite") }, { g: "\u{f1e0}", t: @tr("Courbe") }]: ToggleButton {
                glyph: m.g;
                text: m.t;
                tip: i == 0 ? @tr("Ligne droite entre deux points") : @tr("Courbe : après le tracé, deux points intermédiaires permettent de la courber");
                checked: ToolOpts.line-mode == i;
                clicked => { ToolOpts.line-mode = i; }
            }
        }
        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            // dans l'ordre de la ligne : bout de gauche, trait, bout de droite
            LineStylePicker { what: 0; tip: @tr("Début de ligne"); value <=> ToolOpts.cap-start; }
            LineStylePicker { what: 2; tip: @tr("Style du trait"); value <=> ToolOpts.line-dash; }
            LineStylePicker { what: 1; tip: @tr("Fin de ligne"); value <=> ToolOpts.cap-end; }
        }
    }
    if root.classic: HorizontalLayout {
        spacing: 4px;
        for m[i] in [{ g: "\u{f068}", t: @tr("Droite") }, { g: "\u{f1e0}", t: @tr("Courbe") }]: ToggleButton {
            compact: true;
            glyph: m.g;
            tip: m.t;
            checked: ToolOpts.line-mode == i;
            clicked => { ToolOpts.line-mode = i; }
        }
        LineStylePicker { y: 1px; what: 0; tip: @tr("Début de ligne"); value <=> ToolOpts.cap-start; }
        LineStylePicker { y: 1px; what: 2; tip: @tr("Style du trait"); value <=> ToolOpts.line-dash; }
        LineStylePicker { y: 1px; what: 1; tip: @tr("Fin de ligne"); value <=> ToolOpts.cap-end; }
    }
}

component StrokeGroup inherits RibbonGroup {
    in property <bool> line;
    label: @tr("Trait");
    if !root.classic: VerticalLayout {
        spacing: 6px;
        if !root.line: HorizontalLayout {
            spacing: 2px;
            ToggleButton {
                glyph: "\u{f0c8}";
                weight: 400;
                img: Sprite.shape-stroke;
                text: @tr("Contour");
                checked: ToolOpts.shape-style == 0;
                clicked => {
                    ToolOpts.shape-style = 0;
                }
            }
            ToggleButton {
                glyph: "\u{f0c8}";
                img: Sprite.shape-fill;
                text: @tr("Plein");
                checked: ToolOpts.shape-style == 1;
                clicked => {
                    ToolOpts.shape-style = 1;
                }
            }
            ToggleButton {
                glyph: "\u{f5fd}";
                img: Sprite.shape-both;
                text: @tr("Les deux");
                checked: ToolOpts.shape-style == 2;
                clicked => {
                    ToolOpts.shape-style = 2;
                }
            }
        }
        Gauge {
            label: @tr("Épaisseur");
            label-width: 58px;
            minimum: 1;
            maximum: ToolOpts.line-width-max;
            progressive: true;
            value <=> ToolOpts.line-width;
        }
    }
    if root.classic: HorizontalLayout {
        spacing: 2px;
        if !root.line: ToggleButton {
            compact: true;
            glyph: "\u{f0c8}";
            weight: 400;
            img: Sprite.shape-stroke;
            tip: Tips.desc(@tr("Contour")) != "" ? Tips.desc(@tr("Contour")) : @tr("Contour");
            checked: ToolOpts.shape-style == 0;
            clicked => {
                ToolOpts.shape-style = 0;
            }
        }
        if !root.line: ToggleButton {
            compact: true;
            glyph: "\u{f0c8}";
            img: Sprite.shape-fill;
            tip: Tips.desc(@tr("Plein")) != "" ? Tips.desc(@tr("Plein")) : @tr("Plein");
            checked: ToolOpts.shape-style == 1;
            clicked => {
                ToolOpts.shape-style = 1;
            }
        }
        if !root.line: ToggleButton {
            compact: true;
            glyph: "\u{f5fd}";
            img: Sprite.shape-both;
            tip: Tips.desc(@tr("Les deux")) != "" ? Tips.desc(@tr("Les deux")) : @tr("Les deux");
            checked: ToolOpts.shape-style == 2;
            clicked => {
                ToolOpts.shape-style = 2;
            }
        }
        Gauge {
            label: @tr("Épaisseur");
            label-width: 56px;
            bar-width: 70px;
            minimum: 1;
            maximum: ToolOpts.line-width-max;
            progressive: true;
            value <=> ToolOpts.line-width;
        }
    }
}

component TextGroup inherits RibbonGroup {
    label: @tr("Texte");
    if !root.classic: VerticalLayout {
        spacing: 4px;
        alignment: center;
        FontCombo {
            width: 200px;
            current-index <=> ToolOpts.font-index;
            selected(i) => {
                Actions.ribbon("text-opts");
            }
        }
        HorizontalLayout {
            height: 26px;
            spacing: 4px;
            // même largeur que la liste des polices au-dessus (le « + » tombe sous son bord droit)
            Gauge {
                label: @tr("Taille");
                label-width: 34px;
                bar-width: 122px;
                minimum: 6;
                maximum: ToolOpts.font-size-max;
                progressive: true;
                value <=> ToolOpts.font-size;
                changed(v) => {
                    Actions.ribbon("text-opts");
                }
            }
        }
    }
    if root.classic: HorizontalLayout {
        spacing: 4px;
        FontCombo {
            y: 2px;
            width: 160px;
            current-index <=> ToolOpts.font-index;
            selected(i) => {
                Actions.ribbon("text-opts");
            }
        }
        Gauge {
            label: @tr("Taille");
            label-width: 34px;
            bar-width: 64px;
            minimum: 6;
            maximum: ToolOpts.font-size-max;
            progressive: true;
            value <=> ToolOpts.font-size;
            changed(v) => {
                Actions.ribbon("text-opts");
            }
        }
    }
}

component TextStyleGroup inherits RibbonGroup {
    label: @tr("Paragraphe");
    GridLayout {
        spacing: 2px;
        Row {
            for k[i] in ["\u{f036}", "\u{f037}", "\u{f038}"]: ToggleButton {
                compact: true;
                glyph: k;
                tip: i == 0 ? @tr("Aligner le texte à gauche") : i == 1 ? @tr("Centrer le texte") : @tr("Aligner le texte à droite");
                checked: ToolOpts.text-align == i;
                clicked => {
                    ToolOpts.text-align = i;
                    Actions.ribbon("text-opts");
                }
            }
        }
        if !root.classic: Row {
            ToggleButton {
                colspan: 3;
                // même largeur que les trois boutons d'alignement au-dessus
                width: 3 * 26px + 2 * 2px;
                glyph: "\u{f1fc}";
                text: @tr("Lissé");
                checked: ToolOpts.antialias;
                clicked => {
                    ToolOpts.antialias = !ToolOpts.antialias;
                    Actions.ribbon("text-opts");
                }
            }
        }
    }
}

component GradientGroup inherits RibbonGroup {
    /// projet SVG : seuls linéaire et radial existent dans le format
    in property <bool> vector;
    label: @tr("Dégradé");
    GridLayout {
        spacing: 2px;
        Row {
            for k[i] in [{ g: "\u{f337}", t: @tr("Linéaire") }, { g: "\u{f192}", t: @tr("Radial") }]: ToggleButton {
                compact: root.classic;
                glyph: k.g;
                img: i == 0 ? Sprite.grad-linear : Sprite.grad-radial;
                text: k.t;
                checked: ToolOpts.gradient-kind == i;
                clicked => {
                    ToolOpts.gradient-kind = i;
                }
            }
        }
        if !root.vector: Row {
            for k[i] in [{ g: "\u{f219}", t: @tr("Losange") }, { g: "\u{f1ce}", t: @tr("Conique") }]: ToggleButton {
                compact: root.classic;
                glyph: k.g;
                img: i == 0 ? Sprite.grad-diamond : Sprite.grad-conic;
                text: k.t;
                checked: ToolOpts.gradient-kind == i + 2;
                clicked => {
                    ToolOpts.gradient-kind = i + 2;
                }
            }
        }
    }
}

/// Remplissage d'une forme, comme la version HTML. Trois colonnes : uni ou dégradé ; type du
/// dégradé et angle ; méthode. Barre Paint.NET : tout sur une ligne.
component ShapeFillGroup inherits RibbonGroup {
    label: @tr("Remplissage");
    property <bool> grad: ToolOpts.shape-fill-type == 1;
    GridLayout {
        spacing: root.classic ? 2px : 4px;
        spacing-horizontal: root.classic ? 2px : 12px;
        ToggleButton {
            row: 0;
            col: 0;
            compact: root.classic;
            glyph: "\u{f0c8}";
            img: Sprite.fill-solid;
            text: @tr("Uni");
            checked: !root.grad;
            clicked => { ToolOpts.shape-fill-type = 0; }
        }
        ToggleButton {
            row: root.classic ? 0 : 1;
            col: root.classic ? 1 : 0;
            compact: root.classic;
            glyph: "\u{f337}";
            img: Sprite.fill-gradient;
            text: @tr("Dégradé");
            checked: root.grad;
            clicked => { ToolOpts.shape-fill-type = 1; }
        }
        if root.grad: HorizontalLayout {
            row: 0;
            col: root.classic ? 2 : 1;
            spacing: 2px;
            alignment: start;
            ToggleButton {
                compact: root.classic;
                glyph: "\u{f337}";
                img: Sprite.grad-linear;
                text: @tr("Linéaire");
                checked: ToolOpts.shape-grad-type == 0;
                clicked => { ToolOpts.shape-grad-type = 0; }
            }
            ToggleButton {
                compact: root.classic;
                glyph: "\u{f192}";
                img: Sprite.grad-radial;
                text: @tr("Radial");
                checked: ToolOpts.shape-grad-type == 1;
                clicked => { ToolOpts.shape-grad-type = 1; }
            }
        }
        // l'angle garde sa place en radial (grisé) : la colonne ne change pas de largeur
        if root.grad: Gauge {
            row: root.classic ? 0 : 1;
            col: root.classic ? 3 : 1;
            opacity: ToolOpts.shape-grad-type == 0 ? 1 : 0.4;
            label: @tr("Angle");
            label-width: 38px;
            bar-width: 80px;
            minimum: 0;
            maximum: 360;
            unit: "°";
            value <=> ToolOpts.shape-grad-angle;
        }
        if root.grad: ToggleButton {
            row: 0;
            col: root.classic ? 4 : 2;
            compact: root.classic;
            glyph: "\u{f0d0}";
            img: Sprite.grad-method-smart;
            text: @tr("Intelligent");
            checked: ToolOpts.shape-grad-smart;
            clicked => { ToolOpts.shape-grad-smart = true; }
        }
        if root.grad: ToggleButton {
            row: root.classic ? 0 : 1;
            col: root.classic ? 5 : 2;
            compact: root.classic;
            glyph: "\u{f337}";
            img: Sprite.grad-method-simple;
            text: @tr("Simple");
            checked: !ToolOpts.shape-grad-smart;
            clicked => { ToolOpts.shape-grad-smart = false; }
        }
    }
}

/// Paramètres : titre de page et introduction. Les textes renvoyés à la ligne ont une largeur
/// imposée (`text-w`) : la hauteur de la page suit, le défilement atteint bien le bas.
/// Maillon entre largeur et hauteur : enfoncé = proportions conservées (Nouvelle image,
/// Redimensionner, Taille de la zone de travail).
component LinkToggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 30px;
    border-radius: Theme.ctl-radius;
    background: root.checked ? Theme.accent-14 : (Theme.hover-fx && lka.has-hover) ? Theme.accent-12 : transparent;
    border-width: 1px;
    border-color: root.checked ? Theme.accent : Theme.window-border;
    GlyphIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: root.checked ? "\u{f0c1}" : "\u{f127}";
        size: 12px;
        tint: root.checked ? Theme.accent : Theme.text-inactive;
    }
    HoverTip { y: parent.height; hovered: lka.has-hover; text: root.checked ? @tr("Proportions conservées (cliquer pour délier)") : @tr("Conserver les proportions"); }
    lka := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component AppearanceColorChoice inherits Rectangle {
    in property <string> label;
    in property <int> index;
    in property <color> value;
    width: 124px;
    height: 54px;
    border-radius: Theme.ctl-radius;
    background: Theme.button-bg;
    border-width: 1px;
    border-color: Theme.button-border;
    HorizontalLayout {
        x: 8px; y: 6px; width: parent.width - 16px; height: parent.height - 12px; spacing: 8px;
        Rectangle { width: 30px; height: 30px; background: root.value; border-width: 1px; border-color: Theme.field-border; border-radius: Theme.ctl-radius; }
        Text { horizontal-stretch: 1; text: root.label; color: Theme.text; wrap: word-wrap; vertical-alignment: center; font-size: Theme.small-font-size; }
    }
    HoverTip { y: parent.height; hovered: choice.has-hover; text: @tr("Choisir cette couleur"); }
    choice := TouchArea {
        clicked => { ColorPop.show("appearance:" + root.index, root.value, self.absolute-position.x, self.absolute-position.y, self.height); }
    }
}


/// Paramètres › Toile et outils : pastille de couleur posée sur la maquette de la toile
/// (libellé au-dessus, clic : sélecteur de couleur surgissant).
component CanvasSwatch inherits Rectangle {
    in property <string> label;
    in property <int> index;
    in property <color> value;
    in property <length> sw: 48px;
    in property <length> sh: 34px;
    width: max(self.sw, lbl.preferred-width + 12px);
    height: self.sh + 18px;
    // libellé sur une pastille claire : lisible sur n'importe quelle couleur
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 0;
        width: lbl.preferred-width + 10px;
        height: 16px;
        border-radius: 8px * Theme.round;
        background: #ffffffe0;
        lbl := Text {
            text: root.label;
            font-size: Theme.small-font-size;
            font-weight: 600;
            color: #202020;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Rectangle {
        x: (parent.width - root.sw) / 2;
        y: 18px;
        width: root.sw;
        height: root.sh;
        border-radius: 6px * Theme.round;
        background: root.value;
        border-width: 3px;
        border-color: (Theme.hover-fx && swt.has-hover) ? Theme.accent : #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000050;
    }
    HoverTip { y: parent.height; hovered: swt.has-hover; text: @tr("Choisir cette couleur"); }
    swt := TouchArea {
        mouse-cursor: pointer;
        clicked => { ColorPop.show("appearance:" + root.index, root.value, self.absolute-position.x, self.absolute-position.y, self.height); }
    }
}

/// Paramètres : intitulé d'un réglage et son explication.
component SetHead inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    in property <length> text-w;
    padding-top: 8px;
    spacing: 2px;
    Text {
        width: root.text-w;
        text: root.title;
        font-weight: 600;
        color: Theme.text;
        wrap: word-wrap;
    }
    if root.hint != "": Text {
        width: root.text-w;
        text: root.hint;
        wrap: word-wrap;
        color: Theme.text-inactive;
        font-size: Theme.small-font-size;
    }
}

/// Paramètres : réglage Oui / Non (intitulé et explication à gauche, choix à droite).
component SetYesNo inherits HorizontalLayout {
    in property <bool> compact;
    in property <string> title;
    in property <string> hint;
    in property <length> text-w;
    in-out property <bool> value;
    callback changed(bool);
    width: root.text-w;
    horizontal-stretch: 0;
    padding-top: root.compact ? 2px : 8px;
    spacing: 10px;
    VerticalLayout {
        spacing: 2px;
        alignment: center;
        Text {
            width: max(0px, root.text-w - 122px);
            text: root.title;
            font-weight: 600;
            color: Theme.text;
            wrap: word-wrap;
        }
        if root.hint != "" && !root.compact: Text {
            width: max(0px, root.text-w - 122px);
            text: root.hint;
            wrap: word-wrap;
            color: Theme.text-inactive;
            font-size: Theme.small-font-size;
        }
    }
    VerticalLayout {
        width: 112px;
        horizontal-stretch: 0;
        alignment: center;
        Segmented {
            width: 112px;
            tip: root.hint != "" ? root.hint : root.title;
            options: [@tr("Non"), @tr("Oui")];
            index: root.value ? 1 : 0;
            selected(i) => {
                root.value = i == 1;
                root.changed(root.value);
            }
        }
    }
}

/// Paramètres : groupe de réglages encadré, titre au-dessus. Les enfants prennent la largeur
/// `text-w - 30px` (marges de la carte) : un enfant venu d'ailleurs ne voit pas `parent`.
component SetCard inherits VerticalLayout {
    in property <string> title;
    in property <length> text-w;
    spacing: 6px;
    if root.title != "": Text {
        text: root.title;
        color: Theme.accent;
        font-weight: 700;
    }
    Rectangle {
        width: root.text-w;
        border-radius: Theme.ctl-radius > 0 ? Theme.ctl-radius + 3px : 0px;
        background: Theme.dark ? Theme.window-bg.brighter(8%) : Theme.field-bg;
        border-width: 1px;
        border-color: Theme.window-border;
        VerticalLayout {
            padding: 14px;
            spacing: 10px;
            @children
        }
    }
}

export component AppWindow inherits Window {
    // taille logique de la fenêtre (zoom de l'interface : lib.rs::fit_ui_zoom_size la corrige)
    out property <length> win-w: self.width;
    out property <length> win-h: self.height;
    callback ui-resized();
    changed height => { root.ui-resized(); }
    in-out property <[color]> appearance-colors: [#ffffff, #cccccc, #cfcfcf, #000000, #ffffff];
    in-out property <[string]> appearance-hex: ["#FFFFFF", "#CCCCCC", "#CFCFCF", "#000000", "#FFFFFF"];
    in-out property <float> checker-size: 8;
    in-out property <bool> workspace-custom;
    in property <image> checker-image;
    // aucune tuile de la toile n'a de pixel transparent (lib.rs::sync_canvas_opaque)
    in property <bool> canvas-opaque;
    out property <float> checker-view-w: root.usable-width / 1px;
    out property <float> checker-view-h: root.usable-height / 1px;
    changed checker-view-w => { root.appearance-changed(); }
    changed checker-view-h => { root.appearance-changed(); }
    callback appearance-color-edited(int, string);
    callback appearance-color-picked(int, color);
    callback appearance-reset();
    callback appearance-changed();

    title: @tr("MasterPaint");
    // logo MasterPaint (le même que le site et les installateurs)
    icon: @image-url("../../packaging/icons/128x128.png");
    // bureau : fenêtre sans cadre, les menus et les onglets forment la barre de titre
    no-frame: root.custom-frame;
    preferred-width: 1600px;
    preferred-height: 1000px;
    min-width: 320px;
    min-height: 400px;
    default-font-family: Theme.font;
    default-font-size: Theme.font-size;
    // couleur de l'espace de travail : posée par le fond de la fenêtre (un simple effacement de
    // l'écran), pas par un aplat de plus sous tout le reste
    background: root.platform-insets ? Theme.mob-accent-dark : root.ws-color;
    in property <bool> platform-insets;
    property <length> system-left: root.platform-insets ? root.safe-area-insets.left : 0px;
    property <length> system-top: root.platform-insets ? root.safe-area-insets.top : 0px;
    property <length> usable-width: max(1px, root.width - root.system-left - (root.platform-insets ? root.safe-area-insets.right : 0px));
    property <length> usable-height: max(1px, root.height - root.system-top - (root.platform-insets ? root.safe-area-insets.bottom : 0px));
    forward-focus: fs;

    // ---- état fourni par le Rust ----
    in property <image> canvas-image;
    // projet SVG : toile tracée à la résolution de l'écran (src/vecview.rs), pas d'image de pixels
    in property <bool> vec-on: false;
    in property <image> vec-image;
    in property <image> vec-overlay;
    /// zone du document couverte par vec-image
    in property <float> vec-x;
    in property <float> vec-y;
    in property <float> vec-w;
    in property <float> vec-h;
    callback vec-view-moved();
    in property <string> gpu-text;
    // barre de titre intégrée (bureau) : déplacer, réduire, agrandir, fermer
    in property <bool> custom-frame;
    /// version navigateur (sinon application de bureau)
    in property <bool> web;
    /// l'image active est un masque α : interface limitée aux niveaux de gris
    in property <bool> mask-doc;
    in property <string> app-version: "3.2.0";
    in property <bool> maximized;
    callback window-action(string);
    // fenêtre de choix façon Paint.NET (modifications non enregistrées, glisser-déposer, coller
    // une image plus grande que la toile) : boutons de commande, vignettes ; -1 = fermée
    in-out property <bool> show-task;
    in property <string> task-title;
    in property <string> task-intro;
    in property <string> task-info;
    in property <string> task-list-header;
    in property <[TaskCommand]> task-commands;
    in property <[TaskThumb]> task-thumbs;
    callback task-result(int);
    callback task-thumb(int);
    // fond du haut : image active floutée (voir header_background) sous un voile d'accent
    in property <image> header-bg;
    in property <[CanvasTile]> canvas-tiles: [];
    /// aucun projet ouvert (dernier onglet fermé) : toile masquée, palettes grisées
    in property <bool> no-doc;
    // largeur du bloc menus + barre rapide (les onglets commencent après) : 400 px au moins,
    // plus si les titres de menus ne tiennent pas
    property <length> menu-zone: root.interface-style == 2 ? max(360px, menu-row.preferred-width + 12px) : max(456px, menu-row.preferred-width + 12px, 368px + bug-label-measure.preferred-width);
    // Derive the tab band from the real action-button positions, including translations.
    in property <int> active-tab-index: -1;
    property <length> tabs-end: root.interface-style == 2 ? root.usable-width - 34px - 6 * 27px - 18px : min(info-button.x - 8px, root.custom-frame ? root.usable-width - 146px : root.usable-width - 8px);
    property <length> tabs-room: max(0px, root.tabs-end - root.menu-zone - 18px);
    property <length> tab-w: clamp((root.tabs-room - max(0, root.tabs.length - 1) * 2px) / max(1, root.tabs.length), 44px, 80px);
    property <length> tabs-full: root.tabs.length * root.tab-w + max(0, root.tabs.length - 1) * 2px;
    property <bool> tabs-over: root.tabs-full > root.tabs-room + 1px;
    property <length> tabs-view-room: max(0px, root.tabs-room - (root.tabs-over ? 40px : 0px));
    function scroll-tabs(delta: length) {
        tabs-fl.content-x = clamp(tabs-fl.content-x + delta, min(0px, root.tabs-view-room - root.tabs-full), 0px);
    }
    function reveal-active-tab() {
        if (root.active-tab-index >= 0 && root.tabs-view-room > 0px) {
            let left = root.active-tab-index * (root.tab-w + 2px);
            let right = left + root.tab-w;
            if (left < -tabs-fl.content-x) {
                tabs-fl.content-x = -left;
            } else if (right > -tabs-fl.content-x + root.tabs-view-room) {
                tabs-fl.content-x = root.tabs-view-room - right;
            }
        }
        root.scroll-tabs(0px);
    }
    changed active-tab-index => { root.reveal-active-tab(); }
    changed tabs-full => { root.reveal-active-tab(); }
    changed tabs-view-room => { root.reveal-active-tab(); }
    // ---- mode Animation (frise, voir anim.slint / anim.rs) ----
    in property <bool> anim-on;
    in-out property <bool> anim-open: true;
    in property <bool> anim-playing;
    in property <int> anim-frame;
    in property <int> anim-duration: 24;
    in property <int> anim-fps: 12;
    in property <bool> anim-loop: true;
    in property <bool> anim-pingpong;
    in property <bool> anim-onion;
    in property <bool> anim-onion-all;
    in property <bool> anim-draw-step;
    in property <bool> anim-has-clip;
    in property <[AnimRow]> anim-rows;
