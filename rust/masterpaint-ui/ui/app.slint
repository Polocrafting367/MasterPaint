    callback shape-opts-changed();
    property <string> shape-sig: ToolOpts.gradient-kind + "|" + ToolOpts.shape-fill-type + "|" + ToolOpts.shape-grad-type + "|" + ToolOpts.shape-grad-angle + "|" + (ToolOpts.shape-grad-smart ? "s" : "") + "|" + ToolOpts.shape-kind + "|" + ToolOpts.shape-style + "|" + ToolOpts.line-width + "|" + ToolOpts.corner-radius
        + "|" + ToolOpts.shape-sides + "|" + ToolOpts.star-points + "|" + root.primary-color.red + "," + root.primary-color.green + ","
        + root.primary-color.blue + "," + root.primary-color.alpha + "|" + root.secondary-color.red + "," + root.secondary-color.green + ","
        + root.secondary-color.blue + "," + root.secondary-color.alpha + "|" + ToolOpts.line-mode + "|" + ToolOpts.cap-start + "|"
        + ToolOpts.cap-end + "|" + ToolOpts.line-dash;
    changed shape-sig => { root.shape-opts-changed(); }
    // curseur de l'outil actif sur la toile (croix + icône + contour du pinceau), un vrai curseur
    // système rendu par lib.rs::refresh_tool_cursor : le dessiner dans l'interface redessinerait
    // toute la fenêtre à chaque mouvement du pointeur
    in property <image> tool-cursor;
    in property <bool> tool-cursor-on;
    in property <int> tool-cursor-hx: 7;
    in property <int> tool-cursor-hy: 7;
    // contour du pinceau à l'écran, en pixels de l'interface (0 : aucun)
    out property <float> ring-d: root.is-brush(root.current-tool) || (root.current-tool == "tool-pencil" && ToolOpts.brush-size > 1) ? max(ToolOpts.brush-size * root.zoom, 4) : 0;
    out property <bool> ring-square: ToolOpts.brush-shape == 3;
    property <float> ui-scale: 1px / 1phx;
    // contour trop grand pour un curseur système : dessiné par l'interface
    in property <bool> ring-overlay;
    callback tool-cursor-refresh();
    // appui dans la fenêtre (lib.rs) : la fenêtre flottante la plus haute sous le pointeur passe
    // devant ; deux temps, chaque fenêtre ne connaissant que son propre rang
    public function window-press(x: length, y: length) {
        WinStack.hit = 0;
        WinStack.press-x = x;
        WinStack.press-y = y;
        WinStack.press-serial += 1;
    }
    public function window-press-commit() {
        WinStack.commit-serial += 1;
    }
    changed ring-d => { root.tool-cursor-refresh(); }
    changed ring-square => { root.tool-cursor-refresh(); }
    changed ui-scale => { root.tool-cursor-refresh(); }
