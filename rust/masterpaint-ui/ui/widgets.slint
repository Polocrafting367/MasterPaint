// Contrôles Windows 10 de MasterPaint (équivalents de css/win-controls.css, theme-pdn.css).
import { Tips } from "tips.slint";
import { Theme, Backdrop } from "theme.slint";
import { IconSpec, Icons, ToolPackIcons } from "types.slint";
import { MpIcons } from "mpicons.slint";
import { PackIcons } from "pack-icons.slint";

/// Relief Windows 98 : deux liserés clairs en haut à gauche et sombres en bas à droite
/// (inversés en creux). Posé par-dessus le contrôle, il ne capte pas la souris.
export component Bevel inherits Rectangle {
    in property <bool> sunken;
    property <color> tl: sunken ? Theme.bevel-lo : Theme.bevel-hi;
    property <color> br: sunken ? Theme.bevel-hi : Theme.bevel-dk;
    property <color> tl2: sunken ? Theme.bevel-dk : Theme.window-bg;
    property <color> br2: sunken ? Theme.window-bg : Theme.bevel-lo;
    Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: root.tl; }
    Rectangle { x: 0; y: 0; width: 1px; height: parent.height; background: root.tl; }
    Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: root.br; }
    Rectangle { x: parent.width - 1px; y: 0; width: 1px; height: parent.height; background: root.br; }
    Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: 1px; background: root.tl2; }
    Rectangle { x: 1px; y: 1px; width: 1px; height: parent.height - 2px; background: root.tl2; }
    Rectangle { x: 1px; y: parent.height - 2px; width: parent.width - 2px; height: 1px; background: root.br2; }
    Rectangle { x: parent.width - 2px; y: 1px; width: 1px; height: parent.height - 2px; background: root.br2; }
}

/// Face des boutons Windows 7 (7.css : --w7-el-grad / -h / -a, bord #8e8f8f, #3c7fb1 au survol,
/// #6d91ab enfoncé, liseré blanc intérieur, bouton par défaut bleuté) et Windows XP (XP.css :
/// dégradé beige, bord #003c74, survol orangé, bouton par défaut bleu, enfoncé grisé). Posée sous
/// le libellé, elle ne capte pas la souris. `soft` : survol d'un bouton d'outil en Windows 7, en
/// surbrillance de liste (--w7-li-bg-hl, --w7-li-bd-hl).
export component ClassicFace inherits Rectangle {
    in property <bool> hover;
    in property <bool> pressed;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <bool> soft;
    property <bool> lit: Theme.hover-fx && root.hover && root.enabled;
    property <bool> li: Theme.b-w7 && root.soft && !root.pressed;
    /// boutons d'outil et de ruban en clair : survol doré, coché / enfoncé orangé (ruban de
    /// Windows 7 et d'Office 2010)
    /// XP : survol orangé d'Office 2003, bordé de bleu marine (couleur de surbrillance réglable)
    property <bool> gold: Theme.b-classic && root.soft;
    /// relief 3D coupé (Personnalisation avancée) : mêmes teintes, en aplats
    property <bool> flat: !Theme.gloss;
    border-radius: 3px * Theme.round;
    border-width: 1px;
    border-color: root.gold && Theme.b-xp ? (Theme.dark ? Theme.w7-hl.mix(#ffffff, 0.5) : Theme.xp-hl-border)
        : Theme.b-w7
        ? (root.gold ? (root.pressed ? Theme.w7-hl.mix(#000000, 0.74) : Theme.w7-hl.mix(#c08a00, 0.8)) : root.li ? (Theme.dark ? #5a8fb8 : #aaddfa) : !root.enabled ? #adb2b5 : root.pressed ? Theme.w7-ctl-bd-down : root.lit ? Theme.w7-ctl-bd : root.primary ? Theme.w7-ctl-bd-down : Theme.dark ? #1e1f22 : #8e8f8f)
        : !root.enabled ? #cac8bb : #003c74;
    background: root.flat ? (root.gold ? (root.pressed ? Theme.w7-hl-p3 : Theme.w7-hl-2)
            : !root.enabled ? (Theme.dark ? #3a3c40 : #f4f4f4)
            : Theme.b-w7 ? (root.pressed ? Theme.w7-ctl-3 : root.lit || root.primary ? Theme.w7-ctl-2 : Theme.dark ? #4a4e55 : #ebebeb)
            : root.pressed ? (Theme.dark ? #3a3934 : #e3e3db) : Theme.dark ? #47463f : #f4f3ee)
        // XP : surbrillance d'Office 2003, dégradé doux sans reflet vitré (pas celui de 7)
        : root.gold && Theme.b-xp ? (root.pressed ? @linear-gradient(180deg, Theme.w7-hl 0%, Theme.w7-hl.mix(#ffffff, 0.62) 100%)
            : @linear-gradient(180deg, Theme.w7-hl.mix(#ffffff, 0.22) 0%, Theme.w7-hl.mix(#ffffff, 0.6) 100%))
        : Theme.b-w7 || root.gold
        ? (root.gold ? (root.pressed ? @linear-gradient(180deg, Theme.w7-hl-p0 0%, Theme.w7-hl-p1 10%, Theme.w7-hl-p2 48%, Theme.w7-hl-p3 52%, Theme.w7-hl-p4 100%)
                : @linear-gradient(180deg, Theme.w7-hl-1 0%, Theme.w7-hl-2 48%, Theme.w7-hl-3 52%, Theme.w7-hl-4 100%))
            : root.li ? (Theme.dark ? @linear-gradient(180deg, #ffffff1f 0%, #ffffff0f 90%, #ffffff1a 100%) : @linear-gradient(180deg, #ffffff99 0%, #e6ecf5cc 90%, #ffffffcc 100%))
            : !root.enabled ? (Theme.dark ? #3a3c40 : #f4f4f4)
            : root.pressed ? @linear-gradient(180deg, Theme.w7-ctl-1 0%, Theme.w7-ctl-2 30%, Theme.w7-ctl-2 50%, Theme.w7-ctl-3 50%, Theme.w7-ctl-4 100%)
            : root.lit || root.primary ? @linear-gradient(180deg, Theme.w7-ctl-1 0%, Theme.w7-ctl-1 45%, Theme.w7-ctl-2 45%, Theme.w7-ctl-3 100%)
            : Theme.dark ? @linear-gradient(180deg, #6a6f78 0%, #565b63 45%, #3f4349 45%, #2b2e33 100%) : @linear-gradient(180deg, #f2f2f2 0%, #f2f2f2 45%, #ebebeb 45%, #cfcfcf 100%))
        : !root.enabled ? (Theme.dark ? #3a3933 : #f5f4ea)
        : root.pressed ? (Theme.dark ? @linear-gradient(180deg, #2f2e29 0%, #3a3934 8%, #3d3c36 94%, #47463f 100%) : @linear-gradient(180deg, #cdcac3 0%, #e3e3db 8%, #e5e5de 94%, #f2f2f1 100%))
        : Theme.dark ? @linear-gradient(180deg, #5f5d55 0%, #47463f 86%, #3b3a34 100%) : @linear-gradient(180deg, #ffffff 0%, #ecebe5 86%, #d8d0c4 100%);
    // 7.css : liseré blanc intérieur (inset 0 0 0 1px #fffc), bleu lumineux sur le bouton par
    // défaut (pulse-anim, figé : pas d'animation qui redessinerait sans cesse)
    if Theme.b-w7 && root.gold && !root.pressed: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: 2px * Theme.round;
        border-width: 1px;
        border-color: Theme.dark ? #ffffff30 : #ffffffb0;
    }
    if Theme.b-w7 && !root.li && !root.pressed: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: 2px * Theme.round;
        border-width: 1px;
        border-color: root.primary && !root.lit ? Theme.accent.mix(#ffffff, 0.45).with-alpha(Theme.dark ? 0.4 : 0.66) : Theme.dark ? #ffffff30 : #ffffffcc;
    }
    // 7.css enfoncé : inset 1px 1px 0 #0003
    if Theme.b-w7 && root.pressed: Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: 1px; background: root.gold ? #8a5a0033 : #00000033; }
    if Theme.b-w7 && root.pressed: Rectangle { x: 1px; y: 1px; width: 1px; height: parent.height - 2px; background: root.gold ? #8a5a001f : #00000033; }
    // XP.css : survol = liserés orangés (#fff0cf, #fdd889, #fbc761, #e5a01a) ; bouton par défaut
    // = liserés bleus (#cee7ff, #98b8ea, #bcd4f6, #89ade4)
    if Theme.b-xp && !root.gold && root.enabled && !root.pressed && (root.lit || root.primary): Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: 2px * Theme.round;
        border-width: 2px;
        border-color: root.lit ? (Theme.btn-hl-on ? Theme.btn-hl.mix(#ffffff, 0.6) : #fbc761) : #bcd4f6;
        Rectangle { x: 1px; y: 0; width: parent.width - 2px; height: 1px; background: root.lit ? (Theme.btn-hl-on ? Theme.btn-hl.mix(#ffffff, 0.2) : #fff0cf) : #cee7ff; }
        Rectangle { x: 1px; y: parent.height - 2px; width: parent.width - 2px; height: 2px; background: root.lit ? (Theme.btn-hl-on ? Theme.btn-hl : #e5a01a) : #89ade4; }
    }
}

/// Jauge Windows 7 / XP : barre de progression de 7.css (creux gris vitré, remplissage brillant)
/// ou de XP.css (blocs séparés), à la couleur d'accentuation ; la valeur est écrite dedans par la
/// jauge. Dessin seul : glisser, molette et double-clic restent ceux de la jauge.
export component TrackSkin inherits Rectangle {
    in property <float> ratio;
    in property <bool> hover;
    in property <bool> pressed;
    border-radius: 3px * Theme.round;
    border-width: 1px;
    border-color: Theme.win7 ? ((Theme.hover-fx && root.hover) || root.pressed ? Theme.w7-ctl-bd : Theme.dark ? #1e1f22 : #8e8f8f)
        : Theme.dark ? #5a5d63 : #686868;
    clip: true;
    // 7.css : linear-gradient(#f3f3f3, #fcfcfc 3px, #dbdbdb 6px, #cacaca 6px, #d5d5d5) sur 15 px
    // relief 3D coupé : creux uni et remplissage plein, à la Windows 8
    background: !Theme.gloss ? (Theme.dark ? #2e3035 : Theme.xp ? #ffffff : #e6e6e6)
        : Theme.dark ? @linear-gradient(180deg, #2a2c30 0%, #34373c 45%, #26282c 45%, #2e3035 100%)
        : Theme.xp ? #ffffff
        : @linear-gradient(180deg, #f3f3f3 0%, #fcfcfc 20%, #dbdbdb 42%, #cacaca 42%, #d5d5d5 100%);
    property <length> fill-w: max(0px, (self.width - 2px) * clamp(root.ratio, 0, 1));
    if Theme.win7: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.fill-w;
        height: parent.height - 2px;
        // clair comme le vert de 7.css : le chiffre noir écrit dessus reste lisible
        background: !Theme.gloss ? Theme.accent.mix(#ffffff, 0.42) : @linear-gradient(180deg, Theme.accent.mix(#ffffff, 0.22) 0%, Theme.accent.mix(#ffffff, 0.12) 22%, Theme.accent.mix(#ffffff, 0.3) 42%, Theme.accent.mix(#ffffff, 0.55) 42%, Theme.accent.mix(#ffffff, 0.45) 70%, Theme.accent.mix(#ffffff, 0.3) 100%);
        // liseré clair intérieur (inset 0 0 0 1px #ffffff1f) et bord droit net
        if Theme.gloss: Rectangle { border-width: 1px; border-color: #ffffff30; }
        Rectangle { x: parent.width - 1px; width: 1px; background: Theme.accent.mix(#000000, 0.6); visible: root.ratio < 1; }
    }
    // XP.css : blocs de 8 px séparés de 2 px blancs, dégradé vertical clair au centre
    if Theme.xp: Rectangle {
        x: 2px;
        y: 2px;
        width: max(0px, parent.fill-w - 2px);
        height: parent.height - 4px;
        clip: true;
        background: !Theme.gloss ? Theme.accent.mix(#ffffff, 0.45) : @linear-gradient(180deg, Theme.accent.mix(#ffffff, 0.25) 0%, Theme.accent.mix(#ffffff, 0.45) 30%, Theme.accent.mix(#ffffff, 0.55) 50%, Theme.accent.mix(#ffffff, 0.42) 75%, Theme.accent.mix(#ffffff, 0.22) 100%);
        for k in 60: Rectangle {
            x: 8px + k * 10px;
            width: 2px;
            background: Theme.dark ? #26282c : #ffffff;
        }
    }
}

/// Flèche d'une barre de défilement (Windows 7 / XP / 98) : bouton en relief au survol.
component ScrollArrow inherits Rectangle {
    in property <int> dir; // 0 haut, 1 bas, 2 gauche, 3 droite
    in property <bool> bar-hover;
    callback step();
    if Theme.classic && (ta.has-hover || ta.pressed): ClassicFace {
        hover: true;
        pressed: ta.pressed;
    }
    if Theme.xp && !ta.has-hover && !ta.pressed: Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        border-radius: 2px * Theme.round;
        background: Theme.dark ? #4a5a80 : !Theme.gloss ? #c3d3fa : @linear-gradient(135deg, #cbd9fd 0%, #b3c7f7 100%);
        border-width: 1px;
        border-color: Theme.dark ? #7088c0 : #ffffff;
    }
    if Theme.win98: Rectangle {
        background: Theme.button-bg;
        Bevel { sunken: ta.pressed; }
    }
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 7px;
        height: 7px;
        viewbox-width: 8;
        viewbox-height: 8;
        commands: root.dir == 0 ? "M0 6 L4 2 L8 6 Z" : root.dir == 1 ? "M0 2 L4 6 L8 2 Z" : root.dir == 2 ? "M6 0 L2 4 L6 8 Z" : "M2 0 L6 4 L2 8 Z";
        fill: Theme.win98 ? Theme.text : Theme.xp && !Theme.dark ? #4d6185 : Theme.dark ? #c8ccd2 : (ta.has-hover ? #1c2e4a : #5a6474);
    }
    ta := TouchArea {
        clicked => { root.step(); }
    }
    Timer {
        interval: 60ms;
        running: ta.pressed;
        triggered => { root.step(); }
    }
}

/// Barre de défilement de MasterPaint, dessinée selon le style : fine et discrète (moderne,
/// ultra léger), ou barre pleine de 17 px avec flèches et poignée vitrée (Windows 7 : 7.css),
/// bleutée (XP) ou en relief (98).
component MpScrollBar inherits Rectangle {
    in property <bool> horizontal;
    in property <length> maximum;
    in property <length> page-size;
    in-out property <length> value;
    in property <ScrollBarPolicy> policy: ScrollBarPolicy.as-needed;
    in property <bool> enabled: true;
    callback scrolled();
    property <bool> full: Theme.classic || Theme.win98;
    property <length> offset: root.full ? 17px : 16px;
    property <length> track-size: (root.horizontal ? root.width : root.height) - 2 * root.offset;
    property <length> thumb-len: root.maximum <= 0px ? 0px : max(min(root.full ? 17px : 16px, root.track-size), root.track-size * root.page-size / (root.maximum + root.page-size));
    property <length> thumb-pos: root.maximum <= 0px ? root.offset : root.offset + (root.track-size - root.thumb-len) * (-root.value / root.maximum);
    property <bool> hov: Theme.hover-fx && (ta.has-hover || ta.pressed);
    property <length> thin: root.hov && !Theme.lite ? 6px : Theme.lite ? 6px : 2px;
    visible: (root.policy == ScrollBarPolicy.always-on) || (root.policy == ScrollBarPolicy.as-needed && root.maximum > 0);
    function move(by: length) {
        root.value = max(-root.maximum, min(0px, root.value + by));
        root.scrolled();
    }
    border-radius: root.full || Theme.lite ? 0px : 7px;
    background: Theme.win98 ? Theme.bevel-hi.mix(Theme.window-bg, 0.5)
        : Theme.win7 && !Theme.gloss ? (Theme.dark ? #2a2c30 : #f0f0f0)
        : Theme.xp && !Theme.gloss ? (Theme.dark ? #2c2b27 : #f8f7f3)
        : Theme.win7 ? (Theme.dark ? #2a2c30 : root.horizontal ? @linear-gradient(180deg, #e5e5e5 0%, #f0f0f0 20%, #f0f0f0 100%) : @linear-gradient(90deg, #e5e5e5 0%, #f0f0f0 20%, #f0f0f0 100%))
        : Theme.xp ? (Theme.dark ? #2c2b27 : root.horizontal ? @linear-gradient(180deg, #f3f1ec 0%, #fefefb 100%) : @linear-gradient(90deg, #f3f1ec 0%, #fefefb 100%))
        : root.hov && !Theme.lite ? Theme.text.with-alpha(0.06) : transparent;
    ta := TouchArea {
        property <length> start-value;
        property <length> start-pos;
        property <bool> on-thumb;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                self.start-pos = root.horizontal ? self.mouse-x : self.mouse-y;
                self.on-thumb = self.start-pos >= root.thumb-pos && self.start-pos <= root.thumb-pos + root.thumb-len;
                // clic dans la piste : une page vers le clic
                if (!self.on-thumb) {
                    root.move(self.start-pos < root.thumb-pos ? root.page-size : 0px - root.page-size);
                }
                self.start-value = -root.value;
            }
        }
        moved => {
            if (self.pressed && self.on-thumb && root.track-size > root.thumb-len) {
                root.value = -max(0px, min(root.maximum, self.start-value + ((root.horizontal ? self.mouse-x : self.mouse-y) - self.start-pos) * (root.maximum / (root.track-size - root.thumb-len))));
                root.scrolled();
            }
        }
        scroll-event(e) => {
            if (root.horizontal && e.delta-x != 0) {
                root.move(e.delta-x);
                return accept;
            } else if (!root.horizontal && e.delta-y != 0) {
                root.move(e.delta-y);
                return accept;
            }
            reject
        }
    }
    // poignée
    Rectangle {
        x: root.horizontal ? root.thumb-pos : root.full ? 1px : parent.width - 4px - self.width;
        y: !root.horizontal ? root.thumb-pos : root.full ? 1px : parent.height - 4px - self.height;
        width: root.horizontal ? root.thumb-len : root.full ? parent.width - 2px : root.thin;
        height: !root.horizontal ? root.thumb-len : root.full ? parent.height - 2px : root.thin;
        border-radius: Theme.win98 || Theme.lite ? 0px : root.full ? 3px * Theme.round : (root.horizontal ? self.height : self.width) / 2;
        border-width: Theme.classic ? 1px : 0px;
        border-color: Theme.xp ? (Theme.dark ? #7088c0 : #ffffff)
            : ta.pressed ? Theme.w7-ctl-bd-down : root.hov ? Theme.w7-ctl-bd : Theme.dark ? #1e1f22 : #8e8f8f;
        property <angle> ga: root.horizontal ? 180deg : 90deg;
        background: Theme.win98 ? Theme.button-bg
            : Theme.xp ? (Theme.dark ? #4a5a80 : ta.pressed ? #a8bdf5 : root.hov ? #dbe5ff : #c8d6fb)
            : Theme.win7 && !Theme.gloss ? (Theme.dark ? (root.hov ? #3f6383 : #4b4e54) : ta.pressed ? Theme.w7-ctl-3 : root.hov ? Theme.w7-ctl-2 : #dcdcdc)
            : Theme.win7 ? (Theme.dark
                    ? (root.hov ? @linear-gradient(self.ga, #3f6383 0%, #3f6383 45%, #2f5373 45%, #284866 100%) : @linear-gradient(self.ga, #4b4e54 0%, #4b4e54 45%, #42454b 45%, #36383d 100%))
                : ta.pressed ? @linear-gradient(self.ga, Theme.w7-ctl-2 0%, Theme.w7-ctl-2 45%, Theme.w7-ctl-3 45%, Theme.w7-ctl-4 100%)
                : root.hov ? @linear-gradient(self.ga, Theme.w7-ctl-1 0%, Theme.w7-ctl-1 45%, Theme.w7-ctl-2 45%, Theme.w7-ctl-3 100%)
                : @linear-gradient(self.ga, #f2f2f2 0%, #f2f2f2 45%, #ebebeb 45%, #cfcfcf 100%))
            : Theme.text.with-alpha(root.hov ? 0.55 : 0.4);
        if Theme.win98: Bevel { }
        // liseré blanc intérieur (7.css : --w7-el-sd)
        if Theme.win7: Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            border-radius: 2px * Theme.round;
            border-width: 1px;
            border-color: Theme.dark ? #ffffff1a : #ffffffcc;
        }
        // stries de prise au milieu de la poignée
        for k in [-3, 0, 3]: Rectangle {
            visible: Theme.classic && (root.horizontal ? parent.width : parent.height) > 24px;
            x: root.horizontal ? parent.width / 2 + k * 1px : 4px;
            y: root.horizontal ? 4px : parent.height / 2 + k * 1px;
            width: root.horizontal ? 1px : parent.width - 8px;
            height: root.horizontal ? parent.height - 8px : 1px;
            background: Theme.dark ? #ffffff66 : Theme.xp ? #8ca4e0 : #6a7480a0;
        }
    }
    if root.full: ScrollArrow {
        x: 0; y: 0;
        width: root.horizontal ? 17px : parent.width;
        height: root.horizontal ? parent.height : 17px;
        dir: root.horizontal ? 2 : 0;
        step => { root.move(24px); }
    }
    if root.full: ScrollArrow {
        x: root.horizontal ? parent.width - 17px : 0;
        y: root.horizontal ? 0 : parent.height - 17px;
        width: root.horizontal ? 17px : parent.width;
        height: root.horizontal ? parent.height : 17px;
        dir: root.horizontal ? 3 : 1;
        step => { root.move(-24px); }
    }
}

/// Zone défilante de MasterPaint : même interface que celle de la bibliothèque standard, mais
/// ses barres suivent le style choisi (Windows 7, XP, 98…) et recouvrent le bord droit / bas
/// du contenu, comme avant.
export component ScrollView {
    in property <bool> enabled: true;
    out property <length> visible-width <=> flickable.width;
    out property <length> visible-height <=> flickable.height;
    in-out property <length> content-width <=> flickable.content-width;
    in-out property <length> content-height <=> flickable.content-height;
    in-out property <length> content-x <=> flickable.content-x;
    in-out property <length> content-y <=> flickable.content-y;
    in property <ScrollBarPolicy> vertical-scrollbar-policy <=> vertical-bar.policy;
    in property <ScrollBarPolicy> horizontal-scrollbar-policy <=> horizontal-bar.policy;
    in property <bool> mouse-drag-pan-enabled <=> flickable.mouse-drag-pan-enabled;
    in-out property <bool> has-focus;
    callback scrolled <=> flickable.flicked;
    property <bool> full: Theme.classic || Theme.win98;
    property <length> bar: root.full ? 17px : 14px;
    min-height: 50px;
    min-width: 50px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    preferred-height: 100%;
    preferred-width: 100%;
    flickable := Flickable {
        mouse-drag-pan-enabled: false;
        content-y <=> vertical-bar.value;
        content-x <=> horizontal-bar.value;
        x: 0;
        y: 0;
        // les barres recouvrent le bord du contenu (comme la bibliothèque standard) : réduire la
        // zone visible quand une barre apparaît ferait dépendre la taille du contenu d'elle-même
        width: parent.width;
        height: parent.height;
        @children
    }
    vertical-bar := MpScrollBar {
        enabled: root.enabled;
        width: root.bar;
        // barres pleines : en retrait de 2 px, le cadre des fenêtres en coupait le bord droit
        x: parent.width - self.width - (root.full ? 2px : 0px);
        y: 0;
        height: horizontal-bar.visible ? parent.height - horizontal-bar.height : parent.height;
        horizontal: false;
        maximum: flickable.content-height - flickable.height;
        page-size: flickable.height;
        scrolled => { root.scrolled() }
    }
    horizontal-bar := MpScrollBar {
        enabled: root.enabled;
        width: vertical-bar.visible ? parent.width - vertical-bar.width : parent.width;
        height: root.bar;
        y: parent.height - self.height - (root.full ? 2px : 0px);
        x: 0;
        horizontal: true;
        maximum: flickable.content-width - flickable.width;
        page-size: flickable.width;
        scrolled => { root.scrolled() }
    }
}

/// Liste défilante (lignes créées à la demande, comme la `ListView` standard : le compilateur
/// reconnaît ce nom et ses propriétés `content-*` / `visible-*`).
export component ListView inherits ScrollView {
    @children
    accessible-role: list;
}

/// Icône : icône maison (MpIcons : trait du thème + accent) quand l'outil / le bouton en a une,
/// sinon icône du sprite SVG ou glyphe Font Awesome. Sur fond d'accent (teinte on-accent) :
/// glyphe, pour garder le contraste.
export component HoverTip inherits Rectangle {
    in property <bool> hovered;
    in property <string> text;
    width: 0px;
    height: 0px;
    Timer {
        interval: 600ms;
        running: root.hovered && root.text != "" && !(Tip.shown && Tip.text == root.text);
        triggered => {
            Tip.text = root.text;
            Tip.x = root.absolute-position.x;
            Tip.y = root.absolute-position.y + 4px;
            Tip.shown = true;
        }
    }
    changed hovered => { if (!root.hovered && Tip.text == root.text) { Tip.shown = false; } }
}

export component Icon inherits Rectangle {
    in property <IconSpec> spec;
    in property <length> size: 16px;
    in property <color> tint: Theme.text;
    width: size;
    height: size;
    in property <bool> monochrome: false;
    property <int> mp: root.monochrome || root.tint == Theme.on-accent ? -1 : MpIcons.for-spec(root.spec);
    property <int> pack: PackIcons.index(root.spec.fa);
    property <image> tool-pack: root.spec.svg-index >= 0 ? ToolPackIcons.images[root.spec.svg-index] : @image-url("");
    property <image> png: root.tool-pack.width > 0 && !root.monochrome && root.tint != Theme.on-accent ? root.tool-pack : root.mp >= 0 ? MpIcons.images[root.mp] : root.pack >= 0 && !root.monochrome && root.tint != Theme.on-accent ? PackIcons.images[root.pack] : @image-url("");
    if root.png.width > 0: Image {
        source: root.png;
        width: parent.width;
        height: parent.height;
        image-fit: contain;
    }
    if root.png.width == 0 && spec.svg-index >= 0 && !monochrome: Image {
        source: Icons.images[spec.svg-index];
        width: parent.width;
        height: parent.height;
        image-fit: contain;
    }
    if spec.svg-index >= 0 && monochrome: Image {
        source: Icons.images[spec.svg-index];
        width: parent.width;
        height: parent.height;
        colorize: root.tint;
        image-fit: contain;
    }
    if root.png.width == 0 && spec.svg-index < 0 && spec.fa != "": Text {
        text: spec.fa;
        font-family: Theme.icon-font;
        font-weight: spec.fa-weight;
        font-size: round(root.size * 0.86 / 1px) * 1px;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

/// Signe « − » / « + » (jauges) et symboles des boutons de fenêtre (réduire, agrandir,
/// restaurer, fermer), dessinés en traits : jamais remplacés par une icône du pack (le « − »
/// devenait une case « ⊟ » sans rapport avec le « + »), toujours centrés au pixel.
export component SignGlyph inherits Rectangle {
    /// "minus", "plus", "min", "max", "restore", "close"
    in property <string> kind: "minus";
    in property <length> size: 9px;
    in property <color> tint: Theme.text;
    in property <length> thick: 1px;
    property <length> s: round(root.size / 1px) * 1px;
    property <length> ox: round((root.width - root.s) / 2 / 1px) * 1px;
    property <length> oy: round((root.height - root.s) / 2 / 1px) * 1px;
    property <length> mid: round((root.s - root.thick) / 2 / 1px) * 1px;
    if root.kind == "minus" || root.kind == "plus" || root.kind == "min": Rectangle {
        x: root.ox; y: root.oy + root.mid; width: root.s; height: root.thick; background: root.tint;
    }
    if root.kind == "plus": Rectangle {
        x: root.ox + root.mid; y: root.oy; width: root.thick; height: root.s; background: root.tint;
    }
    if root.kind == "max": Rectangle {
        x: root.ox; y: root.oy; width: root.s; height: root.s; border-width: root.thick; border-color: root.tint;
    }
    if root.kind == "restore": Rectangle {
        x: root.ox + 2px; y: root.oy; width: root.s - 2px; height: root.s - 2px; border-width: root.thick; border-color: root.tint;
    }
    if root.kind == "restore": Rectangle {
        x: root.ox; y: root.oy + 2px; width: root.s - 2px; height: root.s - 2px; border-width: root.thick; border-color: root.tint; background: root.background;
    }
    if root.kind == "close": Path {
        x: root.ox; y: root.oy; width: root.s; height: root.s;
        viewbox-width: 10; viewbox-height: 10;
        stroke: root.tint; stroke-width: root.thick;
        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
    }
}

/// Glyphe Font Awesome direct.
export component FaIcon inherits Text {
    in property <string> glyph;
    in property <int> weight: 900;
    in property <length> size: 13px;
    property <int> pack: PackIcons.index(root.glyph);
    property <image> packed: root.pack >= 0 ? PackIcons.images[root.pack] : @image-url("");
    text: root.packed.width == 0 ? root.glyph : "";
    font-family: Theme.icon-font; font-weight: root.weight;
    font-size: round(root.size / 1px) * 1px; color: Theme.text;
    horizontal-alignment: center; vertical-alignment: center;
    if root.packed.width > 0: Image {
        source: root.packed; width: root.size; height: root.size; image-fit: contain;
        colorize: root.color == Theme.text ? transparent : root.color;
    }
}

/// Glyphe d'action : icône maison (MpIcons, style du sprite) quand le glyphe Font Awesome en a
/// une, sinon le glyphe lui-même (chevrons, croix…). Sur fond d'accent (`on-accent`) ou en
/// texte simple (autre police) : toujours le glyphe, pour garder le contraste.
export component GlyphIcon inherits Rectangle {
    in property <string> glyph;
    in property <int> weight: 900;
    in property <length> size: 13px;
    in property <color> tint: Theme.text;
    in property <string> font-family: Theme.icon-font;
    in property <bool> on-accent: false;
    property <int> mp: root.on-accent || root.font-family != Theme.icon-font ? -1 : MpIcons.for-glyph(root.glyph);
    width: round(root.size * 1.25 / 1px) * 1px;
    height: round(root.size * 1.3 / 1px) * 1px;
    property <int> pack: PackIcons.index(root.glyph);
    property <image> packed: root.mp >= 0 ? MpIcons.images[root.mp] : root.pack >= 0 && !root.on-accent && root.font-family == Theme.icon-font ? PackIcons.images[root.pack] : @image-url("");
    if root.packed.width > 0: Image {
        source: root.packed;
        x: round((parent.width - self.width) / 2 / 1px) * 1px;
        y: round((parent.height - self.height) / 2 / 1px) * 1px;
        width: round(root.size * 1.15 / 1px) * 1px;
        height: round(root.size * 1.15 / 1px) * 1px;
        image-fit: contain;
    }
    if root.packed.width == 0: Text {
        width: parent.width;
        height: parent.height;
        text: root.glyph;
        font-family: root.font-family;
        font-weight: root.weight;
        font-size: root.size;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// Bouton plat (barre d'outils, ruban, fenêtre Outils) : survol et état coché à l'accent.
export component FlatButton inherits Rectangle {
    in property <IconSpec> icon;
    in property <string> label;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <length> icon-size: 16px;
    in property <length> icon-width: root.icon-size;
    in property <bool> show-label: true;
    in property <bool> label-below;
    /// icône du sprite MasterPaint (prioritaire sur `icon`)
    in property <image> img;
    /// info-bulle (par défaut : le libellé d'un bouton sans libellé visible)
    in property <string> tip;
    property <string> tip-text: root.tip != "" ? root.tip : Tips.desc(root.label) != "" ? Tips.desc(root.label) : root.label;
    callback clicked();
    /// clic droit (position dans la fenêtre) : menu de réglages du bouton, s'il en a un
    callback right-clicked(length, length);
    out property <bool> hovered: ta.has-hover;
    Timer {
        interval: 600ms;
        running: ta.has-hover && !ta.pressed && root.tip-text != "" && !(Tip.shown && Tip.text == root.tip-text);
        triggered => {
            Tip.text = root.tip-text;
            Tip.x = root.absolute-position.x;
            Tip.y = root.absolute-position.y + root.height + 4px;
            Tip.shown = true;
        }
    }
    background: Theme.b-98 ? (checked ? Theme.bevel-hi.mix(Theme.window-bg, 0.5) : transparent)
        : Theme.b-classic || !enabled ? transparent : ta.pressed ? Theme.tb-20 : checked ? Theme.tb-14 : (Theme.hover-fx && ta.has-hover) ? Theme.tb-12 : transparent;
    border-width: Theme.b-98 || Theme.b-classic ? 0px : (checked || ((Theme.hover-fx && ta.has-hover) && enabled)) ? 1px : 0px;
    // Windows 7 / XP : survol en surbrillance (7) ou bouton en relief (XP), coché = enfoncé
    if Theme.b-classic && root.enabled && (root.checked || ta.pressed || (Theme.hover-fx && ta.has-hover)): ClassicFace {
        width: parent.width;
        height: parent.height;
        hover: ta.has-hover;
        pressed: root.checked || ta.pressed;
        soft: true;
    }
    border-color: checked ? Theme.tb-edge : Theme.tb-60;
    border-radius: Theme.ctl-radius;
    min-width: icon-size + 7px;
    min-height: icon-size + 7px;
    ta := TouchArea {
        mouse-cursor: default;
        clicked => {
            Tip.shown = false;
            if (root.enabled) {
                root.clicked();
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right && root.enabled) {
                Tip.shown = false;
                root.right-clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        changed has-hover => {
            if (!self.has-hover && Tip.text == root.tip-text) {
                Tip.shown = false;
            }
        }
    }
    if !label-below: HorizontalLayout {
        padding-left: (root.show-label && root.label != "") ? 6px : 0px;
        padding-right: (root.show-label && root.label != "") ? 8px : 0px;
        spacing: 6px;
        alignment: (root.show-label && root.label != "") ? start : center;
        VerticalLayout {
            alignment: center;
            if root.img.width > 0: Image {
                width: root.icon-size + 2px;
                height: root.icon-size + 2px;
                source: root.img;
                opacity: root.enabled ? 1 : 0.4;
            }
            if root.img.width == 0: Icon {
                spec: root.icon;
                size: root.icon-size;
                width: root.icon-width;
                tint: root.enabled ? Theme.ribbon-fg : Theme.text-inactive;
                opacity: root.enabled ? 1 : 0.4;
            }
        }
        if root.show-label && root.label != "": Text {
            text: root.label;
            font-size: Theme.font-size;
            color: root.enabled ? Theme.ribbon-fg : Theme.text-inactive;
            vertical-alignment: center;
        }
    }
    // Windows 98 : bouton enfoncé quand il est coché ou pressé, en relief au survol
    if Theme.b-98 && enabled && (checked || ta.pressed || ta.has-hover): Bevel {
        sunken: root.checked || ta.pressed;
    }
    if label-below: VerticalLayout {
        padding: 3px;
        spacing: 2px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Icon {
                spec: root.icon;
                size: root.icon-size;
                tint: Theme.ribbon-fg;
            }
        }
        Text {
            text: root.label;
            font-size: Theme.small-font-size;
            color: Theme.ribbon-fg;
            horizontal-alignment: center;
        }
    }
}

/// Bouton façon Windows 11 : coins arrondis, bord discret plus marqué en bas ; bouton
/// principal plein, à la couleur d'accent. Thème Windows 98 : relief 3D.
export component W10Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    /// bouton à bascule enfoncé (Grille…)
    in property <bool> checked;
    in property <string> tip;
    property <string> tip-text: root.tip != "" ? root.tip : root.text == @tr("Annuler") ? @tr("Ferme cette fenêtre sans appliquer les changements.") : Tips.desc(root.text) != "" ? Tips.desc(root.text) : root.text;
    /// icône facultative devant le libellé (icônes maison : MpIcons.images)
    in property <image> icon;
    property <bool> has-icon: root.icon.width > 0;
    callback clicked();
    Timer {
        interval: 600ms;
        running: ta.has-hover && !ta.pressed && root.tip-text != "" && !(Tip.shown && Tip.text == root.tip-text);
        triggered => {
            Tip.text = root.tip-text;
            Tip.x = root.absolute-position.x;
            Tip.y = root.absolute-position.y + root.height + 4px;
            Tip.shown = true;
        }
    }
    property <bool> filled: root.primary && !Theme.b-98 && !Theme.b-classic;
    height: Theme.b-98 ? 22px : 24px;
    width: max(Theme.b-98 ? 0px : 56px, txt.preferred-width + (Theme.b-98 ? 16px : 24px) + (root.has-icon ? 22px : 0px));
    border-radius: Theme.b-98 || Theme.b-classic ? 0px : min(Theme.button-radius, self.height / 2);
    background: Theme.b-98 ? Theme.button-bg : Theme.b-classic ? transparent
        : root.filled ? (ta.pressed ? Theme.accent.darker(0.15) : (Theme.hover-fx && ta.has-hover) ? Theme.accent.brighter(0.1) : Theme.accent)
        : ta.pressed || root.checked ? (Theme.btn-hl-on ? Theme.btn-hl.mix(Theme.button-bg, 0.3) : Theme.accent-14)
        : (Theme.hover-fx && ta.has-hover) ? (Theme.btn-hl-on ? Theme.btn-hl.mix(Theme.button-bg, 0.16) : Theme.dark ? Theme.button-bg.brighter(0.15) : Theme.button-bg.darker(0.03)) : Theme.button-bg;
    border-width: Theme.b-98 ? (primary ? 1px : 0px) : Theme.b-classic ? 0px : 1px;
    border-color: Theme.b-98 ? Theme.bevel-dk : root.filled ? Theme.accent.darker(0.1) : root.checked ? Theme.accent
        : Theme.btn-hl-on && Theme.hover-fx && ta.has-hover ? Theme.btn-hl : !Theme.button-relief ? Theme.button-border : Theme.dark ? #ffffff17 : #0000001a;
    if Theme.b-classic: ClassicFace {
        width: parent.width;
        height: parent.height;
        hover: ta.has-hover;
        pressed: ta.pressed || root.checked;
        primary: root.primary;
    }
    // ombre du bas (Windows 11 : bord inférieur un peu plus foncé)
    if !Theme.b-98 && !Theme.b-classic && Theme.button-relief: Rectangle {
        x: root.border-radius;
        y: root.height - 1px;
        width: root.width - 2 * root.border-radius;
        height: 1px;
        background: root.filled ? #00000040 : Theme.dark ? #00000040 : #00000029;
    }
    ta := TouchArea {
        clicked => {
            Tip.shown = false;
            root.clicked();
        }
        changed has-hover => {
            if (!self.has-hover && Tip.text == root.tip-text) {
                Tip.shown = false;
            }
        }
    }
    if Theme.b-98: Bevel {
        x: root.primary ? 1px : 0px;
        y: root.primary ? 1px : 0px;
        width: parent.width - (root.primary ? 2px : 0px);
        height: parent.height - (root.primary ? 2px : 0px);
        sunken: ta.pressed;
    }
    if root.has-icon: Image {
        x: 10px;
        width: 16px;
        height: 16px;
        source: root.icon;
    }
    txt := Text {
        x: root.has-icon ? 30px : 0px;
        width: parent.width - self.x - (root.has-icon ? 8px : 0px);
        text: root.text;
        font-size: Theme.b-98 ? Theme.small-font-size : Theme.font-size;
        color: root.filled ? Theme.on-accent : (ta.pressed && !Theme.b-98 && !Theme.b-classic) ? Theme.text-inactive : Theme.button-fg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// Curseur Windows 10 : piste fine, partie remplie à l'accent, poignée en étiquette.
export component W10Slider inherits Rectangle {
    in property <string> tip;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in-out property <float> value: 50;
    /// piste en dégradé (luminosité, saturation, teinte, canal de couleur…)
    in property <bool> gradient;
    in property <brush> track;
    /// valeur imposée par le parent (liée) : le curseur la signale sans l'écrire
    in property <bool> controlled;
    callback changed(float);
    callback released(float);
    height: 20px;
    min-width: 60px;
    property <length> usable: self.width - 11px;
    property <float> ratio: (value - minimum) / max(0.0001, maximum - minimum);
    Rectangle {
        x: 5px;
        y: (parent.height - self.height) / 2 - 2px;
        width: parent.width - 10px;
        height: root.gradient ? 9px : Theme.classic ? 4px : 5px;
        border-radius: root.gradient || Theme.xp ? 2px : 0px;
        background: root.gradient ? root.track : Theme.track-bg;
        border-width: 1px;
        border-color: Theme.track-border;
    }
    // Windows 7 / XP : poignée de 7.css (slider-indicator*.png) et de XP.css (indicator-horizontal)
    if Theme.classic: Image {
        x: root.usable * root.ratio + (Theme.win7 ? 0.5px : 0px);
        y: (parent.height - self.height) / 2;
        width: Theme.win7 ? 10px : 11px;
        height: Theme.win7 ? 18px : 21px;
        source: Theme.xp ? @image-url("skins/xp/slider.png")
            : ta.pressed ? @image-url("skins/win7/slider-active.png")
            : (Theme.hover-fx && ta.has-hover) ? @image-url("skins/win7/slider-hover.png") : @image-url("skins/win7/slider.png");
        image-rendering: pixelated;
    }
    if !Theme.classic: Path {
        x: root.usable * root.ratio;
        y: (parent.height - 19px) / 2;
        width: 11px;
        height: 19px;
        viewbox-width: 11;
        viewbox-height: 19;
        commands: "M0 0 L11 0 L11 13 L5.5 19 L0 13 Z";
        fill: ta.pressed ? #cccccc : (Theme.hover-fx && ta.has-hover) ? #171717 : Theme.accent;
    }
    ta := TouchArea {
        function set-from(px: length) {
            let v = clamp(root.minimum + (px - 5px) / root.usable * (root.maximum - root.minimum), root.minimum, root.maximum);
            if (!root.controlled) {
                root.value = v;
            }
            root.changed(v);
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                self.set-from(self.mouse-x);
            } else if (e.kind == PointerEventKind.up) {
                root.released(root.value);
            }
        }
        moved => {
            if (self.pressed) {
                self.set-from(self.mouse-x);
            }
        }
    }
    HoverTip { y: parent.height; hovered: ta.has-hover && !ta.pressed; text: root.tip != "" ? root.tip : @tr("Valeur : ") + round(root.value); }

}

/// Case à cocher Windows 10.
export component W10CheckBox inherits Rectangle {
    in-out property <bool> checked;
    in property <string> tip;
    /// case seulement montrée (menus) : le clic revient à l'élément qui la contient
    in property <bool> passive;
    callback toggled(bool);
    /// bascule (clic sur la case ou sur son libellé)
    public function toggle() {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }
    property <string> tip-text: root.tip;
    Timer {
        interval: 600ms;
        running: ta.has-hover && !ta.pressed && root.tip-text != "" && !(Tip.shown && Tip.text == root.tip-text);
        triggered => {
            Tip.text = root.tip-text;
            Tip.x = root.absolute-position.x;
            Tip.y = root.absolute-position.y + root.height + 4px;
            Tip.shown = true;
        }
    }
    width: Theme.win7 ? 13px : 15px;
    height: Theme.win7 ? 13px : 15px;
    border-radius: Theme.classic ? 0px : max(0px, Theme.ctl-radius - 1px);
    // 7.css : case #f6f6f6 bordée de #8e8f8f, creux en dégradé, ✔ #4a5f97 ; XP.css : bord #1d5281,
    // dégradé 135° #dcdcd7 → blanc, coche verte (checkmark.svg), survol orangé
    background: Theme.win7 ? (Theme.dark ? #3a3d42 : #f4f4f4) : Theme.xp ? (Theme.gloss ? @linear-gradient(135deg, #dcdcd7 0%, #ffffff 100%) : #ffffff)
        : checked && !Theme.win98 ? Theme.accent : Theme.field-bg;
    border-width: Theme.win98 ? 0px : 1px;
    border-color: Theme.win7 ? ((Theme.hover-fx && ta.has-hover) ? Theme.w7-ctl-bd : #8e8f8f) : Theme.xp ? #1d5281
        : checked ? Theme.accent : ((Theme.hover-fx && ta.has-hover) ? Theme.accent : #333333);
    if Theme.win98: Bevel {
        sunken: true;
    }
    if Theme.win7: Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        // creux clair de la case Windows 7 (dégradé en diagonale, liseré intérieur), teinté par
        // l'accentuation au survol
        border-width: 1px;
        border-color: Theme.dark ? #55585e : (Theme.hover-fx && ta.has-hover) ? Theme.w7-ctl-3 : #c4c7cb;
        background: !Theme.gloss ? (Theme.dark ? #33363b : (Theme.hover-fx && ta.has-hover) ? Theme.w7-ctl-1 : #ffffff)
            : Theme.dark ? @linear-gradient(135deg, #2a2c30 0%, #3c3f45 100%)
            : (Theme.hover-fx && ta.has-hover) ? @linear-gradient(135deg, Theme.w7-ctl-3 0%, Theme.w7-ctl-1 55%, #ffffff 100%)
            : @linear-gradient(135deg, #d6d8db 0%, #f0f1f2 50%, #ffffff 100%);
    }
    // coche de Windows 7 : trait fin bleu nuit
    if checked && Theme.win7: Path {
        x: 1px;
        y: 1px;
        width: 11px;
        height: 11px;
        viewbox-width: 11;
        viewbox-height: 11;
        commands: "M2 5.5 L4.5 8.5 L9 2.5";
        stroke: Theme.dark ? #e8ecf2 : #1f3566;
        stroke-width: 1.7px;
        fill: transparent;
    }
    if Theme.xp && Theme.hover-fx && ta.has-hover: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-width: 2px;
        border-color: #fbc761;
    }
    if checked && !Theme.classic: FaIcon {
        glyph: "\u{f00c}";
        size: 10px;
        color: Theme.win98 ? Theme.text : Theme.win7 ? Theme.accent : Theme.on-accent;
    }
    if checked && Theme.xp: Image {
        x: 2px;
        y: 2px;
        width: 11px;
        height: 11px;
        source: @image-url("skins/xp/checkmark.png");
        image-rendering: pixelated;
    }
    ta := TouchArea {
        enabled: !root.passive;
        clicked => {
            Tip.shown = false;
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
        changed has-hover => {
            if (!self.has-hover && Tip.text == root.tip-text) {
                Tip.shown = false;
            }
        }
    }
}

/// Liste déroulante Windows 10 (champ blanc, chevron).
/// Petit drapeau d'une langue (0 français, 1 anglais, 2 espagnol, 3 allemand, 4 italien,
/// 5 portugais), dessiné en aplats (pas d'émoji : la police de l'interface n'en a pas).
export component LangFlag inherits Rectangle {
    in property <int> lang;
    width: 18px;
    height: 12px;
    clip: true;
    border-radius: 2px;
    if root.lang == 0 || root.lang == 4: HorizontalLayout {
        Rectangle { background: root.lang == 0 ? #0055a4 : #009246; }
        Rectangle { background: #ffffff; }
        Rectangle { background: root.lang == 0 ? #ef4135 : #ce2b37; }
    }
    if root.lang == 5: HorizontalLayout {
        Rectangle { horizontal-stretch: 2; background: #006600; }
        Rectangle { horizontal-stretch: 3; background: #ff0000; }
    }
    if root.lang == 3: VerticalLayout {
        Rectangle { background: #000000; }
        Rectangle { background: #dd0000; }
        Rectangle { background: #ffce00; }
    }
    if root.lang == 2: VerticalLayout {
        Rectangle { vertical-stretch: 1; background: #aa151b; }
        Rectangle { vertical-stretch: 2; background: #f1bf00; }
        Rectangle { vertical-stretch: 1; background: #aa151b; }
    }
    // Union Jack simplifié : croix rouge sur liseré blanc
    if root.lang == 1: Rectangle {
        background: #012169;
        Rectangle { x: 7px; y: 0; width: 4px; height: parent.height; background: #ffffff; }
        Rectangle { x: 0; y: 4px; width: parent.width; height: 4px; background: #ffffff; }
        Rectangle { x: 8px; y: 0; width: 2px; height: parent.height; background: #c8102e; }
        Rectangle { x: 0; y: 5px; width: parent.width; height: 2px; background: #c8102e; }
    }
    Rectangle {
        border-width: 1px;
        border-color: #00000030;
        border-radius: 2px;
        background: transparent;
    }
}

export component W10ComboBox inherits Rectangle {
    in property <string> tip;
    in property <[string]> model;
    /// liste des langues : petit drapeau devant chaque nom (indice = langue)
    in property <bool> flags;
    in-out property <int> current-index: 0;
    callback selected(int);
    pure function classic-sel(blue: bool, hover: bool, current: bool) -> brush {
        if (blue) {
            return Theme.win7 ? Theme.accent : Theme.xp-t1;
        }
        if (Theme.classic) {
            return transparent;
        }
        return (Theme.hover-fx && hover) ? Theme.accent-14 : current ? Theme.accent-12 : transparent;
    }
    height: 22px;
    // même arrondi que sa liste déroulante (le champ paraissait plus carré que la liste)
    border-radius: Theme.classic ? 0px : Theme.ctl-radius > 0 ? Theme.ctl-radius + 2px : 0px;
    // 7.css : liste = bouton en dégradé + flèche ; XP.css : champ blanc bordé de #7f9db9 + bouton
    // bleu (dropdown*.svg)
    background: Theme.win7 ? transparent : Theme.field-bg;
    border-width: Theme.win98 || Theme.win7 ? 0px : 1px;
    border-color: Theme.xp ? Theme.field-border : (Theme.hover-fx && ta.has-hover) ? Theme.accent : Theme.field-border;
    if Theme.win98: Bevel {
        sunken: true;
    }
    if Theme.win7: ClassicFace {
        width: parent.width;
        height: parent.height;
        hover: ta.has-hover;
        pressed: ta.pressed;
    }
    if Theme.win7: Image {
        x: parent.width - 19px;
        y: (parent.height - 17px) / 2;
        width: 16px;
        height: 17px;
        source: @image-url("skins/win7/dropdown-arrow.png");
        colorize: Theme.dark ? #e8e8e8 : #000000;
        image-rendering: pixelated;
    }
    if Theme.xp: Image {
        x: parent.width - 17px;
        y: (parent.height - 17px) / 2;
        width: 15px;
        height: 17px;
        source: ta.pressed ? @image-url("skins/xp/dropdown-active.png") : (Theme.hover-fx && ta.has-hover) ? @image-url("skins/xp/dropdown-hover.png") : @image-url("skins/xp/dropdown.png");
        image-rendering: pixelated;
    }
    if Theme.win98: Rectangle {
        border-radius: Theme.ctl-radius;
        x: parent.width - 18px;
        y: 2px;
        width: 16px;
        height: parent.height - 4px;
        background: Theme.button-bg;
        Bevel {
            sunken: ta.pressed;
        }
    }
    if root.flags: LangFlag {
        x: 7px;
        y: (parent.height - self.height) / 2;
        lang: root.current-index;
    }
    Text {
        x: root.flags ? 31px : 7px;
        width: parent.width - (root.flags ? 50px : 26px);
        height: parent.height;
        text: root.model[root.current-index];
        font-size: Theme.font-size;
        color: Theme.win7 ? Theme.button-fg : Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    if !Theme.classic: FaIcon {
        x: parent.width - 18px;
        width: 14px;
        height: parent.height;
        glyph: "\u{f078}";
        size: 9px;
    }
    ta := TouchArea {
        clicked => {
            popup.show();
        }
    }
    popup := PopupWindow {
        // fond qui capte le pointeur : le curseur de la toile ne reste pas sur le volet
        TouchArea { }
        x: 0;
        y: root.height;
        width: root.width;
        Rectangle {
            background: Theme.field-bg;
            border-width: 1px;
            border-color: Theme.field-border;
            border-radius: Theme.classic ? 0px : Theme.ctl-radius > 0 ? Theme.ctl-radius + 2px : 0px;
            drop-shadow-blur: Theme.win98 ? 0px : 8px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: Theme.shadows ? (Theme.window-shadow) : transparent;
            VerticalLayout {
                padding: 3px;
                for item[i] in root.model: Rectangle {
                    height: 22px;
                    border-radius: Theme.classic ? 0px : Theme.ctl-radius;
                    // Windows 7 / XP : ligne survolée en bleu plein, texte blanc (listes natives)
                    property <bool> blue: Theme.classic && (Theme.hover-fx ? ita.has-hover : i == root.current-index);
                    background: root.classic-sel(self.blue, ita.has-hover, i == root.current-index);
                    if root.flags: LangFlag {
                        x: 6px;
                        y: (parent.height - self.height) / 2;
                        lang: i;
                    }
                    Text {
                        x: root.flags ? 30px : 6px;
                        width: parent.width - (root.flags ? 36px : 12px);
                        height: parent.height;
                        text: item;
                        font-size: Theme.font-size;
                        color: parent.blue ? #ffffff : Theme.text;
                        vertical-alignment: center;
                    }
                    ita := TouchArea {
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                        }
                    }
                }
            }
        }
    }
    HoverTip { y: parent.height; hovered: ta.has-hover && !ta.pressed; text: root.tip != "" ? root.tip : root.model[root.current-index]; }

}

/// Bouton de fermeture : rouge quand l'application est active (comme Paint.NET), gris sinon.
/// Windows 7 : bouton vitré rouge de 7.css (48 × 19, coins bas arrondis, lueur au survol) ;
/// Windows XP : croix de XP.css (close*.svg) ; ultra léger : simple croix sans fond.
export component CloseButton inherits Rectangle {
    in property <string> tip;
    /// fenêtre étroite : bouton Windows 7 à la largeur des autres boutons de titre (29 px)
    in property <bool> narrow;
    /// fenêtre au premier plan (sinon bouton éteint, comme une fenêtre d'arrière-plan)
    in property <bool> active: true;
    property <bool> on: Theme.app-active && root.active;
    callback clicked();
    property <bool> lit: Theme.hover-fx && ta.has-hover;
    width: Theme.c-98 ? 17px : Theme.c-w7 ? (root.narrow ? 31px : 50px) : Theme.c-xp ? 21px : Theme.close-size;
    height: Theme.c-98 ? 15px : Theme.c-w7 ? 20px : Theme.c-xp ? 21px : Theme.close-size;
    background: Theme.c-98 ? Theme.button-bg : Theme.c-classic ? transparent
        : Theme.c-lite ? (ta.pressed ? Theme.accent-20 : transparent)
        : !root.on ? Theme.close-inactive : root.lit ? Theme.close-hover : Theme.close-bg;
    if Theme.c-w7: Rectangle {
        border-bottom-left-radius: 5px * Theme.round;
        border-bottom-right-radius: 5px * Theme.round;
        clip: true;
        // fenêtre inactive : bouton sans couleur (#fff3), comme 7.css hors de .active
        background: !root.on ? #ffffff33
            : !Theme.gloss ? (ta.pressed ? #9c2a14 : root.lit ? #e04a2c : #c94b33)
            : ta.pressed ? @linear-gradient(180deg, #d1a894 0%, #b67562 25%, #b67562 50%, #7d0d01 50%, #7d0d01 100%)
            : root.lit ? @linear-gradient(180deg, #fb9d8b 0%, #ee6d56 25%, #ee6d56 50%, #d42809 50%, #d42809 100%)
            : @linear-gradient(180deg, #e0a197e5 0%, #cf796a 25%, #cf796a 50%, #d54f36 50%, #d54f36 100%);
        drop-shadow-blur: root.on && root.lit && Theme.gloss ? 7px : 0px;
        drop-shadow-color: #e68e75;
        // ombres des bords (radial-gradient à -60 % et 160 %)
        if root.on && Theme.gloss: Rectangle {
            background: @linear-gradient(90deg, #00000038 0%, #00000000 22%, #00000000 78%, #00000038 100%);
        }
        // reflet vitré (--w7-wct-bg)
        if Theme.gloss: Rectangle {
            background: @linear-gradient(180deg, #ffffff80 0%, #ffffff4d 45%, #0000001a 50%, #0000001a 75%, #ffffff80 100%);
        }
        // lueur jaune du bas au survol (radial-gradient circle at 50% 170%, #f4e676)
        if root.on && Theme.gloss && (root.lit || ta.pressed): Rectangle {
            x: parent.width * 0.1;
            y: parent.height * 0.45;
            width: parent.width * 0.8;
            height: parent.height * 1.1;
            background: @radial-gradient(circle, (ta.pressed ? #dcc03f : #f4e676) 0%, #f4e67600 70%);
        }
        // liseré blanc intérieur (--w7-wct-sd), puis bord #000000b3 (#0000004d inactif)
        Rectangle {
            x: 1px;
            y: 0;
            width: parent.width - 2px;
            height: parent.height - 1px;
            border-bottom-left-radius: 4px * Theme.round;
            border-bottom-right-radius: 4px * Theme.round;
            border-width: 1px;
            border-color: Theme.gloss ? #ffffffaa : #ffffff55;
        }
        Rectangle {
            border-bottom-left-radius: 5px * Theme.round;
            border-bottom-right-radius: 5px * Theme.round;
            border-width: 1px;
            border-color: root.on ? #000000b3 : #0000004d;
        }
    }
    if Theme.c-w7: Image {
        x: round((parent.width - 11px) / 2 / 1px) * 1px;
        y: round((parent.height - 10px) / 2 / 1px) * 1px;
        width: 11px;
        height: 10px;
        source: @image-url("skins/win7/close.png");
        image-rendering: pixelated;
    }
    // XP sans relief : carré rouge uni bordé de blanc, croix blanche
    if Theme.c-xp && !Theme.gloss: Rectangle {
        width: 21px;
        height: 21px;
        border-radius: 3px * Theme.round;
        border-width: 1px;
        border-color: #ffffff;
        background: ta.pressed ? #a8361a : root.lit ? #e8603d : #d24e2b;
        SignGlyph { kind: "close"; size: 9px; thick: 2px; background: transparent; tint: #ffffff; }
    }
    if Theme.c-xp && Theme.gloss: Image {
        width: 21px;
        height: 21px;
        source: ta.pressed ? @image-url("skins/xp/close-active.png") : root.lit ? @image-url("skins/xp/close-hover.png") : @image-url("skins/xp/close.png");
        image-rendering: pixelated;
    }
    // glyphe direct, jamais remplacé par un pack : la croix d'un pack (paintdotjs : petit « x »
    // rouge dans une grande marge) disparaissait sur le fond rouge
    if !Theme.c-classic: Text {
        text: "\u{f00d}";
        font-family: Theme.icon-font;
        font-weight: 900;
        font-size: Theme.c-98 ? 10px : 11px;
        color: Theme.c-98 || Theme.c-lite ? Theme.text : #ffffff;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    if Theme.c-98: Bevel {
        sunken: ta.pressed;
    }
    HoverTip { y: parent.height; hovered: ta.has-hover && !ta.pressed; text: @tr("Fermer"); }

}

/// Fenêtre volante Paint.NET (Outils, Couleurs, Calques, Historique) : déplaçable par
/// sa barre de titre, ramenée au premier plan au clic.
/// Pile des fenêtres flottantes : une fenêtre prend le rang le plus haut à son ouverture et quand
/// on appuie dessus. L'appui est observé à la source (lib.rs, évènements de la fenêtre) : les
/// boutons d'une fenêtre gardent ainsi leur clic, et elle passe quand même devant.
export global WinStack {
    in-out property <int> top: 100;
    in-out property <length> press-x;
    in-out property <length> press-y;
    in-out property <int> press-serial;
    /// rang le plus haut parmi les fenêtres sous l'appui (0 : aucune)
    in-out property <int> hit;
    in-out property <int> commit-serial;
    /// rang de la fenêtre flottante active (0 : aucune, la fenêtre principale a la main)
    in-out property <int> active;
}

export component FloatWindow inherits Rectangle {
    in property <string> title;
    /// Masquer la fermeture pendant une opération sans annulation.
    in property <bool> closable: true;
    /// verrouillée (aucun projet ouvert) : contenu grisé et inactif, la fenêtre reste déplaçable
    in property <bool> locked;
    /// rang dans la pile des fenêtres : la valeur de `z` de chaque fenêtre
    out property <int> rank;
    /// fenêtre active : la dernière sur laquelle on a appuyé (ou ouverte) ; un appui hors de toute
    /// fenêtre flottante rend la main à la fenêtre principale, et l'application en arrière-plan
    /// éteint tout. Les panneaux ancrés font partie de la fenêtre principale : toujours actifs.
    out property <bool> active: Theme.app-active && (root.docked || root.sheet || root.mob || WinStack.active == root.rank);
    function raise() {
        if (root.rank != WinStack.top) {
            WinStack.top += 1;
            root.rank = WinStack.top;
        }
        WinStack.active = root.rank;
    }
    property <int> press-seen: WinStack.press-serial;
    changed press-seen => {
        if (!root.docked && root.rank > WinStack.hit
            && WinStack.press-x >= self.absolute-position.x && WinStack.press-x < self.absolute-position.x + self.width
            && WinStack.press-y >= self.absolute-position.y && WinStack.press-y < self.absolute-position.y + self.height) {
            WinStack.hit = root.rank;
        }
    }
    property <int> commit-seen: WinStack.commit-serial;
    changed commit-seen => {
        if (WinStack.hit == root.rank) {
            root.raise();
        } else if (WinStack.hit == 0 && WinStack.active == root.rank) {
            WinStack.active = 0;
        }
    }
    in property <length> bounds-width: 10000px;
    in property <length> bounds-height: 10000px;
    /// fenêtre gardée entière dans les bornes (palettes : jamais sur la frise d'animation)
    in property <bool> keep-inside;
    /// Modal settings may also use the space above the workspace, within min-y.
    in property <bool> full-window-area;
    /// redimensionnable en hauteur (poignées sur les bords haut et bas)
    in property <bool> resizable;
    /// redimensionnable en largeur (bords gauche / droit ; coins si aussi en hauteur)
    in property <bool> resizable-w;
    in property <length> min-window-width: 120px;
    in property <length> max-window-width: 100000px;
    /// fin d'un déplacement ou d'un redimensionnement (palettes : géométrie enregistrée)
    callback geometry-changed();
    /// mode téléphone : panneau du bas comme la version web (coins arrondis, poignée à la place
    /// de la barre de titre, bouton « Fermer » en bas si `sheet-footer`)
    in property <bool> sheet;
    in property <bool> sheet-footer: true;
    /// mode téléphone : jamais de barre de titre de bureau (croix rouge carrée) ; en-tête de page
    /// mobile (titre centré, bouton fermer rond, poignée si panneau du bas)
    property <bool> mob: PhoneDock.on && !root.sheet;
    property <length> head-h: root.sheet ? 18px : root.mob ? (root.docked ? 46px : 50px) : Theme.title-height + (root.framed && Theme.f-w7 ? 1px : 0px);
    /// Windows 7 / XP : cadre épais autour du contenu (7.css : bord 1 px + marge 6 px + bord du
    /// corps ; XP.css : trois liserés bleus). Les côtés du cadre sont dessinés HORS de la fenêtre
    /// (`ext` de chaque côté) : sa largeur, celle que lisent les contenus (`parent.width`), et la
    /// zone de contenu restent celles du style moderne ; le cache de rendu englobe ces débords.
    /// En hauteur, la fenêtre grandit de la barre de titre et du bas du cadre.
    property <bool> framed: Theme.f-classic && !root.sheet && !root.mob && !root.docked;
    property <length> frame-in: !root.framed ? 1px : Theme.f-w7 ? 8px : 3px;
    property <length> ext: root.framed ? root.frame-in - 1px : 0px;
    /// écart aux bords de l'espace de travail à l'aimantation : 8 px de vide AU-DELÀ du cadre
    property <length> gap-l: 8px + root.ext;
    property <length> grow-h: root.framed ? root.frame-in - 1px + root.head-h - 26px : 0px;
    property <length> foot-h: root.sheet && root.sheet-footer ? 50px : 0px;
    /// hauteur de la zone de contenu (sous la barre de titre) : à utiliser pour ancrer en bas
    out property <length> content-height: root.height - root.head-h - root.foot-h - (root.framed ? root.frame-in : root.sheet || root.mob || root.docked || Theme.f-98 ? 0px : 1px);
    in property <length> min-window-height: 100px;
    /// position la plus haute (négative : la fenêtre peut monter sur le ruban et les menus)
    in property <length> min-y: 0px;
    /// bord gauche de la zone utile (règles affichées : la palette ne les recouvre pas)
    in property <length> min-x: 0px;
    /// palettes : aimantation vers leur place d'origine (`home-x`, `home-y`) et vers les bords
    /// de l'espace de travail quand on les en approche
    in property <bool> snap-home;
    in property <length> home-x;
    in property <length> home-y;
    /// hauteur d'origine (palettes redimensionnables) ; négative : inchangée à la réinitialisation
    in property <length> home-h: -1px;
    property <int> reset-seen: Workspace.reset;
    changed reset-seen => {
        if (root.snap-home) {
            root.float-x = root.home-x;
            root.float-y = root.home-y;
            if (root.home-h > 0px) {
                root.float-h = root.home-h;
            }
        }
    }
    // position visée pendant un glisser (avant aimantation)
    property <length> drag-nx;
    property <length> drag-ny;
    // position et taille en mode flottant (le glisser les modifie), ou imposées quand la
    // fenêtre est ancrée dans une colonne (disposition Photoshop)
    in-out property <length> float-x;
    in-out property <length> float-y;
    in-out property <length> float-w: 200px;
    in-out property <length> float-h: 200px;
    in property <bool> docked;
    /// disposition Photoshop : barre de titre façon panneau du téléphone (poignée centrée en
    /// haut, titre plus petit, croix discrète) ; seulement quand la fenêtre est ancrée
    in property <bool> grip;
    // présentation Photoshop (PhotoCraft) : panneau ancré à en-tête en onglet
    property <bool> ps-tab: Theme.reference-style == 3 && root.docked && !root.sheet && !Theme.f-98;
    property <bool> grip-on: root.grip && root.docked && !root.sheet && !Theme.f-98 && !Theme.f-classic && !root.ps-tab;
    /// palette ancrée déplaçable dans sa colonne : glisser la barre de titre (`dock-drag` donne
    /// la position verticale du pointeur dans la zone de travail, `dock-drop` au relâchement)
    in property <bool> dock-movable;
    callback dock-drag(length);
    callback dock-drop(length);
    property <bool> dock-moved;
    in property <length> dock-x;
    in property <length> dock-y;
    in property <length> dock-w;
    in property <length> dock-h;
    // téléphone : posée en bas, toute la largeur, non déplaçable (au plus 62 % de la hauteur :
    // le ruban reste visible) ; écran plus étroit que la fenêtre : réduite et collée à gauche
    property <bool> auto-dock: PhoneDock.on && !root.docked && !root.sheet;
    // position bornée à la zone (fenêtre principale réduite : la palette reste atteignable)
    // calée sur les pixels de l'écran : une fenêtre centrée tombait sur un demi-pixel (fenêtre du
    // navigateur de largeur impaire, zoom) et tout son contenu était flou
    x: round((root.docked ? root.dock-x : root.auto-dock ? 0px : root.float-w >= root.bounds-width ? 0px
        : clamp(root.float-x, root.min-x - root.width + 40px, max(root.min-x, root.bounds-width - 40px))) / 1phx) * 1phx;
    y: round((root.docked ? root.dock-y : root.auto-dock ? root.bounds-height - self.height - PhoneDock.inset : root.float-h >= root.bounds-height - (root.full-window-area ? root.min-y : 0px) ? (root.full-window-area ? root.min-y : 0px)
        : clamp(root.float-y, root.min-y, max(root.min-y, root.bounds-height - (root.keep-inside ? self.height : Theme.title-height)))) / 1phx) * 1phx;
    width: root.docked ? root.dock-w : root.auto-dock ? root.bounds-width : min(root.float-w, root.bounds-width);
    height: root.docked ? root.dock-h : root.auto-dock ? min(min(root.float-h, (root.bounds-height - PhoneDock.inset) * 0.62), PhoneDock.max-h) : min(root.float-h + root.grow-h, root.bounds-height - (root.full-window-area ? root.min-y : 0px));
    // ancrée (Photoshop) : le contenu ne déborde jamais sur la palette voisine
    clip: root.docked;
    // fenêtre gardée en texture : déplacée ou simplement affichée, elle ne coûte qu'un seul tracé
    cache-rendering-hint: !PhoneDock.on;
    changed height => {
        if (root.auto-dock) {
            PhoneDock.sheet-h = self.height;
        }
    }
    init => {
        root.raise();
        if (root.auto-dock) {
            PhoneDock.sheet-h = self.height;
        }
    }
    callback close();
    property <bool> glass: Theme.title-transparent && !Theme.f-98 && !root.sheet && !root.mob && !root.docked;
    /// Windows 10/11 : barre de titre à la couleur d'accentuation (fenêtre active seulement)
    property <bool> acc-title: Theme.title-accent && Theme.frame-skin == 0 && root.active && Theme.app-active && !root.docked && !root.sheet && !root.mob;
    // barre de titre translucide : le fond de la fenêtre ne commence que sous elle
    background: root.sheet || root.mob ? Theme.mob-surface : root.glass || root.framed ? transparent : Theme.window-bg;
    border-radius: root.sheet || (root.mob && !root.docked) ? 16px : root.docked ? 0px : Theme.window-radius;
    border-width: Theme.f-98 || root.framed || root.sheet || root.mob ? 0px : 1px;
    border-color: Theme.window-border;
    // 7.css : box-shadow 2px 2px 10px 1px #000000b3 ; XP.css : aucune ombre
    // Windows 7 / XP : l'ombre est portée par le cadre (plus large que la fenêtre)
    // relief 3D coupé (style Windows 8) : ombre courte
    drop-shadow-blur: !Theme.shadows ? 0px : root.sheet || (root.mob && !root.docked) ? 14px : Theme.f-98 || root.docked || root.framed ? 0px : Theme.gloss ? 10px : 5px;
    drop-shadow-offset-y: root.sheet || root.mob ? -2px : 2px;
