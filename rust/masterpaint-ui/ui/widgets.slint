    if root.locked: Rectangle {
        y: root.head-h;
        height: root.content-height;
        background: Theme.window-bg.with-alpha(0.72);
        // capte clics et molette : rien n'atteint le contenu
        TouchArea {
            mouse-cursor: not-allowed;
        }
    }
    if root.sheet && root.sheet-footer: Rectangle {
        y: root.height - 50px;
        height: 50px;
        Rectangle {
            y: 0;
            height: 1px;
            background: Theme.mob-divider;
        }
        Rectangle {
            y: 9px;
            width: min(320px, parent.width - 32px);
            height: 32px;
            border-radius: 16px * Theme.round;
            background: sfta.pressed ? Theme.accent.with-alpha(0.32) : Theme.accent.with-alpha(0.2);
            Text {
                text: @tr("Fermer");
                font-size: 15px;
                font-weight: 700;
                color: Theme.accent;
            }
            sfta := TouchArea {
                clicked => {
                    root.close();
                }
            }
        }
    }
    // ---- redimensionnement : bords (5 px) et coins (8 px, par-dessus les bords) ----
    property <bool> can-h: root.resizable && !root.docked && !root.auto-dock && !root.sheet;
    property <bool> can-w: root.resizable-w && !root.docked && !root.auto-dock && !root.sheet;
    // déplacement d'un bord (dx / dy depuis l'appui) ; le bord opposé reste en place
    function drag-left(dx: length) {
        root.drag-nx = clamp(root.x + dx, max(root.min-x, root.x + root.width - root.max-window-width), root.x + root.width - root.min-window-width);
        root.float-w = root.x + root.width - root.drag-nx;
        root.float-x = root.drag-nx;
    }
    function drag-right(dx: length) {
        root.float-w = clamp(root.width + dx, root.min-window-width, max(root.min-window-width, min(root.max-window-width, root.bounds-width - root.x)));
    }
    function drag-top(dy: length) {
        root.drag-ny = clamp(root.y + dy, root.min-y, root.y + root.height - root.min-window-height);
        root.float-h = root.y + root.height - root.drag-ny;
        root.float-y = root.drag-ny;
    }
    function drag-bottom(dy: length) {
        root.float-h = clamp(root.height + dy, root.min-window-height, max(root.min-window-height, root.bounds-height - root.y));
    }
    if root.resizable && !root.docked: TouchArea {
        y: root.height - 5px;
        height: 6px;
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                root.geometry-changed();
            }
        }
        moved => {
            if (self.pressed) {
                root.drag-bottom(self.mouse-y - self.pressed-y);
            }
        }
    }
    // par le haut : le bas reste en place
    if root.can-h: TouchArea {
        y: 0;
        height: 5px;
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                root.geometry-changed();
            }
        }
        moved => {
            if (self.pressed) {
                root.drag-top(self.mouse-y - self.pressed-y);
            }
        }
    }
    if root.can-w: TouchArea {
        x: 0;
        width: 5px;
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                root.geometry-changed();
            }
        }
        moved => {
            if (self.pressed) {
                root.drag-left(self.mouse-x - self.pressed-x);
            }
        }
    }
    if root.can-w: TouchArea {
        x: root.width - 5px;
        width: 5px;
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                root.geometry-changed();
            }
        }
        moved => {
            if (self.pressed) {
                root.drag-right(self.mouse-x - self.pressed-x);
            }
        }
    }
    if root.can-w && root.can-h: TouchArea {
        x: 0;
        y: 0;
        width: 8px;
        height: 8px;
        mouse-cursor: nwse-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                root.geometry-changed();
            }
        }
        moved => {
            if (self.pressed) {
                root.drag-left(self.mouse-x - self.pressed-x);
                root.drag-top(self.mouse-y - self.pressed-y);
            }
        }
    }
    if root.can-w && root.can-h: TouchArea {
        x: root.width - 8px;
        y: 0;
        width: 8px;
        height: 8px;
        mouse-cursor: nesw-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                root.geometry-changed();
            }
        }
        moved => {
            if (self.pressed) {
                root.drag-right(self.mouse-x - self.pressed-x);
                root.drag-top(self.mouse-y - self.pressed-y);
            }
        }
    }
    if root.can-w && root.can-h: TouchArea {
        x: 0;
        y: root.height - 8px;
        width: 8px;
        height: 8px;
        mouse-cursor: nesw-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                root.geometry-changed();
            }
        }
        moved => {
            if (self.pressed) {
                root.drag-left(self.mouse-x - self.pressed-x);
                root.drag-bottom(self.mouse-y - self.pressed-y);
            }
        }
    }
    if root.can-w && root.can-h: TouchArea {
        x: root.width - 8px;
        y: root.height - 8px;
        width: 8px;
        height: 8px;
        mouse-cursor: nwse-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                root.geometry-changed();
            }
        }
        moved => {
            if (self.pressed) {
                root.drag-right(self.mouse-x - self.pressed-x);
                root.drag-bottom(self.mouse-y - self.pressed-y);
            }
        }
    }
}

/// Mode téléphone : les fenêtres volantes se posent en bas, sur toute la largeur, sans
/// déplacement (comme la version web) ; `sheet-h` = hauteur de la fenêtre posée, pour cadrer
/// la toile au-dessus.
export global PhoneDock {
    in-out property <bool> on;
    in-out property <length> sheet-h;
    /// barre du bas (Filtre, Ajuster…), flottante sur la toile : les fenêtres se posent
    /// au-dessus (hauteur réelle de la barre, donnée par la fenêtre principale)
    in-out property <length> inset: on ? 66px : 0px;
    /// hauteur maximale d'un panneau du bas : il s'arrête sous le ruban et la bande d'outils
    in-out property <length> max-h: 100000px;
}

/// Info-bulle commune : nom du bouton survolé sans bouger (comme les title HTML). Chaque bouton
/// la renseigne après un court délai ; la fenêtre principale l'affiche par-dessus tout.
export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> shown;
}

/// Ruban trop large pour la fenêtre (comme la version web) : les libellés des boutons
/// disparaissent et les jauges rétrécissent.
/// Fenêtre › Réinitialiser le bureau : chaque palette revient à sa place (et sa hauteur)
/// d'origine quand `reset` change (une palette déplacée n'écoute plus ses liaisons de position).
export global Workspace {
    in-out property <int> reset;
}

/// Ruban adaptatif (comme Office) : palier choisi selon la largeur disponible (AppWindow.rib-step).
/// 0 : tout déplié, libellés en plus (Intersection / OU exclusif, Affichage) ; 1 à 3 : ces
/// libellés puis ceux de Copier / Coller disparaissent ; 4 : plus aucun libellé, jauges
/// raccourcies ; 5 à 11 : les groupes se replient en menus, du moins utile au plus utile
/// (Alignement, Affichage, Image, Symétrie, Édition, Pinceau, Sélection). Au-delà : défilement.
export global RibbonFit {
    in-out property <int> level;
    out property <bool> tight: level >= 4;
}

/// Jauge du ruban MasterPaint : « Libellé  −  [barre remplie   valeur]  + ».
/// La barre se règle aussi en glissant dessus.
export component Gauge inherits HorizontalLayout {
    in property <string> label;
    /// info-bulle (par défaut : le libellé de la jauge)
    in property <string> tip;
    property <string> tip-text: root.tip != "" ? root.tip : root.label;
    in property <float> minimum: 1;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <bool> progressive;
    property <float> ratio: clamp((root.value - root.minimum)/max(0.0001,root.maximum - root.minimum),0,1);
    in property <length> label-width: 42px;
    in property <length> bar-width: 100px;
    in property <string> unit;
    in-out property <float> value: 10;
    callback changed(float);
    spacing: 4px;
    height: 22px;
    function set(v: float) {
        root.value = clamp(round(v / root.step) * root.step, root.minimum, root.maximum);
        root.changed(root.value);
    }
    Timer {
        interval: 600ms;
        running: bta.has-hover && !bta.pressed && root.tip-text != "" && !(Tip.shown && Tip.text == root.tip-text);
        triggered => {
            Tip.text = root.tip-text;
            Tip.x = root.absolute-position.x;
            Tip.y = root.absolute-position.y + root.height + 4px;
            Tip.shown = true;
        }
    }
    if root.label != "": Text {
        width: root.label-width;
        text: root.label;
        font-size: Theme.font-size;
        color: Theme.ribbon-fg;
        vertical-alignment: center;
    }
    Rectangle {
        width: 16px;
        border-radius: Theme.ctl-radius;
        background: (Theme.hover-fx && mta.has-hover) ? Theme.accent-12 : transparent;
        SignGlyph { kind: "minus"; size: 9px; tint: Theme.ribbon-fg; }
        HoverTip { y: parent.height; hovered: mta.has-hover && !mta.pressed; text: @tr("Réduire la valeur"); }
        mta := TouchArea {
            clicked => {
                root.set(root.value - root.step);
            }
        }
    }
    Rectangle {
        width: RibbonFit.tight ? min(root.bar-width, 64px) : root.bar-width;
        border-radius: Theme.ctl-radius;
        // Windows 7 / XP : glissière (rainure + poignée de 7.css / XP.css), valeur à droite
        property <length> tw: self.width;
        background: Theme.classic ? transparent : Theme.field-bg;
        border-width: Theme.classic ? 0px : 1px;
        border-color: (Theme.hover-fx && bta.has-hover) ? Theme.accent : Theme.field-border;
        if !Theme.classic: Rectangle {
            x: 1px;
            y: 1px;
            height: parent.height - 2px;
            width: (parent.width - 2px) * (root.progressive ? sqrt(root.ratio) : root.ratio);
            border-radius: max(0px, Theme.ctl-radius - 1px);
            background: Theme.accent-32;
        }
        if Theme.classic: TrackSkin {
            width: parent.tw;
            ratio: root.progressive ? sqrt(root.ratio) : root.ratio;
            hover: bta.has-hover;
            pressed: bta.pressed;
        }
        gv := Text {
            x: 4px;
            width: parent.width - 8px;
            height: parent.height;
            text: (root.step < 1 ? round(root.value * 100) / 100 : round(root.value)) + root.unit;
            font-size: Theme.font-size;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        bta := TouchArea {
            mouse-cursor: ew-resize;
            function from-x(px: length) {
                let t=clamp(px / self.width,0,1);
                root.set(root.minimum + (root.progressive ? t*t : t) * (root.maximum - root.minimum));
            }
            changed has-hover => {
                if (!self.has-hover && Tip.text == root.tip-text) {
                    Tip.shown = false;
                }
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    Tip.shown = false;
                    self.from-x(self.mouse-x);
                }
            }
            moved => {
                if (self.pressed) {
                    self.from-x(self.mouse-x);
                }
            }
            scroll-event(e) => {
                root.set(root.value + (e.delta-y > 0 ? root.step : -root.step));
                accept
            }
        }
    }
    Rectangle {
        width: 16px;
        border-radius: Theme.ctl-radius;
        background: (Theme.hover-fx && pta.has-hover) ? Theme.accent-12 : transparent;
        SignGlyph { kind: "plus"; size: 9px; tint: Theme.ribbon-fg; }
        HoverTip { y: parent.height; hovered: pta.has-hover && !pta.pressed; text: @tr("Augmenter la valeur"); }
        pta := TouchArea {
            clicked => {
                root.set(root.value + root.step);
            }
        }
    }
}

/// Jauge des fenêtres (même style que celles du ruban) : « − [barre + valeur] + ».
/// Glisser ou molette pour régler ; double-clic sur la barre pour saisir la valeur.
/// Avec `gradient`, la barre montre ce que règle le curseur (luminosité, teinte, canal…).
export component GaugeBar inherits HorizontalLayout {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <bool> gradient;
    in property <brush> track;
    callback changed(float);
    property <bool> editing;
    property <float> ratio: clamp((root.value - root.minimum) / max(0.0001, root.maximum - root.minimum), 0, 1);
    pure function fmt(v: float) -> string {
        return root.step < 1 ? round(v * 100) / 100 : round(v);
    }
    function set(v: float) {
        root.changed(clamp(round(v / root.step) * root.step, root.minimum, root.maximum));
    }
    spacing: 2px;
    height: 22px;
    min-width: 80px;
    Rectangle {
        width: 16px;
        border-radius: Theme.ctl-radius;
        background: (Theme.hover-fx && mta.has-hover) ? Theme.accent-12 : transparent;
        SignGlyph { kind: "minus"; size: 9px; tint: Theme.text; }
        HoverTip { y: parent.height; hovered: mta.has-hover && !mta.pressed; text: @tr("Réduire la valeur"); }
        mta := TouchArea {
            clicked => {
                root.set(root.value - root.step);
            }
        }
    }
    Rectangle {
        horizontal-stretch: 1;
        border-radius: Theme.classic ? 3px * Theme.round : Theme.ctl-radius;
        clip: !self.skin;
        // Windows 7 / XP : glissière (rainure + poignée), valeur à droite
        property <bool> skin: Theme.classic && !root.gradient;
        property <length> tw: self.width;
        background: root.gradient ? root.track : self.skin ? transparent : Theme.field-bg;
        border-width: self.skin || (root.gradient && Theme.classic && Theme.gloss) ? 0px : 1px;
        border-color: (Theme.hover-fx && bta.has-hover) || root.editing ? Theme.accent : Theme.field-border;
        if self.skin: TrackSkin {
            width: parent.tw;
            ratio: root.ratio;
            hover: bta.has-hover;
            pressed: bta.pressed;
        }
        if !root.gradient && !self.skin: Rectangle {
            x: 1px;
            y: 1px;
            height: parent.height - 2px;
            width: (parent.width - 2px) * root.ratio;
            border-radius: max(0px, Theme.ctl-radius - 1px);
            background: Theme.accent-32;
        }
        // 7 / XP : la barre en dégradé prend le verre de la barre de progression du style
        // (reflet clair en haut, cassure au milieu, bord du style) ; la couleur reste celle réglée
        if root.gradient && Theme.classic && Theme.gloss: Rectangle {
            border-radius: parent.border-radius;
            background: Theme.win7 ? @linear-gradient(180deg, #ffffff73 0%, #ffffff40 40%, #00000012 42%, #00000000 70%, #ffffff26 100%)
                : @linear-gradient(180deg, #ffffff40 0%, #ffffff66 45%, #ffffff1a 60%, #00000014 100%);
            border-width: 1px;
            border-color: Theme.win7 ? ((Theme.hover-fx && bta.has-hover) || bta.pressed ? Theme.w7-ctl-bd : Theme.dark ? #1e1f22 : #8e8f8f)
                : Theme.dark ? #5a5d63 : #686868;
        }
        // repère sur une barre en dégradé (7 / XP : petite poignée vitrée)
        if root.gradient: Rectangle {
            x: (parent.width - self.width) * root.ratio;
            width: Theme.classic ? 6px : 4px;
            background: Theme.classic && Theme.gloss ? @linear-gradient(180deg, #ffffff 0%, #f0f0f0 45%, #d8d8d8 55%, #ececec 100%) : #ffffff;
            border-width: 1px;
            border-color: Theme.classic ? (Theme.win7 ? #3c7fb1 : #1d5281) : #202020;
            border-radius: (Theme.classic ? 2px : 1px) * Theme.round;
        }
        if !root.editing: Rectangle {
            x: parent.width - self.width - 3px;
            y: 3px;
            width: vt.preferred-width + 6px;
            height: parent.height - 6px;
            border-radius: 2px * Theme.round;
            background: root.gradient ? Theme.field-bg.with-alpha(0.8) : transparent;
            vt := Text {
                text: root.fmt(root.value);
                font-size: Theme.font-size;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        bta := TouchArea {
            mouse-cursor: ew-resize;
            function from-x(px: length) {
                root.set(root.minimum + clamp(px / self.width, 0, 1) * (root.maximum - root.minimum));
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && !root.editing) {
                    self.from-x(self.mouse-x);
                }
            }
            moved => {
                if (self.pressed && !root.editing) {
                    self.from-x(self.mouse-x);
                }
            }
            double-clicked => {
                root.editing = true;
                ed.text = root.fmt(root.value);
                ed.focus();
                ed.select-all();
            }
            scroll-event(e) => {
                root.set(root.value + (e.delta-y > 0 ? root.step : -root.step));
                accept
            }
        }
        if root.editing: Rectangle {
            background: Theme.field-bg;
            border-radius: Theme.ctl-radius;
        }
        ed := TextInput {
            visible: root.editing;
            x: 4px;
            width: parent.width - 8px;
            height: parent.height;
            vertical-alignment: center;
            horizontal-alignment: right;
            color: Theme.text;
            font-size: Theme.font-size;
            single-line: true;
            accepted => {
                if (self.text.is-float()) {
                    root.set(self.text.to-float());
                }
                root.editing = false;
            }
            changed has-focus => {
                if (!self.has-focus && root.editing) {
                    if (self.text.is-float()) {
                        root.set(self.text.to-float());
                    }
                    root.editing = false;
                }
            }
        }
    }
    Rectangle {
        width: 16px;
        border-radius: Theme.ctl-radius;
        background: (Theme.hover-fx && pta.has-hover) ? Theme.accent-12 : transparent;
        SignGlyph { kind: "plus"; size: 9px; tint: Theme.text; }
        HoverTip { y: parent.height; hovered: pta.has-hover && !pta.pressed; text: @tr("Augmenter la valeur"); }
        pta := TouchArea {
            clicked => {
                root.set(root.value + root.step);
            }
        }
    }
}

/// Bouton à bascule du ruban (glyphe + libellé), coché à l'accent.
export component ToggleButton inherits Rectangle {
    in property <string> glyph;
    in property <int> weight: 900;
    in property <string> text;
    in property <bool> checked;
    in property <bool> compact;
    in property <bool> plain-font;  // glyphe Unicode ordinaire (formes géométriques)
    /// icône du sprite MasterPaint (prioritaire sur le glyphe)
    in property <image> img;
    /// info-bulle (par défaut : le texte d'un bouton compact)
    in property <string> tip;
    property <string> tip-text: root.tip != "" ? root.tip : Tips.desc(root.text) != "" ? Tips.desc(root.text) : root.text;
    callback clicked();
    height: 26px;
    width: compact ? 26px : (lbl.preferred-width + 30px);
    Timer {
        interval: 600ms;
        running: ta.has-hover && !ta.pressed && root.tip-text != "" && !(Tip.shown && Tip.text == root.tip-text);
        triggered => {
            Tip.text = root.tip-text;
            Tip.x = root.absolute-position.x;
            Tip.y = root.absolute-position.y + root.height + 4px;
            Tip.shown = true;
        }
    }
    border-radius: Theme.ctl-radius;
    background: Theme.b-classic ? transparent : ta.pressed ? Theme.tb-20 : checked ? Theme.tb-14 : (Theme.hover-fx && ta.has-hover) ? Theme.tb-12 : transparent;
    border-width: !Theme.b-classic && (checked || (Theme.hover-fx && ta.has-hover)) ? 1px : 0px;
    border-color: checked ? Theme.tb-edge : Theme.tb-60;
    if Theme.b-classic && (root.checked || ta.pressed || (Theme.hover-fx && ta.has-hover)): ClassicFace {
        width: parent.width;
        height: parent.height;
        hover: ta.has-hover;
        pressed: root.checked || ta.pressed;
        soft: true;
    }
    if root.img.width > 0: Image {
        x: root.compact ? (parent.width - self.width) / 2 : 5px;
        width: 16px;
        height: 16px;
        source: root.img;
    }
    if root.img.width == 0: GlyphIcon {
        x: root.compact ? (parent.width - self.width) / 2 : 6px;
        width: 14px;
        glyph: root.glyph;
        weight: root.weight;
        size: root.plain-font ? 14px : 12px;
        font-family: root.plain-font ? Theme.font : Theme.icon-font;
        tint: Theme.ribbon-fg;
    }
    lbl := Text {
        visible: !root.compact;
        x: 25px;
        text: root.text;
        font-size: Theme.font-size;
        color: Theme.ribbon-fg;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => {
            Tip.shown = false;
            root.clicked();
        }
        changed has-hover => {
            if (!self.has-hover && Tip.text == root.tip-text) {
                Tip.shown = false;
            }
        }
    }
}

/// Section d'une colonne (Paramètres, Aide et raccourcis) : même dessin partout — Panneau de
/// configuration en 7 / Vista / XP (clair et sombre), liseré d'accent sinon.
export component SideItem inherits Rectangle {
    in property <string> glyph;
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    property <bool> hov: Theme.hover-fx && ta.has-hover;
    height: 32px;
    border-radius: Theme.ctl-radius;
    background: Theme.side-skin
        ? (Theme.xp ? (root.selected ? (Theme.dark ? #ffffff30 : #ffffff) : root.hov ? (Theme.dark ? #ffffff18 : Theme.xp-bar-a) : (Theme.dark ? transparent : Theme.xp-menu-a))
            // Windows 7 : section choisie en surbrillance dorée, comme le ruban et les menus
            : root.selected ? (Theme.vista ? #ffffff38 : !Theme.gloss ? Theme.w7-hl-2 : @linear-gradient(180deg, Theme.w7-hl-1 0%, Theme.w7-hl-2 48%, Theme.w7-hl-3 52%, Theme.w7-hl-4 100%))
            : root.hov ? (Theme.vista || Theme.dark ? #ffffff1c : Theme.accent-12) : transparent)
        : root.selected ? Theme.accent-14 : root.hov ? Theme.accent-12 : transparent;
    border-width: Theme.side-skin && Theme.win7 && root.selected ? 1px : 0px;
    border-color: Theme.vista ? #ffffff60 : Theme.accent-60;
    // Windows 7 clair : texte bleu foncé sur l'or ; sombre : clair partout
    property <color> ink: Theme.side-skin ? (Theme.win7 && !Theme.vista && root.selected && Theme.dark ? #ffffff : Theme.side-link) : Theme.text;
    Rectangle {
        x: 0;
        y: 7px;
        width: 3px;
        height: parent.height - 14px;
        border-radius: 2px * Theme.round;
        background: root.selected && !Theme.side-skin ? Theme.accent : transparent;
    }
    GlyphIcon {
        x: 12px;
        y: round((parent.height - self.height) / 2 / 1px) * 1px;
        width: 18px;
        glyph: root.glyph;
        size: 13px;
        tint: Theme.side-skin ? root.ink : root.selected ? Theme.accent : Theme.text;
    }
    Text {
        x: 38px;
        width: parent.width - 42px;
        height: parent.height;
        text: root.text;
        font-weight: root.selected ? 600 : 400;
        color: root.ink;
        vertical-alignment: center;
        overflow: elide;
    }
    HoverTip { y: parent.height; hovered: ta.has-hover && !ta.pressed; text: root.text; }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

/// Groupe du ruban : contenu, puis libellé centré en bas, séparateur à droite.
/// En barre classique : « Libellé : » puis le contenu sur une ligne.
export component RibbonGroup inherits Rectangle {
    in property <string> label;
    in property <bool> classic;
    /// volet d'un groupe replié : libellés toujours montrés (le ruban, lui, peut les avoir
    /// retirés faute de place ; sans eux les boutons gardaient la largeur de leur colonne et les
    /// icônes se décalaient)
    in property <bool> full;
    /// barre classique : « Libellé : » devant le contenu (non quand le contenu se nomme déjà,
    /// « Lissage : Lissage » ; ni dans un groupe replié, où le bouton porte le nom)
    in property <bool> titled: true;
    /// sans séparateur (contenu d'un groupe replié)
    in property <bool> bare: false;
    // barre réduite (Paint.NET, ruban replié, Photoshop) : pas de titres de groupes, ils
    // doublaient les libellés des réglages (« Lissage : Lissage ») ; infobulles et libellés
    // des boutons suffisent
    property <bool> show-label-c: false && root.titled;
    // largeur minimale du contenu aussi (un bouton à libellé, « Rendu ÷2 », a un minimum plus
    // grand que sa largeur préférée annoncée : il débordait du groupe)
    min-width: classic ? (self.show-label-c ? lbl-c.preferred-width + 4px : 0px) + max(inner.preferred-width, inner.min-width) + 12px : max(inner.preferred-width, inner.min-width, lbl.preferred-width) + 16px;
    height: classic ? 32px : 88px;
    lbl-c := Text {
        visible: root.show-label-c;
        x: 6px;
        height: parent.height;
        text: root.label + " :";
        font-size: Theme.font-size;
        color: Theme.ribbon-fg;
        vertical-alignment: center;
    }
    inner := HorizontalLayout {
        x: root.classic ? (root.show-label-c ? lbl-c.preferred-width + 10px : 6px) : 8px;
        y: root.classic ? 3px : 5px;
        // largeur restante, marge droite comprise : sans elle le contenu prenait toute la largeur
        // du groupe à partir de x, et les boutons extensibles (colonnes Grille / Hors toile)
        // passaient de 8 px sous le séparateur
        width: max(0px, root.width - self.x - (root.classic ? 6px : 8px));
        height: root.classic ? 26px : 60px;
        spacing: 2px;
        @children
    }
    lbl := Text {
        visible: !root.classic;
        y: 70px;
        width: parent.width;
        text: root.label;
        font-size: Theme.small-font-size;
        color: Theme.ribbon-label;
        horizontal-alignment: center;
    }
    if !root.bare: Rectangle {
        x: parent.width - (Theme.win7 ? 2px : 1px);
        y: Theme.win7 ? 3px : 6px;
        width: 1px;
        height: parent.height - (Theme.win7 ? 6px : 12px);
        // Windows 7 / Office 2010 : trait qui s'efface en haut et en bas, doublé d'un reflet
        background: Theme.win7 ? @linear-gradient(180deg, Theme.ribbon-sep.with-alpha(0) 0%, Theme.ribbon-sep 30%, Theme.ribbon-sep 70%, Theme.ribbon-sep.with-alpha(0) 100%) : Theme.ribbon-sep;
    }
    if !root.bare && Theme.win7: Rectangle {
        x: parent.width - 1px;
        y: 3px;
        width: 1px;
        height: parent.height - 6px;
        background: Theme.dark ? @linear-gradient(180deg, #ffffff00 0%, #ffffff14 30%, #ffffff14 70%, #ffffff00 100%) : @linear-gradient(180deg, #ffffff00 0%, #ffffffe6 30%, #ffffffe6 70%, #ffffff00 100%);
    }
}

/// Choix exclusif en boutons accolés (Paramètres : « Paint.NET | Photoshop | Téléphone »…).
/// Windows 11 : piste arrondie, option choisie en pastille claire avec un trait d'accent.
/// Case à choisir (type de projet, fond, format, proportions…) : carte de MasterPaint en moderne,
/// vrai bouton du style en 7 / XP / 98 — enfoncé (doré en 7) quand elle est choisie, comme les
/// options d'un `Segmented`. Le contenu (icône, textes) se place dedans.
export component ChoiceTile inherits Rectangle {
    in property <bool> selected;
    /// moderne : fond plein (cartes) ou transparent (cases d'une barre)
    in property <brush> idle-bg: Theme.field-bg;
    /// moderne : arrondi de la carte ; couleur du contour au repos
    in property <length> tile-radius: Theme.ctl-radius;
    in property <color> idle-border: Theme.window-border;
    /// choix plein (ancrage) : fond d'accent au lieu d'une teinte
    in property <bool> strong;
    in property <bool> enabled: true;
    callback clicked();
    out property <bool> hovered: ta.has-hover && root.enabled;
    out property <bool> pressed: ta.pressed;
    out property <bool> skinned: Theme.b-classic || Theme.b-98;
    border-radius: root.skinned ? 0px : root.tile-radius;
    opacity: root.enabled ? 1 : 0.4;
    background: Theme.b-98 ? (root.selected ? Theme.bevel-hi.mix(Theme.window-bg, 0.5) : Theme.button-bg) : Theme.b-classic ? transparent
        : !root.enabled ? transparent
        : root.selected ? (root.strong ? Theme.accent : Theme.accent-14) : ta.pressed ? Theme.accent-20 : (Theme.hover-fx && ta.has-hover) ? Theme.accent-12 : root.idle-bg;
    border-width: root.skinned ? 0px : root.selected && !root.strong ? 2px : 1px;
    border-color: root.selected ? Theme.accent : (Theme.hover-fx && root.hovered) ? Theme.accent-60 : root.idle-border;
    if Theme.b-classic: ClassicFace {
        width: parent.width;
        height: parent.height;
        hover: ta.has-hover;
        pressed: root.selected || ta.pressed;
        soft: Theme.b-w7 && root.selected;
        enabled: root.enabled;
    }
    if Theme.b-98: Bevel {
        sunken: root.selected || ta.pressed;
    }
    @children
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component Segmented inherits Rectangle {
    in property <string> tip;
    in property <[string]> options;
    // sans largeur imposée : assez pour des libellés courts
    min-width: root.options.length * 52px;
    in-out property <int> index;
    callback selected(int);
    height: 30px;
    // Windows 7 / XP : boutons accolés de la feuille de style, l'option choisie enfoncée
    border-radius: Theme.b-98 || Theme.b-classic ? 0px : Theme.ctl-radius > 0 ? Theme.ctl-radius + 2px : 0px;
    background: Theme.b-98 || Theme.b-classic ? transparent : Theme.track-bg;
    border-width: Theme.b-98 || Theme.b-classic ? 0px : 1px;
    border-color: Theme.button-border;
    HorizontalLayout {
        padding: Theme.b-98 || Theme.b-classic ? 0px : 2px;
        spacing: Theme.b-98 ? 0px : 2px;
        // cases égales (largeur ÷ nombre d'options) : ni largeur préférée ni minimum par case,
        // la place se partage à parts égales (un minimum par case, la largeur de son texte,
        // était servi d'abord et rendait les cases inégales)
        for o[i] in root.options: Rectangle {
            horizontal-stretch: 1;
            preferred-width: 0px;
            min-width: 0px;
            border-radius: Theme.ctl-radius;
            background: Theme.b-98 ? (i == root.index ? Theme.bevel-hi.mix(Theme.window-bg, 0.5) : Theme.button-bg)
                : Theme.b-classic ? transparent
                : i == root.index ? Theme.field-bg : (Theme.hover-fx && sta.has-hover) ? Theme.accent-12 : transparent;
            border-width: !Theme.b-98 && !Theme.b-classic && i == root.index ? 1px : 0px;
            border-color: Theme.button-border;
            if Theme.b-98: Bevel {
                sunken: i == root.index;
            }
            if Theme.b-classic: ClassicFace {
                width: parent.width;
                height: parent.height;
                hover: sta.has-hover;
                pressed: i == root.index;
                soft: Theme.b-w7 && i == root.index;
            }
            // trait d'accent centré sous l'option choisie (comme Windows 11)
            Rectangle {
                visible: i == root.index && !Theme.b-98 && !Theme.b-classic;
                x: (parent.width - self.width) / 2;
                y: parent.height - 3px;
                width: min(18px, parent.width - 8px);
                height: 3px;
                border-radius: 1.5px * Theme.round;
                background: Theme.accent;
            }
            seg-t := Text {
                width: parent.width;
                height: parent.height;
                font-size: Theme.font-size;
                text: o;
                color: Theme.b-classic ? Theme.button-fg : i == root.index && !Theme.b-98 ? Theme.accent : Theme.text;
                font-weight: i == root.index ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            HoverTip { y: parent.height; hovered: sta.has-hover && !sta.pressed; text: root.tip != "" ? root.tip : o; }
            sta := TouchArea {
                clicked => {
                    root.index = i;
                    root.selected(i);
                }
            }
        }
    }
}

/// Pied des fenêtres de dialogue (« alvéole » des boutons) : bande un peu plus claire que la
/// fenêtre, trait en haut, boutons à droite. Un élément `horizontal-stretch: 1` placé avant
/// les boutons occupe la gauche (texte d'état, case à cocher, boutons secondaires).
/// Cadran d'angle (degrés, 0 à droite, sens trigonométrique comme Paint.NET) : glisser pour
/// orienter, molette = un pas, double-clic = valeur par défaut. Aiguille = barre tournée (le
/// tracé Path de l'ancien cadran était recadré par Slint : aiguille à gauche à 0°, invisible
/// vers 40°). Plage d'au plus un demi-tour (Redresser ±45°, Linogravure ±90°) : on lit un AXE
/// (une direction et son opposée se valent), sinon la direction ; hors plage : borne la plus
/// proche sur le cercle (avant : vers le haut donnait −45 au lieu de +45).
export component AngleDial inherits Rectangle {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 360;
    in property <float> step: 1;
    in property <float> default-value;
    in property <length> size: 22px;
    callback changed(float);
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: Theme.field-bg;
    border-width: 1px;
    border-color: ta.pressed ? Theme.accent : (Theme.hover-fx && ta.has-hover) ? Theme.accent-60 : Theme.field-border;
    // repères discrets 0° / 90° / 180° / 270°
    for k in 4: Rectangle {
        x: k == 0 ? root.width - 4px : k == 2 ? 2px : (root.width - 1px) / 2;
        y: k == 1 ? 2px : k == 3 ? root.height - 4px : (root.height - 1px) / 2;
        width: k == 0 || k == 2 ? 2px : 1px;
        height: k == 0 || k == 2 ? 1px : 2px;
        background: Theme.field-border;
    }
    // aiguille : barre de la largeur du cadran tournée autour du centre ; seule la moitié droite
    // est peinte (vers l'angle)
    Rectangle {
        x: 0;
        y: (root.height - 2px) / 2;
        width: root.width;
        height: 2px;
        transform-rotation: -root.value * 1deg;
        Rectangle {
            x: root.width / 2;
            width: root.width / 2 - 3px;
            height: 2px;
            border-radius: 1px;
            background: Theme.accent;
        }
    }
    Rectangle {
        width: 5px;
        height: 5px;
        border-radius: 2.5px;
        background: Theme.accent;
    }
    function snap(v: float) -> float {
        let st = root.step > 0 ? root.step : 1;
        return clamp(round(v / st) * st, root.minimum, root.maximum);
    }
    function set-from(px: length, py: length) {
        let dx = (px - root.width / 2) / 1px;
        let dy = (root.height / 2 - py) / 1px;
        if (dx * dx + dy * dy < 4) { return; }
        let a = atan2(dy, dx) / 1deg;
        let span = root.maximum - root.minimum;
        let period = span <= 180.001 ? 180 : 360;
        // ramène a dans [min, min + période)
        let b = a - floor((a - root.minimum) / period) * period;
        if (b <= root.maximum) {
            root.changed(root.snap(b));
            return;
        }
        // hors plage : borne la plus proche, distance prise sur le cercle
        let d-max = b - root.maximum;
        let d-min = root.minimum + period - b;
        root.changed(root.snap(d-max <= d-min ? root.maximum : root.minimum));
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.set-from(self.mouse-x, self.mouse-y);
            }
        }
        moved => {
            if (self.pressed) { root.set-from(self.mouse-x, self.mouse-y); }
        }
        double-clicked => { root.changed(root.default-value); }
        scroll-event(e) => {
            if (e.delta-y == 0) { return reject; }
            let st = root.step > 0 ? max(root.step, 1) : 1;
            root.changed(root.snap(root.value + (e.delta-y > 0 ? st : -st)));
            accept
        }
    }
}

export component DialogFooter inherits Rectangle {
    height: 44px;
    background: Theme.footer-bg;
    border-bottom-left-radius: Theme.classic || Theme.lite ? 0px : max(0px, Theme.window-radius - 1px);
    border-bottom-right-radius: Theme.classic || Theme.lite ? 0px : max(0px, Theme.window-radius - 1px);
    // 7.css (footer::before) : creux de 2 px, inset 0 1px #0000004d et 0 -1px #fff
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.win7 && !Theme.dark ? #0000004d : Theme.window-border;
    }
    if Theme.win7 && !Theme.dark: Rectangle {
        y: 1px;
        height: 1px;
        background: #ffffff;
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;
        alignment: end;
        @children
    }
}

/// Champ de saisie Windows 10 : fond blanc, bordure grise, accent au focus.
export component W10LineEdit inherits Rectangle {
    in property <string> tip;
    in-out property <string> text;
    in property <InputType> input-type: InputType.text;
    callback accepted(string);
    callback edited(string);
    height: 22px;
    min-width: 40px;
    // 7.css : bords #abadb3 (haut) / #dbdfe6, bleus au survol et au focus, 2 px d'arrondi ;
    // XP.css : bord #7f9db9, carré
    border-radius: Theme.xp ? 0px : Theme.win7 ? 2px : Theme.ctl-radius;
    background: Theme.field-bg;
    border-width: Theme.win98 ? 0px : 1px;
    border-color: Theme.win7 ? (ti.has-focus ? Theme.accent.mix(#ffffff, 0.45) : (Theme.hover-fx && hov.has-hover) ? Theme.accent.mix(#ffffff, 0.35) : #dbdfe6) : Theme.xp ? Theme.field-border
        : ti.has-focus ? Theme.accent : (Theme.hover-fx && hov.has-hover) ? Theme.text-inactive : Theme.field-border;
    if Theme.win98: Bevel {
        sunken: true;
    }
    if Theme.win7: Rectangle {
        x: 1px;
        y: 0;
        width: parent.width - 2px;
        height: 1px;
        background: ti.has-focus ? #3d7bad : (Theme.hover-fx && hov.has-hover) ? #5794bf : #abadb3;
    }
    hov := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            ti.focus();
        }
    }
    ti := TextInput {
        x: 5px;
        width: parent.width - 10px;
        height: parent.height;
        vertical-alignment: center;
        text <=> root.text;
        input-type: root.input-type;
        color: Theme.text;
        font-size: Theme.font-size;
        single-line: true;
        selection-background-color: Theme.accent.with-alpha(0.35);
        accepted => {
            root.accepted(self.text);
        }
        edited => {
            root.edited(self.text);
        }
    }
    HoverTip { y: parent.height; hovered: hov.has-hover && !hov.pressed; text: root.tip != "" ? root.tip : root.text; }

}

/// Valeur numérique saisissable : suit `value` tant qu'on ne la modifie pas au clavier ;
/// Entrée (ou perte du focus) valide la saisie.
export component NumEdit inherits Rectangle {
    in property <float> value;
    in property <bool> decimals;
    callback accepted(float);
    pure function fmt() -> string {
        return root.decimals ? round(root.value * 100) / 100 : round(root.value);
    }
    height: 22px;
    min-width: 34px;
    border-radius: Theme.xp ? 0px : Theme.win7 ? 2px : Theme.ctl-radius;
    background: Theme.field-bg;
    border-width: Theme.win98 ? 0px : 1px;
    border-color: Theme.win7 ? (ti.has-focus ? Theme.accent.mix(#ffffff, 0.45) : #dbdfe6) : Theme.xp ? Theme.field-border
        : ti.has-focus ? Theme.accent : Theme.field-border;
    if Theme.win98: Bevel {
        sunken: true;
    }
    if Theme.win7: Rectangle {
        x: 1px;
        y: 0;
        width: parent.width - 2px;
        height: 1px;
        background: ti.has-focus ? #3d7bad : #abadb3;
    }
    changed value => {
        if (!ti.has-focus) {
            ti.text = root.fmt();
        }
    }
    init => {
        ti.text = root.fmt();
    }
    ti := TextInput {
        x: 4px;
        width: parent.width - 8px;
        height: parent.height;
        vertical-alignment: center;
        horizontal-alignment: right;
        color: Theme.text;
        font-size: Theme.font-size;
        single-line: true;
        selection-background-color: Theme.accent.with-alpha(0.35);
        accepted => {
            root.accepted(self.text.to-float());
            self.text = root.fmt();
        }
        changed has-focus => {
            if (!self.has-focus) {
                if (self.text != root.fmt() && self.text.is-float()) {
                    root.accepted(self.text.to-float());
                }
                self.text = root.fmt();
            }
        }
    }
}

/// Séparateur vertical (ruban, barres d'outils).
export component VSep inherits Rectangle {
    width: 1px;
    background: Theme.ribbon-sep;
}
