// MasterPaint — © 2026 polocrafting — https://polocrafting.fr. Voir COPYRIGHT.md / See COPYRIGHT.md.
// Fenêtre de bienvenue (comme la version HTML) : affichée aux deux premières ouvertures et par
// Fichier › Bienvenue / Informations. L'essentiel pour démarrer, quelques réglages rapides
// (thème, accent, barre d'options, disposition — les mêmes que les Paramètres), un rappel des
// raccourcis et le projet GitHub. Contenu seul : app.slint le pose dans une FloatWindow (panneau
// plein écran en mode téléphone).
// Téléphone : mise en page à part (onglets Démarrer / Réglages, une seule colonne qui ne défile
// que verticalement, textes renvoyés à la ligne, grandes cibles tactiles, pas de raccourcis
// clavier).
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { MpIcons } from "mpicons.slint";
import { FaIcon, HoverTip, W10Button, W10CheckBox, W10ComboBox, Segmented, DialogFooter } from "widgets.slint";

/// Titre d'une section de la fenêtre, avec son trait d'accent.
component WelHead inherits HorizontalLayout {
    in property <string> title;
    spacing: 6px;
    alignment: LayoutAlignment.start;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 3px;
            height: 14px;
            border-radius: 1.5px * Theme.round;
            background: Theme.accent;
        }
    }
    Text {
        text: root.title;
        font-size: Theme.font-size + 2px;
        font-weight: 700;
        color: Theme.text;
    }
}

/// Grand bouton « Démarrer » : icône maison, titre, explication.
component StartCard inherits Rectangle {
    in property <int> mp: -1;
    in property <string> glyph;
    in property <string> title;
    in property <string> hint;
    /// téléphone : carte plus haute, explication renvoyée à la ligne (largeur `touch-w`)
    in property <bool> touch;
    in property <length> touch-w;
    callback clicked();
    // téléphone : place pour un titre et deux lignes d'explication
    height: root.touch ? 68px : 46px;
    border-radius: Theme.ctl-radius + 2px * Theme.round;
    background: ta.pressed ? Theme.accent-20 : (Theme.hover-fx && ta.has-hover) ? Theme.accent-12 : Theme.button-bg;
    border-width: 1px;
    border-color: (Theme.hover-fx && ta.has-hover) ? Theme.accent-60 : Theme.button-border;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Rectangle {
            width: 24px;
            if root.mp >= 0: Image {
                y: (parent.height - 24px) / 2;
                width: 24px;
                height: 24px;
                source: MpIcons.images[root.mp];
            }
            if root.mp < 0: FaIcon {
                width: parent.width;
                height: parent.height;
                glyph: root.glyph;
                size: 18px;
                color: Theme.accent;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.title;
                font-weight: 600;
                color: Theme.text;
            }
            if !root.touch: Text {
                text: root.hint;
                font-size: Theme.small-font-size;
                color: Theme.text-inactive;
                overflow: elide;
            }
            if root.touch: Text {
                width: max(0px, root.touch-w - 66px);
                text: root.hint;
                font-size: Theme.small-font-size;
                color: Theme.text-inactive;
                wrap: word-wrap;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

/// Lien discret (texte d'accent souligné au survol).
component WelLink inherits Text {
    callback clicked();
    color: Theme.accent;
    font-weight: lta.has-hover ? 600 : 400;
    lta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

/// « Démarrer » : nouvelle image, ouvrir, projet d'exemple.
component StartSection inherits VerticalLayout {
    in property <bool> touch;
    in property <length> w;
    callback act(string);
    spacing: root.touch ? 8px : 6px;
    WelHead {
        title: @tr("Démarrer");
    }
    StartCard {
        touch: root.touch;
        touch-w: root.w;
        mp: 0;
        title: @tr("Nouvelle image");
        hint: root.touch ? @tr("Toile vide, taille et fond au choix") : @tr("Toile vide, taille et fond au choix (Ctrl+N)");
        clicked => {
            root.act("new");
        }
    }
    StartCard {
        touch: root.touch;
        touch-w: root.w;
        mp: 1;
        title: @tr("Ouvrir une image");
        hint: root.touch ? @tr("PNG, JPEG, WebP, RAW, projet .illu…") : @tr("PNG, JPEG, WebP, RAW, projet .illu… ou glisser-déposer (Ctrl+O)");
        clicked => {
            root.act("open");
        }
    }
    StartCard {
        touch: root.touch;
        touch-w: root.w;
        mp: 87;
        title: @tr("Ouvrir le projet d'exemple");
        hint: @tr("Calques, masques et filtres dynamiques déjà en place");
        clicked => {
            root.act("example");
        }
    }
    StartCard {
        touch: root.touch;
        touch-w: root.w;
        glyph: "\u{f02d}";
        title: @tr("Tutoriel");
        hint: @tr("Découvrir les outils et les fonctions avec des explications illustrées");
        clicked => { root.act("tutorial"); }
    }
}

/// Téléphone : intitulé (renvoyé à la ligne) puis choix sur toute la largeur.
component PhoneRow inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    in property <length> w;
    spacing: 6px;
    padding-top: 6px;
    Text {
        width: root.w;
        text: root.title;
        font-weight: 600;
        color: Theme.text;
        wrap: word-wrap;
    }
    if root.hint != "": Text {
        width: root.w;
        text: root.hint;
        wrap: word-wrap;
        font-size: Theme.small-font-size;
        color: Theme.text-inactive;
    }
    @children
}

/// Téléphone : réglages rapides en une colonne, cibles de 36 px au moins (pas de barre
/// d'options : le ruban n'existe pas en mode téléphone).
component PhoneSettings inherits VerticalLayout {
    in property <length> w;
    in-out property <int> language;
    in-out property <int> layout;
    in-out property <bool> layout-auto;
    callback language-chosen(int);
    callback theme(bool, color);
    callback settings-changed();
    callback layout-changed(int);
    callback act(string);
    spacing: 10px;
    PhoneRow {
        w: root.w;
        title: @tr("Langue");
        W10ComboBox {
            flags: true;
            width: root.w;
            height: 36px;
            model: [@tr("Français"), @tr("English"), @tr("Español"), @tr("Deutsch"), @tr("Italiano"), @tr("Português")];
            current-index: root.language;
            selected(i) => { root.language = i; root.language-chosen(i); root.settings-changed(); }
        }
    }
    PhoneRow {
        w: root.w;
        title: @tr("Thème sombre");
        Segmented {
            width: root.w;
            height: 36px;
            options: [@tr("Non"), @tr("Oui")];
            index: Theme.dark ? 1 : 0;
            selected(i) => {
                root.theme(i == 1, Theme.accent-base);
            }
        }
    }
    PhoneRow {
        w: root.w;
        title: @tr("Couleur d'accentuation");
        // pastilles réparties sur la largeur (11 couleurs, jamais plus large que l'écran)
        HorizontalLayout {
            width: root.w;
            spacing: 4px;
            for a in Theme.accent-options: Rectangle {
                horizontal-stretch: 1;
                height: 34px;
                border-radius: Theme.ctl-radius;
                background: a;
                border-width: Theme.accent-base == a ? 3px : 1px;
                border-color: Theme.accent-base == a ? Theme.text : #808080;
                TouchArea { clicked => { root.theme(Theme.dark, a); } }
            }
        }
    }
    PhoneRow {
        w: root.w;
        title: @tr("Interface");
        hint: @tr("Paint.NET : comme paintdotjs. Photoshop : comme PhotoCraft. Téléphone : tactile.");
        Segmented {
            width: root.w;
            height: 36px;
            options: ["MasterPaint", "Paint.NET", "Photoshop", @tr("Téléphone")];
            index <=> root.layout;
            selected(i) => {
                root.layout-changed(i);
            }
        }
    }
    PhoneRow {
        w: root.w;
        title: @tr("Interface tactile automatique sur petit écran");
        Segmented {
            width: root.w;
            height: 36px;
            options: [@tr("Non"), @tr("Oui")];
            index: root.layout-auto ? 1 : 0;
            selected(i) => {
                root.layout-auto = i == 1;
                root.settings-changed();
            }
        }
    }
    HorizontalLayout {
        padding-top: 4px;
        alignment: LayoutAlignment.start;
        WelLink {
            text: @tr("Tous les paramètres…");
            clicked => {
                root.act("settings");
            }
        }
    }
}

/// Teinte « découvrir » (Tutoriel, Exemple) : opposée à la couleur d'accentuation, pour que ces
/// boutons ne se confondent pas avec les actions principales.
export global Discover {
    out property <color> color: hsv(mod(Theme.accent.to-hsv().hue + 150, 360), 0.65, Theme.dark ? 0.92 : 0.72);
    out property <color> on: self.color.to-hsv().value > 0.8 ? #1a1a1a : #ffffff;
}

/// Bouton du pied de page à la teinte « découvrir » (Exemple).
component DiscoverButton inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    callback clicked();
    height: 24px;
    width: max(56px, dt.preferred-width + 24px);
    border-radius: min(Theme.button-radius, self.height / 2);
    background: ta.pressed ? Discover.color.darker(15%) : (Theme.hover-fx && ta.has-hover) ? Discover.color.brighter(10%) : Discover.color;
    border-width: 1px;
    border-color: Discover.color.darker(12%);
    dt := Text {
        text: root.text;
        font-size: Theme.font-size;
        color: Discover.on;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    HoverTip { y: parent.height + 2px; hovered: ta.has-hover && !ta.pressed; text: root.tip; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component WelcomeContent inherits Rectangle {
    in property <string> version;
    /// mode téléphone : mise en page tactile à part (voir en tête du fichier)
    in property <bool> phone;
    in-out property <int> language;
    callback language-chosen(int);
    in-out property <int> toolbar-mode;
    in-out property <int> layout;
    in-out property <bool> layout-auto;
    /// « Ne plus afficher » (réglage `welcomeHide`)
    in-out property <bool> hide;
    /// thème sombre, couleur d'accentuation (même chemin que les Paramètres)
    callback theme(bool, color);
    /// réglage modifié : à enregistrer
    callback settings-changed();
    /// disposition choisie (le choix explicite sur un écran étroit est respecté)
    callback layout-changed(int);
    /// new, open, example, github, shortcuts, settings
    callback action(string);
    /// « Commencer » : fermer la fenêtre
    callback start();
    property <length> pad: 16px;
    // deux colonnes dès que la place le permet ; sinon (téléphone) tout s'empile
    property <bool> wide: root.width >= 600px;
    property <length> inner-w: root.width - 2 * root.pad - 14px;
    property <length> col-w: root.wide ? (root.inner-w - 20px) / 2 : root.inner-w;
    /// téléphone : onglet affiché (0 Démarrer, 1 Réglages)
    property <int> phone-page: 0;
    // téléphone : largeur utile de la colonne (marges seules : pas de barre de défilement fixe)
    property <length> phone-w: max(160px, root.width - 2 * 14px);
    // ---- bureau : bandeau d'accueil, quatre grandes actions, apparence en une ligne ----
    if !root.phone: ScrollView {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height - 44px;
        content-height: body.preferred-height + 8px;
        body := VerticalLayout {
            padding: 0;
            spacing: 0;
            alignment: LayoutAlignment.start;
            // bandeau : logo, titre, une phrase, version
            Rectangle {
                height: 112px;
                background: @linear-gradient(110deg, Theme.accent.with-alpha(0.30) 0%, Theme.accent.with-alpha(0.06) 55%, transparent 100%);
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 16px;
                    alignment: LayoutAlignment.start;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            width: 64px;
                            height: 64px;
                            source: @image-url("../../packaging/icons/128x128.png");
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: @tr("Bienvenue dans MasterPaint");
                            font-size: Theme.font-size + 10px;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        Text {
                            width: root.inner-w - 110px;
                            text: @tr("Dessin, retouche photo et vectoriel, gratuit et sans publicité.");
                            wrap: word-wrap;
                            color: Theme.text-inactive;
                        }
                        HorizontalLayout {
                            alignment: LayoutAlignment.start;
                            spacing: 10px;
                            Rectangle {
                                height: 18px;
                                width: vtxt.preferred-width + 14px;
                                border-radius: 9px * Theme.round;
                                background: Theme.accent-14;
                                vtxt := Text {
                                    text: @tr("version ") + root.version;
                                    font-size: Theme.small-font-size;
                                    color: Theme.text;
                                }
                            }
                            // crédit cliquable : site de l'auteur
                            Text {
                                text: @tr("Développé par") + " polocrafting 367 ↗";
                                font-size: Theme.small-font-size;
                                color: (Theme.hover-fx && auta.has-hover) ? Theme.accent : Theme.text-inactive;
                                vertical-alignment: center;
                                auta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.action("author"); }
                                }
                            }
                        }
                    }
                }
            }
            // grandes actions
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 18px;
                spacing: 12px;
                for t in [
                    { mp: 0, id: "new", g: "", title: @tr("Nouvelle image"), hint: @tr("Toile vide") },
                    { mp: 1, id: "open", g: "", title: @tr("Ouvrir"), hint: @tr("Image, PSD, SVG…") },
                    { mp: -1, id: "raw", g: "\u{f030}", title: @tr("Développer une photo RAW"), hint: @tr("Mode Photo Pro, façon Lightroom") },
                    { mp: -1, id: "tutorial", g: "\u{f19d}", title: @tr("Tutoriel"), hint: @tr("Les outils pas à pas") },
                ]: Rectangle {
                    // tutoriel : carte « découvrir », teinte opposée à l'accent (on la repère)
                    property <bool> learn: t.id == "tutorial";
                    horizontal-stretch: 1;
                    height: 118px;
                    border-radius: Theme.ctl-radius + 4px * Theme.round;
                    background: tta.pressed ? (self.learn ? Discover.color.with-alpha(0.30) : Theme.accent-20)
                        : (Theme.hover-fx && tta.has-hover) ? (self.learn ? Discover.color.with-alpha(0.22) : Theme.accent-12)
                        : self.learn ? Discover.color.with-alpha(0.12) : Theme.button-bg;
                    border-width: 1px;
                    border-color: self.learn ? Discover.color.with-alpha((Theme.hover-fx && tta.has-hover) ? 1 : 0.6) : (Theme.hover-fx && tta.has-hover) ? Theme.accent : Theme.button-border;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px * Theme.round;
                                background: t.id == "tutorial" ? Discover.color.with-alpha(0.25) : Theme.accent-14;
                                if t.mp >= 0: Image {
                                    width: 24px;
                                    height: 24px;
                                    source: MpIcons.images[t.mp];
                                }
                                if t.mp < 0: FaIcon {
                                    glyph: t.g;
                                    size: 18px;
                                    color: t.id == "tutorial" ? Discover.color : Theme.accent;
                                }
                            }
                        }
                        Text {
                            text: t.title;
                            font-weight: 600;
                            color: Theme.text;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: t.hint;
                            font-size: Theme.small-font-size;
                            color: Theme.text-inactive;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    tta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.action(t.id);
                        }
                    }
                }
            }
            // apparence : l'essentiel seulement (le reste dans les Paramètres)
            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 20px;
                spacing: 8px;
                Text {
                    text: @tr("Choisissez votre interface");
                    font-weight: 600;
                    color: Theme.text;
                }
                Segmented {
                    options: ["MasterPaint", "Paint.NET", "Photoshop", @tr("Téléphone")];
                    index <=> root.layout;
                    selected(i) => {
                        root.layout-changed(i);
                    }
                }
                HorizontalLayout {
                    spacing: 14px;
                    alignment: LayoutAlignment.start;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: @tr("Thème"); color: Theme.text-inactive; vertical-alignment: center; }
                        Segmented {
                            width: 150px;
                            options: [@tr("Clair"), @tr("Sombre")];
                            index: Theme.dark ? 1 : 0;
                            selected(i) => {
                                root.theme(i == 1, Theme.accent-base);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: LayoutAlignment.start;
                        for a in Theme.accent-options: Rectangle {
                            width: 18px;
                            height: 18px;
                            y: 6px;
                            border-radius: 9px * Theme.round;
                            background: a;
                            border-width: Theme.accent-base == a ? 2px : 0px;
                            border-color: Theme.text;
                            TouchArea { mouse-cursor: pointer; clicked => { root.theme(Theme.dark, a); } }
                        }
                    }
                }
            }
            // liens : raccourcis, paramètres, langue
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 16px;
                padding-bottom: 8px;
                spacing: 16px;
                alignment: LayoutAlignment.start;
                VerticalLayout {
                    alignment: center;
                    WelLink {
                        text: @tr("Raccourcis clavier");
                        clicked => { root.action("shortcuts"); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    WelLink {
                        text: @tr("Tous les paramètres…");
                        clicked => { root.action("settings"); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                W10ComboBox {
                    flags: true;
                    width: 150px;
                    model: [@tr("Français"), @tr("English"), @tr("Español"), @tr("Deutsch"), @tr("Italiano"), @tr("Português")];
                    current-index: root.language;
                    selected(i) => { root.language = i; root.language-chosen(i); root.settings-changed(); }
                }
            }
        }
    }

    // ---- téléphone : onglets en haut, une colonne qui ne défile que verticalement ----
    if root.phone: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: 52px;
        Segmented {
            x: 14px;
            y: 8px;
            width: parent.width - 28px;
            height: 36px;
            options: [@tr("Démarrer"), @tr("Réglages")];
            index <=> root.phone-page;
        }
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.window-border;
        }
    }
    if root.phone: Flickable {
        x: 0;
        y: 52px;
        width: root.width;
        height: root.height - 52px - 44px;
        // largeur imposée : jamais de défilement horizontal
        content-width: self.width;
        content-height: max(self.height, pbody.preferred-height + 8px);
        pbody := VerticalLayout {
            width: root.width;
            padding: 14px;
            spacing: 12px;
            alignment: LayoutAlignment.start;
            if root.phone-page == 0: VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: LayoutAlignment.start;
                    Image {
                        width: 44px;
                        height: 44px;
                        source: @image-url("../../packaging/icons/128x128.png");
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            width: root.phone-w - 56px;
                            text: @tr("Bienvenue dans MasterPaint");
                            font-size: Theme.font-size + 5px;
                            font-weight: 700;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        Text {
                            text: @tr("version ") + root.version;
                            color: Theme.text-inactive;
                        }
                    }
                }
                Text {
                    width: root.phone-w;
                    text: @tr("Éditeur d'images inspiré de Paint.NET, Photoshop et Illustrator : calques, effets, sélections, photos RAW. Gratuit, sans publicité ni traceurs, dans le navigateur comme en application.");
                    wrap: word-wrap;
                    color: Theme.text-inactive;
                }
                StartSection {
                    touch: true;
                    w: root.phone-w;
                    act(id) => {
                        root.action(id);
                    }
                }
                HorizontalLayout {
                    alignment: LayoutAlignment.start;
                    WelLink {
                        text: @tr("Réglages rapides…");
                        clicked => {
                            root.phone-page = 1;
                        }
                    }
                }
            }
            if root.phone-page == 1: PhoneSettings {
                w: root.phone-w;
                language <=> root.language;
                layout <=> root.layout;
                layout-auto <=> root.layout-auto;
                language-chosen(i) => {
                    root.language-chosen(i);
                }
                theme(d, a) => {
                    root.theme(d, a);
                }
                settings-changed => {
                    root.settings-changed();
                }
                layout-changed(i) => {
                    root.layout-changed(i);
                }
                act(id) => {
                    root.action(id);
                }
            }
        }
    }

    // pied : « Ne plus afficher » à gauche, GitHub et Commencer à droite
    DialogFooter {
        y: root.height - 44px;
        width: root.width;
        HorizontalLayout {
            spacing: 6px;
            alignment: LayoutAlignment.start;
            VerticalLayout {
                alignment: center;
                hide-cb := W10CheckBox {
                    checked <=> root.hide;
                    toggled => {
                        root.settings-changed();
                    }
                }
            }
            Text {
                text: root.phone ? @tr("Ne plus afficher") : @tr("Ne plus afficher au démarrage");
                color: Theme.text;
                vertical-alignment: center;
                TouchArea {
                    clicked => {
                        hide-cb.toggle();
                    }
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        if !root.phone: W10Button {
            text: @tr("Projet sur GitHub");
            tip: @tr("Code source, suivi des problèmes et nouveautés de MasterPaint");
            clicked => {
                root.action("github");
            }
        }
        // projet d'exemple : à côté de Commencer, à la teinte « découvrir »
        DiscoverButton {
            text: @tr("Exemple");
            tip: @tr("Ouvrir le projet d'exemple, tout prêt à explorer");
            clicked => { root.action("example"); }
        }
        W10Button {
            text: @tr("Commencer");
            primary: true;
            clicked => {
                root.start();
            }
        }
    }
}
