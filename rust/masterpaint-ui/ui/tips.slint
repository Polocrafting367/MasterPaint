// Généré par tools/gen_tips.py depuis tools/tips.json : descriptions des info-bulles (clé = titre).
export global Tips {
    public pure function desc(t: string) -> string {
        if (t == @tr("Nouveau document…")) { return @tr("Crée une image vide : choisissez sa taille, son fond et son mode (Ctrl+N)."); }
        if (t == @tr("Ouvrir")) { return @tr("Ouvre une image, une photo RAW ou un projet .illu dans un nouvel onglet (Ctrl+O). Vous pouvez aussi glisser un fichier sur la page."); }
        if (t == @tr("Exporter / enregistrer…")) { return @tr("Enregistre l'image : PNG, JPEG, WebP, BMP… ou projet .illu pour garder les calques (Ctrl+S)."); }
        if (t == @tr("Imprimer")) { return @tr("Imprime l'image aplatie."); }
        if (t == @tr("Annuler la dernière action")) { return @tr("Annule la dernière action (Ctrl+Z). L'historique garde toutes les étapes."); }
        if (t == @tr("Rétablir")) { return @tr("Refait l'action annulée (Ctrl+Y)."); }
        if (t == @tr("Zoom arrière")) { return @tr("Réduit l'affichage. Ctrl + molette fait la même chose sous le curseur."); }
        if (t == @tr("Zoom avant")) { return @tr("Agrandit l'affichage. Ctrl + molette fait la même chose sous le curseur."); }
        if (t == @tr("Adapter au workspace")) { return @tr("Ajuste le zoom pour voir toute l'image dans la fenêtre."); }
        if (t == @tr("Ajuster à la fenêtre")) { return @tr("Ajuste le zoom pour voir toute l'image dans la fenêtre."); }
        if (t == @tr("Signaler un bug")) { return @tr("Ouvre le formulaire de contact : décrivez le problème, le journal de l'application est joint."); }
        if (t == @tr("Inverser la sélection")) { return @tr("Sélectionne tout ce qui ne l'était pas (Ctrl+I)."); }
        if (t == @tr("Tout sélectionner")) { return @tr("Sélectionne toute la toile (Ctrl+A)."); }
        if (t == @tr("Sélection / baguette / lasso")) { return @tr("Choisit l'outil de sélection : rectangle, lasso, baguette magique…"); }
        if (t == @tr("Nouvelle sélection")) { return @tr("La nouvelle sélection remplace l'ancienne."); }
        if (t == @tr("Ajouter à la sélection")) { return @tr("La nouvelle zone est ajoutée à la sélection existante (union)."); }
        if (t == @tr("Soustraire de la sélection")) { return @tr("La nouvelle zone est retirée de la sélection existante."); }
        if (t == @tr("Copier")) { return @tr("Copie la sélection (ou le calque) dans le presse-papiers (Ctrl+C), aussi vers les autres applications."); }
        if (t == @tr("Coller")) { return @tr("Colle l'image du presse-papiers comme nouveau calque déplaçable (Ctrl+V)."); }
        if (t == @tr("Aligner la sélection à gauche de la toile")) { return @tr("Colle la sélection contre le bord gauche de la toile."); }
        if (t == @tr("Centrer la sélection horizontalement sur la toile")) { return @tr("Place la sélection au milieu de la toile, sur l'axe horizontal."); }
        if (t == @tr("Aligner la sélection à droite de la toile")) { return @tr("Colle la sélection contre le bord droit de la toile."); }
        if (t == @tr("Effacer sélection")) { return @tr("Vide les pixels de la sélection (Suppr)."); }
        if (t == @tr("Aligner la sélection en haut de la toile")) { return @tr("Colle la sélection contre le bord haut de la toile."); }
        if (t == @tr("Centrer la sélection verticalement sur la toile")) { return @tr("Place la sélection au milieu de la toile, sur l'axe vertical."); }
        if (t == @tr("Aligner la sélection en bas de la toile")) { return @tr("Colle la sélection contre le bord bas de la toile."); }
        if (t == @tr("Centrer la sélection sur la toile")) { return @tr("Place la sélection exactement au centre de la toile."); }
        if (t == @tr("Grille de pixels")) { return @tr("Affiche la grille entre les pixels (visible à fort zoom)."); }
        if (t == @tr("Règles")) { return @tr("Affiche les règles graduées en pixels sur les bords de la toile."); }
        if (t == @tr("Autoriser le contenu hors de la toile")) { return @tr("Le contenu qui dépasse de la toile est gardé (zone de travail illimitée) au lieu d'être coupé. Réglage rendu à la toile par « Supprimer le contenu hors toile »."); }
        if (t == @tr("Aimantation")) { return @tr("Les bords de la sélection et des calques se collent aux repères, aux bords et aux autres objets."); }
        if (t == @tr("Masquer cette palette")) { return @tr("Ferme la palette d'outils (rouvrez-la par le menu Fenêtre)."); }
        if (t == @tr("Sélection rectangulaire")) { return @tr("Dessine une sélection rectangulaire. Maj = carré, Ctrl = ajoute, Alt = soustrait."); }
        if (t == @tr("Sélection à la volée")) { return @tr("Sélection au lasso à main levée : tracez le contour en gardant le bouton appuyé."); }
        if (t == @tr("Baguette")) { return @tr("Sélectionne d'un clic les pixels voisins de couleur proche. Réglez la tolérance dans les options."); }
        if (t == @tr("Lasso magnétique")) { return @tr("Le contour se colle aux bords de l'image pendant que vous le suivez."); }
        if (t == @tr("Lasso polygonal")) { return @tr("Cliquez point par point pour tracer un contour à segments droits ; double-clic pour fermer."); }
        if (t == @tr("Désélectionner")) { return @tr("Retire la sélection (Ctrl+D)."); }
        if (t == @tr("Déformation 4 coins")) { return @tr("Déforme le calque en déplaçant ses quatre coins (perspective)."); }
        if (t == @tr("Déformation")) { return @tr("Déforme le calque librement : tirez les points pour le tordre."); }
        if (t == @tr("Pipette")) { return @tr("Prélève la couleur d'un pixel ; maintenez le bouton appuyé pour la voir changer. Clic droit : couleur secondaire."); }
        if (t == @tr("Déplacer la sélection ou le calque")) { return @tr("Déplace la sélection (contenu inclus) ou le calque. Maj = bloque un axe."); }
        if (t == @tr("Zoom")) { return @tr("Cliquez pour agrandir, clic droit pour réduire, ou encadrez la zone à voir."); }
        if (t == @tr("Pinceau")) { return @tr("Peint avec la couleur principale (clic gauche) ou secondaire (clic droit). Taille et dureté dans les options."); }
        if (t == @tr("Crayon")) { return @tr("Trace des pixels nets, sans lissage."); }
        if (t == @tr("Dégradé")) { return @tr("Type de dégradé et couleurs."); }
        if (t == @tr("Remplissage")) { return @tr("Remplit d'un clic la zone de couleur voisine avec la couleur principale."); }
        if (t == @tr("Gomme")) { return @tr("Efface vers la transparence (ou la couleur secondaire sur le fond)."); }
        if (t == @tr("Texte")) { return @tr("Ajoute du texte : cliquez sur la toile puis tapez. Police, taille et style dans les options."); }
        if (t == @tr("Formes multiples")) { return @tr("Dessine des formes : rectangle, ellipse, polygones, étoiles, flèches… Choix de la forme dans les options."); }
        if (t == @tr("Rectangle à coins arrondis")) { return @tr("Dessine un rectangle dont les coins sont arrondis."); }
        if (t == @tr("Ligne")) { return @tr("Trace une ligne ou une courbe de Bézier modifiable."); }
        if (t == @tr("Sélection rapide")) { return @tr("Sélectionne un objet en peignant dessus (pas encore transféré dans la version Rust)."); }
        if (t == @tr("Sélection d'objet")) { return @tr("Détecte l'objet sous le curseur (pas encore transféré dans la version Rust)."); }
        if (t == @tr("Rectangle")) { return @tr("Dessine un rectangle (Maj = carré)."); }
        if (t == @tr("Triangle isocèle")) { return @tr("Dessine un triangle isocèle."); }
        if (t == @tr("Cercle / Ellipse")) { return @tr("Dessine une ellipse (Maj = cercle)."); }
        if (t == @tr("Étoile")) { return @tr("Dessine une étoile à branches réglables."); }
        if (t == @tr("Contigu")) { return @tr("Activé : seuls les pixels reliés à celui cliqué sont pris. Désactivé : toute l'image est parcourue."); }
        if (t == @tr("Calque")) { return @tr("La sélection ou le remplissage se base sur le calque actif seulement."); }
        if (t == @tr("Global")) { return @tr("La sélection ou le remplissage se base sur l'image visible (tous les calques)."); }
        if (t == @tr("Tol.")) { return @tr("Tolérance : écart de couleur accepté. Plus elle est haute, plus la zone prise est grande."); }
        if (t == @tr("Taille")) { return @tr("Diamètre de l'outil (pinceau, gomme…) ou corps du texte, en pixels."); }
        if (t == @tr("Taille / trait")) { return @tr("Taille de l'outil, ou épaisseur du trait pour une forme."); }
        if (t == @tr("Dureté")) { return @tr("100 % = bord net ; plus bas, le bord devient flou et progressif."); }
        if (t == @tr("Épaisseur")) { return @tr("Épaisseur du trait en pixels."); }
        if (t == @tr("Rond")) { return @tr("Pointe de pinceau ronde."); }
        if (t == @tr("Doux")) { return @tr("Pointe ronde au bord progressif."); }
        if (t == @tr("Spray")) { return @tr("Projette des gouttelettes comme un aérosol."); }
        if (t == @tr("Carré")) { return @tr("Pointe de pinceau carrée."); }
        if (t == @tr("Contour")) { return @tr("Dessine seulement le contour de la forme."); }
        if (t == @tr("Plein")) { return @tr("Remplit la forme avec la couleur secondaire."); }
        if (t == @tr("Les deux")) { return @tr("Contour en couleur principale, remplissage en couleur secondaire."); }
        if (t == @tr("Lissé")) { return @tr("Adoucit le bord des lettres (anticrénelage)."); }
        if (t == @tr("Linéaire")) { return @tr("Dégradé en ligne droite."); }
        if (t == @tr("Radial")) { return @tr("Dégradé qui part d'un centre vers l'extérieur."); }
        if (t == @tr("Losange")) { return @tr("Dégradé en losange autour du point de départ."); }
        if (t == @tr("Conique")) { return @tr("Dégradé qui tourne autour du point de départ."); }
        if (t == @tr("Sym. X")) { return @tr("Symétrie gauche/droite : ce que vous peignez est reflété de l'autre côté de l'axe vertical."); }
        if (t == @tr("Sym. Y")) { return @tr("Symétrie haut/bas : ce que vous peignez est reflété de l'autre côté de l'axe horizontal."); }
        if (t == @tr("Symétrie")) { return @tr("Reflète vos traits par rapport à un ou deux axes (les règles s'affichent pour les placer)."); }
        if (t == @tr("Forme")) { return @tr("Type de forme dessinée."); }
        if (t == @tr("Recadrer l'image (poignées sur la toile)")) { return @tr("Affiche quatre poignées sur la toile : tirez-les pour choisir la zone à garder, puis validez."); }
        if (t == @tr("Valeur par défaut")) { return @tr("Remet ce réglage à sa valeur d'origine."); }
        if (t == @tr("Masque alpha (actif) — éditer")) { return @tr("Le masque règle la transparence du calque : blanc = visible, noir = caché. Cliquez pour le peindre."); }
        if (t == @tr("Créer / ouvrir le masque alpha")) { return @tr("Crée un masque de transparence pour ce calque et l'ouvre dans un onglet à part (niveaux de gris)."); }
        if (t == @tr("Supprimer le masque α")) { return @tr("Retire le masque ; le calque redevient entièrement visible."); }
        if (t == @tr("Filtre dynamique (effet sous le calque, masqué par l'alpha du calque)")) { return @tr("Applique un effet en direct aux calques situés dessous, limité par la transparence de ce calque. Modifiable à tout moment."); }
        if (t == @tr("Afficher / masquer le calque")) { return @tr("Cache ou montre le calque sans le supprimer."); }
        if (t == @tr("Calque : double-clic pour renommer, glisser pour réordonner")) { return @tr("Clic : activer. Double-clic : renommer. Glisser : changer l'ordre. Clic droit : menu."); }
        if (t == @tr("Ajouter un calque")) { return @tr("Ajoute un calque transparent au-dessus du calque actif."); }
        if (t == @tr("Supprimer le calque")) { return @tr("Supprime le calque actif. Cette action peut être annulée avec Ctrl+Z."); }
        if (t == @tr("Nouveau dossier")) { return @tr("Crée un dossier pour organiser et regrouper les calques."); }
        if (t == @tr("Dupliquer le calque")) { return @tr("Crée une copie du calque actif avec son contenu et ses réglages."); }
        if (t == @tr("Fusionner le calque")) { return @tr("Fusionne le calque actif avec celui situé juste en dessous."); }
        if (t == @tr("Monter le calque")) { return @tr("Déplace le calque actif d’un niveau vers le haut dans la pile."); }
        if (t == @tr("Descendre le calque")) { return @tr("Déplace le calque actif d’un niveau vers le bas dans la pile."); }
        if (t == @tr("Exporter")) { return @tr("Choisit le format et les options d’enregistrement de l’image ou du projet."); }
        if (t == @tr("OK")) { return @tr("Valide les réglages et ferme cette fenêtre."); }
        if (t == @tr("Fermer")) { return @tr("Ferme cette fenêtre et revient à l’espace de travail."); }
        if (t == @tr("Réinitialiser")) { return @tr("Rétablit les valeurs d’origine de ces réglages."); }
        if (t == @tr("Appliquer")) { return @tr("Applique les réglages sélectionnés."); }
        if (t == @tr("Télécharger")) { return @tr("Enregistre le fichier sur votre appareil."); }
        if (t == @tr("Réinitialiser les couleurs")) { return @tr("Rétablit le damier blanc et gris, le fond adapté au thème et les couleurs de démarrage noir et blanc."); }
        if (t == @tr("Langue")) { return @tr("Change la langue de l’interface. Les noms de vos fichiers et de vos calques sont conservés."); }
        return "";
    }
}
