#!/usr/bin/env xdg-open
[Desktop Entry]
Type=Application
Version=1.0
Name=HTCL
GenericName=Surveillance d'écran
Comment=Chronomètre l'affichage de textes et de changements de luminosité à l'écran
Exec=@DIR@/htcl.sh
Path=@DIR@
Icon=utilities-system-monitor
Terminal=false
Categories=Utility;Monitor;
Keywords=ocr;écran;surveillance;chronomètre;
StartupNotify=true
