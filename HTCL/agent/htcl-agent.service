# Service utilisateur systemd : surveillance au démarrage de la session.
#
#   cp htcl-agent.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now htcl-agent
#   journalctl --user -u htcl-agent -f
#
# Adaptez ExecStart si l'agent n'est pas dans ~/HTCL/agent, et DISPLAY si votre
# écran n'est pas :0. Pour un usage occasionnel, l'interface graphique suffit.

[Unit]
Description=HTCL — surveillance de zones de l'écran
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
ExecStart=%h/HTCL/agent/htcl.sh run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
