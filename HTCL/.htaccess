# HTCL — règles propres au dossier.

# Déclarer RewriteEngine ici coupe l'héritage des règles du dossier parent :
# la redirection « polocrafting.fr → masterpaint.fr » de MasterPaint/.htaccess
# ne s'applique donc pas à /HTCL, et la réécriture SPA (tout vers index.html)
# non plus. C'est ce qui permet d'ouvrir polocrafting.fr/HTCL directement.
RewriteEngine On

DirectoryIndex index.php
Options -Indexes

# HTTPS obligatoire dès qu'on n'est pas en local.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1) [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Rien à servir dans ces dossiers : ils contiennent le mot de passe et la base.
RewriteRule ^(lib|data)/ - [F,L]

<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|db|jsonl|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# La configuration de l'agent contient le token : jamais téléchargeable.
<Files "htcl.json">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Page consultée surtout au téléphone : compression et revalidation.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Pas d'indexation par les moteurs.
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "same-origin"
</IfModule>
